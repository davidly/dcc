        ld      hl,(__stok_delim)
        push    hl
        ld      hl,(__stok_s)
        push    hl
        call    __sspn
        pop     bc
        pop     bc
        ex      de,hl                   ; DE = span length
        ld      hl,(__stok_s)
        add     hl,de
        ld      (__stok_s),hl

        ld      a,(hl)
        or      a
        jr      nz,stok_token
        ld      hl,0
        ld      (SCZ0007),hl
        ret

stok_token:
        ld      (__stok_token),hl

        ; p = strpbrk(token, delim)
        ld      de,(__stok_delim)
        push    de
        push    hl
        call    __spbr
        pop     bc
        pop     bc
        ld      a,h
        or      l
        jr      z,stok_last

        xor     a
        ld      (hl),a                   ; terminate this token
        inc     hl
        ld      (SCZ0007),hl
        ld      hl,(__stok_token)
        ret

stok_last:
        ld      hl,0
        ld      (SCZ0007),hl
        ld      hl,(__stok_token)
        ret

__stok_s:
        dw      0
__stok_delim:
        dw      0
__stok_token:
        dw      0


; strtok saved-position state
SCZ0007:
        dw 0

; ================= END generated string-conversion functions =================

; ============================================================
; exec / execv -- load and run a .COM program over this one
; ============================================================
; C interface (declared in <stdlib.h>):
;   int exec(const char *path, const char *cmdtail);
;   int execv(const char *path, char **argv);
;
; Does not return on success (new program replaces this one).
; Returns -1 if the .COM file cannot be opened.
;
; CP/M SDA set up before the new program starts:
;   0080h : command-tail length byte
;   0081h : command-tail text (CR-terminated)
;   005Ch : FCB1 -- first argument, parsed
;   006Ch : FCB2 -- second argument, parsed
;
; Trampoline layout (placed just below BDOS):
;   [FCB: FCBSIZE bytes]    <- __xbase  (opened by exec before jumping)
;   [Code: XTCOD bytes]     <- __xtrep  (reads sectors, then jp 0100h)
; Stack during trampoline: SP = __xbase - XTSGP (clear gap below block)
; ============================================================

; ============================================================
; _getenv  (C89 7.10.4.4) -- CP/M 2.2 has no environment
; ============================================================
        public  _getenv
_getenv:
        ld      hl,0            ; always NULL: no environment on CP/M
        ret

; ============================================================
; _system  (C89 7.10.4.5)
; system(NULL) -> 0 (no command processor available on CP/M 2.2)
; system(cmd)  -> -1 (cannot execute)
; ============================================================
        public  _system
_system:
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      a,h
        or      l
        jr      nz,sys_fail
        ld      hl,0            ; NULL: no command processor
        pop     ix
        ret
sys_fail:
        ld      hl,0ffffh       ; -1: not supported
        pop     ix
        ret

; ============================================================
; Multibyte / wide-character functions  (C89 7.10.7 / 7.10.8)
; C/ASCII locale: MB_CUR_MAX=1, wchar_t = unsigned int (16-bit).
; ============================================================
        public  _mblen
        public  _mbtowc
        public  _wctomb
        public  _mbstowcs
        public  _wcstombs
__mbs_n:        dw      0               ; scratch: remaining n for mbstowcs
__wcs_n:        dw      0               ; scratch: remaining n for wcstombs

_mblen:
; int mblen(const char *s, size_t n) -- s@IX+4, n@IX+6
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      a,h
        or      l
        jr      z,mbl_zero      ; NULL: no state-dependent encodings -> 0
        ld      e,(ix+6)
        ld      d,(ix+7)
        ld      a,d
        or      e
        jr      z,mbl_err       ; n==0: cannot examine -> -1
        ld      a,(hl)
        or      a
        jr      z,mbl_zero      ; NUL byte -> 0
        ld      hl,1
        pop     ix
        ret
mbl_err:
        ld      hl,0ffffh
        pop     ix
        ret
mbl_zero:
        ld      hl,0
        pop     ix
        ret

_mbtowc:
; int mbtowc(wchar_t *pwc, const char *s, size_t n) -- pwc@IX+4, s@IX+6, n@IX+8
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+6)
        ld      h,(ix+7)        ; HL = s
        ld      a,h
        or      l
        jr      z,mbw_zero      ; s==NULL -> 0
        ld      e,(ix+8)
        ld      d,(ix+9)
        ld      a,d
        or      e
        jr      z,mbw_err       ; n==0 -> -1
        ld      a,(hl)          ; A = *s
        ld      c,a
        ld      l,(ix+4)
        ld      h,(ix+5)        ; HL = pwc
        ld      a,h
        or      l
        jr      z,mbw_nopwc
        ld      (hl),c          ; *pwc low byte = char value
        inc     hl
        ld      (hl),0          ; *pwc high byte = 0
mbw_nopwc:
        ld      a,c
        or      a
        jr      z,mbw_zero
        ld      hl,1
        pop     ix
        ret
mbw_err:
        ld      hl,0ffffh
        pop     ix
        ret
mbw_zero:
        ld      hl,0
        pop     ix
        ret

_wctomb:
; int wctomb(char *s, wchar_t wc) -- s@IX+4, wc@IX+6
; Returns 0 if s==NULL (no state-dep encoding), else stores (char)wc and returns 1.
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      a,h
        or      l
        jr      z,wcm_null
        ld      a,(ix+6)
        ld      (hl),a
        ld      hl,1
        pop     ix
        ret
wcm_null:
        ld      hl,0
        pop     ix
        ret

_mbstowcs:
; size_t mbstowcs(wchar_t *pwcs, const char *s, size_t n) -- pwcs@IX+4, s@IX+6, n@IX+8
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      (__mbs_n),hl            ; save n
        ld      c,(ix+6)
        ld      b,(ix+7)                ; BC = src
        ld      e,(ix+4)
        ld      d,(ix+5)                ; DE = dst
        ld      hl,0                    ; HL = count
mbs_lp:
        push    hl
        ld      hl,(__mbs_n)
        ld      a,h
        or      l
        jr      z,mbs_nexhausted
        dec     hl
        ld      (__mbs_n),hl
        pop     hl
        ld      a,(bc)
        or      a
        jr      z,mbs_null
        ld      (de),a                  ; wchar_t low byte
        inc     de
        xor     a
        ld      (de),a                  ; wchar_t high byte = 0
        inc     de
        inc     bc
        inc     hl
        jr      mbs_lp
mbs_null:
        ld      (de),a                  ; null wchar_t
        inc     de
        ld      (de),a
        jr      mbs_ret
mbs_nexhausted:
        pop     hl
mbs_ret:
        pop     ix
        ret

_wcstombs:
; size_t wcstombs(char *s, const wchar_t *pwcs, size_t n) -- s@IX+4, pwcs@IX+6, n@IX+8
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      (__wcs_n),hl            ; save n
        ld      c,(ix+6)
        ld      b,(ix+7)                ; BC = src (wchar_t *)
        ld      e,(ix+4)
        ld      d,(ix+5)                ; DE = dst
        ld      hl,0                    ; HL = count
wcs_lp:
        push    hl
        ld      hl,(__wcs_n)
        ld      a,h
        or      l
        jr      z,wcs_nexhausted
        dec     hl
        ld      (__wcs_n),hl
        pop     hl
        ld      a,(bc)                  ; low byte of wchar_t
        or      a
        jr      z,wcs_null
        ld      (de),a
        inc     de
        inc     bc
        inc     bc                      ; advance wchar_t* by 2
        inc     hl
        jr      wcs_lp
wcs_null:
        ld      (de),a
        jr      wcs_ret
wcs_nexhausted:
        pop     hl
wcs_ret:
        pop     ix
        ret

        public  _exec
        public  _execv
        public  __xmain
; XTCOD=31 (trampoline code bytes), XTSGP=16 (stack gap below trampoline)

; int exec(const char *path, const char *cmdtail)
_exec:
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+4)
        ld      h,(ix+5)        ; HL = path
        ld      e,(ix+6)
        ld      d,(ix+7)        ; DE = cmdtail
        call    __xmain
        pop     ix
        ret

; int execv(const char *path, char **argv)
_execv:
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+6)
        ld      h,(ix+7)        ; HL = argv
        ld      a,h
        or      l
        jr      z,ev_noav       ; NULL argv
        call    __xmkct         ; build cmdtail in __xctbf from argv[1..]
        jr      ev_have
ev_noav:
        xor     a
        ld      (__xctbf),a     ; empty cmdtail
ev_have:
        ld      l,(ix+4)
        ld      h,(ix+5)        ; HL = path
        ld      de,__xctbf
        call    __xmain
        pop     ix
        ret

; __xmain(HL=path, DE=cmdtail): shared exec implementation
__xmain:
        ld      (__xpath),hl
        ld      (__xctls),de

        ; Compute trampoline base: BDOS entry - (36 FCB bytes + 31 code bytes)
        ld      hl,(0006h)      ; HL = BDOS entry point (word at 0006h)
        ld      bc,67           ; 36 (FCB) + 31 (code) = trampoline block size
        or      a
        sbc     hl,bc           ; HL = tramp_base = BDOS - 67
        ld      (__xbase),hl

        ; Zero FCB area (36 bytes) at tramp_base
        ex      de,hl           ; DE = tramp_base
        ld      b,36
xm_clr:
        xor     a
        ld      (de),a
        inc     de
        djnz    xm_clr

        ; Copy path to __xpbuf, appending ".COM" if no '.' in name
        ld      hl,(__xpath)
        ld      de,__xpbuf
        call    __xacom

        ; Build FCB at tramp_base from the path in __xpbuf
        ld      de,(__xbase)
        ld      hl,__xpbuf
        call    __mkfcb

        ; Pre-check: open the file (BDOS fn 15); return -1 if not found
        ld      de,(__xbase)
        ld      c,15
        call    5
        cp      0ffh
        jr      nz,xm_ok
        ld      hl,0ffffh       ; open failed
        ret

xm_ok:
        ; Patch trampoline template: write FCB address into the ld de,0 immediate
        ld      hl,(__xbase)    ; HL = FCB address = tramp_base
        ld      a,l
        ld      (__xtemp+13),a  ; lo byte of FCB address
        ld      a,h
        ld      (__xtemp+14),a  ; hi byte of FCB address

        ; Set up command tail (0080h) and default FCBs (005Ch, 006Ch)
        ld      hl,(__xctls)
        call    __xsctl

        ; __xsctl's call __mkfcb pushes a return address onto the stack that
        ; lands exactly on FCB[32] (cr).  Zero cr now, after __xsctl returns,
        ; so the first fn 20 reads from the start of the file.
        ld      hl,(__xbase)
        ld      de,32
        add     hl,de
        xor     a
        ld      (hl),a          ; FCB[32] = CR = 0

        ; Compute and save trampoline entry = tramp_base + 36 (FCB size)
        ld      hl,(__xbase)
        ld      bc,36
        add     hl,bc
        ld      (__xtrep),hl

        ; Copy patched template (31 bytes) to trampoline entry address
        ex      de,hl           ; DE = trampoline entry (destination)
        ld      hl,__xtemp
        ld      bc,31
        ldir

        ; Switch to safe stack below trampoline, then jump (no return)
        ld      hl,(__xbase)
        ld      bc,16           ; 16-byte stack gap below trampoline
        or      a
        sbc     hl,bc           ; HL = tramp_base - 16
        ld      sp,hl           ; new stack
        ld      hl,(__xtrep)
        jp      (hl)

; __xmkct(HL=argv): build cmdtail in __xctbf from argv[1..] (" arg1 arg2 ...")
__xmkct:
        ld      de,__xctbf
        inc     hl
        inc     hl              ; skip argv[0] pointer (2 bytes)
xmk_lp:
        ld      c,(hl)
        inc     hl
        ld      b,(hl)
        inc     hl              ; BC = argv[i]; HL -> next argv slot
        ld      a,b
        or      c
        jr      z,xmk_dn        ; NULL pointer = end of argv
        push    hl              ; save argv index
        push    de              ; save output pointer
        ld      h,b
        ld      l,c             ; HL = argv[i] string
        pop     de
        ld      a,' '
        ld      (de),a          ; space separator before each argument
        inc     de
xmk_cs:
        ld      a,(hl)
        or      a
        jr      z,xmk_ce
        ld      (de),a
        inc     hl
        inc     de
        jr      xmk_cs
xmk_ce:
        pop     hl              ; restore argv index
        jr      xmk_lp
xmk_dn:
        xor     a
        ld      (de),a          ; null-terminate __xctbf
        ret

; __xacom(HL=src, DE=dest): copy path to dest, appending ".COM" if no '.' present
__xacom:
        ld      b,0             ; B = dot-seen flag
xac_cp:
        ld      a,(hl)
        or      a
        jr      z,xac_dn
        cp      '.'
        jr      nz,xac_nd
        ld      b,1             ; found a dot
xac_nd:
        ld      (de),a
        inc     hl
        inc     de
        jr      xac_cp
xac_dn:
        ld      a,b
        or      a
        jr      nz,xac_hd       ; had dot: just null-terminate
        ld      a,'.'
        ld      (de),a
        inc     de
        ld      a,'C'
        ld      (de),a
        inc     de
        ld      a,'O'
        ld      (de),a
        inc     de
        ld      a,'M'
        ld      (de),a
        inc     de
xac_hd:
        xor     a
        ld      (de),a          ; null-terminate
        ret

; __xsctl(HL=cmdtail): set 0080h length byte, 0081h text, FCB1, FCB2
__xsctl:
        ; Clear FCB1 (16 bytes at 005Ch) then FCB2 (16 bytes at 006Ch)
        ld      de,005ch
        call    __xclfb         ; clears 005Ch-006Bh; DE = 006Ch on return
        call    __xclfb         ; clears 006Ch-007Bh

        ; Null or empty cmdtail -> write empty tail and return
        ld      a,h
        or      l
        jr      z,xsc_em
        ld      a,(hl)
        or      a
        jr      z,xsc_em

        ; Copy cmdtail to 0081h; count bytes in B; append CR
        ld      de,0081h
        ld      b,0
xsc_cp:
        ld      a,(hl)
        or      a
        jr      z,xsc_es
        cp      0dh
        jr      z,xsc_es
        ld      (de),a
        inc     hl
        inc     de
        inc     b
        jr      xsc_cp
xsc_es:
        ld      a,0dh
        ld      (de),a          ; CR terminator
        ld      a,b
        ld      (0080h),a       ; length byte

        ; FCB1 from first whitespace-delimited word in tail
        ld      hl,0081h
        call    __xsksp         ; skip leading spaces; HL -> first non-space
        ld      a,(hl)
        or      a
        ret     z
        cp      0dh
        ret     z
        ld      de,__xpbuf
        call    __xwcp          ; copy word to __xpbuf; HL -> delimiter
        push    hl              ; save position after first word
        ld      de,005ch
        ld      hl,__xpbuf
        call    __mkfcb
        pop     hl              ; restore position after first word

        ; FCB2 from second word
        call    __xsksp
        ld      a,(hl)
        or      a
        ret     z
        cp      0dh
        ret     z
        ld      de,__xpbuf
        call    __xwcp
        ld      de,006ch
        ld      hl,__xpbuf
        call    __mkfcb
        ret

xsc_em:
        xor     a
        ld      (0080h),a       ; length = 0
        ld      a,0dh
        ld      (0081h),a       ; CR at 0081h
        ret

; __xclfb(DE=buf): zero 16 bytes at DE (for clearing default FCB slots)
__xclfb:
        ld      b,16
xclf_l:
        xor     a
        ld      (de),a
        inc     de
        djnz    xclf_l
        ret

; __xsksp(HL=ptr): advance HL past space characters
__xsksp:
        ld      a,(hl)
        cp      ' '
        ret     nz
        inc     hl
        jr      __xsksp

; __xwcp(HL=src, DE=dest): copy space/NUL/CR-delimited word from HL to DE
; Null-terminates dest. Returns HL = position of delimiter.
__xwcp:
xwc_lp:
        ld      a,(hl)
        or      a
        jr      z,xwc_dn
        cp      0dh
        jr      z,xwc_dn
        cp      ' '
        jr      z,xwc_dn
        ld      (de),a
        inc     hl
        inc     de
        jr      xwc_lp
xwc_dn:
        xor     a
        ld      (de),a
        ret

; ---- exec/execv scratch data ----
__xbase:        dw      0       ; trampoline base address (= FCB address)
__xtrep:        dw      0       ; trampoline entry = __xbase + FCBSIZE
__xpath:        dw      0       ; saved path argument
__xctls:        dw      0       ; saved cmdtail argument
__xpbuf:        ds      16      ; path scratch buffer (8+1+3+NUL = 13 max)
__xctbf:        ds      128     ; execv: cmdtail build buffer

; Trampoline code template (XTCOD = 31 bytes).
; The FCB at __xbase is already open (BDOS fn 15 called before copy).
; Reads the .COM image sequentially from 0100h using fn 26 + fn 20,
; then jumps to 0100h.  Bytes 13-14 are patched with __xbase (lo, hi).
__xtemp:
        db      021h,000h,001h  ; ld hl,0100h          offsets  0- 2
        db      0e5h            ; push hl               offset   3  <- tloop
        db      0ebh            ; ex de,hl              offset   4
        db      00eh,01ah       ; ld c,26h              offsets  5- 6
        db      0cdh,005h,000h  ; call 5                offsets  7- 9
        db      0e1h            ; pop hl                offset  10
        db      0e5h            ; push hl               offset  11
        db      011h,000h,000h  ; ld de,0  PATCH 13,14  offsets 12-14
        db      00eh,014h       ; ld c,20h              offsets 15-16
        db      0cdh,005h,000h  ; call 5                offsets 17-19
        db      0e1h            ; pop hl                offset  20
        db      0b7h            ; or a                  offset  21
        db      0c2h,000h,001h  ; jp nz,0100h           offsets 22-24
        db      011h,080h,000h  ; ld de,0080h           offsets 25-27
        db      019h            ; add hl,de             offset  28
        db      018h,0e4h       ; jr tloop  (-28)       offsets 29-30

; ============================================================
; signal / raise  (C89 7.7)
; CP/M 2.2 has no async signal delivery.  signal() always returns
; SIG_ERR.  raise() calls abort() for SIGABRT; all others are no-ops.
; ============================================================
        public  _signal
        public  _raise

_signal:
; void (*signal(int sig, void (*func)(int)))(int) -- always returns SIG_ERR
        ld      hl,0ffffh               ; SIG_ERR = (void(*)(int))-1
        ret

_raise:
; int raise(int sig) -- sig @ IX+4/5
        push    ix
        ld      ix,0
        add     ix,sp
        ld      a,(ix+4)                ; sig (fits in a byte for all defined SIG values)
        cp      6                       ; SIGABRT
        jr      nz,rai_ok
        call    _abort                  ; does not return
rai_ok:
        ld      hl,0
        pop     ix
        ret

; ============================================================
; setlocale / localeconv  (C89 7.4)
; Always the "C" locale.  setlocale accepts NULL, "", or "C".
; ============================================================
        public  _setlocale
        public  __lcnv
__lc_dot:       db      '.', 0
__lc_emp:       db      0
__lc_cstr:      db      'C', 0
; Static C-locale lconv (28 bytes: 10 char* @ 2 bytes + 8 char @ 1 byte).
__lconv:
        dw      __lc_dot        ; decimal_point
        dw      __lc_emp        ; thousands_sep
        dw      __lc_emp        ; grouping
        dw      __lc_emp        ; int_curr_symbol
        dw      __lc_emp        ; currency_symbol
        dw      __lc_emp        ; mon_decimal_point
        dw      __lc_emp        ; mon_thousands_sep
        dw      __lc_emp        ; mon_grouping
        dw      __lc_emp        ; positive_sign
        dw      __lc_emp        ; negative_sign
        db      07fh            ; int_frac_digits  (CHAR_MAX = not applicable)
        db      07fh            ; frac_digits
        db      07fh            ; p_cs_precedes
        db      07fh            ; p_sep_by_space
        db      07fh            ; n_cs_precedes
        db      07fh            ; n_sep_by_space
        db      07fh            ; p_sign_posn
        db      07fh            ; n_sign_posn

_setlocale:
; char *setlocale(int category, const char *locale) -- category@IX+4, locale@IX+6
; Returns "C" for NULL/""/"C"; NULL for any other locale name.
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+6)
        ld      h,(ix+7)        ; HL = locale
        ld      a,h
        or      l
        jr      z,slc_ok        ; NULL: query current locale
        ld      a,(hl)
        or      a
        jr      z,slc_ok        ; "": set to implementation default
        cp      'C'
        jr      nz,slc_fail
        inc     hl
        ld      a,(hl)
        or      a
        jr      nz,slc_fail     ; not exactly "C"
slc_ok:
        ld      hl,__lc_cstr
        pop     ix
        ret
slc_fail:
        ld      hl,0
        pop     ix
        ret

__lcnv:
; struct lconv *localeconv(void)
        ld      hl,__lconv
        ret

; ============================================================
; Time functions  (C89 7.12)
; CP/M 2.2 has no real-time clock.  clock() and time() return -1.
; Struct-based functions (localtime etc.) return NULL.
; difftime converts the low 16 bits of (t1-t0) to float via __fif.
; ============================================================
        public  _clock
        public  _time
        public  _difftime
        public  _mktime
        public  _asctime
        public  _ctime
        public  _gmtime
        public  __ltim
        public  _strftime

_clock:
; clock_t clock(void) -- returns (clock_t)-1 (unavailable)
        ld      hl,0ffffh
        ld      de,0ffffh
        ret

_time:
; time_t time(time_t *tp) -- tp @ IX+4/5
; Stores (time_t)-1 through tp if non-null; returns (time_t)-1.
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      a,h
        or      l
        jr      z,tim_ret
        ld      (hl),0ffh
        inc     hl
        ld      (hl),0ffh
        inc     hl
        ld      (hl),0ffh
        inc     hl
        ld      (hl),0ffh
tim_ret:
        ld      hl,0ffffh
        ld      de,0ffffh
        pop     ix
        ret

_difftime:
; float difftime(time_t t1, time_t t0)
; Note: C89 returns double; dcc returns float (no double type).
; Converts the signed 16-bit difference of the low words to float via __fif.
; t0 @ IX+4..7, t1 @ IX+8..11
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+8)
        ld      h,(ix+9)        ; HL = t1 low word
        ld      e,(ix+4)
        ld      d,(ix+5)        ; DE = t0 low word
        or      a
        sbc     hl,de           ; HL = t1_lo - t0_lo
        call    __fif           ; convert signed 16-bit to float in DE:HL
        pop     ix
        ret

_mktime:
; time_t mktime(struct tm *tp) -- returns (time_t)-1 (unavailable)
        ld      hl,0ffffh
        ld      de,0ffffh
        ret

_asctime:
_ctime:
_gmtime:
__ltim:
_strftime:
; All return NULL/0 (no clock on CP/M 2.2). strftime returns size_t (0 =
; wrote nothing) rather than a NULL pointer, but that's still HL=0 on
; return, and none of these five functions ever read their arguments, so
; the differing parameter lists don't matter for a shared stub that
; ignores all of them.
        ld      hl,0
        ret

        end     start
