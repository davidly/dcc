; dccrtl.mac - minimal CP/M-80 runtime for dcc
;
; M80/L80 Z80 assembly.
;
;        org     100h

        extrn   __mrun     ; app-supplied main shim (see dcc_func.c)
        extrn   __hstart   ; heap start
        extrn   __bssb     ; bss begin
        extrn   __bsse     ; bss end
        extrn   __stack_size ; bytes reserved above heap for C stack
        public  __brk
        public  __hlimit   ; heap limit
        public  start

HDRSIZE          equ     2
FTRSIZE          equ     2
; Maximum fd value + 1: fds 0..10 (stdin/stdout/stderr + NFILES real files).
; Keep in sync with MAXFD = FIRSTFD+NFILES at the _open block.
UGC_MAX  equ     11

; errno values used by the CP/M file layer.  Keep these in sync with errno.h.
ENOENT   equ     2
EIO      equ     5
EBADF    equ     9
EINVAL   equ     22
EMFILE   equ     24
ENOSPC   equ     28

        cseg
; start: must be the very first thing in the linked image - CP/M loads a
; .COM at 0100h and begins executing there directly, with no jump to a
; named entry point, so anything placed before start: in this always-kept
; block (even zeroed data, which happens to decode as NOP) executes first.
start:
        ; Initialize heap allocator.
        ; __hlimit = initial SP - __stack_size
        ld      hl,0
        add     hl,sp
        ld      de,__stack_size
        or      a
        sbc     hl,de
        ld      (__hlimit),hl
        ; __brk = __hbase = __hstart (label at end of user module)
        ld      hl,__hstart
        ld      (__hbase),hl
        ld      (__brk),hl

        ; Zero BSS (C89: uninitialized globals must be zero at startup)
        ld      hl,__bsse
        ld      de,__bssb
        or      a
        sbc     hl,de           ; HL = __bsse - __bssb = BSS length
        ld      b,h
        ld      c,l
        ld      a,b
        or      c
        jr      z,bss_done
        ld      hl,__bssb
        ld      (hl),0
        ld      d,h
        ld      e,l
        inc     de
        dec     bc
        ld      a,b
        or      c
        jr      z,bss_done
        ldir
bss_done:

        call    __mrun
        push    hl                      ; pass main() return value to exit
        call    _exit                   ; -> __cflush, __cpm_set_retcode, jp 0000h
        ; unreachable

; Heap state used by start/free/malloc.  Kept in this always-kept startup
; block (data, not code, so its position relative to start: doesn't matter
; for execution) so allocator code itself is not pulled in just because
; start initializes __brk/__hlimit.
__hbase:        dw      0
__brk:          dw      0
__hlimit:       dw      0

; Every heap block is [HDRSIZE header][user data][FTRSIZE footer], where
; header and footer both hold the SAME packed value: bit 0 is the free
; flag (1 = free, 0 = used), bits 15-1 are the user size. This only works
; because every stored size is rounded to even (see __mlh), which leaves
; bit 0 free to double as the flag - shrinking a 2-byte size field down to
; a 2-byte size+flag field, so adding a footer costs 2 bytes/allocation
; instead of naively adding a full 3rd header byte's worth (footer) on top.
; The footer is what lets __frcoal find the block immediately before the
; one being freed in O(1) (read 2 bytes) instead of a linear scan.
;
; Write `packed` as BOTH the header at `addr` and the matching footer
; FTRSIZE bytes after `size` bytes of user data (i.e. at addr+HDRSIZE+
; size). Every block state change in the allocator goes through this, so
; there is one place that can get the header/footer pairing wrong instead
; of several. Kept in this always-linked startup block (like __hbase/
; __brk/__hlimit above) rather than inside __mlh's or __frcoal's own block,
; so that neither malloc-only nor free-only programs are forced to pull in
; the other's block just to reach this helper. It sits AFTER start's own
; code (which is never reached by fall-through - CP/M begins executing at
; the very first byte of the linked image, with no jump to `start`, so
; anything placed before `start:` in this block would execute first, with
; garbage register state, rather than through an explicit call).
; Entry: HL=addr, DE=packed, BC=size (true, even user size).
; Exit: HL clobbered (ends at footer+2). AF clobbered. DE, BC preserved.
__wr_hf:
        ld      (hl),e
        inc     hl
        ld      (hl),d
        inc     hl              ; HL = addr + HDRSIZE
        add     hl,bc           ; HL = addr + HDRSIZE + size = footer addr
        ld      (hl),e
        inc     hl
        ld      (hl),d
        ret

; ------------------------------------------------------------
; CP/M command-tail argc/argv builder
; ------------------------------------------------------------
; CP/M command tail:
;   0080h = length
;   0081h = text
;
; Builds:
;   argc = 1 + whitespace-delimited command-tail args
;   argv[0] = ""
;   argv[1..] = pointers into __argbuf

        public  __build_argv
        public  __argc
        public  argv

__build_argv:
        ld      hl,argv0
        ld      (argv),hl
        ld      hl,1
        ld      (__argc),hl

        ld      a,(80h)
        or      a
        ret     z

        ld      b,a
        ld      hl,81h
        ld      de,__argbuf

ba_copy:
        ld      a,b
        or      a
        jr      z,ba_done_copy
        ld      a,(hl)
        cp      0dh
        jr      z,ba_done_copy
        ld      (de),a
        inc     hl
        inc     de
        dec     b
        jr      ba_copy

ba_done_copy:
        xor     a
        ld      (de),a

        ld      hl,__argbuf
        ld      de,argv+2
        ld      c,1

ba_skip_spaces:
        ld      a,(hl)
        or      a
        jr      z,ba_finish
        cp      ' '
        jr      nz,ba_arg_start
        inc     hl
        jr      ba_skip_spaces

ba_arg_start:
        ld      a,l
        ld      (de),a
        inc     de
        ld      a,h
        ld      (de),a
        inc     de
        inc     c

ba_scan_arg:
        ld      a,(hl)
        or      a
        jr      z,ba_finish
        cp      ' '
        jr      z,ba_end_arg
        inc     hl
        jr      ba_scan_arg

ba_end_arg:
        xor     a
        ld      (hl),a
        inc     hl
        jr      ba_skip_spaces

ba_finish:
        ld      h,0
        ld      l,c
        ld      (__argc),hl
        ret

__argc:
        dw      0

argv0:
        db      0

argv:
        ds      34

__argbuf:
        ds      128

; __conout: output char in E to console with LF->CR/LF translation.
; Buffered: the character is appended to __cobuf and the buffer is flushed to
; the BDOS lazily.  The flush policy is set by setvbuf()/setbuf():
;   __cob_mode = 0 (_IOFBF)  flush only when the buffer fills, on fflush(),
;                            before stdin input, or at program exit;
;                1 (_IOLBF)  additionally flush at each newline (the default);
;                2 (_IONBF)  flush after every character.
; Preserves all registers except F (callers rely on this).
        public  __conout
COBSZ   equ     128
__conout:
        push    af
        push    bc
        push    de
        push    hl
        ld      a,e
        cp      0ah             ; LF?
        jr      nz,co_one
        ld      a,0dh           ; LF -> CR first
        call    __cob_put
        ld      a,0ah
co_one:
        call    __cob_put       ; append the character
        ld      a,(__cob_mode)
        or      a               ; 0 = _IOFBF: no per-char flush
        jr      z,co_ret
        dec     a               ; 1 = _IOLBF
        jr      z,co_line
        call    __cflush        ; 2 = _IONBF: flush every character
        jr      co_ret
co_line:
        ld      a,e
        cp      0ah             ; flush the buffered line on newline
        jr      nz,co_ret
        call    __cflush
co_ret:
        pop     hl
        pop     de
        pop     bc
        pop     af
        ret

; __cob_put: append the character in A to the console buffer; flush if it is
; now full.  Preserves BC/DE/HL (DE still holds the char for __conout);
; clobbers A and flags.  The active buffer base is __cob_ptr and the fill
; threshold (usable bytes before a forced flush) is __cob_cap; these point at
; the internal __cobuf/COBSZ by default or at a caller buffer set via setvbuf.
__cob_put:
        push    de
        push    hl
        ld      hl,(__cobcnt)
        ld      de,(__cob_ptr)
        add     hl,de
        ld      (hl),a          ; buffer[cobcnt] = A
        ld      hl,(__cobcnt)
        inc     hl
        ld      (__cobcnt),hl
        ld      de,(__cob_cap)
        or      a
        sbc     hl,de           ; cobcnt - capacity
        jr      c,cp_done       ; still room in the buffer
        call    __cflush        ; buffer full: drain it
cp_done:
        pop     hl
        pop     de
        ret

; __cflush: drain the console buffer to the BDOS.  Maximal runs of non-'$'
; characters go out with BDOS function 9 (print '$'-terminated string) and any
; literal '$' goes out with function 2, so the buffered bytes are reproduced
; exactly while still batching most output into single BDOS calls.  A guard
; byte just past the buffer end lets a run that reaches the end borrow a '$'
; terminator.  Preserves all registers except F.
__cflush:
        push    af
        push    bc
        push    de
        push    hl
        ld      bc,(__cobcnt)
        ld      a,b
        or      c
        jr      z,cf_reset      ; nothing buffered
        ld      hl,(__cob_ptr)
cf_outer:
        ld      a,b
        or      c
        jr      z,cf_reset      ; all bytes emitted
        ld      a,(hl)
        cp      '$'
        jr      nz,cf_run
        ; literal '$' -> BDOS function 2
        push    bc
        push    hl
        ld      e,'$'
        ld      c,2
        call    5
        pop     hl
        pop     bc
        inc     hl
        dec     bc
        jr      cf_outer
cf_run:
        ld      d,h
        ld      e,l             ; DE = start of the non-'$' run
cf_scan:
        ld      a,(hl)
        cp      '$'
        jr      z,cf_emit
        inc     hl
        dec     bc
        ld      a,b
        or      c
        jr      nz,cf_scan
cf_emit:
        ; Run is [DE, HL).  Temporarily terminate it with '$' at HL.
        ld      a,(hl)
        push    af              ; save the real '$' or the guard byte
        ld      (hl),'$'
        push    bc
        push    hl
        ld      c,9             ; BDOS print '$'-terminated string (DE = start)
        call    5
        pop     hl
        pop     bc
        pop     af
        ld      (hl),a          ; restore the saved byte
        jr      cf_outer
cf_reset:
        ld      hl,0
        ld      (__cobcnt),hl
        pop     hl
        pop     de
        pop     bc
        pop     af
        ret

__cob_mode:
        db      1               ; default _IOLBF (line-buffered console)
__cobcnt:
        dw      0
; Active console buffer: base pointer + usable capacity (bytes appended before
; a forced flush).  Default to the internal buffer; setvbuf/setbuf may repoint
; these at a caller-supplied buffer (capacity = size-1, reserving one guard
; byte for the '$' terminator borrowed by __cflush).
__cob_ptr:
        dw      __cobuf
__cob_cap:
        dw      COBSZ
__cobuf:
        ds      COBSZ+1         ; +1 guard slot for the '$' terminator

        public  __pchr
__pchr:
        ; IX-free argument setup; caller still cleans the argument.
        pop     bc              ; return address
        pop     hl              ; character
        push    hl              ; restore argument
        push    bc
        ld      e,l
        call    __conout
        ld      h,0
        ld      l,e
        ret

        public  __fpc
__fpc:
        ; int fputc(int c, FILE *fp)
        ; fp values 0/1/2 are stdin/stdout/stderr pseudo FILEs in this RTL.
        pop     hl              ; return address
        pop     de              ; c
        pop     bc              ; fp/fd
        push    bc              ; restore caller-cleanup fp argument
        push    de              ; restore caller-cleanup c argument
        push    hl              ; restore return address

        ld      a,c             ; low byte of fp/fd
        cp      1
        jr      z,fputc_con
        cp      2
        jr      z,fputc_con

        ; File path: store char in a one-byte buffer and call _write(fp,&ch,1).
        ld      a,e
        ld      (___fpc_ch),a

        ld      hl,1
        push    hl              ; count
        ld      hl,___fpc_ch
        push    hl              ; buf
        push    bc              ; fp
        call    _write

        ; Clean 3 args while preserving _write return in HL.
        ex      de,hl
        ld      hl,6
        add     hl,sp
        ld      sp,hl
        ex      de,hl

        ; Success iff _write returned 1 byte.
        ld      a,h
        or      a
        jr      nz,fputc_bad
        ld      a,l
        cp      1
        jr      nz,fputc_bad

        ld      h,0
        ld      a,(___fpc_ch)
        ld      l,a             ; return written character
        ret

fputc_con:
        ; E still contains c.
        call    __conout
        ld      h,0
        ld      l,e
        ret

fputc_bad:
        ld      hl,0ffffh       ; EOF
        ret

___fpc_ch:
        db      0

        public  _clearerr
_clearerr:
        ; void clearerr(FILE *fp)
        ; Clear the EOF and error indicators for this stream's slot.
        pop     bc              ; return address
        pop     hl              ; fp
        push    hl              ; restore argument
        push    bc
        ld      a,l
        sub     FIRSTFD
        jr      c,clrerr_done
        cp      NFILES
        jr      nc,clrerr_done
        ld      h,0
        ld      l,a
        ld      de,__fdeof
        add     hl,de
        ld      (hl),0
        ld      h,0
        ld      l,a
        ld      de,__fderr
        add     hl,de
        ld      (hl),0
clrerr_done:
        ld      hl,0
        ret

        public  _setbuf
_setbuf:
        ; void setbuf(FILE *fp, char *buf)
        ; C89 7.9.5.5: equivalent to setvbuf(fp, buf, buf ? _IOFBF : _IONBF,
        ; BUFSIZ).  When buf is non-NULL the caller's BUFSIZ-byte buffer is
        ; adopted for console output; when NULL the stream becomes unbuffered
        ; and the internal buffer is used.
        push    ix
        ld      ix,0
        add     ix,sp
        ld      a,(ix+5)                ; only stdout/stderr (fd 1/2) use this
        or      a
        jr      nz,sb_ret               ; real file stream: write-through no-op
        ld      a,(ix+4)
        cp      1
        jr      z,sb_console
        cp      2
        jr      nz,sb_ret               ; stdin/invalid: no output buffer
sb_console:
        call    __cflush                ; drain anything already buffered
        ld      l,(ix+6)
        ld      h,(ix+7)                ; HL = buf
        ld      a,h
        or      l                       ; buf == NULL ?
        jr      z,sb_none
        ld      de,256                  ; BUFSIZ (stdio.h); literal for M80
        call    __cob_setbuf            ; adopt caller buffer (size BUFSIZ)
        xor     a                       ; _IOFBF
        ld      (__cob_mode),a
        jr      sb_ret
sb_none:
        call    __cobdflt           ; revert to the internal buffer
        ld      a,2                     ; _IONBF
        ld      (__cob_mode),a
sb_ret:
        ld      hl,0
        pop     ix
        ret

        public  _setvbuf
        public  __cob_setbuf
        public  __cobdflt
_setvbuf:
        ; int setvbuf(FILE *fp, char *buf, int mode, size_t size)
        ; mode: _IOFBF(0)/_IOLBF(1)/_IONBF(2).  Returns 0 on success, nonzero
        ; for an invalid mode.  When buf is non-NULL and size >= 2 the caller's
        ; buffer is adopted for console output (capacity = size-1, reserving
        ; one guard byte); otherwise the internal buffer is used.
        push    ix
        ld      ix,0
        add     ix,sp
        ld      a,(ix+8)                ; mode (low byte; int is 16-bit)
        cp      3
        jr      nc,svb_bad              ; mode > 2: invalid
        ld      a,(ix+5)                ; only stdout/stderr (fd 1/2) use this
        or      a
        jr      nz,svb_noop             ; real file stream: write-through no-op
        ld      a,(ix+4)
        cp      1
        jr      z,svb_console
        cp      2
        jr      nz,svb_noop             ; stdin/invalid: no output buffer
svb_console:
        call    __cflush                ; drain anything already buffered
        ld      a,(ix+8)                ; mode (low byte; int is 16-bit)
        ld      (__cob_mode),a
        ld      l,(ix+6)
        ld      h,(ix+7)                ; HL = buf
        ld      a,h
        or      l                       ; buf == NULL ?
        jr      z,svb_internal
        ld      e,(ix+10)
        ld      d,(ix+11)               ; DE = size
        call    __cob_setbuf            ; adopt caller buffer if size >= 2
        ld      hl,0                    ; success
        pop     ix
        ret
svb_internal:
        call    __cobdflt
        ld      hl,0                    ; success
        pop     ix
        ret
svb_noop:
        ld      hl,0                    ; success: file streams are write-through
        pop     ix
        ret
svb_bad:
        ld      hl,0ffffh               ; nonzero: invalid mode
        pop     ix
        ret

; __cob_setbuf: adopt a caller buffer for console output.
; IN:  HL = buffer base, DE = buffer size.
; Sets __cob_ptr = HL and __cob_cap = size-1 (one byte reserved as the '$'
; guard slot used by __cflush).  A size < 2 cannot host the guard byte, so it
; falls back to the internal buffer.  Clobbers A/DE/HL.
__cob_setbuf:
        ld      a,d
        or      a
        jr      nz,csb_ok               ; size >= 256: plenty of room
        ld      a,e
        cp      2
        jr      c,__cobdflt         ; size 0 or 1: too small for a guard
csb_ok:
        ld      (__cob_ptr),hl
        dec     de                      ; capacity = size - 1 (reserve guard)
        ld      (__cob_cap),de
        ret

; __cobdflt: revert console output to the internal __cobuf/COBSZ buffer.
; Clobbers HL.
__cobdflt:
        ld      hl,__cobuf
        ld      (__cob_ptr),hl
        ld      hl,COBSZ
        ld      (__cob_cap),hl
        ret

        public  _strerror
_strerror:
        ; char *strerror(int errnum)
        pop     bc              ; return address
        pop     hl              ; errnum
        push    hl              ; restore argument
        push    bc
        ld      a,l
        cp      ENOENT
        jr      z,__se02
        cp      EIO
        jr      z,__se05
        cp      EBADF
        jr      z,__se09
        cp      EINVAL
        jr      z,__se22
        cp      EMFILE
        jr      z,__se24
        cp      ENOSPC
        jr      z,__se28
        cp      33
        jr      z,__se33
        cp      34
        jr      z,__se34
        ld      hl,__seuk
        ret
__se02:
        ld      hl,__sem02
        ret
__se05:
        ld      hl,__sem05
        ret
__se09:
        ld      hl,__sem09
        ret
__se22:
        ld      hl,__sem22
        ret
__se24:
        ld      hl,__sem24
        ret
__se28:
        ld      hl,__sem28
        ret
__se33:
        ld      hl,__sem33
        ret
__se34:
        ld      hl,__sem34
        ret

__seuk:         db      'Error',0
__sem02:        db      'No such file',0
__sem05:        db      'I/O error',0
__sem09:        db      'Bad file descriptor',0
__sem22:        db      'Invalid argument',0
__sem24:        db      'Too many open files',0
__sem28:        db      'No space left on device',0
__sem33:        db      'Domain error',0
__sem34:        db      'Range error',0


        public  __putc
__putc:
        ; int putc(int c, FILE *fp) -- same calling convention as fputc
        jp      __fpc

        public  __fgetc
__fgetc:
        ; int fgetc(FILE *fp) / int getc(FILE *fp)
        pop     hl              ; return address
        pop     bc              ; fp/fd
        push    bc              ; restore caller-cleanup argument
        push    hl              ; restore return address

        ; Check the per-fd pushback buffer set by ungetc().
        ld      a,c             ; fd (low byte)
        cp      UGC_MAX
        jr      nc,fgc_no_pb    ; fd out of range
        ld      l,a
        ld      h,0
        ld      de,__ugv
        add     hl,de
        ld      a,(hl)          ; pushback-valid flag
        or      a
        jr      z,fgc_no_pb
        xor     a
        ld      (hl),a          ; consume: clear valid flag
        ld      l,c
        ld      h,0
        ld      de,__ugc
        add     hl,de
        ld      l,(hl)          ; return pushed-back char as int (0..255)
        ld      h,0
        ret

fgc_no_pb:
        ld      hl,1
        push    hl              ; count
        ld      hl,___getc_ch
        push    hl              ; buf
        push    bc              ; fp/fd
        call    _read
        ex      de,hl
        ld      hl,6
        add     hl,sp
        ld      sp,hl
        ex      de,hl

        ; success iff _read returned 1
        ld      a,h
        or      a
        jr      nz,getc_bad
        ld      a,l
        cp      1
        jr      nz,getc_bad

        ld      h,0
        ld      a,(___getc_ch)
        ld      l,a
        ret

getc_bad:
        ld      hl,0ffffh       ; EOF
        ret

___getc_ch:
        db      0
; Per-fd pushback buffer for ungetc().  __ugv[fd]=1 means __ugc[fd] is valid.
; Indexed 0..UGC_MAX-1 directly by fd (0=stdin, 3..10=real files).
__ugv:  ds      UGC_MAX         ; valid flags
__ugc:  ds      UGC_MAX         ; pushed-back characters

        public  __getc
__getc:
        jp      __fgetc

        public  _ungetc
; int ungetc(int c, FILE *stream)
; Pushes c back onto stream so the next fgetc/getc/fgets/fscanf returns it.
; Only one character of pushback per stream is guaranteed (C89 7.9.7.11).
; Returns c on success, EOF on failure (c == EOF or fd out of range).
_ungetc:
        pop     hl              ; return address
        pop     de              ; c
        pop     bc              ; stream/fd
        push    bc              ; restore caller-cleanup stream argument
        push    de              ; restore caller-cleanup c argument
        push    hl              ; restore return address

        ; Fail if c == EOF (0xFFFF).
        ld      a,d
        and     e
        inc     a
        jr      z,ugc_fail      ; d=ff and e=ff: c == -1

        ; Check fd in range.
        ld      a,c             ; stream/fd low byte
        cp      UGC_MAX
        jr      nc,ugc_fail

        ; Keep the character byte in B; the fd remains in C.
        ld      b,e

        ; __ugc[fd] = c & 0xff
        ld      h,0
        ld      l,c
        ld      de,__ugc
        add     hl,de
        ld      (hl),b

        ; __ugv[fd] = 1
        ld      l,c
        ld      h,0
        ld      de,__ugv
        add     hl,de
        ld      (hl),1

        ; Return c & 0xff.
        ld      h,0
        ld      l,b
        ret

ugc_fail:
        ld      hl,0ffffh       ; EOF
        ret

        public  _remove
_remove:
        ; int remove(const char *path)
        jp      _unlink

        public  __gchr
__gchr:
        ; Check pushback for stdin (fd=0) before blocking on BDOS fn 1.
        ld      hl,__ugv        ; __ugv[0]
        ld      a,(hl)
        or      a
        jr      z,gchr_no_pb
        xor     a
        ld      (hl),a          ; consume valid flag
        ld      hl,__ugc        ; __ugc[0]
        ld      l,(hl)
        ld      h,0
        ret
gchr_no_pb:
        call    __cflush        ; show any pending prompt before blocking
        ld      c,1
        call    5               ; BDOS fn 1: blocking console input, echoes A
        cp      1ah             ; Ctrl-Z: CP/M text EOF
        jr      z,gchr_eof
        cp      0dh             ; CR (Enter): echo LF and present '\n'
        jr      nz,gchr_ret
        ld      e,0ah
        ld      c,2
        call    5               ; echo the LF following the echoed CR
        ld      a,0ah           ; deliver '\n' to the caller
gchr_ret:
        ld      h,0
        ld      l,a
        ret
gchr_eof:
        ld      hl,0ffffh       ; EOF sentinel consumed by _read
        ret

        public  __kbht
__kbht:
        ; int kbhit(void) - BDOS 11: console status
        ; returns 0xFF if a key is ready, 0 otherwise
        ld      c,11
        call    5
        ld      l,a
        ld      h,0
        ret

        public  __gtch
__gtch:
        ; int getch(void) - BDOS 6: direct console input without echo
        ; BDOS 6 with E=FFh returns 0 when no key ready; poll until non-zero
        call    __cflush        ; show any pending prompt before blocking
__gtch_poll:
        ld      c,6
        ld      e,0ffh
        call    5
        or      a
        jr      z,__gtch_poll
        ld      l,a
        ld      h,0
        ret


; bdos(fn, dearg)
; Call CP/M BDOS directly.
;
; C prototype:
;     extern int bdos(int fn, int dearg);
;
; Arguments:
;     fn    -> BDOS function number, placed in C
;     dearg -> 16-bit argument pointer/value, placed in DE
;
; Return:
;     low-byte BDOS result A, returned as int in HL.
;     This matches CP/M 2.2 BDOS functions that return a byte value.
;     Functions whose useful result is written through DE, such as FCB/DMA
;     operations, should read that memory after the call.
        public  _bdos
_bdos:
        pop     bc              ; return address
        pop     hl              ; function number
        pop     de              ; DE argument
        push    de              ; restore arguments
        push    hl
        push    bc
        ld      c,l
        jr      bdos_core

        public  __bdosf
__bdosf:
        ; fastcall int bdos(int fn, int dearg)
        ; Entry: C = fn (low byte), DE = dearg - skips the general
        ; push-2/call/pop-2 convention entirely. See dcc_ast_gen_expr.c's
        ; bdos call-site codegen.
bdos_core:
        call    5
        ld      l,a             ; only needed for non-conformant emulators
        ld      h,0
        ret


; inp(port) / outp(port, val)
; Direct 8-bit port I/O.  These are a dcc extension (not C89), declared in
; <stdlib.h>.
;
; C prototypes:
;     extern int  inp(unsigned port);
;     extern void outp(unsigned port, unsigned val);
;
; The Z80 IN A,(n) / OUT (n),A instructions take the port as an 8-bit immediate
; operand.  inp()/outp() receive the port at run time, so the port byte is
; patched into the instruction stream just before it executes (the runtime runs
; from RAM in the CP/M TPA).  This immediate form is the one implemented across
; the CP/M emulators and hardware this runtime targets, whose I/O port decode is
; 8-bit, so only the low 8 bits of the port are used.  The register-indirect
; IN A,(C) / OUT (C),A forms are avoided: those ED-prefixed opcodes are not
; implemented on every target.  Being self-modifying, these are not re-entrant.
        public  _inp
_inp:
        pop     bc              ; return address
        pop     hl              ; port
        push    hl              ; restore argument
        push    bc
        ld      a,l
        ld      (inp_prt),a
        db      0dbh
inp_prt:
        db      0
        ld      l,a
        ld      h,0
        ret

        public  _outp
_outp:
        pop     bc              ; return address
        pop     hl              ; port
        pop     de              ; value
        push    de              ; restore arguments
        push    hl
        push    bc
        ld      a,l
        ld      (outp_prt),a
        ld      a,e
        db      0d3h
outp_prt:
        db      0
        ld      hl,0
        ret


        public  __slen
__slen:
        ; size_t strlen(const char *s)
        ; IX-free entry; jumps into __slf's CPIR scan below once HL = s is
        ; set up (no locals of its own to preserve). This must be an
        ; explicit jump, not fall-through: dccrtlstrip extracts referenced
        ; functions per public label and traces jr/jp/call targets, but a
        ; naked fall-through across a public-label boundary is invisible to
        ; it - a program that references __slen without ever referencing
        ; __slf (e.g. strlen only called through a function pointer) would
        ; otherwise get a __slen stub truncated at the label boundary,
        ; falling through into whatever public symbol happens to follow.
        pop     bc              ; return address
        pop     hl              ; HL = s
        push    hl              ; restore caller argument for caller cleanup
        push    bc              ; restore return address
        jr      __slf

        public  __slf
__slf:
        ; fastcall size_t strlen(const char *s)
        ; Entry: HL = s.  Return: HL = length.
        ld      e,l
        ld      d,h             ; DE = original s
        ld      bc,0ffffh
        xor     a
        cpir
        or      a
        sbc     hl,de           ; bytes scanned including NUL
        dec     hl
        ret

        public  __scf
__scf:
        ; fastcall char *strcpy(char *dst, const char *src)
        ; Entry: DE=dst, HL=src directly (matching __cmpf's DE/HL
        ; convention). Named __scf, not __scpyf: __scpyf would 6-char-
        ; truncate to __SCPY, colliding with __scpy itself.
        ld      b,d
        ld      c,e             ; BC = dst (return value) - scpy_core reads
                                 ; the copy loop's dst progress from DE, but
                                 ; the return value comes from BC, which the
                                 ; general __scpy entry below also sets up
                                 ; before falling into scpy_core. Missing
                                 ; this the first time round produced a
                                 ; correct copy but a garbage return value,
                                 ; caught by a strcpy() == dst comparison
                                 ; test rather than the copied content.
        jr      scpy_core

        public  __scpy
__scpy:
        ; char *strcpy(char *dst, const char *src)
        ; IX-free entry. Preserve the caller-cleanup argument layout.
        pop     bc              ; return address
        pop     de              ; DE = dst
        pop     hl              ; HL = src
        push    hl              ; restore src
        push    de              ; restore dst
        push    bc              ; restore return address
        ld      b,d
        ld      c,e             ; BC = original dst
scpy_core:
sc1:
        ld      a,(hl)
        ld      (de),a
        inc     hl
        inc     de
        or      a
        jr      nz,sc1
        ld      h,b
        ld      l,c             ; return dst
        ret

        public  __scmp
__scmp:
        ; int strcmp(const char *s1, const char *s2)
        ; IX-free entry. Preserve the caller-cleanup argument layout.
        pop     bc              ; return address
        pop     de              ; DE = s1
        pop     hl              ; HL = s2
        push    hl              ; restore s2
        push    de              ; restore s1
        push    bc              ; restore return address
sp1:
        ld      a,(de)
        cp      (hl)
        jr      nz,sp2
        or      a
        jr      z,sp3
        inc     de
        inc     hl
        jr      sp1
sp2:
        ; A still holds *s1 after CP (HL), so compute *s1 - *s2 directly.
        sub     (hl)
        ld      l,a
        ld      h,0
        ret     nc
        ld      h,0ffh
        ret

sp3:
        ld      hl,0
        ret

        public  __icf
__icf:
        ; fastcall int stricmp(const char *s1, const char *s2)
        ; Entry: DE=s1, HL=s2 directly (matching __cmpf's DE/HL
        ; convention). Named __icf, not __sicmpf: M80 truncates public
        ; symbols to 6 significant characters, and __sicmpf truncates to
        ; __SICMP, which doesn't collide with anything here, but __icf
        ; keeps the same short "letter+f" fastcall style as __chf/__rcf
        ; rather than inventing a new pattern for one function.
        jr      sicm_core

        public  __sicm
__sicm:
        ; int stricmp(const char *s1, const char *s2)
        ; ASCII-only case-insensitive compare - CP/M has no locale, so
        ; folding 'A'-'Z' to lowercase covers every byte that can appear.
        ; IX-free entry, mirrors __scmp's own caller-cleanup argument
        ; layout above.
        pop     bc              ; return address
        pop     de              ; DE = s1
        pop     hl              ; HL = s2
        push    hl              ; restore s2
        push    de              ; restore s1
        push    bc              ; restore return address
sicm_core:
        ld      a,(de)
        cp      'A'
        jr      c,sicm_s1_nf
        cp      'Z'+1
        jr      nc,sicm_s1_nf
        add     a,20h
sicm_s1_nf:
        ld      b,a             ; B = fold(*s1)
        ld      a,(hl)
        cp      'A'
        jr      c,sicm_s2_nf
        cp      'Z'+1
        jr      nc,sicm_s2_nf
        add     a,20h
sicm_s2_nf:
        cp      b               ; fold(*s2) vs fold(*s1)
        jr      nz,sicm_diff
        ld      a,b
        or      a               ; *s1 == 0 (folding never changes NUL)?
        jr      z,sicm_eq
        inc     de
        inc     hl
        jr      sicm_core
sicm_diff:
        ; A = fold(*s2), B = fold(*s1); want fold(*s1) - fold(*s2).
        ld      c,a
        ld      a,b
        sub     c
        ld      l,a
        ld      h,0
        ret     nc
        ld      h,0ffh
        ret
sicm_eq:
        ld      hl,0
        ret

        public  __rcf
__rcf:
        ; fastcall char *strrchr(const char *s, int c)
        ; Entry: HL=s, A = low byte of c (matching __chf's convention).
        ; Named __rcf, not __srchf: __srchf would 6-char-truncate to
        ; __SRCH, colliding with __srch itself.
        ld      c,a
        jr      srch_core

        public  __srch
__srch:
        ; char *strrchr(const char *s, int c)
        ; CPIR finds end of string, then CPDR scans backward for last match.
        ; 37T/byte combined vs 52T/byte forward scan (~30% faster on typical strings).
        pop     de              ; pop return address
        pop     hl              ; HL = s
        pop     bc              ; BC = c (C = char)
        push    bc              ; restore c for caller cleanup
        push    hl              ; restore s for caller cleanup
        push    de              ; restore return address
srch_core:
        ld      e,c             ; save target char in E (CPIR clobbers BC)
        xor     a               ; A = 0, search for NUL
        ld      c,a
        ld      b,a             ; BC = 0 = 65536 max CPIR iterations
        cpir                    ; scan forward to NUL: 21T/byte
        dec     hl              ; HL = NUL position
        ld      a,c             ; negate BC to get strlen+1
        cpl
        ld      c,a
        ld      a,b
        cpl
        ld      b,a
        inc     bc              ; BC = strlen+1
        ld      a,e             ; A = target char
        cpdr                    ; scan backward: 16T/byte
        jp      nz,srch_not_found
        inc     hl              ; CPDR leaves HL one before match
        ret
srch_not_found:
        ld      hl,0
        ret


        public  __chf
__chf:
        ; char *strchr_fastcall(const char *s, int c)
        ; Entry: HL = s, A = low byte of c.  Return HL = match or 0.
        ld      c,a
        jr      schr_core

        public  __schr
__schr:
        ; char *strchr(const char *s, int c)
        ; IX-free argument setup, then shares __chf's unrolled scalar scan
        ; below. CPIR is unsafe without first finding NUL, and a length-
        ; prefetch would scan long misses twice.  This keeps strchr(s,'$')
        ; long misses to one pass while reducing loop branches.
        pop     de              ; pop return address
        pop     hl              ; HL = s
        pop     bc              ; BC = c (C = char)
        push    bc              ; restore c for caller cleanup
        push    hl              ; restore s for caller cleanup
        push    de              ; restore return address
schr_core:
        ld      a,(hl)
        cp      c
        ret     z
        inc     hl
        or      a
        jr      z,schr_not_found

        ld      a,(hl)
        cp      c
        ret     z
        inc     hl
        or      a
        jr      z,schr_not_found

        ld      a,(hl)
        cp      c
        ret     z
        inc     hl
        or      a
        jr      z,schr_not_found

        ld      a,(hl)
        cp      c
        ret     z
        inc     hl
        or      a
        jr      nz,schr_core
schr_not_found:
        ld      hl,0
        ret

        public  __ssf
__ssf:
        ; fastcall char *strstr(const char *haystack, const char *needle)
        ; Entry: DE=haystack, HL=needle directly (matching __cmpf's DE/HL
        ; convention). Named __ssf, not __sstrf: __sstrf would 6-char-
        ; truncate to __SSTR, colliding with __sstr itself.
        jr      sstr_core

        public  __sstr
__sstr:
        ; char *strstr(const char *haystack, const char *needle)
        ; Length-bounded CPIR outer scan, with a quick second-character
        ; precheck before saving full retry state.  This is especially good
        ; for repeated misses like strstr(s,"gfe") against alphabetic data:
        ; many candidates match needle[0], almost all fail at needle[1].
        pop     bc              ; return address
        pop     de              ; DE = haystack
        pop     hl              ; HL = needle
        push    hl              ; restore caller arguments for caller cleanup
        push    de
        push    bc              ; restore return address
sstr_core:
        ld      a,(hl)
        or      a
        jr      nz,sstr_ne2
        ex      de,hl           ; empty needle => return haystack
        ret
sstr_ne2:
        ; Compute remaining haystack span including the terminating NUL.
        push    hl              ; save needle
        push    de              ; save haystack/current pointer
        ex      de,hl           ; HL = haystack
        ld      bc,0ffffh
        xor     a
        cpir                    ; find NUL, BC has one's-complement count left
        ld      a,c
        cpl
        ld      c,a
        ld      a,b
        cpl
        ld      b,a             ; BC = strlen(haystack) + 1
        pop     de              ; DE = current haystack search pointer
        pop     hl              ; HL = needle
        ld      a,(hl)          ; A = needle[0]
sstr_cpir_scan:
        push    hl              ; save original needle pointer
        ld      h,d
        ld      l,e             ; HL = current haystack pointer
        cpir                    ; search A within remaining span
        jr      nz,sstr_cpir_not_found

        ; Found first char.  HL is one past candidate, BC is remaining after it.
        ; Fast path: check needle[1] before pushing full retry state.
        pop     de              ; DE = original needle pointer
        inc     de              ; DE = needle + 1
        ld      a,(de)
        or      a
        jr      z,sstr_cpir_onechar
        cp      (hl)            ; compare needle[1] with candidate[1]
        jr      nz,sstr_cpir_fast_fail

        ; First two characters matched.  Save retry/return state and compare
        ; the rest of the needle.
        push    bc              ; save remaining span after candidate first byte
        push    de              ; save needle+1
        push    hl              ; save candidate+1
sstr_cpir_cmp_rest:
        inc     de
        inc     hl
        ld      a,(de)
        or      a
        jr      z,sstr_cpir_found
        cp      (hl)
        jr      nz,sstr_cpir_fail
        jr      sstr_cpir_cmp_rest

sstr_cpir_fast_fail:
        ; DE = needle+1, HL = candidate+1, BC = remaining span.
        dec     de              ; DE = original needle
        ex      de,hl           ; HL = original needle, DE = next haystack
        ld      a,(hl)          ; A = needle[0] for CPIR
        jr      sstr_cpir_scan

sstr_cpir_fail:
        pop     hl              ; HL = candidate+1
        pop     de              ; DE = needle+1
        pop     bc              ; BC = remaining span after candidate first byte
        dec     de              ; DE = original needle
        ex      de,hl           ; HL = original needle, DE = next haystack
        ld      a,(hl)          ; A = needle[0] for CPIR
        jr      sstr_cpir_scan

sstr_cpir_found:
        pop     hl              ; HL = candidate+1
        pop     de              ; discard saved needle+1
        pop     bc              ; discard saved remaining span
sstr_cpir_onechar:
        dec     hl              ; return candidate start
        ret

sstr_cpir_not_found:
        pop     hl              ; discard saved needle pointer
        ld      hl,0
        ret

        public  __ncmp
__ncmp:
        ; int strncmp(const char *s1, const char *s2, size_t n)
        ; IX-free entry. Preserve the caller-cleanup argument layout.
        pop     af              ; return address
        pop     de              ; DE = s1
        pop     hl              ; HL = s2
        pop     bc              ; BC = n
        push    bc              ; restore n
        push    hl              ; restore s2
        push    de              ; restore s1
        push    af              ; restore return address
sncmp_loop:
        ld      a,b
        or      c
        jr      z,sncmp_equal
        ld      a,(de)
        cp      (hl)
        jr      nz,sncmp_diff
        or      a
        jr      z,sncmp_equal
        inc     de
        inc     hl
        dec     bc
        jr      sncmp_loop
sncmp_diff:
        ; A still holds *s1 after CP (HL), so compute *s1 - *s2 directly.
        sub     (hl)
        ld      l,a
        ld      h,0
        ret     nc
        ld      h,0ffh
        ret
sncmp_equal:
        ld      hl,0
        ret

        public  __mhf
__mhf:
        ; fastcall void *memchr(const void *s, int c, size_t n)
        ; Entry: HL=s, E=c (low byte), BC=n directly (matching __msf's
        ; HL/E/BC convention). Named __mhf, not __mchrf: __mchrf would
        ; 6-char-truncate to __MCHR, colliding with __mchr itself.
        jr      mchr_core

        public  __mchr
__mchr:
        ; void *memchr(const void *s, int c, size_t n)
        ; IX-free entry. Preserve the caller-cleanup argument layout.
        pop     af              ; return address
        pop     hl              ; HL = s
        pop     de              ; E = c
        pop     bc              ; BC = n
        push    bc              ; restore n
        push    de              ; restore c
        push    hl              ; restore s
        push    af              ; restore return address
mchr_core:
        ld      a,b
        or      c
        jr      z,mchr_none
        ld      a,e
        cpir
        jr      nz,mchr_none
        dec     hl              ; CPIR leaves HL one byte past the match
mchr_found:
        ret
mchr_none:
        ld      hl,0
        ret

        public  __scat
__scat:
        ; char *strcat(char *dst, const char *src)
        ; IX-free entry. Preserve the caller-cleanup argument layout.
        pop     bc              ; return address
        pop     de              ; DE = dst
        pop     hl              ; HL = src
        push    hl              ; restore src
        push    de              ; restore dst
        push    bc              ; restore return address
        ld      b,d
        ld      c,e             ; BC = original dst (needed only for the
                                 ; return value at the end)
        ; Find the NUL in dst via CPIR (same idiom as __ncat above and
        ; __slf's strlen scan). BC (original dst) must be stashed since
        ; CPIR clobbers it as an iteration counter; src (HL) survives for
        ; free because CPIR only touches HL/BC/A, and DE (src) is untouched
        ; by the swap below.
        push    bc              ; save original dst
        ex      de,hl           ; HL = dst, DE = src
        ld      bc,0ffffh
        xor     a
        cpir                    ; HL = address of dst's NUL + 1
        dec     hl              ; HL = address of dst's NUL
        ex      de,hl           ; DE = dst's NUL position, HL = src (restored)
        pop     bc              ; restore original dst
scat_copy:
        ld      a,(hl)
        ld      (de),a
        inc     hl
        inc     de
        or      a
        jr      nz,scat_copy
        ld      h,b
        ld      l,c             ; return dst
        ret


        public  __scol
__scol:
        ; int strcoll(const char *s1, const char *s2)
        ; Current C locale: collation is bytewise strcmp.
        jp      __scmp

        public  _strxfrm
_strxfrm:
        ; size_t strxfrm(char *s1, const char *s2, size_t n)
        ; C locale transform is identity.  IX-free implementation.
        ; Load DE=s1, HL=s2, BC=n using the caller-cleanup stack layout.
        ld      hl,2
        add     hl,sp
        ld      e,(hl)
        inc     hl
        ld      d,(hl)          ; DE = s1
        inc     hl
        ld      c,(hl)
        inc     hl
        ld      b,(hl)          ; BC = s2 temporary
        inc     hl
        ld      a,(hl)
        inc     hl
        ld      h,(hl)
        ld      l,a             ; HL = n temporary
        push    de              ; save s1
        push    hl              ; save n
        ld      h,b
        ld      l,c             ; HL = s2
        push    hl              ; save s2

        ld      de,0            ; DE = strlen(s2)
sxf_len:
        ld      a,(hl)
        or      a
        jr      z,sxf_have_len
        inc     hl
        inc     de
        jr      sxf_len
sxf_have_len:
        ld      (sxf_lenv),de
        pop     hl              ; HL = s2
        pop     bc              ; BC = n
        pop     de              ; DE = s1

        ld      a,b
        or      c
        jr      z,sxf_done
sxf_lp:
        ld      a,(hl)
        ld      (de),a
        or      a
        jr      z,sxf_done
        inc     hl
        inc     de
        dec     bc
        ld      a,b
        or      c
        jr      nz,sxf_lp
sxf_done:
        ld      hl,(sxf_lenv)
        ret
sxf_lenv:
        dw      0

        public  __scsp
__scsp:
        ; size_t strcspn(const char *s, const char *reject)
        ; IX-free. HL walks s; reject is reloaded from the caller stack.
        ld      hl,2
        add     hl,sp
        ld      e,(hl)
        inc     hl
        ld      d,(hl)
        ex      de,hl           ; HL = s
scsp_outer:
        ld      a,(hl)
        or      a
        jr      z,scsp_ret_count
        push    hl              ; save current s
        ld      hl,6            ; reject is at SP+6 after the push
        add     hl,sp
        ld      e,(hl)
        inc     hl
        ld      d,(hl)          ; DE = reject
        pop     hl              ; restore current s
scsp_inner:
        ld      a,(de)
        or      a
        jr      z,scsp_no_match
        ld      c,a
        ld      a,(hl)
        cp      c
        jr      z,scsp_ret_count
        inc     de
        jr      scsp_inner
scsp_no_match:
        inc     hl
        jr      scsp_outer
scsp_ret_count:
        ex      de,hl           ; DE = current s
        ld      hl,2
        add     hl,sp
        ld      c,(hl)
        inc     hl
        ld      b,(hl)          ; BC = initial s
        ex      de,hl           ; HL = current s
        or      a
        sbc     hl,bc
        ret

        public  __spbr
__spbr:
        ; char *strpbrk(const char *s, const char *accept)
        ; IX-free. HL walks s; accept is reloaded from the caller stack.
        ld      hl,2
        add     hl,sp
        ld      e,(hl)
        inc     hl
        ld      d,(hl)
        ex      de,hl           ; HL = s
spbr_outer:
        ld      a,(hl)
        or      a
        jr      z,spbr_none
        push    hl
        ld      hl,6            ; accept is at SP+6 after the push
        add     hl,sp
        ld      e,(hl)
        inc     hl
        ld      d,(hl)
        pop     hl
spbr_inner:
        ld      a,(de)
        or      a
        jr      z,spbr_no_match
        ld      c,a
        ld      a,(hl)
        cp      c
        jr      z,spbr_found
        inc     de
        jr      spbr_inner
spbr_no_match:
        inc     hl
        jr      spbr_outer
spbr_found:
        ret
spbr_none:
        ld      hl,0
        ret

        public  __sspn
__sspn:
        ; size_t strspn(const char *s, const char *accept)
        ; IX-free. HL walks s; accept is reloaded from the caller stack.
        ld      hl,2
        add     hl,sp
        ld      e,(hl)
        inc     hl
        ld      d,(hl)
        ex      de,hl           ; HL = s
sspn_outer:
        ld      a,(hl)
        or      a
        jr      z,sspn_ret_count
        push    hl
        ld      hl,6            ; accept is at SP+6 after the push
        add     hl,sp
        ld      e,(hl)
        inc     hl
        ld      d,(hl)
        pop     hl
sspn_inner:
        ld      a,(de)
        or      a
        jr      z,sspn_ret_count
        ld      c,a
        ld      a,(hl)
        cp      c
        jr      z,sspn_match
        inc     de
        jr      sspn_inner
sspn_match:
        inc     hl
        jr      sspn_outer
sspn_ret_count:
        ex      de,hl           ; DE = current s
        ld      hl,2
        add     hl,sp
        ld      c,(hl)
        inc     hl
        ld      b,(hl)          ; BC = initial s
        ex      de,hl
        or      a
        sbc     hl,bc
        ret

        public  __sdup
__sdup:
        ; char *strdup(const char *s)
        ; IX-free.  Save the source because __slen and _malloc may clobber
        ; all registers; strdup is already non-reentrant through malloc.
        ld      hl,2
        add     hl,sp
        ld      e,(hl)
        inc     hl
        ld      d,(hl)          ; DE = src
        ld      (__sdup_src),de

        ; Compute length including NUL via __slf (fastcall entry: HL = s
        ; in, HL = length out) - no push/pop needed at all, unlike the
        ; general __slen entry this used to call.
        ex      de,hl           ; HL = src
        call    __slf
        inc     hl
        ld      (__sdup_len),hl

        ; malloc(len)
        push    hl
        call    _malloc
        pop     bc              ; clean malloc arg

        ; If malloc failed, return NULL.
        ld      a,h
        or      l
        ret     z

        ; Copy len bytes and return the original destination.
        push    hl              ; save dest for return
        ex      de,hl           ; DE = dest
        ld      hl,(__sdup_src) ; HL = src
        ld      bc,(__sdup_len)
        ldir
        pop     hl
        ret

__sdup_src:
        dw      0
__sdup_len:
        dw      0

        public  __ncpy
__ncpy:
        ; char *strncpy(char *dst, const char *src, size_t n)
        ; IX-free setup. DE=dst, HL=src, BC=n; saved dst is return value.
        ld      hl,2
        add     hl,sp
        ld      c,(hl)
        inc     hl
        ld      b,(hl)          ; BC = dst temporary
        inc     hl
        ld      e,(hl)
        inc     hl
        ld      d,(hl)          ; DE = src temporary
        inc     hl
        ld      a,(hl)
        inc     hl
        ld      h,(hl)
        ld      l,a             ; HL = n temporary
        push    bc              ; save dst
        push    hl              ; save n
        ex      de,hl           ; HL = src
        pop     bc              ; BC = n
        pop     de              ; DE = dst
        push    de              ; return dst
nc1lp:
        ld      a,b
        or      c
        jr      z,nc1dn
        ld      a,(hl)
        inc     hl
        ld      (de),a
        inc     de
        dec     bc
        or      a
        jr      nz,nc1lp
        xor     a
nc1pd:
        ld      a,b
        or      c
        jr      z,nc1dn
        xor     a               ; count test above clobbered A
        ld      (de),a
        inc     de
        dec     bc
        jr      nc1pd
nc1dn:
        pop     hl
        ret

        public  __cmpf
__cmpf:
        ; fastcall int memcmp(const void *s1, const void *s2, size_t n)
        ; Entry: DE = s1, HL = s2, BC = n (already the hot loop's own
        ; layout below) - skips both the caller's push-3/call/pop-3 general
        ; convention and this routine's own stack-reconstruction marshaling
        ; entirely.  See dcc_ast_gen_expr.c's memcmp call-site codegen.
        jr      mcmp_core

        public  __mcmp
__mcmp:
        ; int memcmp(const void *s1, const void *s2, size_t n)
        ; IX-free argument setup.  Final hot loop uses DE=s1, HL=s2, BC=n.
        ld      hl,2
        add     hl,sp
        ld      c,(hl)
        inc     hl
        ld      b,(hl)          ; BC = s1 temporary
        inc     hl
        ld      e,(hl)
        inc     hl
        ld      d,(hl)          ; DE = s2 temporary
        inc     hl
        ld      a,(hl)
        inc     hl
        ld      h,(hl)
        ld      l,a             ; HL = n temporary
        push    bc              ; save s1
        push    hl              ; save n
        ex      de,hl           ; HL = s2
        pop     bc              ; BC = n
        pop     de              ; DE = s1
mcmp_core:
        ld      a,b
        or      c
        jr      z,mc2eq         ; n == 0
        ld      a,b
        or      a
        jr      z,mc2tail       ; n < 256: no 256-byte chunks
        push    bc              ; save [n_high, n_low] across chunk loop
mc2chunk:
        ; Compare one full 256-byte chunk.  The common tstring path is
        ; equality over long buffers; unroll 4 bytes per DJNZ to reduce
        ; branch overhead without changing mismatch return semantics.
        ld      b,64
mc2clp:
        ld      a,(de)
        cp      (hl)
        jr      nz,mc2dkl
        inc     de
        inc     hl
        ld      a,(de)
        cp      (hl)
        jr      nz,mc2dkl
        inc     de
        inc     hl
        ld      a,(de)
        cp      (hl)
        jr      nz,mc2dkl
        inc     de
        inc     hl
        ld      a,(de)
        cp      (hl)
        jr      nz,mc2dkl
        inc     de
        inc     hl
        djnz    mc2clp
        pop     bc              ; restore [n_high, n_low]
        djnz    mc2more         ; dec n_high; more chunks if nonzero
        jr      mc2tail         ; all chunks done, handle tail
mc2more:
        push    bc
        jr      mc2chunk
mc2tail:
        ld      a,c             ; A = n_low (remaining bytes)
        or      a
        jr      z,mc2eq
        ld      b,a
mc2tlp:
        ld      a,(de)
        cp      (hl)
        jr      nz,mc2dtl
        inc     de
        inc     hl
        djnz    mc2tlp
mc2eq:
        ld      hl,0
        ret
mc2dkl:
        pop     bc              ; clean [n_high, n_low] off stack
mc2dtl:
        sub     (hl)            ; A = *s1 - *s2
        ld      l,a
        ld      h,0
        ret     nc
        ld      h,0ffh
        ret

        public  __mmov
__mmov:
        ; void *memmove(void *dst, const void *src, size_t n)
        ; IX-free setup. DE=dst, HL=src, BC=n.
        ld      hl,2
        add     hl,sp
        ld      c,(hl)
        inc     hl
        ld      b,(hl)          ; BC = dst temporary
        inc     hl
        ld      e,(hl)
        inc     hl
        ld      d,(hl)          ; DE = src temporary
        inc     hl
        ld      a,(hl)
        inc     hl
        ld      h,(hl)
        ld      l,a             ; HL = n temporary
        push    bc              ; save dst
        push    hl              ; save n
        ex      de,hl           ; HL = src
        pop     bc              ; BC = n
        pop     de              ; DE = dst
        push    de              ; return dst

        ld      a,b
        or      c
        jr      z,mmv_done
        ld      a,d
        cp      h
        jr      c,mmv_forward
        jr      nz,mmv_backward
        ld      a,e
        cp      l
        jr      c,mmv_forward
        jr      z,mmv_done
mmv_backward:
        add     hl,bc           ; HL = src+n
        ex      de,hl           ; HL = dst, DE = src+n
        add     hl,bc           ; HL = dst+n
        ex      de,hl           ; HL = src+n, DE = dst+n
        dec     hl
        dec     de
        lddr
        jr      mmv_done
mmv_forward:
        ldir
mmv_done:
        pop     hl
        ret

        public  __ncat
__ncat:
        ; char *strncat(char *dst, const char *src, size_t n)
        ; IX-free setup. DE=dst, HL=src, BC=n; saved dst is return value.
        ld      hl,2
        add     hl,sp
        ld      c,(hl)
        inc     hl
        ld      b,(hl)          ; BC = dst temporary
        inc     hl
        ld      e,(hl)
        inc     hl
        ld      d,(hl)          ; DE = src temporary
        inc     hl
        ld      a,(hl)
        inc     hl
        ld      h,(hl)
        ld      l,a             ; HL = n temporary
        push    bc
        push    hl
        ex      de,hl           ; HL = src
        pop     bc              ; BC = n
        pop     de              ; DE = dst
        push    de              ; return dst
        ; Find the NUL in dst via CPIR (same idiom __slf uses for strlen)
        ; instead of a byte-at-a-time loop. n (BC) must be stashed since
        ; CPIR clobbers it as an iteration counter; src (HL) survives for
        ; free because CPIR only touches HL/BC/A, and DE (src) is untouched
        ; by the swap below.
        push    bc              ; save n
        ex      de,hl           ; HL = dst, DE = src
        ld      bc,0ffffh
        xor     a
        cpir                    ; HL = address of dst's NUL + 1
        dec     hl              ; HL = address of dst's NUL
        ex      de,hl           ; DE = dst's NUL position, HL = src (restored)
        pop     bc              ; restore n
snc_copy:
        ld      a,b
        or      c
        jr      z,snc_term
        ld      a,(hl)
        or      a
        jr      z,snc_term
        ld      (de),a
        inc     hl
        inc     de
        dec     bc
        jr      snc_copy
snc_term:
        xor     a
        ld      (de),a
        pop     hl
        ret

        public  __mcf
__mcf:
        ; fastcall void *memcpy(void *dst, const void *src, size_t n)
        ; Entry: DE=dst, HL=src, BC=n directly (matching __cmpf's DE/HL/BC
        ; convention). Named __mcf, not __mcpyf: M80 truncates public
        ; symbols to 6 significant characters, and __mcpyf truncates to
        ; __MCPY, colliding with __mcpy itself (the same mistake as
        ; __msf's first attempt, __msetf).
        push    de              ; return dst
        jr      mcpy_core

        public  __mcpy
__mcpy:
        ; void *memcpy(void *dst, const void *src, size_t n)
        ; IX-free argument setup.  C memcpy is undefined for overlap, so LDIR is OK.
        ld      hl,2
        add     hl,sp
        ld      c,(hl)
        inc     hl
        ld      b,(hl)          ; BC = dst temporary
        inc     hl
        ld      e,(hl)
        inc     hl
        ld      d,(hl)          ; DE = src temporary
        inc     hl
        ld      a,(hl)
        inc     hl
        ld      h,(hl)
        ld      l,a             ; HL = n temporary
        push    bc              ; save dst for return/setup
        push    hl              ; save n
        ex      de,hl           ; HL = src
        pop     bc              ; BC = n
        pop     de              ; DE = dst
        push    de              ; return dst
mcpy_core:
        ld      a,b
        or      c
        jr      z,mcpy_done
        ldir
mcpy_done:
        pop     hl
        ret

        public  __msf
__msf:
        ; fastcall void *memset(void *dest, int c, int count)
        ; Entry: HL = dest, E = fill byte, BC = count directly - skips
        ; the general push-3/call/pop-3 convention and __mset's own
        ; stack-marshaling prologue below entirely. See dcc_ast_gen_
        ; expr.c's memset call-site codegen.
        ;
        ; Named __msf, not __msetf: M80 truncates public symbols to 6
        ; significant characters, and __msetf truncates to __MSET, which
        ; collides exactly with __mset's own (already 6-char) name -
        ; confirmed the hard way (a real "%Mult. Def. Global __MSET"
        ; linker warning, silently hidden by only checking the tail of
        ; the build output, plus the miscompile it caused: __msetf's
        ; call sites got linked to __mset's stack-marshaling entry point
        ; instead, reading garbage stack data as dest/c/count).
        jr      mset_core

        public  __mset
__mset:
        ; void *memset(void *dest, int c, int count)
        ; IX-free setup plus Z80 LDIR block-fill.
        ld      hl,2
        add     hl,sp
        ld      e,(hl)
        inc     hl
        ld      d,(hl)          ; DE = dest temporary
        inc     hl
        ld      a,(hl)          ; A = fill byte
        push    af              ; save fill while loading count
        inc     hl              ; skip high byte of int c
        inc     hl
        ld      c,(hl)
        inc     hl
        ld      b,(hl)          ; BC = count
        ex      de,hl           ; HL = dest
        pop     af              ; A = fill byte
        ld      e,a             ; E = fill byte across zero tests

mset_core:
        push    hl              ; save dest for return value
        ld      a,b
        or      c
        jr      z,ms_done       ; count == 0, nothing to do
        ld      a,e
        ld      (hl),a          ; write first byte
        dec     bc
        ld      a,b
        or      c
        jr      z,ms_done       ; count was 1, done
        ld      d,h
        ld      e,l
        inc     de              ; DE = dest+1, HL = dest (contains fill byte)
        ldir                    ; copy (HL)->(DE) BC times, each step propagates fill
ms_done:
        pop     hl              ; HL = dest (return value)
        ret


; Indirect call helper.
; Indirect call helper.
; Input HL = target address. Returns whatever callee returns in HL.
        public  __call_hl
__call_hl:
        jp      (hl)

        public  __mulu
__mulu:
        push    bc
        push    af
        ; HL = multiplier, DE = multiplicand, product returned in HL.
        ; Multiplication is commutative and the result is taken mod 2^16, so
        ; pick an operand with a zero high byte as the multiplier and run only
        ; 8 iterations.  The multiplicand is shifted with sla e/rl d, which is
        ; cheaper than ex de,hl/add hl,hl/ex de,hl.
        ld      a,h
        or      a
        jr      z,mul8          ; HL fits in 8 bits -> use it as multiplier
        ld      a,d
        or      a
        jr      nz,mul16        ; neither operand fits in 8 bits -> full 16
        ex      de,hl           ; DE fits in 8 bits -> swap it into HL
mul8:
        ld      c,l             ; C = 8-bit multiplier
        ld      hl,0            ; HL = product
        ld      b,8
mul8l:
        srl     c
        jr      nc,mul8s
        add     hl,de
mul8s:
        sla     e
        rl      d
        djnz    mul8l
        pop     af
        pop     bc
        ret

mul16:
        ld      b,16
        ld      c,l
        ld      a,h
        ld      hl,0
mu1:
        srl     a
        rr      c
        jr      nc,mu2
        add     hl,de
mu2:
        sla     e
        rl      d
        djnz    mu1
        pop     af
        pop     bc
        ret

        public  __divu
        public  __modu
        public  __divs
        public  __mods
DRSU:
        ; Unsigned 16-bit divide, hybrid bounded.
        ; Input:  HL = dividend, DE = divisor
        ; Output: HL = quotient, DE = remainder
        ;
        ; Small quotients (the common case, e.g. e.c divides a variable n with
        ; a small carry) use repeated subtraction, which beats the fixed
        ; 16-step divider.  A djnz down-counter caps the loop: once the
        ; quotient reaches the cap the partially divided value is discarded
        ; and the bounded D16U divider finishes the job, so a large quotient
        ; can no longer cause an unbounded (up to 65535 iteration) stall.
        push    bc
        push    af
        ld      a,d
        or      e
        jr      nz,dms_rs0
        ld      d,h             ; divide by zero: quotient = 0xffff,
        ld      e,l             ; remainder = original dividend
        ld      hl,0ffffh
        jr      dms_rs_done

dms_rs0:
        push    hl              ; save dividend for the fallback path
        ld      b,40            ; B = remaining attempts (quotient cap)

dms_rs1:
        or      a
        sbc     hl,de
        jr      c,dms_rs2       ; underflow -> quotient = 40 - B
        djnz    dms_rs1         ; cap not reached -> keep subtracting

        ; cap reached: quotient >= 40, finish with the bounded divider.
        pop     hl              ; restore dividend (DE still = divisor)
        call    D16U            ; HL = quotient, DE = remainder
        jr      dms_rs_done

dms_rs2:
        add     hl,de           ; undo failed subtract; HL = remainder
        ex      de,hl           ; DE = remainder
        ld      a,40
        sub     b               ; A = quotient (cap - remaining)
        ld      h,0
        ld      l,a             ; HL = quotient
        pop     bc              ; discard saved dividend

dms_rs_done:
        pop     af
        pop     bc
        ret

; Divide-result cache shared by __divu, __modu, __divs, __mods.
; Lives in the DRSU prelude so dccrtlstrip keeps it whenever any of
; those entry points is referenced, without forcing __mods: to be kept.
__dmval:
        db      0
__dmc_lhs:
        dw      0
__dmc_rhs:
        dw      0
__dmquot:
        dw      0
__dmrem:
        dw      0

__divu:
        ; Faster cache-aware unsigned divide.
        ; Input:  HL = dividend, DE = divisor
        ; Output: HL = quotient
        ;
        ; Fast hit path compares the live operands directly against the
        ; cached operands.  This avoids storing scratch operands on every
        ; div/mod pair hit.
        ld      a,(__dmval)
        or      a
        jr      z,du_miss_save

        push    hl              ; save dividend
        or      a
        ld      hl,(__dmc_rhs)
        sbc     hl,de
        jr      nz,du_rhs_bad

        pop     hl              ; restore dividend
        push    de              ; save divisor
        push    hl              ; save original dividend so miss has correct HL
        ld      de,(__dmc_lhs)
        or      a
        sbc     hl,de           ; compare only; result discarded on both paths
        pop     hl              ; restore original dividend (hit or miss)
        pop     de              ; restore divisor
        jr      nz,du_miss_save

        ld      hl,(__dmquot)
        ret

du_rhs_bad:
        pop     hl              ; restore dividend

du_miss_save:
        ld      (__dmc_lhs),hl
        ex      de,hl
        ld      (__dmc_rhs),hl
        ex      de,hl

        call    DRSU        ; HL = quotient, DE = remainder

        ld      (__dmquot),hl
        ex      de,hl
        ld      (__dmrem),hl
        ld      a,1
        ld      (__dmval),a
        ld      hl,(__dmquot)
        ret

__modu:
        ; Cache-aware unsigned modulo.  Same cache as __divu, so x%n then x/n
        ; (or x/n then x%n) with identical operands calls DRSU once.
        ; Input:  HL = dividend, DE = divisor
        ; Output: HL = remainder
        ld      a,(__dmval)
        or      a
        jr      z,dm_miss       ; cache empty
        push    de              ; [SP: divisor]
        push    hl              ; [SP: dividend, divisor]
        ; Check rhs (divisor)
        or      a
        ld      hl,(__dmc_rhs)
        sbc     hl,de
        jr      nz,dm_both_pop  ; rhs mismatch
        ; rhs matches  check lhs (dividend)
        pop     hl              ; restore dividend  [SP: divisor]
        push    hl              ; re-save           [SP: dividend, divisor]
        ld      de,(__dmc_lhs)
        or      a
        sbc     hl,de           ; HL = dividend - cached_lhs (HL corrupted)
        jr      nz,dm_both_pop  ; lhs mismatch
        ; cache hit
        pop     hl              ; discard saved dividend [SP: divisor]
        pop     de              ; restore divisor
        ld      hl,(__dmrem)
        ret
dm_both_pop:
        pop     hl              ; restore dividend
        pop     de              ; restore divisor
dm_miss:
        ld      (__dmc_lhs),hl
        ex      de,hl
        ld      (__dmc_rhs),hl
        ex      de,hl
        call    DRSU  ; HL = quotient, DE = remainder
        ld      (__dmquot),hl
        ex      de,hl
        ld      (__dmrem),hl    ; HL = remainder
        ld      a,1
        ld      (__dmval),a
        ret


; Signed 16-bit division/modulo wrappers.
; Input:  HL = signed dividend, DE = signed divisor
; Output: HL = quotient (__divs) or remainder (__mods)
; Semantics: quotient truncates toward zero; remainder has dividend sign.
;
; CONTRACT: __divs, __mods, __divu, and __modu all preserve BC across the
; call (the fast paths never touch it; the slow paths and DRSU explicitly
; push/pop it). dccpeep's pass_byte_loop_counter_to_reg_c relies on this to
; keep a loop counter live in C across a call to one of these without any
; spill/reload - if that ever changes, update this comment and the pass's
; whitelist of safe-to-cross call targets together.
__divs:
        ; Fast path: if both operands are non-negative, signed division is
        ; identical to unsigned division.  This avoids the sign-wrapper
        ; overhead in hot loops such as e.c where int values stay >= 0.
        ld      a,h
        or      d
        jp      p,__divu
        push    bc
        ld      b,0             ; bit0: quotient negative?
        ld      a,h
        or      a
        jp      p,__ds_lpos
        ld      a,b
        xor     1
        ld      b,a
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
__ds_lpos:
        ld      a,d
        or      a
        jp      p,__ds_rpos
        ld      a,b
        xor     1
        ld      b,a
        ex      de,hl
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
        ex      de,hl
__ds_rpos:
        call    __divu
        ld      a,b
        or      a
        jp      z,__ds_done
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
__ds_done:
        pop     bc
        ret

__mods:
        ; Fast path: if both operands are non-negative, signed modulo is
        ; identical to unsigned modulo.  Jump directly so cache pairing with
        ; __divu/__modu still works.
        ld      a,h
        or      d
        jp      p,__modu
        push    bc
        ld      b,0             ; bit0: remainder negative? dividend sign only
        ld      a,h
        or      a
        jp      p,__ms_lpos
        ld      b,1
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
__ms_lpos:
        ld      a,d
        or      a
        jp      p,__ms_rpos
        ex      de,hl
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
        ex      de,hl
__ms_rpos:
        call    __modu
        ld      a,b
        or      a
        jp      z,__ms_done
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
__ms_done:
        pop     bc
        ret

        public  _abs
_abs:
        ; int abs(int j)
        pop     bc              ; return address
        pop     hl              ; j
        push    hl              ; restore argument
        push    bc
        bit     7,h
        ret     z
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
        ret

        public  _labs
_labs:
        ; long labs(long j), returned in DE:HL
        pop     bc              ; return address
        pop     hl              ; low word
        pop     de              ; high word
        push    de              ; restore argument
        push    hl
        push    bc
        bit     7,d
        ret     z
        ld      a,l
        cpl
        ld      l,a
        ld      a,h
        cpl
        ld      h,a
        ld      a,e
        cpl
        ld      e,a
        ld      a,d
        cpl
        ld      d,a
        inc     hl
        ld      a,h
        or      l
        ret     nz
        inc     de
        ret

        public  _div
_div:
        ; div_t div(int numer, int denom)
        ; Hidden struct return pointer is the first argument at IX+4.
        push    ix
        ld      ix,0
        add     ix,sp

        ld      l,(ix+6)
        ld      h,(ix+7)        ; HL = numer
        ld      e,(ix+8)
        ld      d,(ix+9)        ; DE = denom
        call    __divs          ; HL = quotient
        ld      c,(ix+4)
        ld      b,(ix+5)        ; BC = result pointer
        ld      a,l
        ld      (bc),a
        inc     bc
        ld      a,h
        ld      (bc),a

        ld      l,(ix+6)
        ld      h,(ix+7)        ; HL = numer
        ld      e,(ix+8)
        ld      d,(ix+9)        ; DE = denom
        call    __mods          ; HL = remainder
        ld      c,(ix+4)
        ld      b,(ix+5)
        inc     bc
        inc     bc              ; BC = &result->rem
        ld      a,l
        ld      (bc),a
        inc     bc
        ld      a,h
        ld      (bc),a
        ld      l,(ix+4)
        ld      h,(ix+5)
        pop     ix
        ret

        public  _ldiv
_ldiv:
        ; ldiv_t ldiv(long numer, long denom)
        ; Hidden struct return pointer is the first argument at IX+4.
        push    ix
        ld      ix,0
        add     ix,sp

        ; fastcall: denom (divisor/RHS) live in DE:HL at the call, matching
        ; __lds/__lms's new convention; only numer (dividend/LHS) is pushed.
        ld      l,(ix+8)
        ld      h,(ix+9)        ; numer high word
        push    hl
        ld      l,(ix+6)
        ld      h,(ix+7)        ; numer low word
        push    hl
        ld      l,(ix+10)
        ld      h,(ix+11)       ; denom low word -> HL (live)
        ld      e,(ix+12)
        ld      d,(ix+13)       ; denom high word -> DE (live)
        call    __lds           ; DE:HL = quotient
        pop     bc
        pop     bc
        ld      c,(ix+4)
        ld      b,(ix+5)        ; BC = result pointer
        ld      a,l
        ld      (bc),a
        inc     bc
        ld      a,h
        ld      (bc),a
        inc     bc
        ld      a,e
        ld      (bc),a
        inc     bc
        ld      a,d
        ld      (bc),a

        ld      l,(ix+8)
        ld      h,(ix+9)        ; numer high word
        push    hl
        ld      l,(ix+6)
        ld      h,(ix+7)        ; numer low word
        push    hl
        ld      l,(ix+10)
        ld      h,(ix+11)       ; denom low word -> HL (live)
        ld      e,(ix+12)
        ld      d,(ix+13)       ; denom high word -> DE (live)
        call    __lms           ; DE:HL = remainder
        pop     bc
        pop     bc
        ld      c,(ix+4)
        ld      b,(ix+5)
        inc     bc
        inc     bc
        inc     bc
        inc     bc              ; BC = &result->rem
        ld      a,l
        ld      (bc),a
        inc     bc
        ld      a,h
        ld      (bc),a
        inc     bc
        ld      a,e
        ld      (bc),a
        inc     bc
        ld      a,d
        ld      (bc),a
        ld      l,(ix+4)
        ld      h,(ix+5)
        pop     ix
        ret


        public  _bsearch
; const void *bsearch(const void *key, const void *base, size_t num,
;                     size_t size, int (*compare)(const void *, const void *))
; Classic size-decrementing binary search: no signed index arithmetic, so it
; is correct for the full unsigned size_t range.  Calls the comparator through
; __call_hl using the standard dcc convention (args pushed right-to-left,
; result in HL, caller cleans the stack).  State is held in static scratch
; because the comparator may clobber every register.  Returns the matching
; element pointer, or 0 if not found.
_bsearch:
        ; IX-free; the loop already reads everything back from static
        ; scratch (the comparator may clobber every register), so entry
        ; just pops each argument straight into its static slot instead
        ; of reading it via (ix+n) and then storing it.
        pop     bc              ; return address
        pop     hl              ; key
        ld      (__bs_key),hl
        pop     hl              ; base
        ld      (__bs_base),hl
        pop     hl              ; num
        ld      (__bs_num),hl
        pop     hl              ; size
        ld      (__bs_size),hl
        pop     hl              ; cmp
        ld      (__bs_cmp),hl

        push    hl              ; restore cmp
        ld      hl,(__bs_size)
        push    hl              ; restore size
        ld      hl,(__bs_num)
        push    hl              ; restore num
        ld      hl,(__bs_base)
        push    hl              ; restore base
        ld      hl,(__bs_key)
        push    hl              ; restore key
        push    bc              ; restore return address
bs_loop:
        ld      hl,(__bs_num)
        ld      a,h
        or      l
        jp      z,bs_nf                 ; num == 0 -> not found
        ; half = num >> 1
        srl     h
        rr      l
        ld      (__bs_half),hl
        ; here = base + half*size
        ld      de,(__bs_size)
        call    __mulu                  ; HL = half*size
        ld      de,(__bs_base)
        add     hl,de
        ld      (__bs_here),hl
        ; compare(key, here): push here (b), push key (a)
        push    hl
        ld      hl,(__bs_key)
        push    hl
        ld      hl,(__bs_cmp)
        call    __call_hl
        pop     bc
        pop     bc
        ld      a,h
        or      l
        jr      z,bs_found              ; equal
        bit     7,h
        jr      nz,bs_lt                ; result < 0 -> search lower half
        ; result > 0 -> search upper half: base = here+size; num = num-half-1
        ld      hl,(__bs_here)
        ld      de,(__bs_size)
        add     hl,de
        ld      (__bs_base),hl
        ld      hl,(__bs_num)
        ld      de,(__bs_half)
        or      a
        sbc     hl,de
        dec     hl
        ld      (__bs_num),hl
        jp      bs_loop
bs_lt:
        ld      hl,(__bs_half)
        ld      (__bs_num),hl
        jp      bs_loop
bs_found:
        ld      hl,(__bs_here)
        ret
bs_nf:
        ld      hl,0
        ret
__bs_key:       dw      0
__bs_base:      dw      0
__bs_num:       dw      0
__bs_size:      dw      0
__bs_cmp:       dw      0
__bs_half:      dw      0
__bs_here:      dw      0

        public  _qsort
; void qsort(void *base, size_t num, size_t size,
;            int (*compare)(const void *, const void *))
; In-place Shell sort: non-recursive (no C-stack growth on adversarial input,
; unlike a recursive quicksort) and needs no auxiliary memory, which suits the
; small CP/M TPA.  Element size is arbitrary; elements are exchanged with a
; byte-wise swap.  The comparator is called through __call_hl.  State is kept
; in static scratch (the comparator may clobber all registers), so qsort is not
; re-entrant from within its own comparator -- acceptable for this runtime.
_qsort:
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      (__qs_base),hl
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      (__qs_num),hl
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      (__qs_size),hl
        ld      l,(ix+10)
        ld      h,(ix+11)
        ld      (__qs_cmp),hl
        ; if num < 2 nothing to do
        ld      hl,(__qs_num)
        ld      de,2
        or      a
        sbc     hl,de
        jp      c,qs_ret
        ; gap = num >> 1
        ld      hl,(__qs_num)
        srl     h
        rr      l
        ld      (__qs_gap),hl
qs_gaploop:
        ; gapb = gap * size
        ld      hl,(__qs_gap)
        ld      de,(__qs_size)
        call    __mulu
        ld      (__qs_gapb),hl
        ; i = gap ; pi = base + gapb
        ld      hl,(__qs_base)
        ld      de,(__qs_gapb)
        add     hl,de
        ld      (__qs_pi),hl
        ld      hl,(__qs_gap)
        ld      (__qs_i),hl
qs_iloop:
        ld      hl,(__qs_i)
        ld      de,(__qs_num)
        or      a
        sbc     hl,de
        jp      nc,qs_gapnext           ; i >= num -> end of this gap pass
        ; pj = pi ; j = i
        ld      hl,(__qs_pi)
        ld      (__qs_pj),hl
        ld      hl,(__qs_i)
        ld      (__qs_j),hl
qs_inner:
        ; while j >= gap
        ld      hl,(__qs_j)
        ld      de,(__qs_gap)
        or      a
        sbc     hl,de
        jr      c,qs_idone              ; j < gap -> stop
        ; pprev = pj - gapb
        ld      hl,(__qs_pj)
        ld      de,(__qs_gapb)
        or      a
        sbc     hl,de
        ld      (__qs_pprev),hl
        ; compare(pprev, pj): push pj (b), push pprev (a)
        ld      hl,(__qs_pj)
        push    hl
        ld      hl,(__qs_pprev)
        push    hl
        ld      hl,(__qs_cmp)
        call    __call_hl
        pop     bc
        pop     bc
        ld      a,h
        or      l
        jr      z,qs_idone              ; cmp == 0 -> ordered, stop
        bit     7,h
        jr      nz,qs_idone             ; cmp < 0 -> ordered, stop
        ; cmp > 0 -> swap *pprev and *pj (size bytes), then step down by gap
        ld      hl,(__qs_pprev)
        ld      de,(__qs_pj)
        ld      bc,(__qs_size)
qs_swap:
        ld      a,(de)
        ex      af,af'
        ld      a,(hl)
        ld      (de),a
        ex      af,af'
        ld      (hl),a
        inc     hl
        inc     de
        dec     bc
        ld      a,b
        or      c
        jr      nz,qs_swap
        ld      hl,(__qs_pprev)
        ld      (__qs_pj),hl
        ld      hl,(__qs_j)
        ld      de,(__qs_gap)
        or      a
        sbc     hl,de
        ld      (__qs_j),hl
        jp      qs_inner
qs_idone:
        ; i++ ; pi += size
        ld      hl,(__qs_i)
        inc     hl
        ld      (__qs_i),hl
        ld      hl,(__qs_pi)
        ld      de,(__qs_size)
        add     hl,de
        ld      (__qs_pi),hl
        jp      qs_iloop
qs_gapnext:
        ; gap >>= 1 ; continue while gap > 0
        ld      hl,(__qs_gap)
        srl     h
        rr      l
        ld      (__qs_gap),hl
        ld      a,h
        or      l
        jp      nz,qs_gaploop
qs_ret:
        pop     ix
        ret
__qs_base:      dw      0
__qs_num:       dw      0
__qs_size:      dw      0
__qs_cmp:       dw      0
__qs_gap:       dw      0
__qs_gapb:      dw      0
__qs_i:         dw      0
__qs_pi:        dw      0
__qs_j:         dw      0
__qs_pj:        dw      0
__qs_pprev:     dw      0


        public  __r1u
; 16-bit unsigned dividend modulo 8-bit constant divisor.
; Input:  HL = dividend, E = divisor (1..255)
; Output: HL = remainder
; Used for unsigned x % C when C fits in one byte and is not a power of two.
__r1u:
        push    bc
        push    de              ; preserve caller DE (D reused as bit counter)
        push    af
        ld      a,e
        or      a
        jr      nz,R1U0
        ; Undefined in C, but keep a deterministic fallback for divisor 0.
        pop     af
        pop     de
        pop     bc
        ret
R1U0:
        ld      bc,0            ; BC = partial remainder, kept < divisor
        ld      d,16            ; D = bit counter (D is otherwise unused here)
R1U1:
        add     hl,hl           ; next dividend bit -> carry
        rl      c
        rl      b

        ; if BC >= E, subtract E.  Since E is 8-bit and BC is at most
        ; 9 bits here, this avoids the full 16-bit divisor compare path.
        ld      a,b
        or      a
        jr      nz,R1US
        ld      a,c
        cp      e
        jr      c,R1UN
R1US:
        ld      a,c
        sub     e
        ld      c,a
        ld      a,b
        sbc     a,0
        ld      b,a
R1UN:
        dec     d
        jr      nz,R1U1
        ld      h,0
        ld      l,c
        pop     af
        pop     de
        pop     bc
        ret


        public  __r1s
; 16-bit signed dividend modulo positive 8-bit constant divisor.
; Input:  HL = signed dividend, E = divisor (1..255)
; Output: HL = signed remainder, same sign convention as __mods/__r2s.
__r1s:
        ld      a,h
        or      a
        jp      p,__r1u
        push    bc
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
        call    __r1u
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
        pop     bc
        ret


        public  __q2u
        public  __r2u
        public  __q2s
        public  __r2s
; Fixed 16-iteration unsigned divider for constant divisors.
; dccpeep rewrites ld de,<const> / call __div*/__mod* to these short
; public names.  Names are 5 chars and unique under short external matching.
D16U:
        ; Input:  HL = dividend, DE = divisor
        ; Output: HL = quotient, DE = remainder
        ; Uses alternate AF as the 16-iteration counter.  The old version
        ; stored the counter in memory every bit, which is costly in hot
        ; constant-modulo code such as rand() % C.
        push    bc
        push    af
        ld      a,d
        or      e
        jr      nz,D16U0
        ld      d,h
        ld      e,l
        ld      hl,0ffffh
        jr      D16UD
D16U0:
        ld      bc,0            ; BC = partial remainder
        ex      af,af'
        ld      a,16            ; alternate A = loop counter
        ex      af,af'
D16U1:
        add     hl,hl           ; shift next dividend bit into carry;
        rl      c               ; BC = (BC << 1) | carry
        rl      b

        ; if BC >= DE, BC -= DE and set current quotient bit.
        ld      a,c
        sub     e
        ld      a,b
        sbc     a,d
        jr      c,D16U2

        ld      a,c
        sub     e
        ld      c,a
        ld      a,b
        sbc     a,d
        ld      b,a
        inc     l               ; low bit is known clear after add hl,hl
D16U2:
        ex      af,af'          ; decrement alternate counter
        dec     a
        jr      z,D16U3
        ex      af,af'
        jr      D16U1
D16U3:
        ex      af,af'          ; restore primary AF before returning
        ld      d,b             ; DE = remainder
        ld      e,c
D16UD:
        pop     af
        pop     bc
        ret

__q2u:
        call    D16U             ; fixed divider quotient
        ret

__r2u:
        call    D16U             ; fixed divider remainder
        ex      de,hl
        ret

__q2s:
        ; Signed fixed 16-step quotient.  Same semantics as __divs.
        ld      a,h
        or      d
        jp      p,__q2u
        push    bc
        ld      b,0
        ld      a,h
        or      a
        jp      p,Q2SLP
        ld      a,b
        xor     1
        ld      b,a
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
Q2SLP:
        ld      a,d
        or      a
        jp      p,Q2SRP
        ld      a,b
        xor     1
        ld      b,a
        ex      de,hl
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
        ex      de,hl
Q2SRP:
        call    __q2u
        ld      a,b
        or      a
        jp      z,Q2SDN
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
Q2SDN:
        pop     bc
        ret

__r2s:
        ; Signed fixed 16-step remainder.  Same semantics as __mods.
        ld      a,h
        or      d
        jp      p,__r2u
        push    bc
        ld      b,0
        ld      a,h
        or      a
        jp      p,R2SLP
        ld      b,1
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
R2SLP:
        ld      a,d
        or      a
        jp      p,R2SRP
        ex      de,hl
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
        ex      de,hl
R2SRP:
        call    __r2u
        ld      a,b
        or      a
        jp      z,R2SDN
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
R2SDN:
        pop     bc
        ret

; Shared function-frame entry/exit stubs used by the dccpeep pass_shared_frame_stubs
; optimisation.  Each is a separate public block so dccrtlstrip includes only what
; the application actually references.
;
; Names are <= 6 characters so they remain distinct in L80's 6-character
; symbol-table (L80 truncates longer names for matching purposes).
;
; __en0  frame setup with no local-variable allocation (8 inline bytes -> 3).
;   Caller emits:   call __en0
;   Stack on entry: [body_ret, ret_addr, params...]
;
        public  __en0
__en0:
        pop     de              ; DE = return-to-body address
        push    ix              ; save caller's frame pointer
        ld      ix,0
        add     ix,sp           ; IX = frame  (params at IX+4, IX+6, ...)
        ex      de,hl           ; HL = body address (DE = old HL, discarded)
        jp      (hl)

; __entr  frame setup WITH local-variable allocation (13 inline bytes -> 6).
;   Caller emits:   ld hl,-N  /  call __entr
;   Stack on entry: [body_ret, ret_addr, params...]  HL = -local_size
;
        public  __entr
__entr:
        pop     de              ; DE = return-to-body address
        push    ix              ; save caller's frame pointer
        ld      ix,0
        add     ix,sp           ; IX = frame pointer
        add     hl,sp           ; HL = SP - local_size
        ld      sp,hl           ; allocate locals
        ex      de,hl           ; HL = body address
        jp      (hl)

; __lve  shared epilogue for functions that have locals (5 inline bytes -> 3).
;   Caller emits:   jp __lve
;
        public  __lve
__lve:
        ld      sp,ix
        pop     ix
        ret

; __la1/__la2/__la3  load first/second/third word parameter into HL.
;   Replaces 6-byte inline: ld l,(ix+N) / ld h,(ix+N+1)
;   Caller emits:  call __la1  (or __la2, __la3)
;   Returns: HL = parameter value.  All other registers and flags unchanged.
;
        public  __la1
__la1:
        ld      l,(ix+4)
        ld      h,(ix+5)
        ret

        public  __la2
__la2:
        ld      l,(ix+6)
        ld      h,(ix+7)
        ret

        public  __la3
__la3:
        ld      l,(ix+8)
        ld      h,(ix+9)
        ret

; __phix  save HL on the stack, then copy IX into HL (4 inline bytes -> 3).
;   Replaces:  push hl / push ix / pop hl
;   Caller emits:  call __phix
;   Returns: HL = IX (frame pointer); old HL value pushed onto the stack.
;   All other registers and flags unchanged.
;
        public  __phix
__phix:
        ex      (sp),hl         ; HL = return addr, [SP] = old HL
        push    hl              ; push return addr (below old HL on stack)
        push    ix              ; push IX value
        pop     hl              ; HL = IX
        ret                     ; return; old HL now sits at top of stack

; __lv1-__lv8: load local variable word into HL.
; Analogous to __la1/__la2/__la3 for parameters but uses negative IX offsets.
; Each stub saves 3 bytes per replaced ld l,(ix-N) / ld h,(ix-N+1) pair.
        public  __lv1
__lv1:  ld      l,(ix-2)
        ld      h,(ix-1)
        ret

        public  __lv2
__lv2:  ld      l,(ix-4)
        ld      h,(ix-3)
        ret

        public  __lv3
__lv3:  ld      l,(ix-6)
        ld      h,(ix-5)
        ret

        public  __lv4
__lv4:  ld      l,(ix-8)
        ld      h,(ix-7)
        ret

        public  __lv5
__lv5:  ld      l,(ix-10)
        ld      h,(ix-9)
        ret

        public  __lv6
__lv6:  ld      l,(ix-12)
        ld      h,(ix-11)
        ret

        public  __lv7
__lv7:  ld      l,(ix-14)
        ld      h,(ix-13)
        ret

        public  __lv8
__lv8:  ld      l,(ix-16)
        ld      h,(ix-15)
        ret

; __sv1-__sv6: store HL to local variable word.
; Replaces ld (ix-N),l / ld (ix-N+1),h pairs; caller loads HL first.
        public  __sv1
__sv1:  ld      (ix-2),l
        ld      (ix-1),h
        ret

        public  __sv2
__sv2:  ld      (ix-4),l
        ld      (ix-3),h
        ret

        public  __sv3
__sv3:  ld      (ix-6),l
        ld      (ix-5),h
        ret

        public  __sv4
__sv4:  ld      (ix-8),l
        ld      (ix-7),h
        ret

        public  __sv5
__sv5:  ld      (ix-10),l
        ld      (ix-9),h
        ret

        public  __sv6
__sv6:  ld      (ix-12),l
        ld      (ix-11),h
        ret

; __ldwl  dereference 16-bit pointer in HL (4 inline bytes -> 3).
;   Replaces:  ld e,(hl) / inc hl / ld d,(hl) / ex de,hl
;   Input: HL = pointer.  Output: HL = *HL, DE trashed.  Flags unchanged.
        public  __ldwl
__ldwl: ld      e,(hl)
        inc     hl
        ld      d,(hl)
        ex      de,hl
        ret

; __wand  HL &= DE, 16-bit AND (6 inline bytes -> 3).
;   Replaces:  ld a,h / and d / ld h,a / ld a,l / and e / ld l,a
;   Input: HL, DE.  Output: HL = HL & DE.  Flags set by low-byte AND.
        public  __wand
__wand: ld      a,h
        and     d
        ld      h,a
        ld      a,l
        and     e
        ld      l,a
        ret

; __icmp  signed 16-bit compare, set flags for signed subtraction (8 inline bytes -> 3).
;   Replaces: ld a,h/xor 80h/ld h,a/ld a,d/xor 80h/ld d,a/or a/sbc hl,de
;   Input: HL, DE = signed 16-bit operands.
;   Output: flags set for signed HL-DE, HL and DE trashed.  ret preserves flags.
        public  __icmp
__icmp: ld      a,h
        xor     80h
        ld      h,a
        ld      a,d
        xor     80h
        ld      d,a
        or      a
        sbc     hl,de
        ret

; __sxde  sign-extend HL: produce DE = 0FFFFh if HL negative, 0 otherwise (5 bytes -> 3).
;   Replaces:  ld a,h / rlca / sbc a,a / ld d,a / ld e,a
;   Input: HL = signed 16-bit value.  Output: DE = sign-extension word, HL unchanged.
        public  __sxde
__sxde: ld      a,h
        rlca
        sbc     a,a
        ld      d,a
        ld      e,a
        ret

; __sxhl  sign-extend L into H: HL = (int16_t)(int8_t)L (4 inline bytes -> 3).
;   Replaces:  ld a,l / rlca / sbc a,a / ld h,a
;   Input: L = signed 8-bit value.  Output: H = sign of L, HL = 16-bit signed value.
        public  __sxhl
__sxhl: ld      a,l
        rlca
        sbc     a,a
        ld      h,a
        ret

        public  _printf
        public  __pf_run
        public  pf_emit_a
        public  pf_emstr
        public  pf_arg_hl
        public  pf_pad_a
        public  pf_zero_prec_blank
        public  pf_zsetup
        public  pf_efflen
        public  pf_iprepad
        public  pf_zfd
        public  pf_ipostpad
        public  pf_xu
        public  pf_o
        public  pf_done
        public  pf_hxb16
        public  pf_hex_store_nz
        public  pf_hforce
        public  pf_ocb16
        public  pf_width
_printf:
        push    ix
        ld      ix,0
        add     ix,sp
        push    bc
        push    de
        ld      hl,0
        ld      (pf_sink),hl            ; console mode
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      de,6
        ld      bc,0
        call    __pf_run
        ld      h,b
        ld      l,c
        pop     de
        pop     bc
        pop     ix
        ret

; __pf_run: shared printf body.
; IN:  HL=fmt, DE=vararg offset from IX, BC=0, pf_sink set.
; IX must point to the caller's stack frame throughout.
; OUT: BC = character count.
__pf_run:
pf_loop:
        ld      a,(hl)
        or      a
        jp      z,pf_done
        inc     hl
        cp      '%'
        jp      z,pf_percent
        call    pf_emit_a
        jp      pf_loop

pf_percent:
        xor     a
        ld      (pf_width),a
        ld      (pf_prec),a
        ld      (pf_haveprec),a
        ld      (pf_left),a
        ld      (pf_zero),a

pf_pct_next:
        ld      a,(hl)
        or      a
        jp      z,pf_done
        inc     hl

        cp      '%'
        jp      z,pf_emit_and_loop

        cp      '-'
        jp      z,pf_pct_left

        ; '+' (force sign) and '#' (alternate form) are not implemented, but
        ; must still be recognized and skipped as no-op flags here rather
        ; than falling through to the unrecognized-conversion-character
        ; path below: that path bails out without consuming an argument,
        ; which silently desyncs every argument after it for the rest of
        ; this printf() call (confirmed: "%+d %d %d", 1,2,3 printed
        ; "+d 1 2" instead of failing locally). Recognizing them here as
        ; true no-ops means the real conversion character that follows
        ; (e.g. the 'd' in "%+d") still runs normally and consumes exactly
        ; one argument, so only the '+'/'#' cosmetic effect itself is
        ; missing - nothing after it in the call is corrupted.
        cp      '+'
        jp      z,pf_pct_next
        cp      '#'
        jp      z,pf_pct_next

        cp      '.'
        jp      z,pf_pct_dot

        ; C99 size_t length modifier.  In dcc, size_t is 16-bit, so
        ; %zu/%zd/%zi/%zx/%zX use the ordinary 16-bit integer handlers.
        cp      'z'
        jp      z,pf_pct_z

        ; Decimal field width: %2d / %3u / %8s etc.  A leading '0' (before any
        ; width digit) is the '0' zero-pad flag, not a width digit.
        cp      '0'
        jp      c,pf_pct_done_width
        cp      '9'+1
        jp      nc,pf_pct_done_width

        cp      '0'
        jr      nz,pf_pct_acc
        ld      a,(pf_width)
        or      a
        jr      nz,pf_pct_zero_digit    ; width already started: '0' is a digit
        ld      a,1
        ld      (pf_zero),a             ; leading '0' = zero-pad flag
        jp      pf_pct_next
pf_pct_zero_digit:
        xor     a                       ; treat as digit value 0
        jr      pf_pct_acc2
pf_pct_acc:
        sub     '0'
pf_pct_acc2:
        ld      (pf_digit),a
        push    de              ; DE is the vararg byte offset; preserve it.
        ld      a,(pf_width)
        add     a,a             ; 2*w
        ld      e,a
        add     a,a             ; 4*w
        add     a,a             ; 8*w
        add     a,e             ; 10*w
        ld      e,a
        ld      a,(pf_digit)
        add     a,e
        ld      (pf_width),a
        pop     de
        jp      pf_pct_next

pf_pct_left:
        ld      a,1
        ld      (pf_left),a
        jp      pf_pct_next

pf_pct_dot:
        ; Parse digits after '.' into pf_prec (e.g. %.4d  prec=4).
        ; '.' was already consumed by inc hl in pf_pct_next.
        ; Track that precision was explicitly specified so %.0x can differ
        ; from plain %x, and so the '0' flag is ignored for all integer
        ; conversions even when the explicit precision is zero.
        ld      a,1
        ld      (pf_haveprec),a
pf_pct_prec_loop:
        ld      a,(hl)
        or      a
        jp      z,pf_done
        cp      '0'
        jp      c,pf_pct_prec_done
        cp      '9'+1
        jp      nc,pf_pct_prec_done
        inc     hl
        sub     '0'
        ld      (pf_digit),a
        push    de
        ld      a,(pf_prec)
        add     a,a             ; 2*p
        ld      e,a
        add     a,a             ; 4*p
        add     a,a             ; 8*p
        add     a,e             ; 10*p
        ld      e,a
        ld      a,(pf_digit)
        add     a,e
        ld      (pf_prec),a
        pop     de
        jr      pf_pct_prec_loop
pf_pct_prec_done:
        ; A = format specifier char, HL points to it (not yet consumed)
        inc     hl
        jp      pf_pct_done_width

pf_pct_z:
        ld      a,(hl)
        or      a
        jp      z,pf_done
        inc     hl
        ; fall through into dispatch with A = conversion char after 'z'

pf_pct_done_width:
        cp      'c'
        jp      z,pf_c
        cp      's'
        jp      z,pf_s
        cp      'u'
        jp      z,pf_u
        cp      'd'
        jp      z,pf_d
        cp      'i'
        jp      z,pf_d
        cp      'x'
        jr      nz,pf_pct_not_xl
        push    hl                      ; save fmt ptr before clobbering HL
        ld      hl,(pf_hexl_hook)
        jp      (hl)                    ; handler pops HL to restore fmt ptr
pf_pct_not_xl:
        cp      'X'
        jr      nz,pf_pct_not_xu
        push    hl
        ld      hl,(pf_hexu_hook)
        jp      (hl)
pf_pct_not_xu:
        cp      'o'
        jr      nz,pf_pct_not_o
        push    hl
        ld      hl,(pf_oct_hook)
        jp      (hl)
pf_pct_not_o:
        cp      'l'
        jr      nz,pf_pct_not_l
        push    hl                      ; save fmt ptr before clobbering HL
        ld      hl,(pf_long_hook)
        jp      (hl)                    ; handler pops HL to restore fmt ptr
pf_pct_not_l:
        cp      'f'
        jr      nz,pf_emit_and_loop
        push    hl                      ; save fmt ptr before clobbering HL
        ld      hl,(pf_float_hook)
        jp      (hl)                    ; handler pops HL to restore fmt ptr

pf_emit_and_loop:
        call    pf_emit_a
        jp      pf_loop

pf_arg_hl:
        push    ix
        pop     hl
        add     hl,de
        ld      a,(hl)
        inc     hl
        ld      h,(hl)
        ld      l,a
        inc     de
        inc     de
        ret

; Emit (pf_width - A) spaces, if positive.  A is content length.
pf_pad_a:
        push    af
        ld      a,(pf_width)
        ld      e,a
        pop     af
        ld      d,a
        ld      a,e
        sub     d
        ret     c
        ret     z
        ld      d,a
pf_pad_loop:
        ld      a,' '
        call    pf_emit_a
        dec     d
        jr      nz,pf_pad_loop
        ret

; pf_zsetup: apply the '0' zero-pad flag to the upcoming integer conversion.
; IN:  A = sign length (0, or 1 when a '-' will be emitted).
; If the '0' flag is active, the field is not left-justified, and no explicit
; precision was given (C89/C99 7.19.6.1: a precision makes the '0' flag ignored
; for integer conversions), convert the field width into a zero-fill precision
; of (width - signlen) and clear the width so pf_pad_a emits no leading spaces.
; The sign counts toward the width.  Preserves HL/DE/BC.
pf_zsetup:
        push    hl
        push    de
        ld      e,a             ; E = sign length
        ld      a,(pf_zero)
        or      a
        jr      z,pf_zs_done
        ld      a,(pf_left)
        or      a
        jr      nz,pf_zs_done   ; '-' flag overrides '0'
        ld      a,(pf_haveprec)
        or      a
        jr      nz,pf_zs_done   ; explicit precision -> '0' ignored
        ld      a,(pf_width)
        sub     e               ; width - signlen
        jr      c,pf_zs_clrw    ; width <= signlen: nothing to zero-fill
        jr      z,pf_zs_clrw
        ld      (pf_prec),a     ; zero-fill digits up to (width - signlen)
pf_zs_clrw:
        xor     a
        ld      (pf_width),a    ; suppress space padding (zeros fill the field)
pf_zs_done:
        pop     de
        pop     hl
        ret

; pf_efflen: A = max(pf_digit, pf_prec) = the digit-field length that will
; actually be emitted (precision zero-fill can make it wider than the raw digit
; count).  pf_pad_a must size the space padding from this, not from pf_digit
; alone, or "%8.3d" over-pads.  Clobbers A/E only; preserves HL/BC.
pf_efflen:
        ld      a,(pf_prec)
        ld      e,a
        ld      a,(pf_digit)
        cp      e
        ret     nc              ; digit count >= prec
        ld      a,e             ; prec is larger
        ret

; pf_iprepad / pf_ipostpad: integer field padding helpers.
; IN: A = emitted field length excluding space padding.  The value is saved so
; left-justified integer conversions can emit trailing spaces after digits.
pf_iprepad:
        ld      (pf_field),a
        ld      a,(pf_left)
        or      a
        ret     nz
        ld      a,(pf_field)
        jp      pf_pad_a

pf_ipostpad:
        ld      a,(pf_left)
        or      a
        ret     z
        ld      a,(pf_field)
        jp      pf_pad_a

; pf_zero_prec_blank: implement the C89 integer rule that an explicit
; precision of zero with a zero value emits no digits.  Call after building a
; minimal digit string.  If pf_haveprec && pf_prec==0 && digits are exactly "0",
; set pf_digit=0 and point HL at the terminating NUL.  This is most visible for
; %.0x, but is shared safely by decimal and unsigned integer conversions too.
pf_zero_prec_blank:
        ld      a,(pf_haveprec)
        or      a
        ret     z
        ld      a,(pf_prec)
        or      a
        ret     nz
        ld      a,(pf_digit)
        cp      1
        ret     nz
        ld      a,(hl)
        cp      '0'
        ret     nz
        xor     a
        ld      (pf_digit),a
        inc     hl
        ret

; pf_zfd: emit precision zero-fill then the prebuilt decimal digits.
; IN:  HL -> first digit, pf_digit = digit count, pf_prec = zero-fill target.
; Emits (pf_prec - pf_digit) leading '0's (when positive) then the digits.
; Shared tail for %d/%u/%ld/%lu so precision and the '0' flag behave uniformly.
pf_zfd:
        ld      a,(pf_prec)
        or      a
        jr      z,pf_zfd_print  ; no precision/zero-fill: just print the digits
        ld      d,a             ; D = prec (DE preserved across pf_emit_a)
        ld      a,(pf_digit)
        sub     d               ; A = digit_count - prec
        jr      nc,pf_zfd_print ; digit_count >= prec: no fill
        neg                     ; A = prec - digit_count (zeros needed)
        ld      d,a
pf_zfd_zloop:
        ld      a,'0'
        call    pf_emit_a       ; push de/pop de preserves D
        dec     d
        jr      nz,pf_zfd_zloop
pf_zfd_print:
        call    pf_emstr
        ret

pf_c:
        push    hl
        call    pf_arg_hl
        push    de
        ld      a,(pf_left)
        or      a
        jr      nz,pf_c_emit
        ld      a,1
        call    pf_pad_a
pf_c_emit:
        ld      a,l
        call    pf_emit_a
        ld      a,(pf_left)
        or      a
        jr      z,pf_c_done
        ld      a,1
        call    pf_pad_a
pf_c_done:
        pop     de
        pop     hl
        jp      pf_loop

pf_s:
        push    hl
        call    pf_arg_hl
        push    de
        push    hl
        call    pf__slen_hl       ; A = strlen(HL), HL preserved by stack below
        ld      (pf_digit),a
        ; An explicit precision (%.Ns) caps both the field-width padding
        ; calculation and the actual emit count at min(strlen, N) - C89's
        ; "at most N characters, stopping at a NUL first" rule. Previously
        ; pf_haveprec/pf_prec were parsed correctly but never consulted
        ; here, so %.Ns always printed the whole string regardless of N.
        ld      a,(pf_haveprec)
        or      a
        jr      z,pf_s_no_clamp
        ld      a,(pf_digit)
        ld      e,a
        ld      a,(pf_prec)
        cp      e
        jr      nc,pf_s_no_clamp  ; precision >= strlen: nothing to clamp
        ld      (pf_digit),a      ; clamp the printed/padded length to precision
pf_s_no_clamp:
        ld      a,(pf_left)
        or      a
        jr      nz,pf_s_no_prepad
        ld      a,(pf_digit)
        call    pf_pad_a
pf_s_no_prepad:
        pop     hl
        ld      a,(pf_digit)
        ld      e,a               ; E = characters left to emit. The caller's
                                    ; own DE is safe on the stack below (pushed
                                    ; above) and pf_emit_a itself preserves DE
                                    ; across each call, so E is free to reuse
                                    ; here as this loop's countdown.
pf_s_loop:
        ld      a,e
        or      a
        jr      z,pf_s_done       ; precision limit reached
        ld      a,(hl)
        or      a
        jr      z,pf_s_done       ; NUL reached first
        inc     hl
        call    pf_emit_a
        dec     e
        jr      pf_s_loop
pf_s_done:
        ld      a,(pf_left)
        or      a
        jr      z,pf_s_no_postpad
        ld      a,(pf_digit)
        call    pf_pad_a
pf_s_no_postpad:
        pop     de
        pop     hl
        jp      pf_loop

pf_u:
        push    hl
        call    pf_arg_hl
        push    de
        call    pf_build_u      ; A = digit count, HL -> first digit (built once)
        ld      (pf_digit),a
        call    pf_zero_prec_blank
        push    hl
        xor     a               ; unsigned: no sign
        call    pf_zsetup       ; honour the '0' zero-pad flag
        call    pf_efflen       ; A = max(digits, precision)
        call    pf_iprepad      ; emit leading spaces unless left-justified
        pop     hl
        call    pf_zfd          ; precision/zero-fill then emit the digits
        call    pf_ipostpad     ; emit trailing spaces when left-justified
        pop     de
        pop     hl
        jp      pf_loop

pf_d:
        push    hl
        call    pf_arg_hl
        push    de

        ; Build digits of |value| once, then pad/sign/zero-fill/emit using the
        ; known length.  Avoids the separate digit-counting divide pass.
        bit     7,h
        jr      z,pf_d_pos
        ; Negative: build digits of -value, remember sign.
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
        call    pf_build_u
        ld      (pf_digit),a    ; save digit count of |value|
        call    pf_zero_prec_blank
        push    hl              ; save pointer to first digit
        ld      a,1             ; sign length = 1 ('-')
        call    pf_zsetup       ; honour the '0' zero-pad flag
        call    pf_efflen       ; A = max(digits, precision)
        inc     a               ; width includes the '-'
        call    pf_iprepad
        ld      a,'-'
        call    pf_emit_a
        jr      pf_d_tail
pf_d_pos:
        call    pf_build_u
        ld      (pf_digit),a    ; save digit count
        call    pf_zero_prec_blank
        push    hl              ; save pointer to first digit
        xor     a               ; sign length = 0
        call    pf_zsetup
        call    pf_efflen       ; A = max(digits, precision)
        call    pf_iprepad
pf_d_tail:
        pop     hl              ; HL -> first digit
        call    pf_zfd          ; precision/zero-fill then emit digits
        call    pf_ipostpad
        pop     de
        pop     hl
        jp      pf_loop

; %x/%X hex support, installed via pf_hexl_hook/pf_hexu_hook only when a
; call site's own format string is found (or conservatively assumed) to use
; it - split into its own dccrtlstrip block so a program that never formats
; hex pays nothing for this. (public declared up at the combined _printf
; run above, alongside pf_hex_store_nz/pf_hforce/pf_o/etc. - NOT here as a
; standalone `public` line, which would truncate that run's search window
; before it reaches pf_hex_store_nz/pf_hforce's real positions and cause
; dccrtlstrip to misplace them - confirmed as a real bug on tests/adaint.c.)
pf_xu:
        ld      a,1                     ; %X -> uppercase A-F
        ld      (pf_hexup),a
        jr      pf_x
pf_xl:
        xor     a                       ; %x -> lowercase a-f
        ld      (pf_hexup),a
pf_x:
        ; HL (fmt ptr) already pushed by the %x/%X dispatch in
        ; pf_pct_done_width (see pf_f's identical convention) - no push of
        ; our own here; the pop hl at the end (paired with push de below)
        ; retrieves that dispatch-pushed value, not a self-contained one.
        call    pf_arg_hl
        push    de
        call    pf_hxb16  ; A = digit count, HL -> first hex digit
        ld      (pf_digit),a
        call    pf_zero_prec_blank
        push    hl
        xor     a               ; unsigned: no sign
        call    pf_zsetup       ; honour the '0' zero-pad flag
        call    pf_efflen       ; A = max(digits, precision)
        call    pf_iprepad      ; emit leading spaces unless left-justified
        pop     hl
        call    pf_zfd          ; precision/zero-fill then emit digits
        call    pf_ipostpad     ; emit trailing spaces when left-justified
        pop     de
        pop     hl
        jp      pf_loop

; %o octal support, installed via pf_oct_hook only when needed - see pf_xu
; above for why this is its own block (public declared at the combined
; _printf run, not here).
pf_o:
        ; HL (fmt ptr) already pushed by the %o dispatch in
        ; pf_pct_done_width - see pf_x's identical note above.
        call    pf_arg_hl
        push    de
        call    pf_ocb16  ; A = digit count, HL -> first octal digit
        ld      (pf_digit),a
        call    pf_zero_prec_blank
        push    hl
        xor     a               ; unsigned: no sign
        call    pf_zsetup       ; honour the '0' zero-pad flag
        call    pf_efflen       ; A = max(digits, precision)
        call    pf_iprepad      ; emit leading spaces unless left-justified
        pop     hl
        call    pf_zfd          ; precision/zero-fill then emit digits
        call    pf_ipostpad     ; emit trailing spaces when left-justified
        pop     de
        pop     hl
        jp      pf_loop

; pf_done is directly referenced by __pf_run's pf_loop (jp z,pf_done), so
; it's split out of the (now strippable) pf_o block into its own always-
; kept block (public declared at the combined _printf run, not here).
pf_done:
        ret                     ; count in BC; caller cleans up

pf_emit_a:
        push    hl
        push    de
        push    bc
        ld      e,a
        ld      hl,(pf_sink)
        ld      a,h
        or      l
        jr      z,pfe_con       ; pf_sink=0  console
        inc     a               ; a=h; sink=0FFFFh (unbounded buffer) -> h=0FFh -> wraps to 0
        jr      z,pfe_buf       ; unbounded buffer: sprintf/fprintf/vsprintf/vfprintf

; Bounded buffer (snprintf/vsnprintf, pf_sink=1): write only while pf_bufcnt <
; pf_bufmax, discard past the cap. BC (the running char count returned to the
; caller) still increments either way, which is exactly C99's "as if the
; buffer had been unbounded" snprintf return value - no extra bookkeeping needed.
pfe_bufn:
        ; BC (not DE) holds pf_bufmax here: E still holds the character to
        ; emit (loaded at entry), and ld de,(pf_bufmax) would clobber it.
        ; BC is safe to reuse - the caller's BC is saved on the stack and
        ; only restored at the epilogue below.
        ld      hl,(pf_bufcnt)
        ld      bc,(pf_bufmax)
        or      a
        sbc     hl,bc
        jr      nc,pfe_epilogue         ; bufcnt >= bufmax: discard, skip the write
        ld      hl,(pf_bufptr)
        ld      (hl),e
        inc     hl
        ld      (pf_bufptr),hl
        ld      hl,(pf_bufcnt)
        inc     hl
        ld      (pf_bufcnt),hl
        jr      pfe_epilogue

pfe_buf:
        ld      hl,(pf_bufptr)
        ld      (hl),e
        inc     hl
        ld      (pf_bufptr),hl
pfe_epilogue:
        pop     bc
        pop     de
        pop     hl
        inc     bc
        ret
pfe_con:
        call    __conout
        pop     bc
        pop     de
        pop     hl
        inc     bc
        ret

pf__slen_hl:
        push    hl
        push    bc
        ld      bc,0
pfsl1:
        ld      a,(hl)
        or      a
        jr      z,pfsl2
        inc     hl
        inc     bc
        jr      pfsl1
pfsl2:
        ld      a,c              ; low byte is enough for current tests
        pop     bc
        pop     hl
        ret

; pf_div10: constant-time unsigned divide of HL by 10.
; In:  HL = dividend
; Out: HL = quotient, A = remainder (0..9)
; Preserves DE and IX.  BC is saved/restored.
;
; Fixed 16-step shift-subtract divider specialised for divisor 10.  Unlike
; DRSU (repeated subtraction, O(quotient)) this is bounded, so printing an
; N-digit number is O(N*16) instead of O(value) -- e.g. ~44x faster for
; values in the tens of thousands.
pf_div10:
        push    bc
        ld      bc,1000h        ; B = 16 (loop counter), C = 0 (remainder)
pf_d10_lp:
        add     hl,hl           ; HL <<= 1, MSB -> carry
        ld      a,c
        adc     a,a             ; A = (rem<<1) | bit, range 0..19
        cp      10
        jr      c,pf_d10_no
        sub     10
        inc     l               ; set quotient bit 0 (clear after add hl,hl)
pf_d10_no:
        ld      c,a             ; save remainder
        djnz    pf_d10_lp
        ld      a,c             ; A = remainder (0..9)
        pop     bc
        ret

; pf_build_u: convert HL (unsigned 16-bit) to decimal text in pf_decbuf.
; Digits are built once into the buffer (high end downward) so the caller can
; derive the field length without a separate counting divide pass.
; Out: A = digit count, HL -> first digit (buffer null-terminated at
;      pf_decbuf+6).  Preserves BC and DE.
; NB: BC carries printf's running character count, so it must not be touched;
;     the digit count is computed from the buffer pointer, not a register.
pf_build_u:
        push    ix
        push    de
        ld      ix,pf_decbuf+6
        ld      (ix+0),0        ; null terminator
pfbu1:
        dec     ix
        call    pf_div10        ; HL = quotient, A = remainder
        add     a,'0'
        ld      (ix+0),a
        ld      a,h
        or      l
        jr      nz,pfbu1
        push    ix
        pop     hl              ; HL -> first digit
        ld      de,pf_decbuf+6
        ex      de,hl           ; DE -> first digit, HL = buffer end
        or      a
        sbc     hl,de           ; HL = digit count (end - first)
        ld      a,l             ; A = digit count (<= 5)
        ex      de,hl           ; HL -> first digit
        pop     de
        pop     ix
        ret

; pf_emstr: emit the null-terminated string at HL through pf_emit_a.
pf_emstr:
        ld      a,(hl)
        or      a
        ret     z
        inc     hl
        call    pf_emit_a
        jr      pf_emstr

; pf_hxb16: convert HL (unsigned 16-bit) to minimal hex text.
; Out: A = digit count, HL -> first digit in pf_decbuf, null-terminated.
; Uses pf_hexup to choose lowercase/uppercase.  Preserves BC and DE.
; Split into its own block (referenced by name from pf_xu's block above) so
; it's stripped along with %x/%X support when a program never uses it
; (public declared at the combined _printf run, not here).
pf_hxb16:
        push    ix
        push    de
        ld      ix,pf_decbuf
        ld      d,0             ; D = digit count / nonzero seen

        ld      a,h             ; high byte, high nibble
        rrca
        rrca
        rrca
        rrca
        call    pf_hex_store_nz

        ld      a,h             ; high byte, low nibble
        call    pf_hex_store_nz

        ld      a,l             ; low byte, high nibble
        rrca
        rrca
        rrca
        rrca
        call    pf_hex_store_nz

        ld      a,l             ; low byte, low nibble; always emit one digit
        call    pf_hforce

        ld      (ix+0),0
        ld      a,d             ; return digit count
        ld      hl,pf_decbuf
        pop     de
        pop     ix
        ret

; Store nibble A only after the first nonzero nibble has been seen.
pf_hex_store_nz:
        and     0fh
        ld      e,a
        ld      a,d
        or      a
        jr      nz,pf_hex_store_have
        ld      a,e
        or      a
        ret     z
pf_hex_store_have:
        ld      a,e
        jr      pf_hex_store_common

; Store nibble A unconditionally; used for the final nibble so zero prints "0".
pf_hforce:
        and     0fh
pf_hex_store_common:
        call    pf_hex_nib_char
        ld      (ix+0),a
        inc     ix
        inc     d
        ret

; Convert nibble A to an ASCII hex digit without emitting it.
pf_hex_nib_char:
        and     0fh
        add     a,'0'
        cp      '9'+1
        ret     c
        add     a,7
        push    af
        ld      a,(pf_hexup)
        or      a
        jr      nz,pf_hnc_up
        pop     af
        add     a,20h
        ret
pf_hnc_up:
        pop     af
        ret

pf_hex_byte:
        push    af
        rrca
        rrca
        rrca
        rrca
        call    pf_hex_nib
        pop     af
pf_hex_nib:
        and     0fh
        add     a,'0'
        cp      '9'+1
        jr      c,pfh1
        ; A-F (or a-f): base 'A' is '9'+1+7; for lowercase add a further 20h.
        add     a,7
        push    af
        ld      a,(pf_hexup)
        or      a
        jr      nz,pfh_up
        pop     af
        add     a,20h           ; lowercase a-f for %x/%lx
        jr      pfh1
pfh_up:
        pop     af              ; uppercase A-F for %X/%lX
pfh1:
        call    pf_emit_a
        ret

; pf_ocb16: convert HL (unsigned 16-bit) to minimal octal text.
; Out: A = digit count, HL -> first digit in pf_decbuf, null-terminated.
; Preserves BC and DE. Unlike decimal (base 10, needs a real divide) octal
; digits come straight from the low 3 bits of HL via a 3-bit right shift
; (dividing by 8), the same way pf_hxb16 uses 4-bit nibbles for
; base 16 - a 16-bit value needs at most 6 octal digits (2^16-1 = 177777
; octal), which is exactly pf_decbuf's size including the terminator.
; Split into its own block (referenced by name from pf_o's block above) so
; it's stripped along with %o support when a program never uses it
; (public declared at the combined _printf run, not here).
pf_ocb16:
        push    ix
        push    de
        ld      ix,pf_decbuf+6
        ld      (ix+0),0        ; null terminator
pfbo1:
        dec     ix
        ld      a,l
        and     7               ; remainder = low 3 bits
        add     a,'0'
        ld      (ix+0),a
        srl     h               ; HL >>= 3 (unsigned)
        rr      l
        srl     h
        rr      l
        srl     h
        rr      l
        ld      a,h
        or      l
        jr      nz,pfbo1
        push    ix
        pop     hl              ; HL -> first digit
        ld      de,pf_decbuf+6
        ex      de,hl           ; DE -> first digit, HL = buffer end
        or      a
        sbc     hl,de           ; HL = digit count (end - first)
        ld      a,l             ; A = digit count (<= 6)
        ex      de,hl           ; HL -> first digit
        pop     de
        pop     ix
        ret

; pf_width and everything below it through the printf/sprintf/fprintf/
; snprintf sink+buffer data are universally-needed scratch/hook state,
; always referenced directly from __pf_run (always-kept). Marking pf_width
; public (at the combined _printf run above, not here) splits this data
; out of whatever code block precedes it (pf_ocb16, textually) - without
; this, pf_ocb16's whole block (the octal digit builder) was being kept
; unconditionally for every program, since __pf_run's own reference to
; pf_width transitively kept the bundle it happened to sit in.
pf_width:
        db      0
pf_digit:
        db      0
pf_field:
        db      0
pf_prec:
        db      0
pf_haveprec:
        db      0
pf_left:
        db      0
pf_zero:
        db      0
pf_hexup:
        db      0

pf_decbuf:
        ds      7

pf_float_stub:
        pop     hl                      ; restore fmt ptr pushed by dispatch
        ld      a,'f'
        call    pf_emit_a
        jp      pf_loop
pf_float_hook:
        dw      pf_float_stub
pf_long_stub:
        pop     hl                      ; restore fmt ptr pushed by dispatch
        ld      a,'l'
        call    pf_emit_a
        jp      pf_loop
pf_long_hook:
        dw      pf_long_stub
pf_hexl_stub:
        pop     hl                      ; restore fmt ptr pushed by dispatch
        ld      a,'x'
        call    pf_emit_a
        jp      pf_loop
pf_hexl_hook:
        dw      pf_hexl_stub
pf_hexu_stub:
        pop     hl
        ld      a,'X'
        call    pf_emit_a
        jp      pf_loop
pf_hexu_hook:
        dw      pf_hexu_stub
pf_oct_stub:
        pop     hl
        ld      a,'o'
        call    pf_emit_a
        jp      pf_loop
pf_oct_hook:
        dw      pf_oct_stub

; printf/sprintf/fprintf/snprintf shared sink and buffer (here so they stay in
; the _printf block; placing them elsewhere forces dccrtlstrip to keep that block)
pf_sink:        dw      0       ; 0=console, 0FFFFh=unbounded buffer, 1=bounded buffer
pf_bufptr:      dw      0       ; write pointer for sprintf/fprintf/snprintf
pf_bufcnt:      dw      0       ; snprintf/vsnprintf: chars written into buf so far
pf_bufmax:      dw      0       ; snprintf/vsnprintf: cap on pf_bufcnt (n-1, or 0 if n=0)
__pf_cnt:       dw      0       ; char count saved by fprintf
__pf_fbuf:      ds      256     ; static buffer for fprintf


; ---- 32-bit printf helpers (_pffio and _pflng only) -------------------------
; dccrtlstrip keeps this block only when _pffio (-ffloatio) or _pflng
; (-flongio) is linked; stripped for programs using plain printf with no
; %f or %ld/%lu/%lx.
        public  __pf32h
__pf32h:

pf_decbuf32:
        ds      11

; pf_arg_dehl: read 4-byte vararg into __pf32_l/__pf32_h, advance DE by 4.
; Preserves BC: __pf_run keeps the running character count there, and the
; B/C scratch use below would otherwise corrupt the value returned by
; printf/sprintf/vsprintf whenever a %ld/%lu/%lx argument is formatted.
pf_arg_dehl:
        push    bc              ; preserve running char count (BC)
        push    de              ; save vararg offset
        push    ix
        pop     hl              ; HL = IX (frame base)
        add     hl,de           ; HL = IX + DE
        ld      a,(hl)
        inc     hl
        ld      b,(hl)          ; B:A = low word bytes (A=low, B=high)
        inc     hl
        ld      c,(hl)
        inc     hl
        ld      e,(hl)          ; E:C = high word bytes (C=low, E=high)
        ld      l,a
        ld      h,b
        ld      (__pf32_l),hl
        ld      l,c
        ld      h,e
        ld      (__pf32_h),hl
        pop     de              ; restore vararg offset
        inc     de
        inc     de
        inc     de
        inc     de
        pop     bc              ; restore running char count
        ret

; pf_divu32_10: divide __pf32_l/__pf32_h by 10
; Output: __pf32_l/__pf32_h = quotient, A = remainder (0-9)
; Register-based: holds the 32-bit value in DE:HL and uses the same in-place
; shift-subtract trick as pf_div10 (quotient fills in at bit 0 as the dividend
; shifts out at bit 31).  Avoids the old 64-bit memory-resident shift loop.
pf_divu32_10:
        push    bc
        push    de
        push    hl
        ld      de,(__pf32_h)   ; DE = high word
        ld      hl,(__pf32_l)   ; HL = low word
        ld      bc,2000h        ; B = 32 (counter), C = 0 (remainder)
pf32d_loop:
        add     hl,hl           ; DE:HL <<= 1, bit31 -> carry
        rl      e
        rl      d
        ld      a,c
        adc     a,a             ; A = (rem<<1) | bit, range 0..19
        cp      10
        jr      c,pf32d_no_sub
        sub     10
        inc     l               ; set quotient bit 0 (clear after add hl,hl)
pf32d_no_sub:
        ld      c,a             ; save remainder
        djnz    pf32d_loop
        ld      (__pf32_l),hl
        ex      de,hl
        ld      (__pf32_h),hl   ; store quotient high word
        ld      a,c             ; A = remainder (0..9)
        pop     hl
        pop     de
        pop     bc
        ret

; pf_build_u32: convert __pf32_l/__pf32_h (unsigned 32-bit) to decimal text in
; pf_decbuf32, built once (high end downward).  Out: A = digit count,
; HL -> first digit (null-terminated at pf_decbuf32+10).  Preserves BC and DE.
; Destroys __pf32_l/__pf32_h (consumed as the dividend).
pf_build_u32:
        push    ix
        push    de
        ld      ix,pf_decbuf32+10
        ld      (ix+0),0        ; null terminator
pfbu32_1:
        dec     ix
        call    pf_divu32_10    ; A = remainder digit, __pf32 = quotient
        add     a,'0'
        ld      (ix+0),a
        ld      hl,(__pf32_h)
        ld      a,h
        or      l
        ld      hl,(__pf32_l)
        or      h
        or      l
        jr      nz,pfbu32_1
        push    ix
        pop     hl              ; HL -> first digit
        ld      de,pf_decbuf32+10
        ex      de,hl           ; DE -> first digit, HL = buffer end
        or      a
        sbc     hl,de           ; HL = digit count
        ld      a,l             ; A = digit count (<= 10)
        ex      de,hl           ; HL -> first digit
        pop     de
        pop     ix
        ret

; pf_print_u32: print __pf32_l/__pf32_h as unsigned decimal (no field width).
; Used by the %f float formatter for the integer part.
pf_print_u32:
        call    pf_build_u32    ; A = count, HL -> first digit
        call    pf_emstr
        ret

__pf32_l:       dw      0
__pf32_h:       dw      0


; ---- float-enabled printf (-ffloatio) ------------------------------
        public  _pffio
_pffio:
        ld      hl,pf_f                 ; install float handler (permanent - see
        ld      (pf_float_hook),hl      ; _pflng: -ffloatio is a whole-program
        jp      _printf                 ; flag, so every printf-family call in
                                         ; this build wants it active)

; pf_f is the %f handler installed via pf_float_hook when _pffio is active.
; It lives in the _pffio block so dccrtlstrip omits it for non-float builds.
; Uses pf_arg_dehl, pf_print_u32, __pf32_l/__pf32_h from the __pf32h block,
; and pf_prec/pf_emit_a from the _printf block.
pf_f:
        ; HL (fmt ptr) already pushed by the %f dispatch in pf_pct_done_width
        call    pf_arg_dehl     ; loads __pf32_l/__pf32_h with raw float bits, advances DE by 4
        push    de

        ; Field width support: the sign/integer-part/fraction pipeline below
        ; is tightly interleaved with emission (unlike %d/%x/%o, which build
        ; their digits into pf_decbuf first and pad afterward), so doing the
        ; same "know the length before padding" trick here would need a much
        ; larger restructuring. Instead, when a width was requested, redirect
        ; this whole conversion's output into a scratch buffer by reusing
        ; pf_emit_a's existing sprintf-style buffer-write mode (pf_sink/
        ; pf_bufptr) - the entire body below runs completely unchanged,
        ; unaware it is writing to pf_fwbuf instead of the real destination.
        ; pf_f_done then measures the buffered text, restores the real
        ; sink, and pads+replays it via the existing pf_pad_a/pf_emstr
        ; helpers. When no width was given, none of this runs at all, so
        ; the common case is exactly as before.
        ld      a,(pf_width)
        or      a
        jp      z,pf_f_nowidth
        ld      hl,(pf_sink)
        ld      (pf_fwsink),hl
        ld      hl,(pf_bufptr)
        ld      (pf_fwbptr),hl
        ld      hl,0ffffh
        ld      (pf_sink),hl
        ld      hl,pf_fwbuf
        ld      (pf_bufptr),hl
pf_f_nowidth:

        ld      hl,(__pf32_l)
        ld      (pf_fl),hl
        ld      hl,(__pf32_h)
        ld      (pf_fh),hl

        ; Sign and absolute value.
        bit     7,h
        jp      z,pf_f_absdone
        ld      a,'-'
        call    pf_emit_a
        ld      hl,(__pf32_h)
        res     7,h
        ld      (__pf32_h),hl
        ld      (pf_fh),hl
pf_f_absdone:
        ld      hl,(__pf32_l)
        ld      (pf_fl),hl

        ; Printed precision: default is 6 decimal places unless an explicit
        ; precision was given (even %.0f, which must honor 0 exactly - the
        ; previous check only tested pf_prec==0, indistinguishable from "no
        ; precision given at all", so an explicit ".0" always fell back to
        ; the default of 6 instead of printing no fractional digits).
        ld      a,(pf_haveprec)
        or      a
        jp      z,pf_f_prec_default
        ld      a,(pf_prec)
        jp      pf_f_prec_known
pf_f_prec_default:
        ld      a,6
pf_f_prec_known:
        ld      (pf_fcnt),a

        ; Round before splitting integer/fractional parts: add 0.5*10^-prec.
        cp      10
        jp      nc,pf_f_rounded     ; no table entry for larger precisions
        add     a,a                 ; offset = precision * 4
        add     a,a
        ld      e,a
        ld      d,0
        ld      hl,pf_rndtab
        add     hl,de
        ld      e,(hl)
        inc     hl
        ld      d,(hl)
        inc     hl
        ld      (pf_ftl),de
        ld      e,(hl)
        inc     hl
        ld      d,(hl)
        ld      (pf_fth),de

        ; Every float-arithmetic helper below (__faf/__fsf/__fmf/__ffi/__fif/
        ; __fful/__fulf) freely clobbers B and C as scratch - completely fine
        ; for their normal callers, but BC is also __pf_run's running output
        ; character count for the whole printf call, live across every
        ; pf_emit_a call in this routine. Left alone, each of these calls
        ; would silently corrupt that count (and thus a caller's snprintf/
        ; sprintf return value) every time %f rounds or builds a fractional
        ; digit. Each call below is wrapped in push bc/pop bc for exactly
        ; this reason - not to pass or receive a value, purely to protect the
        ; count across a callee that doesn't know it needs protecting.
        ld      hl,(pf_fl)
        ld      de,(pf_fh)
        push    bc
        push    de
        push    hl
        ld      hl,(pf_ftl)
        ld      de,(pf_fth)
        call    __faf
        pop     af              ; discard the 2 pushed operand pairs via AF, not BC
        pop     af
        pop     bc              ; restore the running count
        ld      (pf_fl),hl
        ld      (pf_fh),de
pf_f_rounded:

        ; Integer part = (unsigned long)abs(f).
        ld      hl,(pf_fl)
        ld      de,(pf_fh)
        push    bc
        call    __fful
        pop     bc

        ; Save integer part in pf_ftl/pf_fth; load __pf32_l/__pf32_h for pf_print_u32.
        ld      (__pf32_l),hl
        ld      (__pf32_h),de
        ld      (pf_ftl),hl
        ld      (pf_fth),de

        call    pf_print_u32

        ; C89: an explicit zero precision (%.0f) prints no decimal point at
        ; all, not just no fractional digits - pf_fcnt is the final chosen
        ; precision (set above), so skip the '.' when it's 0.
        ld      a,(pf_fcnt)
        or      a
        jp      z,pf_f_nodot
        ld      a,'.'
        call    pf_emit_a
pf_f_nodot:

        ; pf_print_u32 destroys __pf32_l/__pf32_h; restore integer part from pf_ftl/pf_fth.
        ld      hl,(pf_ftl)
        ld      de,(pf_fth)
        push    bc
        call    __fulf
        pop     bc
        ld      (pf_ftl),hl
        ld      (pf_fth),de
        ld      hl,(pf_fl)
        ld      de,(pf_fh)
        push    bc
        push    de
        push    hl
        ld      hl,(pf_ftl)
        ld      de,(pf_fth)
        call    __fsf
        pop     af              ; discard operands via AF, not BC - see __faf above
        pop     af
        pop     bc              ; restore the running count
        ld      (pf_fl),hl
        ld      (pf_fh),de

pf_f_digloop:
        ld      a,(pf_fcnt)
        or      a
        jp      z,pf_f_done

        ; frac *= 10.0f
        ld      hl,(pf_fl)
        ld      de,(pf_fh)
        push    bc
        push    de
        push    hl
        ld      hl,0
        ld      de,16672        ; 10.0f = 0x41200000
        call    __fmf
        pop     af              ; discard operands via AF, not BC - see __faf above
        pop     af
        pop     bc              ; restore the running count
        ld      (pf_fl),hl
        ld      (pf_fh),de

        ; digit = (int)frac
        push    bc
        call    __ffi
        pop     bc
        ld      (pf_fiw),hl
        ld      a,l
        add     a,'0'
        call    pf_emit_a

        ; frac -= (float)digit
        ld      hl,(pf_fiw)
        push    bc
        call    __fif
        pop     bc
        ld      (pf_ftl),hl
        ld      (pf_fth),de
        ld      hl,(pf_fl)
        ld      de,(pf_fh)
        push    bc
        push    de
        push    hl
        ld      hl,(pf_ftl)
        ld      de,(pf_fth)
        call    __fsf
        pop     af              ; discard operands via AF, not BC - see __faf above
        pop     af
        pop     bc              ; restore the running count
        ld      (pf_fl),hl
        ld      (pf_fh),de

        ld      a,(pf_fcnt)
        dec     a
        ld      (pf_fcnt),a
        jp      pf_f_digloop
pf_f_done:
        ld      a,(pf_width)
        or      a
        jp      z,pf_f_done_nowidth

        ; NUL-terminate the accumulated text (pf_bufptr still points into
        ; pf_fwbuf here) so pf_emstr can replay it below, and measure its
        ; length while pf_bufptr still reflects the scratch buffer.
        ld      hl,(pf_bufptr)
        ld      (hl),0
        ld      de,pf_fwbuf
        or      a
        sbc     hl,de           ; HL = length
        ld      a,l

        ; Restore the real sink/bufptr now that the length is captured.
        push    af
        ld      hl,(pf_fwsink)
        ld      (pf_sink),hl
        ld      hl,(pf_fwbptr)
        ld      (pf_bufptr),hl
        pop     af
        ld      (pf_digit),a    ; stash length - pf_digit is the same "content
                                  ; length for padding" scratch pf_x/pf_u/pf_o
                                  ; already use, and must survive the
                                  ; pf_emstr call below to be reused for the
                                  ; post-pad case.

        ld      a,(pf_left)
        or      a
        jr      nz,pf_f_w_left  ; left-justified: '0' flag is always ignored

        ; Right-justified: the '0' flag calls for zero-fill instead of
        ; space-fill - but the fill must land AFTER a leading '-', matching
        ; %05d's existing "-0042" (not "000-42") placement. The buffered
        ; text already has the sign as its first byte if negative, so emit
        ; that byte first when present, pad using the ORIGINAL total length
        ; (the sign counts toward the field width either way), then replay
        ; the rest of the buffer starting past the sign.
        ld      a,(pf_zero)
        or      a
        jr      z,pf_f_w_spad
        ld      a,(pf_fwbuf)
        cp      '-'
        jr      nz,pf_f_w_zpad_nosign
        ld      a,'-'
        call    pf_emit_a
        ld      a,(pf_digit)
        call    pf_zpad_a
        ld      hl,pf_fwbuf+1
        call    pf_emstr
        jr      pf_f_done_nowidth
pf_f_w_zpad_nosign:
        ld      a,(pf_digit)
        call    pf_zpad_a
        ld      hl,pf_fwbuf
        call    pf_emstr
        jr      pf_f_done_nowidth
pf_f_w_spad:
        ld      a,(pf_digit)
        call    pf_pad_a
        ld      hl,pf_fwbuf
        call    pf_emstr
        jr      pf_f_done_nowidth

pf_f_w_left:
        ld      hl,pf_fwbuf
        call    pf_emstr        ; '0' flag ignored: plain space post-pad only
        ld      a,(pf_digit)
        call    pf_pad_a
pf_f_done_nowidth:
        pop     de
        pop     hl
        jp      pf_loop

; Emit (pf_width - A) '0' characters, if positive. A is content length.
; Same structure/contract as pf_pad_a, used only by %f's zero-pad path.
pf_zpad_a:
        push    af
        ld      a,(pf_width)
        ld      e,a
        pop     af
        ld      d,a
        ld      a,e
        sub     d
        ret     c
        ret     z
        ld      d,a
pf_zpad_loop:
        ld      a,'0'
        call    pf_emit_a
        dec     d
        jr      nz,pf_zpad_loop
        ret

pf_fwsink:  dw 0
pf_fwbptr:  dw 0
pf_fwbuf:   ds 32

pf_fl:      dw 0
pf_fh:      dw 0
pf_ftl:     dw 0
pf_fth:     dw 0
pf_fiw:     dw 0
pf_fcnt:    db 0

pf_rndtab:
        dw      00000H,03F00H        ; 0.5e-0
        dw      0CCCDH,03D4CH        ; 0.5e-1
        dw      0D70AH,03BA3H        ; 0.5e-2
        dw      0126FH,03A03H        ; 0.5e-3
        dw      0B717H,03851H        ; 0.5e-4
        dw      0C5ACH,036A7H        ; 0.5e-5
        dw      037BDH,03506H        ; 0.5e-6
        dw      0BF95H,03356H        ; 0.5e-7
        dw      0CC77H,031ABH        ; 0.5e-8
        dw      0705FH,03009H        ; 0.5e-9

; ---- long-enabled printf (-flongio) -----------------------------------------
; _pflng and friends are drop-ins for the printf family that pre-install the
; 32-bit integer handler via pf_long_hook before calling __pf_run.
; dccrtlstrip omits this block (and all 32-bit long helpers below) for programs
; that never use %ld / %lu / %lx / %ls.
; The hook is installed permanently on first call so that all subsequent
; printf-family calls (fprintf, sprintf, vfprintf, etc.) also get long support.
        public  _pflng
        public  _splng
        public  _fplng
        public  _vplng
        public  _vslng
        public  _vflng
        public  _snlng
        public  _vnlng
_pflng:
        ld      hl,pf_lng               ; install long handler (permanent)
        ld      (pf_long_hook),hl
        jp      _printf

; pf_lng: the %l handler installed via pf_long_hook when _pflng (or _pflio) is
; active.  Lives in the _pflng block so dccrtlstrip omits it for non-long builds.
; Uses __pf32_l/__pf32_h, pf_arg_dehl, pf_build_u32, pf_divu32_10 from __pf32h.
pf_lng:
        pop     hl                      ; restore fmt ptr pushed by dispatch
        ld      a,(hl)
        inc     hl
        cp      'd'
        jp      z,pf_ld
        cp      'u'
        jp      z,pf_lu
        cp      'x'
        jp      z,pf_lxl
        cp      'X'
        jp      z,pf_lxu
        cp      's'
        jp      z,pf_ls
        call    pf_emit_a
        jp      pf_loop

pf_ls:
        ; wchar_t * string.  DCC wchar_t is 16-bit for L"..." literals.
        ; Print the low byte as ASCII and ignore the high byte.
        push    hl
        call    pf_arg_hl
        push    de
        push    hl
        call    pf_wstrlen_hl      ; A = wide string length, HL preserved by stack
        call    pf_pad_a
        pop     hl
pf_ls_loop:
        ld      a,(hl)
        inc     hl
        ld      e,a                ; save low byte
        ld      a,(hl)
        inc     hl                 ; skip high byte
        or      e
        jr      z,pf_ls_done
        ld      a,e
        call    pf_emit_a
        jr      pf_ls_loop
pf_ls_done:
        pop     de
        pop     hl
        jp      pf_loop

pf_wstrlen_hl:
        push    hl
        ld      c,0
pf_wstrlen_loop:
        ld      a,(hl)
        inc     hl
        ld      e,a
        ld      a,(hl)
        inc     hl
        or      e
        jr      z,pf_wstrlen_done
        inc     c
        jr      pf_wstrlen_loop
pf_wstrlen_done:
        ld      a,c
        pop     hl
        ret

pf_ld:
        ; Signed 32-bit decimal
        push    hl
        call    pf_arg_dehl     ; loads __pf32_l/__pf32_h, advances DE by 4
        push    de
        ld      hl,(__pf32_h)
        bit     7,h
        jr      z,pf_ld_pos
        ; Negative: negate, build digits once, then print with '-'
        call    pf_neg32
        call    pf_build_u32    ; A = count, HL -> first digit
        ld      (pf_digit),a
        call    pf_zero_prec_blank
        push    hl
        ld      a,1             ; sign length = 1 ('-')
        call    pf_zsetup       ; honour the '0' zero-pad flag
        call    pf_efflen       ; A = max(digits, precision)
        inc     a               ; +1 for '-'
        call    pf_iprepad
        ld      a,'-'
        call    pf_emit_a
        jr      pf_ld_tail
pf_ld_pos:
        call    pf_build_u32    ; A = count, HL -> first digit
        ld      (pf_digit),a
        call    pf_zero_prec_blank
        push    hl
        xor     a               ; sign length = 0
        call    pf_zsetup
        call    pf_efflen       ; A = max(digits, precision)
        call    pf_iprepad
pf_ld_tail:
        pop     hl
        call    pf_zfd          ; precision/zero-fill then emit digits
        call    pf_ipostpad
        pop     de
        pop     hl
        jp      pf_loop

pf_lu:
        ; Unsigned 32-bit decimal
        push    hl
        call    pf_arg_dehl
        push    de
        call    pf_build_u32    ; A = count, HL -> first digit
        ld      (pf_digit),a
        call    pf_zero_prec_blank
        push    hl
        xor     a               ; unsigned: no sign
        call    pf_zsetup
        call    pf_efflen       ; A = max(digits, precision)
        call    pf_iprepad
        pop     hl
        call    pf_zfd
        call    pf_ipostpad
        pop     de
        pop     hl
        jp      pf_loop

pf_lxu:
        ld      a,1                     ; %lX -> uppercase A-F
        ld      (pf_hexup),a
        jr      pf_lx
pf_lxl:
        xor     a                       ; %lx -> lowercase a-f
        ld      (pf_hexup),a
pf_lx:
        ; Unsigned 32-bit hex (%lx/%lX): minimum-width hex digits.
        ; Width still works normally, so %08lx emits eight digits.
        push    hl
        call    pf_arg_dehl     ; loads __pf32_l/__pf32_h, advances DE by 4
        push    de
        call    pf_build_hex32  ; A = digit count, HL -> first hex digit
        ld      (pf_digit),a
        call    pf_zero_prec_blank
        push    hl
        xor     a               ; unsigned: no sign
        call    pf_zsetup       ; honour the '0' zero-pad flag
        call    pf_efflen       ; A = max(digits, precision)
        call    pf_iprepad      ; emit leading spaces unless left-justified
        pop     hl
        call    pf_zfd          ; precision/zero-fill then emit digits
        call    pf_ipostpad     ; emit trailing spaces when left-justified
        pop     de
        pop     hl
        jp      pf_loop

; pf_neg32: negate __pf32_l/__pf32_h (two's complement)
pf_neg32:
        ld      de,(__pf32_l)
        ld      hl,0
        or      a
        sbc     hl,de
        ld      (__pf32_l),hl
        ld      de,(__pf32_h)
        ld      hl,0
        sbc     hl,de
        ld      (__pf32_h),hl
        ret

; pf_build_hex32: convert __pf32_h:__pf32_l (unsigned 32-bit) to minimal hex text.
; Out: A = digit count, HL -> first digit in pf_decbuf32, null-terminated.
; Uses pf_hexup/pf_hex_store_nz/pf_hforce from the _printf block.
pf_build_hex32:
        push    ix
        push    de
        ld      ix,pf_decbuf32
        ld      d,0             ; D = digit count / nonzero seen

        ld      hl,(__pf32_h)
        ld      a,h             ; high word, high byte, high nibble
        rrca
        rrca
        rrca
        rrca
        call    pf_hex_store_nz

        ld      a,h             ; high word, high byte, low nibble
        call    pf_hex_store_nz

        ld      a,l             ; high word, low byte, high nibble
        rrca
        rrca
        rrca
        rrca
        call    pf_hex_store_nz

        ld      a,l             ; high word, low byte, low nibble
        call    pf_hex_store_nz

        ld      hl,(__pf32_l)
        ld      a,h             ; low word, high byte, high nibble
        rrca
        rrca
        rrca
        rrca
        call    pf_hex_store_nz

        ld      a,h             ; low word, high byte, low nibble
        call    pf_hex_store_nz

        ld      a,l             ; low word, low byte, high nibble
        rrca
        rrca
        rrca
        rrca
        call    pf_hex_store_nz

        ld      a,l             ; low word, low byte, low nibble; always emit one digit
        call    pf_hforce

        ld      (ix+0),0
        ld      a,d             ; return digit count
        ld      hl,pf_decbuf32
        pop     de
        pop     ix
        ret

; Thin long-aware wrappers for the rest of the printf family.  Each installs
; pf_long_hook permanently, then tail-jumps to the corresponding original entry
; point.  Because these are JP (not CALL), the caller's stack frame is unchanged:
; IX+N offsets inside _sprintf/_fprintf/etc. are correct.
_splng:
        ld      hl,pf_lng
        ld      (pf_long_hook),hl
        jp      _sprintf

_fplng:
        ld      hl,pf_lng
        ld      (pf_long_hook),hl
        jp      _fprintf

_vplng:
        ld      hl,pf_lng
        ld      (pf_long_hook),hl
        jp      _vprintf

_vslng:
        ld      hl,pf_lng
        ld      (pf_long_hook),hl
        jp      _vsprintf

_vflng:
        ld      hl,pf_lng
        ld      (pf_long_hook),hl
        jp      _vfprintf

_snlng:
        ld      hl,pf_lng
        ld      (pf_long_hook),hl
        jp      _snprintf

_vnlng:
        ld      hl,pf_lng
        ld      (pf_long_hook),hl
        jp      _vsnprintf

; ---- long+float printf (-ffloatio -flongio) ----------------------------------
; _pflio is a drop-in for printf that pre-installs both the float handler and the
; 32-bit integer handler before calling __pf_run.  The ld hl,pf_f and ld hl,pf_lng
; references inside _pflio cause dccrtlstrip to keep both _pffio and _pflng.
        public  _pflio
_pflio:
        ld      hl,pf_f                 ; install float handler (permanent)
        ld      (pf_float_hook),hl
        ld      hl,pf_lng               ; install long handler (permanent)
        ld      (pf_long_hook),hl
        jp      _printf

; Thin float-aware wrappers for the rest of the printf family (-ffloatio),
; mirroring the *lng wrappers above: install pf_float_hook permanently, then
; tail-jump to the corresponding original entry point. Before these existed,
; -ffloatio only ever remapped plain printf() - sprintf/fprintf/vprintf/
; vsprintf/vfprintf always used their float-blind base entry, so %f silently
; printed a literal "f" when formatted through anything but printf().
        public  _spfio
        public  _fpfio
        public  _vpfio
        public  _vsfio
        public  _vffio
        public  _snfio
        public  _vnfio
_spfio:
        ld      hl,pf_f
        ld      (pf_float_hook),hl
        jp      _sprintf

_fpfio:
        ld      hl,pf_f
        ld      (pf_float_hook),hl
        jp      _fprintf

_vpfio:
        ld      hl,pf_f
        ld      (pf_float_hook),hl
        jp      _vprintf

_vsfio:
        ld      hl,pf_f
        ld      (pf_float_hook),hl
        jp      _vsprintf

_vffio:
        ld      hl,pf_f
        ld      (pf_float_hook),hl
        jp      _vfprintf

_snfio:
        ld      hl,pf_f
        ld      (pf_float_hook),hl
        jp      _snprintf

_vnfio:
        ld      hl,pf_f
        ld      (pf_float_hook),hl
        jp      _vsnprintf

; Thin float+long wrappers (-ffloatio -flongio together) for the rest of the
; printf family, mirroring _pflio above.
        public  _splio
        public  _fplio
        public  _vplio
        public  _vslio
        public  _vflio
        public  _snlio
        public  _vnlio
_splio:
        ld      hl,pf_f
        ld      (pf_float_hook),hl
        ld      hl,pf_lng
        ld      (pf_long_hook),hl
        jp      _sprintf

_fplio:
        ld      hl,pf_f
        ld      (pf_float_hook),hl
        ld      hl,pf_lng
        ld      (pf_long_hook),hl
        jp      _fprintf

_vplio:
        ld      hl,pf_f
        ld      (pf_float_hook),hl
        ld      hl,pf_lng
        ld      (pf_long_hook),hl
        jp      _vprintf

_vslio:
        ld      hl,pf_f
        ld      (pf_float_hook),hl
        ld      hl,pf_lng
        ld      (pf_long_hook),hl
        jp      _vsprintf

_vflio:
        ld      hl,pf_f
        ld      (pf_float_hook),hl
        ld      hl,pf_lng
        ld      (pf_long_hook),hl
        jp      _vfprintf

_snlio:
        ld      hl,pf_f
        ld      (pf_float_hook),hl
        ld      hl,pf_lng
        ld      (pf_long_hook),hl
        jp      _snprintf

_vnlio:
        ld      hl,pf_f
        ld      (pf_float_hook),hl
        ld      hl,pf_lng
        ld      (pf_long_hook),hl
        jp      _vsnprintf

; __pfehx / __pfeoc: "ensure hex/octal support installed" helpers, called
; by dcc-generated code (via emit_runtime_call, same mechanism as the other
; fastcall RTL helpers) once per printf-family call site whose format string
; is found (or conservatively assumed) to use %x/%X or %o. Unlike the float/
; long wrappers above, %x/%X/%o support doesn't need a variant per printf-
; family function: any call site needing it calls the ensure-helper first,
; then the ordinary (already hook-resolved for float/long) entry point -
; installing the hook is independent of, and composes freely with, whichever
; of the float/long variants that same call also resolved to. Referencing
; pf_xu/pf_xl/pf_o by name here is what causes dccrtlstrip to keep those
; blocks (and pf_hxb16/pf_ocb16 transitively) only when actually
; needed.
        public  __pfehx
__pfehx:
        ld      hl,pf_xl
        ld      (pf_hexl_hook),hl
        ld      hl,pf_xu
        ld      (pf_hexu_hook),hl
        ret

        public  __pfeoc
__pfeoc:
        ld      hl,pf_o
        ld      (pf_oct_hook),hl
        ret

        public  _exit
_exit:
        pop     bc                      ; return address
        pop     hl                      ; exit code
        push    hl                      ; restore caller-cleanup argument
        push    bc                      ; restore return address
        push    hl                      ; save exit code across hooks + flush
        ; Call atexit handlers (LIFO) if any were registered.
        ld      hl,(__ae_hook)
        ld      a,h
        or      l
        call    nz,__ae_hook_call
        ; Call tmpfile cleanup hook if tmpfile() was used this session.
        ; __tmpf_hook is 0 unless _tmpfile set it; the check adds ~8 bytes
        ; to _exit and zero bytes to programs that never call tmpfile.
        ld      hl,(__tmpf_hook)
        ld      a,h
        or      l
        call    nz,__tmpf_dispatch      ; tail-calls __tmpf_cleanup via HL
        call    __cflush                ; flush any buffered console output
        pop     hl                      ; restore exit code
        call    __cpm_set_retcode
        jp      0000h
__ae_hook:
        dw      0
__ae_hook_call:
        ld      hl,(__ae_hook)
        jp      (hl)
__tmpf_hook:
        dw      0
__tmpf_dispatch:
        ld      hl,(__tmpf_hook)
        jp      (hl)

; ============================================================
; atexit -- register a function to call at program exit (C89 7.10.4.2)
; ============================================================
ATEXIT_MAX      equ     32

        public  _atexit
; int atexit(void (*func)(void))
; Returns 0 on success, 1 if the table is full (ATEXIT_MAX registrations).
_atexit:
        pop     bc                      ; return address
        pop     de                      ; function pointer
        push    de                      ; restore caller-cleanup argument
        push    bc                      ; restore return address

        ; Point the _exit hook at our dispatcher (idempotent on repeat calls).
        ld      hl,__ae_dispatch
        ld      (__ae_hook),hl

        ; Reject if table full.
        ld      hl,(__ae_cnt)
        ld      a,l
        cp      ATEXIT_MAX
        jr      nc,ae_reg_fail

        ; Store func ptr at __ae_tbl[cnt * 2].
        ld      l,a
        ld      h,0
        add     hl,hl           ; hl = cnt * 2
        ld      bc,__ae_tbl
        add     hl,bc
        ld      (hl),e
        inc     hl
        ld      (hl),d

        ; Increment count.
        ld      hl,(__ae_cnt)
        inc     hl
        ld      (__ae_cnt),hl

        ld      hl,0
        ret

ae_reg_fail:
        ld      hl,1
        ret

; Called from _exit via __ae_hook_call trampoline.
; Iterates __ae_tbl in LIFO order, calling each registered function.
__ae_dispatch:
ae_disp_lp:
        ld      hl,(__ae_cnt)
        ld      a,h
        or      l
        ret     z               ; all handlers called
        dec     hl
        ld      (__ae_cnt),hl   ; consume this slot
        add     hl,hl           ; hl = cnt * 2
        ld      de,__ae_tbl
        add     hl,de           ; hl = &__ae_tbl[cnt]
        ld      e,(hl)
        inc     hl
        ld      d,(hl)          ; DE = func ptr
        ex      de,hl
        call    __ae_jmp        ; call func; func's ret returns to ae_disp_lp
        jr      ae_disp_lp

__ae_jmp:
        jp      (hl)            ; func's ret pops the call __ae_jmp return addr

__ae_cnt:       dw      0
__ae_tbl:       ds      ATEXIT_MAX * 2

; ============================================================
; _abort  (C89 7.10.4.1) -- abnormal program termination
; Does NOT call atexit handlers, close temp files, or set a
; return code.  Flushes console output so any prior prints
; are visible, then does a CP/M warm boot (jp 0000h).
; ============================================================
        public  _abort
_abort:
        call    __cflush
        jp      0000h

; ============================================================
; __asfl -- assertion failure helper called by the assert() macro.
; void __asfl(const char *msg)
; Prints "Assertion failed: <msg>\n" to the console and aborts.
; Separate block so it is only linked when assert.h is used with
; assertions enabled (NDEBUG not defined).
; ============================================================
        public  __asfl
__asfl:
        pop     hl              ; return address
        pop     de              ; caller-supplied message pointer
        push    de              ; restore caller-cleanup argument
        push    hl              ; restore return address
        ld      (__asfl_msg),de

        ; Print "Assertion failed: " prefix.
        ld      hl,__asfl_pfx
afpfx:
        ld      a,(hl)
        or      a
        jr      z,afmsg
        ld      e,a
        call    __conout
        inc     hl
        jr      afpfx
afmsg:
        ; Print the caller-supplied message string.
        ld      hl,(__asfl_msg)
afstr:
        ld      a,(hl)
        or      a
        jr      z,afnl
        ld      e,a
        call    __conout
        inc     hl
        jr      afstr
afnl:
        ld      e,0ah           ; newline (__conout adds CR before LF)
        call    __conout
        call    __cflush
        jp      0000h           ; abort: warm boot, no atexit handlers

__asfl_msg:
        dw      0
__asfl_pfx:
        db      'Assertion failed: ',0

; ------------------------------------------------------------
; CP/M 3 program return code support.
;
; CP/M 3 / CP/M Plus BDOS function 108 (P_CODE):
;     C  = 6Ch
;     DE = program return code to set
;     DE = FFFFh means get current code, so avoid using FFFFh as a
;          set value.  For exit(-1), use 00FFh, matching the common
;          8-bit process-status convention.
;
; CP/M 2.2 safely ignores unsupported BDOS functions, and emulators can
; intercept this call directly, so no version check is needed.
; ------------------------------------------------------------
        public  __cpm_set_retcode
__cpm_set_retcode:
        ; input: HL = C int status / main return value

        ; If status is FFFFh, remap to 00FFh.  DE=FFFFh is the
        ; P_CODE "get" sentinel, not a settable return code.
        ld      a,h
        and     l
        inc     a
        jr      nz,csr_not_minus1
        ld      hl,00ffh
csr_not_minus1:

        ex      de,hl           ; DE = status
        ld      c,6ch           ; P_CODE: get/set program return code
        call    5
        ret

; ------------------------------------------------------------
; __stchk - lightweight stack-overflow guard (dcc -fstack-check).
;
; dcc emits "call __stchk" in every function prologue (after the frame and
; locals are allocated) when built with -fstack-check.  It compares the live
; SP against __hlimit (the heap ceiling = initial SP minus the reserved
; stack).  While SP stays at or above __hlimit the C stack is within its
; reserve; if SP drops below it the stack has grown into the heap region, so
; instead of silently corrupting memory it prints a diagnostic and exits to
; CP/M with return code 0FFh.
;
; Clobbers AF/DE/HL on the normal path.  This is fine because dcc emits it in
; the generated C function prologue before the body can depend on registers.
; Own public block so dccrtlstrip drops it from programs not built with
; -fstack-check.
; ------------------------------------------------------------
        public  __stchk
__stchk:
        ld      hl,0
        add     hl,sp           ; HL = SP after CALL's return-address push
        ld      de,(__hlimit)
        or      a
        sbc     hl,de           ; carry set iff SP < __hlimit
        jr      c,stchk_over
        ret
stchk_over:
        ; HL = SP - __hlimit (negative). Negate to get overflow = __hlimit - SP.
        ld      a,l
        cpl
        ld      l,a
        ld      a,h
        cpl
        ld      h,a
        inc     hl              ; HL = overflow bytes (positive)
        call    __cflush        ; preserves all regs except F
        ld      de,stchk_msg
        ld      c,9
        call    5               ; print prefix through "0x"
        ld      a,h
        call    stchk_pb        ; high byte of overflow
        ld      a,l
        call    stchk_pb        ; low byte of overflow
        ld      de,stchk_sep
        ld      c,9
        call    5               ; print " limit 0x"
        ld      hl,__stack_size ; configured limit (immediate, not a memory ref)
        ld      a,h
        call    stchk_pb
        ld      a,l
        call    stchk_pb
        ld      de,stchk_end
        ld      c,9
        call    5
        ld      hl,00ffh
        call    __cpm_set_retcode
        jp      0000h
stchk_pb:                       ; print byte in A as two uppercase hex digits
        push    af
        rrca
        rrca
        rrca
        rrca                    ; high nibble -> bits 3:0
        call    stchk_pn
        pop     af              ; restore original byte; fall through for low nibble
stchk_pn:                       ; print low nibble of A as one hex digit
        and     0fh
        add     a,'0'
        cp      '9'+1
        jr      c,stchk_pn1
        add     a,7             ; A-F
stchk_pn1:
        ld      e,a
        ld      c,2
        call    5
        ret
stchk_msg:
        db      0dh,0ah,'?stack overflow: exceeded by 0x','$'
stchk_sep:
        db      ' limit 0x','$'
stchk_end:
        db      0dh,0ah,'$'

        public  _atoi
_atoi:
        ; Leaf parser: fetch nptr without an IX frame and restore the
        ; caller-cleanup stack before parsing.
        pop     bc                      ; return address
        pop     hl                      ; nptr
        push    hl
        push    bc
        ld      de,0
        ld      b,0
at_ws:
        ld      a,(hl)
        cp      ' '
        jr      z,at_ws_inc
        cp      9
        jr      nz,at_sign
at_ws_inc:
        inc     hl
        jr      at_ws
at_sign:
        cp      '-'
        jr      nz,at_plus
        ld      b,1
        inc     hl
        jr      at_digits
at_plus:
        cp      '+'             ; C89 atoi == (int)strtol(s,0,10): accept '+'
        jr      nz,at_digits
        inc     hl
at_digits:
        ld      a,(hl)
        cp      '0'
        jr      c,at_done_abs
        cp      '9'+1
        jr      nc,at_done_abs
        sub     '0'             ; A = digit value
        push    hl              ; save string pointer
        ld      h,d
        ld      l,e             ; HL = accumulator
        add     hl,hl           ; x2
        ld      d,h
        ld      e,l             ; DE = x2
        add     hl,hl           ; x4
        add     hl,hl           ; x8
        add     hl,de           ; x8 + x2 = acc*10
        ld      e,a
        ld      d,0             ; DE = digit
        add     hl,de           ; HL = acc*10 + digit
        ex      de,hl           ; DE = new accumulator
        pop     hl              ; restore string pointer
        inc     hl
        jr      at_digits
at_done_abs:
        ex      de,hl
        ld      a,b
        or      a
        jr      z,at_done
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
at_done:
        ret

        public  _atol
; long atol(const char *nptr)
; Like atoi but builds a 32-bit accumulator.  Skips leading spaces/tabs,
; accepts an optional '+'/'-' sign, then consumes decimal digits.  Overflow
; wraps modulo 2^32 (same defined-behaviour stance as atoi's 2^16 wrap).
; Returns the signed long in DE:HL (DE = high word).
_atol:
        ; The implementation already uses private scratch state, so the IX
        ; frame served only to fetch nptr.
        pop     bc                      ; return address
        pop     hl                      ; nptr
        push    hl
        push    bc
        ld      (__atl_p),hl            ; string pointer
        ld      hl,0
        ld      (__atl_acc),hl
        ld      (__atl_acc+2),hl        ; acc = 0
        xor     a
        ld      (__atl_neg),a
        ld      hl,(__atl_p)
atl_ws:
        ld      a,(hl)
        cp      ' '
        jr      z,atl_ws_i
        cp      9
        jr      nz,atl_sign
atl_ws_i:
        inc     hl
        jr      atl_ws
atl_sign:
        cp      '-'
        jr      nz,atl_plus
        ld      a,1
        ld      (__atl_neg),a
        inc     hl
        jr      atl_pset
atl_plus:
        cp      '+'
        jr      nz,atl_pset
        inc     hl
atl_pset:
        ld      (__atl_p),hl
atl_dig:
        ld      hl,(__atl_p)
        ld      a,(hl)
        cp      '0'
        jr      c,atl_fin
        cp      '9'+1
        jr      nc,atl_fin
        sub     '0'
        ld      (__atl_d),a
        inc     hl
        ld      (__atl_p),hl
        ; acc = acc*10 + digit, computed as acc*8 + acc*2 + digit
        ld      hl,(__atl_acc)
        ld      de,(__atl_acc+2)        ; DE:HL = acc
        add     hl,hl
        rl      e
        rl      d                       ; DE:HL = acc*2
        ld      (__atl_x2),hl
        ld      a,e
        ld      (__atl_x2+2),a
        ld      a,d
        ld      (__atl_x2+3),a          ; save acc*2
        add     hl,hl
        rl      e
        rl      d                       ; acc*4
        add     hl,hl
        rl      e
        rl      d                       ; DE:HL = acc*8
        ld      bc,(__atl_x2)
        add     hl,bc
        ex      de,hl
        ld      bc,(__atl_x2+2)
        adc     hl,bc
        ex      de,hl                   ; DE:HL = acc*10
        ld      a,(__atl_d)
        ld      c,a
        ld      b,0
        add     hl,bc
        jr      nc,atl_nc
        inc     de
atl_nc:
        ld      (__atl_acc),hl
        ld      (__atl_acc+2),de
        jr      atl_dig
atl_fin:
        ld      hl,(__atl_acc)
        ld      de,(__atl_acc+2)        ; DE:HL = acc
        ld      a,(__atl_neg)
        or      a
        jr      z,atl_done
        ld      a,l
        cpl
        ld      l,a
        ld      a,h
        cpl
        ld      h,a
        ld      a,e
        cpl
        ld      e,a
        ld      a,d
        cpl
        ld      d,a
        inc     hl
        ld      a,h
        or      l
        jr      nz,atl_done
        inc     de
atl_done:
        ret
__atl_p:        dw      0
__atl_acc:      ds      4
__atl_x2:       ds      4
__atl_neg:      db      0
__atl_d:        db      0

        public  _atof
; float atof(const char *nptr)
; Parses a decimal floating-point string and returns an IEEE 754
; single-precision float in DE:HL (DE=high word, HL=low word).
; Accepts optional leading whitespace, optional +/- sign, decimal
; digits, optional decimal point, and optional e/E signed exponent.
; Also accepts nan, inf, and infinity (case-insensitive).  Overflow
; returns signed infinity; underflow returns signed zero.
; Note: standard C89 atof returns double; this returns float because
; dcc has no double type.
_atof:
        ; All parser state is already private static storage; avoid an IX
        ; frame that was used only to load nptr.
        pop     bc                      ; return address
        pop     hl                      ; nptr
        push    hl
        push    bc
        ld      (__atf_p),hl
        ld      (__atf_orig),hl
        ld      hl,0
        ld      (__atf_mant),hl
        ld      (__atf_mant+2),hl       ; mant = 0.0f
        ld      (__atf_frac),hl         ; fractional digit count = 0
        ld      (__atf_expo),hl         ; explicit exponent = 0
        ld      (__atf_adj),hl          ; skipped integer digit exponent adj = 0
        ld      (__atf_esav),hl         ; no exponent marker yet
        xor     a
        ld      (__atf_neg),a
        ld      (__atf_dp),a            ; seen decimal point = 0
        ld      (__atf_eneg),a
        ld      (__atf_edig),a
        ld      (__atf_sd),a            ; saw a mantissa digit = 0
        ld      (__atf_ndig),a          ; kept significant digits = 0
        ld      hl,(__atf_p)
atf_ws:
        ld      a,(hl)
        cp      ' '
        jr      z,atf_wsi
        cp      9                       ; C whitespace: \t..\r
        jr      c,atf_sign
        cp      14
        jr      nc,atf_sign
atf_wsi:
        inc     hl
        jr      atf_ws
atf_sign:
        cp      '-'
        jr      nz,atf_spl
        ld      a,1
        ld      (__atf_neg),a
        inc     hl
        jr      atf_psv
atf_spl:
        cp      '+'
        jr      nz,atf_psv
        inc     hl
atf_psv:
        ld      (__atf_p),hl
        ; C99 spellings are useful on a single-precision target too.
        ld      a,(hl)
        and     0dfh
        cp      'N'
        jr      nz,atf_chk_inf
        inc     hl
        ld      a,(hl)
        and     0dfh
        cp      'A'
        jr      nz,atf_dlp
        inc     hl
        ld      a,(hl)
        and     0dfh
        cp      'N'
        jr      nz,atf_dlp
        inc     hl
        ld      (__atf_p),hl
        ld      de,07fc0h              ; quiet NaN, 0x7fc00000
        ld      hl,0
        jp      atf_apply_sign
atf_chk_inf:
        ld      hl,(__atf_p)
        ld      a,(hl)
        and     0dfh
        cp      'I'
        jr      nz,atf_dlp
        inc     hl
        ld      a,(hl)
        and     0dfh
        cp      'N'
        jr      nz,atf_dlp
        inc     hl
        ld      a,(hl)
        and     0dfh
        cp      'F'
        jr      nz,atf_dlp
        inc     hl
        ld      (__atf_p),hl           ; consume at least "inf"
        ld      a,(hl)
        and     0dfh
        cp      'I'
        jp      nz,atf_make_inf
        inc     hl
        ld      a,(hl)
        and     0dfh
        cp      'N'
        jp      nz,atf_make_inf
        inc     hl
        ld      a,(hl)
        and     0dfh
        cp      'I'
        jp      nz,atf_make_inf
        inc     hl
        ld      a,(hl)
        and     0dfh
        cp      'T'
        jp      nz,atf_make_inf
        inc     hl
        ld      a,(hl)
        and     0dfh
        cp      'Y'
        jp      nz,atf_make_inf
        inc     hl
        ld      (__atf_p),hl           ; full "infinity" consumed
        jp      atf_make_inf
        ; main digit loop: accumulates integer and fractional digits
atf_dlp:
        ld      hl,(__atf_p)
        ld      a,(hl)
        cp      '.'
        jr      nz,atf_nodp
        ld      a,(__atf_dp)
        or      a
        jp      nz,atf_mant_done        ; second '.' ends parse
        ld      a,1
        ld      (__atf_dp),a
        inc     hl
        ld      (__atf_p),hl
        jp      atf_dlp
atf_nodp:
        cp      '0'
        jp      c,atf_mant_done
        cp      '9'+1
        jp      nc,atf_mant_done
        sub     '0'
        ld      (__atf_d),a
        ld      a,1
        ld      (__atf_sd),a            ; saw at least one mantissa digit
        inc     hl
        ld      (__atf_p),hl
        ; Keep at most 38 significant decimal digits so the intermediate
        ; float mantissa cannot overflow before exponent scaling.  Skipped
        ; integer digits are folded into an exponent adjustment; skipped
        ; fractional digits are simply discarded precision.
        ld      a,(__atf_ndig)
        or      a
        jr      nz,atf_sig_digit
        ld      a,(__atf_d)
        or      a
        jr      z,atf_keep_digit        ; leading zero: keep but don't count
atf_sig_digit:
        ld      a,(__atf_ndig)
        cp      38
        jr      c,atf_count_digit
        ld      a,(__atf_dp)
        or      a
        jp      nz,atf_dlp              ; extra fractional digit: drop it
        ld      hl,(__atf_adj)          ; extra integer digit: value *= 10
        inc     hl
        ld      (__atf_adj),hl
        jp      atf_dlp
atf_count_digit:
        inc     a
        ld      (__atf_ndig),a
atf_keep_digit:
        ld      a,(__atf_dp)
        or      a
        jr      z,atf_nfc
        ld      hl,(__atf_frac)
        inc     hl
        ld      (__atf_frac),hl
atf_nfc:
        ; mant = mant * 10.0f: push left=10.0f, right=mant
        ; (fmul is commutative; 10.0f: DE=0x4120, HL=0x0000)
        ld      de,04120h
        ld      hl,0
        push    de
        push    hl
        ld      hl,(__atf_mant)
        ld      de,(__atf_mant+2)
        call    __fmf
        pop     bc
        pop     bc
        ld      (__atf_mant),hl
        ld      (__atf_mant+2),de
        ; mant += (float)digit  via __fif(HL=digit) -> DE:HL
        ld      a,(__atf_d)
        ld      l,a
        ld      h,0
        call    __fif
        ; fadd is commutative: push digit then mant (order doesn't matter)
        push    de
        push    hl
        ld      hl,(__atf_mant)
        ld      de,(__atf_mant+2)
        call    __faf
        pop     bc
        pop     bc
        ld      (__atf_mant),hl
        ld      (__atf_mant+2),de
        jp      atf_dlp
atf_mant_done:
        ; No mantissa digit means no valid numeric token (e.g. "", ".",
        ; "e5", ".e5", "+.").  C requires strtod to leave endptr at the
        ; original nptr and return 0 in that case, so restore it here rather
        ; than consuming a stray '.'/exponent.
        ld      b,a                     ; preserve current char
        ld      a,(__atf_sd)
        or      a
        jr      nz,atf_md_go
        ld      hl,(__atf_orig)
        ld      (__atf_p),hl            ; endptr = original nptr
        ld      hl,0
        ld      de,0
        jp      atf_ret
atf_md_go:
        ld      a,b                     ; restore current char
        ; a = current char; check for e/E exponent
        cp      'e'
        jr      z,atf_expd
        cp      'E'
        jr      nz,atf_net
atf_expd:
        ld      hl,(__atf_p)
        ld      (__atf_esav),hl         ; restore here if no exponent digits
        inc     hl                      ; skip 'e'/'E'
        ld      a,(hl)
        cp      '-'
        jr      nz,atf_epl
        ld      a,1
        ld      (__atf_eneg),a
        inc     hl
        jr      atf_epv
atf_epl:
        cp      '+'
        jr      nz,atf_epv
        inc     hl
atf_epv:
        ld      (__atf_p),hl
atf_elp:
        ld      hl,(__atf_p)
        ld      a,(hl)
        cp      '0'
        jr      c,atf_net
        cp      '9'+1
        jr      nc,atf_net
        sub     '0'
        ld      c,a
        ld      a,1
        ld      (__atf_edig),a
        ld      hl,(__atf_expo)
        ld      de,400                  ; bound parse work for huge exponents
        or      a
        sbc     hl,de
        jr      nc,atf_esat
        ld      hl,(__atf_expo)
        add     hl,hl
        ld      d,h
        ld      e,l                     ; DE = expo*2
        add     hl,hl
        add     hl,hl                   ; HL = expo*8
        add     hl,de                   ; HL = expo*10
        ld      e,c
        ld      d,0
        add     hl,de                   ; HL = expo*10 + digit
        ld      de,400
        or      a
        sbc     hl,de
        jr      c,atf_estore_orig
atf_esat:
        ld      hl,400
        jr      atf_estore
atf_estore_orig:
        add     hl,de                   ; undo compare: restore computed expo
atf_estore:
        ld      (__atf_expo),hl
        ld      hl,(__atf_p)
        inc     hl
        ld      (__atf_p),hl
        jr      atf_elp
atf_net:
        ld      a,(__atf_edig)
        or      a
        jr      nz,atf_net_go
        ld      hl,(__atf_esav)
        ld      a,h
        or      l
        jr      z,atf_net_go
        ld      (__atf_p),hl            ; "1e" leaves endptr at 'e'
atf_net_go:
        ; net_exp = (eneg ? -(expo+frac) : expo-frac)
        ld      hl,(__atf_expo)
        ld      de,(__atf_frac)
        ld      a,(__atf_eneg)
        or      a                       ; clears carry
        jr      z,atf_net_pos
        ; negative exponent: net = -(expo + frac)
        add     hl,de
        ex      de,hl
        ld      hl,0
        or      a                       ; clear carry before sbc
        sbc     hl,de
        jr      atf_net_sv
atf_net_pos:
        sbc     hl,de                   ; HL = expo - frac (carry=0)
atf_net_sv:
        ld      de,(__atf_adj)
        add     hl,de                   ; account for skipped integer digits
        ld      (__atf_net),hl
        ; Zero stays zero regardless of exponent range.
        ld      hl,(__atf_mant)
        ld      a,h
        or      l
        ld      hl,(__atf_mant+2)
        or      h
        or      l
        jr      z,atf_sign_bit
        ld      hl,(__atf_net)
        ld      a,h
        or      l
        jr      z,atf_sign_bit          ; net == 0: no scaling needed
        bit     7,h
        jr      nz,atf_neg_net          ; net < 0: divide by 10
        ld      de,39                   ; > FLT_MAX decimal range -> infinity
        or      a
        sbc     hl,de
        jr      nc,atf_make_inf
        ld      hl,(__atf_net)
atf_pos_net:
        ; mant *= 10.0f, net times
        ld      de,04120h
        ld      hl,0
        push    de
        push    hl
        ld      hl,(__atf_mant)
        ld      de,(__atf_mant+2)
        call    __fmf
        pop     bc
        pop     bc
        ld      (__atf_mant),hl
        ld      (__atf_mant+2),de
        ld      hl,(__atf_net)
        dec     hl
        ld      (__atf_net),hl
        ld      a,h
        or      l
        jr      nz,atf_pos_net
        jr      atf_sign_bit
atf_neg_net:
        ld      de,(__atf_net)
        ld      hl,0
        or      a
        sbc     hl,de                   ; HL = abs(net)
        ld      de,78                   ; FLT_MAX*10^-78 < FLT_MIN for any
        or      a                       ; mantissa, so this always underflows
        sbc     hl,de
        jr      nc,atf_make_zero
        ; mant /= 10.0f, |net| times (net is negative, counting toward 0)
        ld      hl,(__atf_mant)
        ld      de,(__atf_mant+2)
        push    de
        push    hl                      ; left = mant (numerator)
        ld      de,04120h
        ld      hl,0
        push    de
        push    hl                      ; right = 10.0f (denominator)
        call    __fdiv
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        ld      (__atf_mant),hl
        ld      (__atf_mant+2),de
        ld      hl,(__atf_net)
        inc     hl                      ; towards 0
        ld      (__atf_net),hl
        ld      a,h
        or      l
        jr      nz,atf_neg_net
atf_sign_bit:
        ld      hl,(__atf_mant)
        ld      de,(__atf_mant+2)
atf_apply_sign:
        ld      a,(__atf_neg)
        or      a
        jr      z,atf_ret
        ld      a,d
        or      80h
        ld      d,a                     ; set IEEE 754 sign bit
atf_ret:
        ret
atf_make_inf:
        ld      hl,0
        ld      de,07f80h
        jr      atf_apply_sign
atf_make_zero:
        ld      hl,0
        ld      de,0
        jr      atf_apply_sign
__atf_p:        dw      0
__atf_orig:     dw      0
__atf_mant:     ds      4
__atf_frac:     dw      0
__atf_expo:     dw      0
__atf_adj:      dw      0
__atf_net:      dw      0
__atf_esav:     dw      0
__atf_neg:      db      0
__atf_dp:       db      0
__atf_eneg:     db      0
__atf_edig:     db      0
__atf_sd:       db      0
__atf_ndig:     db      0
__atf_d:        db      0

        public  _strtod
_strtod:
; float strtod(const char *nptr, char **endptr)
; Note: C89 strtod returns double; dcc returns float (no double type).
; Delegates to _atof for the conversion; __atf_p is left pointing at the
; first character not consumed, which is stored through endptr if non-null.
        pop     bc                      ; return address
        pop     hl                      ; nptr
        pop     de                      ; endptr
        ld      (__std_endptr),de
        push    de                      ; restore caller-cleanup arguments
        push    hl
        push    bc

        push    hl                      ; nptr arg for _atof
        call    _atof                   ; result: DE=high word, HL=low word
        pop     bc                      ; discard nptr; preserves DE:HL
        push    de
        push    hl                      ; save float result
        ld      hl,(__std_endptr)
        ld      a,h
        or      l
        jr      z,std_noep
        ld      de,(__atf_p)            ; first char not consumed by _atof
        ld      (hl),e
        inc     hl
        ld      (hl),d
std_noep:
        pop     hl
        pop     de                      ; restore float result
        ret

__std_endptr:   dw      0

        public  _fflush
_fflush:
        ; int fflush(FILE *stream)
        ; Console output is buffered in this RTL; drain it.  File streams are
        ; written through directly (no user-visible buffer), so nothing further
        ; needs flushing for them.  fflush(NULL)/fflush(stdout)/fflush(stderr)
        ; all drain the console buffer.
        call    __cflush
        ld      hl,0
        ret

        public  _stdout
_stdout:
        dw      1               ; fd 1 = console output



        public  _stderr
_stderr:
        dw      2               ; fd 2 = console output

        public  _stdin
_stdin:
        dw      0

        public  _errno
_errno:
        dw      0

        public  _open
        public  _read
        public  _write
        public  _close
        public  _unlink
        public  _lseek
        public  _fsync
        public  _fdatasync
        public  __emfil
        public  __offp
        public  __fcbp
        public  __mkfcb
        public  __enoent
        public  __nospc
        public  __usep
        public  __ebadf
        public  __ioerr
        public  __chkfd
        public  __setrr
        public  __chunk
        public  __advio
        public  __rdhit
        public  __rdsto
        public  __zerdm
        public  __einval

FIRSTFD  equ     3
; NFILES is the number of concurrently open real files (fd FIRSTFD..MAXFD-1).
; C89 (7.9.3) requires FOPEN_MAX >= 8 streams open at once, including the three
; standard streams.  Here stdin/stdout/stderr are console pseudo-FILEs that do
; not consume a real-file slot, so 8 real-file slots comfortably satisfies the
; standard.  The per-slot cost is one FCB (FCBSIZE) plus 7 bytes of state; the
; 128-byte DMA buffer and the read sector cache stay single/shared.
NFILES   equ     8
MAXFD    equ     FIRSTFD+NFILES
FCBSIZE  equ     36


; ------------------------------------------------------------
; Minimal CP/M byte-stream file I/O.
;
; fd 0 = stdin, fd 1 = stdout, fd 2 = stderr.
; real files are fd 3..6.
;
; One shared 128-byte DMA buffer. 32-bit current offsets, but lseek returns low 16 bits.
; ------------------------------------------------------------

_open:
        push    ix
        ld      ix,0
        add     ix,sp

        ld      hl,__fduse
        ld      b,NFILES
        xor     a
opfind:
        ld      e,a
        ld      a,(hl)
        or      a
        jr      z,opslot
        inc     hl
        ld      a,e
        inc     a
        djnz    opfind
        call    __emfil
        ld      hl,0ffffh
        pop     ix
        ret

opslot:
        ld      a,e
        ld      (__slot),a
        ld      (hl),1
        ; A new file occupies this slot: any cached record for the slot number
        ; belonged to a previous file, so drop the read sector cache.
        xor     a
        ld      (__rdcv),a

        call    __offp
        xor     a
        ld      (hl),a
        inc     hl
        ld      (hl),a
        inc     hl
        ld      (hl),a
        inc     hl
        ld      (hl),a

        ld      a,(__slot)
        call    __fcbp
        push    hl
        ex      de,hl
        ld      b,FCBSIZE
        xor     a
opclr:
        ld      (de),a
        inc     de
        djnz    opclr

        pop     de
        push    de
        ld      l,(ix+4)
        ld      h,(ix+5)
        call    __mkfcb
        pop     de

        ; Create/truncate only if O_CREAT or O_TRUNC is set.
        ; Test uses:
        ;   O_CREAT = 0100 octal = 0040h
        ;   O_TRUNC = 01000 octal = 0200h
        ;   O_RDWR  = 2, which must NOT truncate.
        ld      a,(ix+6)
        and     40h             ; O_CREAT low byte
        jr      nz,opmake
        ld      a,(ix+7)
        and     2               ; O_TRUNC high byte
        jr      nz,opmake

        ld      c,15            ; open existing
        call    5
        cp      0ffh
        jr      z,opfail_noent
        jr      opok

opmake:
        push    de
        ld      c,19            ; delete old, ignore status
        call    5
        pop     de
        ld      c,22            ; make new
        call    5
        cp      0ffh
        jr      z,opfail_nospc

opok:
        ld      a,(__slot)
        add     a,FIRSTFD
        ld      h,0
        ld      l,a
        pop     ix
        ret

opfail_noent:
        call    __enoent
        jr      opfail_common
opfail_nospc:
        call    __nospc
opfail_common:
        ld      a,(__slot)
        call    __usep
        ld      (hl),0
        ld      hl,0ffffh
        pop     ix
        ret

_close:
        push    ix
        ld      ix,0
        add     ix,sp
        ld      a,(ix+4)
        cp      FIRSTFD
        jr      c,clok
        cp      MAXFD
        jr      nc,clbad
        sub     FIRSTFD
        ld      (__slot),a
        call    __fcbp
        ex      de,hl
        ld      c,16            ; close file
        call    5
        push    af
        ld      a,(__slot)
        call    __usep
        ld      (hl),0
        ; invalidate the read sector cache: this slot is closing
        xor     a
        ld      (__rdcv),a
        pop     af
        cp      0ffh
        jr      z,clio
clok:
        ld      hl,0
        pop     ix
        ret
clbad:
        call    __ebadf
        ld      hl,0ffffh
        pop     ix
        ret
clio:
        call    __ioerr
        ld      hl,0ffffh
        pop     ix
        ret

; ---- _unlink(path) -> 0 on success, -1 on failure ----
; Erases a CP/M file using BDOS fn 19.
; path @ IX+4/5.
_unlink:
        ; int unlink(const char *path) - single pointer argument, used
        ; once (immediately, via __mkfcb) and never needed again; IX-free
        ; leaf.
        pop     bc              ; return address
        pop     hl              ; path
        push    hl
        push    bc

        ; Zero the scratch FCB (drive + 8-char name + 3-char ext = 12 bytes)
        push    hl              ; save path across the clear loop below
        ld      hl,__ulfcb
        ld      b,12
        xor     a
ulclr:
        ld      (hl),a
        inc     hl
        djnz    ulclr
        pop     hl              ; HL = path

        ; Build FCB from path string
        ld      de,__ulfcb      ; DE = scratch FCB
        call    __mkfcb

        ; BDOS fn 19: erase file (DE = FCB)
        ld      de,__ulfcb
        ld      c,19
        call    5

        ; A = 0ffh on failure, 0..3 (directory code) on success
        cp      0ffh
        jr      z,ul_fail
        ld      hl,0
        ret
ul_fail:
        call    __enoent
        ld      hl,0ffffh
        ret

_read:
        push    ix
        ld      ix,0
        add     ix,sp

        ld      a,(ix+4)
        or      a
        jr      nz,rdfile
        ; stdin: return one blocking char if count > 0.
        ld      a,(ix+8)
        or      (ix+9)
        jr      z,rdzero
        call    __gchr          ; blocking console input, with stdin pushback
        ld      a,h
        or      a
        jr      nz,rdzero       ; H!=0 -> EOF sentinel (0FFFFh): 0 bytes read
        ld      a,l
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      (hl),a
        ld      hl,1
        pop     ix
        ret
rdzero:
        ld      hl,0
        pop     ix
        ret

rdfile:
        call    __chkfd
        jp      c,rdbad
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      (__rwbuf),hl
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      (__rwrem),hl
        ld      hl,0
        ld      (__rwcnt),hl

rdloop:
        ld      hl,(__rwrem)
        ld      a,h
        or      l
        jr      z,rddone
        call    __setrr
        call    __chunk

        ; Full aligned records can be read directly into the caller buffer.
        ld      a,(__remdr)
        or      a
        jr      nz,rd_dma
        ld      a,(__chnk)
        cp      128
        jr      nz,rd_dma
        ld      de,(__rwbuf)
        ld      c,26            ; set DMA to caller buffer
        call    5
        ld      a,(__slot)
        call    __fcbp
        ex      de,hl
        ld      c,33            ; random read
        call    5
        or      a
        jr      nz,rddone       ; EOF/error returns short count
        call    __advio
        jr      rdloop

rd_dma:
        call    __rdhit         ; is this record already resident in __dma?
        jr      z,rd_copy       ; cache hit: skip BDOS set-DMA + random read
        ; Miss: the random read below overwrites __dma even when it fails with
        ; EOF/error, so invalidate the cache now and only re-validate on a
        ; successful read.  Otherwise a later read of the previously cached
        ; record would falsely hit on the clobbered buffer.
        xor     a
        ld      (__rdcv),a
        ld      de,__dma
        ld      c,26            ; set DMA
        call    5
        ld      a,(__slot)
        call    __fcbp
        ex      de,hl
        ld      c,33            ; random read
        call    5
        or      a
        jr      nz,rddone       ; EOF/error returns short count
        call    __rdsto         ; __dma now caches this (slot, record)

rd_copy:
        ; copy __chunk bytes from __dma+remainder to user buffer
        ld      a,(__remdr)
        ld      h,0
        ld      l,a
        ld      de,__dma
        add     hl,de           ; HL = source
        ld      de,(__rwbuf)    ; DE = dest
        ld      a,(__chnk)
        ld      c,a
        ld      b,0
        ldir
        call    __advio
        jr      rdloop

rddone:
        ld      hl,(__rwcnt)
        pop     ix
        ret
rdbad:
        call    __ebadf
        ld      hl,0ffffh
        pop     ix
        ret

_write:
        push    ix
        ld      ix,0
        add     ix,sp

        ld      a,(ix+4)
        cp      1
        jp      z,wrcon
        cp      2
        jp      z,wrcon
        call    __chkfd
        jp      c,wrbadfd
        ; A write changes file data and reuses __dma as scratch, so the read
        ; sector cache is no longer guaranteed to reflect disk contents.
        xor     a
        ld      (__rdcv),a
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      (__rwbuf),hl
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      (__rwrem),hl
        ld      hl,0
        ld      (__rwcnt),hl

wrloop:
        ld      hl,(__rwrem)
        ld      a,h
        or      l
        jp      z,wrdone
        call    __setrr
        call    __chunk

        ; Full aligned records can be written directly from the caller buffer.
        ld      a,(__remdr)
        or      a
        jr      nz,wrrd
        ld      a,(__chnk)
        cp      128
        jr      nz,wrrd
        ld      de,(__rwbuf)
        ld      c,26            ; set DMA to caller buffer
        call    5
        ld      a,(__slot)
        call    __fcbp
        ex      de,hl
        ld      c,34            ; random write
        call    5
        or      a
        jp      nz,wrnospc
        call    __advio
        jr      wrloop

        ; For partial records, read old data first. If it fails,
        ; zero-fill the shared DMA buffer.
wrrd:
        ld      de,__dma
        ld      c,26
        call    5
        ld      a,(__slot)
        call    __fcbp
        ex      de,hl
        ld      c,33
        call    5
        or      a
        jr      z,wrcopy
        call    __zerdm

wrcopy:
        ; copy __chunk bytes from user buffer to __dma+remainder
        ld      hl,(__rwbuf)    ; source
        ld      a,(__remdr)
        ld      d,0
        ld      e,a
        push    hl
        ld      hl,__dma
        add     hl,de
        ex      de,hl           ; DE = dest
        pop     hl              ; HL = source
        ld      a,(__chnk)
        ld      c,a
        ld      b,0
        ldir

        ld      de,__dma
        ld      c,26
        call    5
        ld      a,(__slot)
        call    __fcbp
        ex      de,hl
        ld      c,34            ; random write
        call    5
        or      a
        jp      nz,wrnospc
        call    __advio
        jp      wrloop

wrdone:
        ld      hl,(__rwcnt)
        pop     ix
        ret

wrcon:
        ld      hl,(__rwcnt)
        ; initialize console write vars
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      (__rwbuf),hl
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      (__rwrem),hl
        ld      hl,0
        ld      (__rwcnt),hl
wcloop:
        ld      hl,(__rwrem)
        ld      a,h
        or      l
        jr      z,wrdone
        ld      hl,(__rwbuf)
        ld      e,(hl)
        call    __conout
        ; advance buf/cnt/rem by 1 without updating fdoff (no __offp call)
        ld      hl,(__rwbuf)
        inc     hl
        ld      (__rwbuf),hl
        ld      hl,(__rwcnt)
        inc     hl
        ld      (__rwcnt),hl
        ld      hl,(__rwrem)
        dec     hl
        ld      (__rwrem),hl
        jr      wcloop

wrbadfd:
        call    __ebadf
        ld      hl,0ffffh
        pop     ix
        ret
wrnospc:
        ; A real write error (disk full / record write rejected).  __slot is
        ; valid here (we passed __chkfd), so record a stream error for ferror().
        ld      a,(__slot)
        ld      h,0
        ld      l,a
        ld      de,__fderr
        add     hl,de
        ld      (hl),1
        call    __nospc
        ld      hl,0ffffh
        pop     ix
        ret

_lseek:
        push    ix
        ld      ix,0
        add     ix,sp
        call    __chkfd
        jp      c,lsbadfd

        ; long lseek(int fd, long offset, int whence)
        ; ix+4/5   fd
        ; ix+6..9  offset, low word then high word
        ; ix+10/11 whence
        ld      a,(ix+10)
        or      a
        jr      z,lsset
        cp      1
        jr      z,lscur
        cp      2
        jr      z,lsend
        jp      lsinval

lsset:
        ; Set current offset from full 32-bit argument.
        call    __offp
        ld      a,(ix+6)
        ld      (hl),a
        inc     hl
        ld      a,(ix+7)
        ld      (hl),a
        inc     hl
        ld      a,(ix+8)
        ld      (hl),a
        inc     hl
        ld      a,(ix+9)
        ld      (hl),a
        jr      lsret

lscur:
        ; Add full 32-bit delta to current offset.
        call    __offp
        ld      a,(hl)
        add     a,(ix+6)
        ld      (hl),a
        inc     hl
        ld      a,(hl)
        adc     a,(ix+7)
        ld      (hl),a
        inc     hl
        ld      a,(hl)
        adc     a,(ix+8)
        ld      (hl),a
        inc     hl
        ld      a,(hl)
        adc     a,(ix+9)
        ld      (hl),a

lsret:
        ; Return full 32-bit offset in DE:HL.
        call    __offp
        ld      e,(hl)          ; byte 0
        inc     hl
        ld      d,(hl)          ; byte 1
        inc     hl
        push    de              ; low word
        ld      e,(hl)          ; byte 2
        inc     hl
        ld      d,(hl)          ; byte 3
        pop     hl              ; HL = low word, DE = high word
        pop     ix
        ret

lsend:
        ; SEEK_END: use BDOS fn 35 to get size in 128-byte records,
        ; then convert to byte offset and add full 32-bit delta.
        ld      a,(__slot)
        call    __fcbp
        ex      de,hl
        ld      c,35
        call    5

        ld      a,(__slot)
        call    __fcbp
        ld      de,33
        add     hl,de
        ld      c,(hl)
        inc     hl
        ld      b,(hl)          ; BC = 16-bit record count

        ; BC * 128 -> A:HL, where A is byte 2 and byte 3 is zero.
        ld      l,c
        ld      h,b
        xor     a
        add     hl,hl
        rla
        add     hl,hl
        rla
        add     hl,hl
        rla
        add     hl,hl
        rla
        add     hl,hl
        rla
        add     hl,hl
        rla
        add     hl,hl
        rla

        ; Add offset low word.
        ld      e,(ix+6)
        ld      d,(ix+7)
        add     hl,de

        ; Add offset high bytes plus carry from low word.
        ld      e,a
        ld      a,e
        adc     a,(ix+8)
        ld      b,a             ; result byte 2

        ld      a,0
        adc     a,(ix+9)
        ld      c,a             ; result byte 3

        push    bc
        push    hl

        call    __offp

        pop     de              ; low word
        ld      (hl),e
        inc     hl
        ld      (hl),d
        inc     hl
        pop     bc
        ld      (hl),b
        inc     hl
        ld      (hl),c
        jr      lsret

lsbadfd:
        call    __ebadf
        jr      lsbadret
lsinval:
        call    __einval
lsbadret:
        ld      hl,0ffffh
        ld      de,0ffffh
        pop     ix
        ret


_fsync:
_fdatasync:
        ld      hl,0
        ret

; Validate fd in A or (ix+4). Sets __slot. Carry set on error.
__chkfd:
        ld      a,(ix+4)
        cp      FIRSTFD
        jr      c,cfbad
        cp      MAXFD
        jr      nc,cfbad
        sub     FIRSTFD
        ld      (__slot),a
        call    __usep
        ld      a,(hl)
        or      a
        jr      z,cfbad
        or      a               ; clear carry
        ret
cfbad:
        scf
        ret

; ---- Read sector cache helpers ----
; __rdhit: after __setrr has loaded the FCB random record for __slot, test
; whether the shared __dma buffer already holds that exact (slot, record).
; Returns Z=1 on hit, Z=0 on miss.  Corrupts AF, BC, DE, HL.
__rdhit:
        ld      a,(__rdcv)
        or      a
        jr      z,rdh_miss              ; cache empty
        ld      a,(__slot)
        ld      hl,__rdck
        cp      (hl)
        jr      nz,rdh_miss             ; different slot
        ld      a,(__slot)
        call    __fcbp
        ld      de,33
        add     hl,de                   ; HL -> FCB random-record bytes
        ld      de,__rdck+1
        ld      b,3
rdh_cmp:
        ld      a,(de)
        cp      (hl)
        jr      nz,rdh_miss
        inc     de
        inc     hl
        djnz    rdh_cmp
        xor     a                       ; Z=1: hit
        ret
rdh_miss:
        ld      a,1
        or      a                       ; Z=0: miss
        ret

; __rdsto: record that __dma now holds (slot, current FCB random record).
; Corrupts AF, BC, DE, HL.
__rdsto:
        ld      a,(__slot)
        ld      (__rdck),a
        call    __fcbp
        ld      de,33
        add     hl,de                   ; HL -> FCB random-record bytes
        ld      de,__rdck+1
        ld      b,3
rds_cpy:
        ld      a,(hl)
        ld      (de),a
        inc     hl
        inc     de
        djnz    rds_cpy
        ld      a,1
        ld      (__rdcv),a
        ret

; A = slot 0..3, returns HL = fd_used slot
__usep:
        ld      h,0
        ld      l,a
        ld      de,__fduse
        add     hl,de
        ret

; __slot -> HL = 32-bit offset dword
__offp:
        ld      a,(__slot)
        ld      h,0
        ld      l,a
        add     hl,hl
        add     hl,hl           ; *4 bytes per offset
        ld      de,__fdoff
        add     hl,de
        ret

; A = slot 0..3, returns HL = FCB
__fcbp:
        ld      h,0
        ld      l,a
        add     hl,hl           ; *2
        add     hl,hl           ; *4
        ld      d,h
        ld      e,l
        add     hl,hl           ; *8
        add     hl,hl           ; *16
        add     hl,hl           ; *32
        add     hl,de           ; *36
        ld      de,__fcbs
        add     hl,de
        ret

; Set FCB random record from 32-bit byte offset.
; record = offset >> 7. remainder = offset & 127.
__setrr:
        call    __offp
        ld      e,(hl)          ; offset byte 0
        inc     hl
        ld      d,(hl)          ; offset byte 1
        inc     hl
        ld      b,(hl)          ; offset byte 2
        inc     hl
        ld      c,(hl)          ; offset byte 3

        ld      a,e
        and     7fh
        ld      (__remdr),a

        ; r0 = (byte0 >> 7) | (byte1 << 1)
        ld      a,e
        rlca
        and     1
        ld      l,a
        ld      a,d
        add     a,a
        or      l
        ld      l,a             ; L = r0

        ; r1 = (byte1 >> 7) | (byte2 << 1)
        ld      a,d
        rlca
        and     1
        ld      h,a
        ld      a,b
        add     a,a
        or      h
        ld      h,a             ; H = r1

        ; r2 = (byte2 >> 7) | (byte3 << 1)
        ld      a,b
        rlca
        and     1
        ld      e,a
        ld      a,c
        add     a,a
        or      e
        ld      e,a             ; E = r2

        push    hl              ; save r0/r1
        push    de              ; save r2 in E
        ld      a,(__slot)
        call    __fcbp
        ld      de,33
        add     hl,de
        pop     de
        pop     bc              ; C = r0, B = r1
        ld      (hl),c
        inc     hl
        ld      (hl),b
        inc     hl
        ld      (hl),e
        ret
; Compute chunk = min(remaining, bytes-left-in-current-CP/M-record), stores __chnk.
; Each CP/M BDOS record is 128 bytes, so we cap at 128 bytes per call.
; The important rule is that when remaining is less than 128, __chnk must
; be remaining, even at a record boundary.
__chunk:
        ; e = min(remaining, 128)
        ld      hl,(__rwrem)
        ld      a,h
        or      a
        jr      nz,ch_more128
        ld      a,l
        cp      129
        jr      nc,ch_more128
        ld      e,a             ; remaining is 1..128
        jr      ch_have_count

ch_more128:
        ld      e,128

ch_have_count:
        ; room = 128 - remainder.  If remainder is 0, room is 128,
        ; so the 128-byte cap already fits.
        ld      a,(__remdr)
        or      a
        jr      z,ch_store
        ld      c,a
        ld      a,128
        sub     c               ; room is 1..127
        cp      e
        jr      nc,ch_store
        ld      e,a

ch_store:
        ld      a,e
        ld      (__chnk),a
        ret

__advio:
        ld      a,(__chnk)
        ld      e,a
        ld      d,0
        ld      hl,(__rwbuf)
        add     hl,de
        ld      (__rwbuf),hl
        ld      hl,(__rwcnt)
        add     hl,de
        ld      (__rwcnt),hl
        ld      hl,(__rwrem)
        or      a
        sbc     hl,de
        ld      (__rwrem),hl
        call    __offp
        ; __offp clobbers DE, so reload the chunk before updating offset.
        ld      a,(__chnk)
        ld      e,a
        ld      d,0
        ld      a,(hl)
        add     a,e
        ld      (hl),a
        inc     hl
        ld      a,(hl)
        adc     a,d
        ld      (hl),a
        inc     hl
        ld      a,(hl)
        adc     a,0
        ld      (hl),a
        inc     hl
        ld      a,(hl)
        adc     a,0
        ld      (hl),a
        ret

__zerdm:
        ld      hl,__dma
        ld      b,128
        ld      a,1ah           ; Ctrl-Z: CP/M text-file EOF sentinel
zdm1:
        ld      (hl),a
        inc     hl
        djnz    zdm1
        ret

; HL = filename string, DE = FCB address.
__mkfcb:
        ld      (__mffcb),de
        push    hl
        ex      de,hl
        xor     a
        ld      (hl),a          ; default drive
        inc     hl
        ld      b,11
mfspc:
        ld      (hl),' '
        inc     hl
        djnz    mfspc
        pop     hl

        ld      de,(__mffcb)
        inc     de              ; name field
        ld      b,8
mfnam:
        ld      a,(hl)
        or      a
        ret     z
        cp      '.'
        jr      z,mfdot
        call    __upa
        ld      (de),a
        inc     de
        inc     hl
        djnz    mfnam
mfskp:
        ld      a,(hl)
        or      a
        ret     z
        cp      '.'
        jr      z,mfdot
        inc     hl
        jr      mfskp
mfdot:
        inc     hl
        push    hl
        ld      hl,(__mffcb)
        ld      de,9
        add     hl,de
        ex      de,hl           ; DE = extension field
        pop     hl
        ld      b,3
mfext:
        ld      a,(hl)
        or      a
        ret     z
        call    __upa
        ld      (de),a
        inc     de
        inc     hl
        djnz    mfext
        ret

__upa:
        cp      'a'
        ret     c
        cp      'z'+1
        ret     nc
        sub     20h
        ret

__seter:
        ld      (_errno),hl
        ret
__enoent:
        ld      hl,ENOENT
        jr      __seter
__ioerr:
        ld      hl,EIO
        jr      __seter
__ebadf:
        ld      hl,EBADF
        jr      __seter
__einval:
        ld      hl,EINVAL
        jr      __seter
__emfil:
        ld      hl,EMFILE
        jr      __seter
__nospc:
        ld      hl,ENOSPC
        jr      __seter


__slot:
        db      0
__chnk:
        db      0
__remdr:
        db      0
__rwbuf:
        dw      0
__rwrem:
        dw      0
__rwcnt:
        dw      0
__mffcb:
        dw      0
__ulfcb:
        ds      12              ; scratch FCB for _unlink

; ============================================================
; _rename  (C89 7.9.4.2) -- rename a file
; int rename(const char *oldname, const char *newname)
; Returns 0 on success, -1 on failure (errno = ENOENT).
; Uses CP/M BDOS fn 23: DE points at a 32-byte FCB where
;   FCB[0..11]  = old name (drive + 8-char + 3-ext)
;   FCB[16..27] = new name (drive + 8-char + 3-ext)
; ============================================================
        public  _rename
_rename:
        ; int rename(const char *old, const char *new) - IX-free. old is
        ; kept in DE across the clear loop below (which only touches
        ; HL/B/A); new is stashed on the stack until it is needed after
        ; the first __mkfcb call.
        pop     bc              ; return address
        pop     hl              ; old
        pop     de              ; new
        push    de              ; restore new (caller-cleanup argument)
        push    hl              ; restore old (caller-cleanup argument)
        push    bc              ; restore return address

        push    de              ; stash new for later
        ex      de,hl           ; DE = old

        ; Zero the 32-byte rename FCB.
        ld      hl,__rnfcb
        ld      b,32
        xor     a
rnclr:
        ld      (hl),a
        inc     hl
        djnz    rnclr

        ; Old name -> FCB[0..11].
        ex      de,hl           ; HL = old
        ld      de,__rnfcb
        call    __mkfcb

        ; New name -> FCB[16..27].
        ld      hl,__rnfcb
        ld      de,16
        add     hl,de
        ex      de,hl           ; DE = __rnfcb + 16
        pop     hl              ; HL = new (stashed earlier)
        call    __mkfcb

        ; BDOS fn 23: rename file.
        ld      de,__rnfcb
        ld      c,23
        call    5

        cp      0ffh
        jr      z,rnfail
        ld      hl,0
        ret
rnfail:
        call    __enoent
        ld      hl,0ffffh
        ret

__rnfcb:        ds      32

; Read sector cache: records which 128-byte file record currently resides in
; the shared __dma buffer, so consecutive small reads of the same record
; (e.g. fgets reading one byte at a time) skip the BDOS random read entirely.
__rdcv:         db      0       ; 1 = __dma holds the record identified by __rdck
__rdck:         ds      4       ; key: slot, then FCB random-record bytes r0,r1,r2

__fdeof:        ds      NFILES  ; EOF flag per slot (index = fd - FIRSTFD)
__fderr:        ds      NFILES  ; error flag per slot
__fduse:
        ds      NFILES
__fdoff:
        ds      NFILES*4

        public  __fcbs
__fcbs:
        ds      NFILES*FCBSIZE

        public  __dma
__dma:
        ds      128


; _srand/_rand placed here so their blocks do not enclose the file I/O and
; divu/modu shared data above; those would force _rand into every build that
; uses file I/O or integer division.
; the assembly implementations match this C code:
;    static unsigned int s_rnd = 1;
;
;    void srand(unsigned int seed)
;    {
;        s_rnd = seed;
;    }
;
;    int rand(void)
;    {
;        /* 16-bit Xorshift (Parameters: 7, 9, 8) */
;        s_rnd ^= s_rnd << 7;
;        s_rnd ^= s_rnd >> 9;
;        s_rnd ^= s_rnd << 8;
;    
;        return (int)(s_rnd & 0x7FFF);
;    }

        public  _srand
_srand:
        pop     de          ; return address
        pop     hl          ; seed
        push    hl          ; preserve caller cleanup convention
        push    de
        ld      (__rand_state),hl
        ret

        public  _rand
_rand:
        ld      hl,(__rand_state)   ; Load the current 16-bit state

        ; --- Step 1: next ^= next << 7 ---
        ld      a,h
        rra
        ld      a,l
        rra
        xor     h
        ld      h,a

        ; --- Step 2: next ^= next >> 9 ---
        ld      a,l
        rra
        ld      a,h
        rra
        xor     l
        ld      l,a

        ; --- Step 3: next ^= next << 8 ---
        xor     h
        ld      h,a

        ; Save the updated full 16-bit state back to memory
        ld      (__rand_state),hl

        ; Clear bit 15 to stay compliant with standard C89 RAND_MAX (0-32767)
        res     7,h
        ret

__rand_state:
        dw      1


; ============================================================
; 32-bit long arithmetic runtime routines
; Calling convention (fastcall, matching __faf/__fsf): caller pushes only
;   LHS (push de; push hl); RHS is left live in DE:HL (DE=high, HL=low) -
;   every dcc call site has RHS freshly evaluated into DE:HL right before
;   the call anyway, so no push/pop round-trip is needed for it. After
;   push ix; ld ix,0; add ix,sp: IX+4=LHS_L, IX+6=LHS_H. Returns DE:HL
;   (DE=high, HL=low). Caller cleans 4 bytes of args (just the LHS) after
;   return.
; ============================================================

        public  __lmul
__lmul:
        ; long __lmul(long a, long b) -> a*b (mod 2^32) in DE:HL.
        ;
        ; fastcall: Y (arg1/"b", the RHS at every dcc call site) is already
        ; live in DE:HL at entry - the call site just finished evaluating it
        ; and would otherwise push it right back, matching the __faf/__fsf
        ; trick. Only X (arg0/"a", the LHS) is pushed by the caller.
        ;
        ; 32x32 -> 32 via partial products.  With X = Xhi:Xlo and Y = Yhi:Ylo,
        ;   X*Y mod 2^32 = Xlo*Ylo + ((Xlo*Yhi + Xhi*Ylo) & 0xFFFF) << 16.
        ; The base term Xlo*Ylo is a register-only 16x16->32 (no per-iteration
        ; memory traffic, unlike the old shift/add-in-RAM loop); the two cross
        ; terms only need the low 16 bits, so they reuse the tuned 16x16->16
        ; __mulu.  Y = live DE:HL at entry, X = arg0 (now ix+4/6).
        ld      (__lm_rhs_l),hl         ; Ylo
        ld      (__lm_rhs_h),de         ; Yhi
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      (__lm_lhs_l),hl         ; Xlo
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      (__lm_lhs_h),hl         ; Xhi

        ; --- base = Xlo * Ylo, register-only 16x16 -> 32 -------------------
        ; HL:DE is the 32-bit accumulator (HL high, DE low).  DE starts as the
        ; multiplier Ylo and is consumed LSB-first; product bits shift down out
        ; of HL into DE.  BC = constant multiplicand Xlo.  16 fixed iterations.
        ld      de,(__lm_rhs_l)         ; DE = Ylo (multiplier / low accumulator)
        ld      bc,(__lm_lhs_l)         ; BC = Xlo (multiplicand, constant)
        ld      hl,0                    ; HL = high accumulator
        ld      a,4                     ; 4 groups of 4 bits = 16 iterations
lmul_b:
        ; 4 unrolled bit steps (see __m1u for the leading-or-a / jr z,$+3 idiom)
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      d
        rr      e
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      d
        rr      e
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      d
        rr      e
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      d
        rr      e
        dec     a
        jr      nz,lmul_b
        ld      (__lm_res_l),de         ; result low = base low (final)
        push    hl                      ; save base high

        ; --- result high = base_high + low16(Xlo*Yhi) + low16(Xhi*Ylo) ------
        ld      hl,(__lm_lhs_l)         ; Xlo
        ld      de,(__lm_rhs_h)         ; Yhi
        call    __mulu                  ; HL = low16(Xlo*Yhi), BC preserved
        pop     de                      ; DE = base high
        add     hl,de
        push    hl                      ; save partial high
        ld      hl,(__lm_lhs_h)         ; Xhi
        ld      de,(__lm_rhs_l)         ; Ylo
        call    __mulu                  ; HL = low16(Xhi*Ylo)
        pop     de                      ; DE = partial high
        add     hl,de                   ; HL = result high
        ex      de,hl                   ; DE = result high
        ld      hl,(__lm_res_l)         ; HL = result low
        ld      sp,ix
        pop     ix
        ret

; __m1u: unsigned 16x16 -> 32 multiply, register ABI.
;   Entry: BC = LHS low word, HL = RHS low word.  Exit: DE:HL = product.
;   Used by dcc when both long operands were freshly widened from 16-bit.
        public  __m1u
__m1u:
        ex      de,hl                   ; DE = multiplier/low accumulator
        ld      hl,0                    ; HL = high accumulator
        ld      a,4                     ; 4 groups of 4 bits = 16 iterations
lm1u_b:
        ; --- 4 unrolled bit steps ---------------------------------------
        ; A leading `or a` sets CF=0 so the shift is clean when the bit is
        ; clear; `add hl,bc` overwrites CF with the real carry when the bit is
        ; set.  `jr z,$+3` skips only the 1-byte `add hl,bc`, so neither branch
        ; needs a label.  Unrolling by 4 cuts the dec/jr loop control from 16x
        ; to 4x -- the 16x16->32 multiply is the hottest runtime routine in
        ; fixed-point apps (e.g. attnc99's vdot/mvmul).
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      d
        rr      e
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      d
        rr      e
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      d
        rr      e
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      d
        rr      e
        dec     a
        jr      nz,lm1u_b
        ex      de,hl
        ret

; __m8u: unsigned 8x16 -> 24-bit multiply, register ABI.
;   Entry: A  = 8-bit multiplier, BC = 16-bit multiplicand.
;   Exit:  HL:E = 24-bit product (HL = high 16 bits, E = low 8 bits).
;   Used by __fmul for the three mantissa partial products that have an
;   8-bit operand (Ahi*Blo, Alo*Bhi, Ahi*Bhi).  Only 8 multiplier bits are
;   processed, so it runs half the iterations of the full 16x16 __m1u while
;   using the identical or-a / bit-test / jr z,$+3 / add / shift idiom, here
;   shifting the 3-byte accumulator HL:E right one bit per step.
        public  __m8u
__m8u:
        ld      e,a                     ; E = multiplier / low accumulator
        ld      hl,0                    ; HL = high accumulator
        ; --- 8 unrolled bit steps (see __m1u for the idiom) --------------
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      e
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      e
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      e
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      e
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      e
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      e
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      e
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      e
        ret

; __m1s: signed 16x16 -> 32 multiply, register ABI.
;   Entry: BC = LHS low word, HL = RHS low word.  Exit: DE:HL = product.
        public  __m1s
__m1s:
        ld      a,b
        xor     h
        ld      (lm1s_sg),a             ; bit7 = sign of product
        bit     7,b
        jr      z,lm1s_ap
        xor     a
        sub     c
        ld      c,a
        sbc     a,a
        sub     b
        ld      b,a
lm1s_ap:
        bit     7,h
        jr      z,lm1s_bp
        xor     a
        sub     l
        ld      l,a
        sbc     a,a
        sub     h
        ld      h,a
lm1s_bp:
        ex      de,hl                   ; DE = |RHS| multiplier/low accumulator
        ld      hl,0                    ; HL = high accumulator
        ld      a,4                     ; 4 groups of 4 bits = 16 iterations
lm1s_b:
        ; 4 unrolled bit steps (see __m1u for the leading-or-a / jr z,$+3 idiom)
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      d
        rr      e
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      d
        rr      e
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      d
        rr      e
        or      a
        bit     0,e
        jr      z,$+3
        add     hl,bc
        rr      h
        rr      l
        rr      d
        rr      e
        dec     a
        jr      nz,lm1s_b
        ex      de,hl                   ; HL = low, DE = high
        ld      a,(lm1s_sg)
        bit     7,a
        ret     z
        ld      a,l
        cpl
        ld      l,a
        ld      a,h
        cpl
        ld      h,a
        ld      a,e
        cpl
        ld      e,a
        ld      a,d
        cpl
        ld      d,a
        inc     hl
        ld      a,h
        or      l
        ret     nz
        inc     de
        ret
lm1s_sg:        db      0

; __ldivu: unsigned 32-bit divide.  Returns DE:HL = LHS / RHS.
        public  __ldu
__ldu:
        ; fastcall: divisor (RHS at every dcc call site) already live in
        ; DE:HL at entry; only the dividend (LHS) is pushed by the caller.
        ld      (__ldv_dvs_l),hl
        ld      (__ldv_dvs_h),de
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      (__ldv_dvd_l),hl
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      (__ldv_dvd_h),hl
        call    __ludivmod_core
        ld      hl,(__ldv_quo_l)
        ld      de,(__ldv_quo_h)
        ld      sp,ix
        pop     ix
        ret

; __lmodu: unsigned 32-bit modulo.  Returns DE:HL = LHS % RHS.
        public  __lmu
__lmu:
        ; fastcall: divisor (RHS at every dcc call site) already live in
        ; DE:HL at entry; only the dividend (LHS) is pushed by the caller.
        ld      (__ldv_dvs_l),hl
        ld      (__ldv_dvs_h),de
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      (__ldv_dvd_l),hl
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      (__ldv_dvd_h),hl
        call    __ludivmod_core
        ld      hl,(__ldv_rem_l)
        ld      de,(__ldv_rem_h)
        ld      sp,ix
        pop     ix
        ret

; Shared unsigned 32-bit divide+modulo core: __ldu/__lmu call it directly
; on their raw unsigned operands; __lds/__lms call it after negating their
; operands to non-negative magnitudes in the same __ldv_dvd/__ldv_dvs
; scratch, then apply the sign themselves to whichever of __ldv_quo/
; __ldv_rem they return. Always computes BOTH outputs; clobbers AF/BC/DE/HL.
__ludivmod_core:
        ld      hl,0
        ld      (__ldv_rem_l),hl
        ld      (__ldv_rem_h),hl
        ld      (__ldv_quo_l),hl
        ld      (__ldv_quo_h),hl
        ; Fast path: divisor fits in 16 bits.
        ld      hl,(__ldv_dvs_h)
        ld      a,h
        or      l
        jp      z,ludm_dvs16
        ld      b,32
ludm_loop:
        push    bc
        ; Shift {rem:dvd} left 1 (64-bit)
        ld      hl,(__ldv_dvd_l)
        or      a
        add     hl,hl
        ld      (__ldv_dvd_l),hl
        ld      hl,(__ldv_dvd_h)
        adc     hl,hl
        ld      (__ldv_dvd_h),hl
        ld      hl,(__ldv_rem_l)
        adc     hl,hl
        ld      (__ldv_rem_l),hl
        ld      hl,(__ldv_rem_h)
        adc     hl,hl
        ld      (__ldv_rem_h),hl
        ; Compare rem with dvs (32-bit)
        ld      hl,(__ldv_rem_l)
        ld      de,(__ldv_dvs_l)
        or      a
        sbc     hl,de
        ex      de,hl           ; DE = rem_l - dvs_l (tentative)
        ld      hl,(__ldv_rem_h)
        ld      bc,(__ldv_dvs_h)
        sbc     hl,bc           ; HL = rem_h - dvs_h - borrow
        jr      c,ludm_no_sub
        ; rem >= dvs: store rem - dvs, set quotient bit
        ld      (__ldv_rem_h),hl
        ex      de,hl
        ld      (__ldv_rem_l),hl
        ld      hl,(__ldv_quo_l)
        or      a
        add     hl,hl
        inc     l
        ld      (__ldv_quo_l),hl
        ld      hl,(__ldv_quo_h)
        adc     hl,hl
        ld      (__ldv_quo_h),hl
        jr      ludm_next
ludm_no_sub:
        ld      hl,(__ldv_quo_l)
        or      a
        add     hl,hl
        ld      (__ldv_quo_l),hl
        ld      hl,(__ldv_quo_h)
        adc     hl,hl
        ld      (__ldv_quo_h),hl
ludm_next:
        pop     bc
        djnz    ludm_loop
        ret

ludm_dvs16:
        ; 16-bit divisor fast path: build the 32-bit quotient MSB-first via
        ; the shared ldqr_byte step, and keep the final 16-bit remainder
        ; (its high word is always 0, since it is < the 16-bit divisor).
        ld      de,(__ldv_dvs_l)        ; DE = divisor
        ld      hl,0                    ; HL = partial remainder
        ld      a,(__ldv_dvd_h+1)       ; byte 3 (MSB)
        call    ldqr_byte
        ld      (__ldv_quo_h+1),a       ; quotient byte 3
        ld      a,(__ldv_dvd_h)         ; byte 2
        call    ldqr_byte
        ld      (__ldv_quo_h),a         ; quotient byte 2
        ld      a,(__ldv_dvd_l+1)       ; byte 1
        call    ldqr_byte
        ld      (__ldv_quo_l+1),a       ; quotient byte 1
        ld      a,(__ldv_dvd_l)         ; byte 0 (LSB)
        call    ldqr_byte
        ld      (__ldv_quo_l),a         ; quotient byte 0
        ld      (__ldv_rem_l),hl        ; remainder low word
        ld      hl,0
        ld      (__ldv_rem_h),hl        ; remainder high word = 0
        ret

ldqr_byte:
        ; Shared one-byte step for 32-bit / 16-bit division and modulo.
        ; In:  A = next dividend byte (MSB-first), HL = remainder, DE = divisor.
        ; Out: A = quotient byte for this position, HL = updated remainder.
        ;      Clobbers B.  Modulo callers ignore A; divide callers store A
        ;      back to build the in-place quotient.
        ;
        ; sla a frees bit0 to receive this position's quotient bit and feeds
        ; the dividend MSB into carry for adc hl,hl.  When adc hl,hl overflows,
        ; the true shifted value exceeds 65535 >= divisor, so a subtract is
        ; mandatory and (HL_wrapped - divisor) is the correct remainder.
        ld      b,4                     ; 4 groups of 2 bits = 8 quotient bits
ldqr_bit:
        sla     a                       ; dividend bit7 -> carry; bit0 = 0 (quotient slot)
        adc     hl,hl                   ; HL = (HL<<1) | bit; carry = 16-bit overflow
        jr      c,ldqr_sub1             ; overflow: must subtract, quotient bit = 1
        or      a                       ; clear carry (leaves A unchanged)
        sbc     hl,de                   ; trial HL -= divisor
        jr      nc,ldqr_one1            ; HL >= divisor: keep, quotient bit = 1
        add     hl,de                   ; restore: HL < divisor, quotient bit = 0
        jr      ldqr_cont1
ldqr_sub1:
        or      a                       ; clear carry
        sbc     hl,de                   ; HL_wrapped - divisor = correct remainder
ldqr_one1:
        inc     a                       ; set quotient bit (bit0)
ldqr_cont1:
        sla     a                       ; dividend bit7 -> carry; bit0 = 0 (quotient slot)
        adc     hl,hl                   ; HL = (HL<<1) | bit; carry = 16-bit overflow
        jr      c,ldqr_sub              ; overflow: must subtract, quotient bit = 1
        or      a                       ; clear carry (leaves A unchanged)
        sbc     hl,de                   ; trial HL -= divisor
        jr      nc,ldqr_one             ; HL >= divisor: keep, quotient bit = 1
        add     hl,de                   ; restore: HL < divisor, quotient bit = 0
        jr      ldqr_cont
ldqr_sub:
        or      a                       ; clear carry
        sbc     hl,de                   ; HL_wrapped - divisor = correct remainder
ldqr_one:
        inc     a                       ; set quotient bit (bit0)
ldqr_cont:
        djnz    ldqr_bit
        ret

; __ldivs: signed 32-bit divide.  Returns DE:HL = LHS / RHS.
        public  __lds
__lds:
        ; fastcall: divisor (RHS at every dcc call site) already live in
        ; DE:HL at entry; only the dividend (LHS) is pushed by the caller.
        ld      (__ldv_dvs_l),hl
        ld      (__ldv_dvs_h),de
        push    ix
        ld      ix,0
        add     ix,sp
        ; Load remaining arg (dividend) and make positive, track sign
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      (__ldv_dvd_l),hl
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      (__ldv_dvd_h),hl
        ; sign = sign(dvd) XOR sign(dvs). D still holds dvs_h's high byte
        ; unclobbered from entry (nothing between entry and here touches
        ; D/E), so no memory re-read is needed for it.
        ld      a,(ix+7)        ; high byte of LHS_H (dvd)
        xor     d               ; XOR with high byte of RHS_H (dvs), live in D
        ld      (__ldv_sign),a  ; bit7 = result sign
        ; If dvd negative: negate it
        ld      a,(ix+7)
        bit     7,a
        jr      z,ldivs_dvd_pos
        ld      de,(__ldv_dvd_l)
        ld      hl,0
        or      a
        sbc     hl,de
        ld      (__ldv_dvd_l),hl
        ld      de,(__ldv_dvd_h)
        ld      hl,0
        sbc     hl,de
        ld      (__ldv_dvd_h),hl
ldivs_dvd_pos:
        ; If dvs negative: negate it. dvs is no longer on the stack, so
        ; read its sign byte back from the scratch copy (address+1 = the
        ; word's high byte, i.e. the original live D) rather than (ix+7).
        ld      a,(__ldv_dvs_h+1)
        bit     7,a
        jr      z,ldivs_dvs_pos
        ld      de,(__ldv_dvs_l)
        ld      hl,0
        or      a
        sbc     hl,de
        ld      (__ldv_dvs_l),hl
        ld      de,(__ldv_dvs_h)
        ld      hl,0
        sbc     hl,de
        ld      (__ldv_dvs_h),hl
ldivs_dvs_pos:
        call    __ludivmod_core
        ; Apply sign to quotient
        ld      a,(__ldv_sign)
        bit     7,a
        jr      z,ldivs_pos_result
        ld      de,(__ldv_quo_l)
        ld      hl,0
        or      a
        sbc     hl,de
        ld      (__ldv_quo_l),hl
        ld      de,(__ldv_quo_h)
        ld      hl,0
        sbc     hl,de
        ld      (__ldv_quo_h),hl
ldivs_pos_result:
        ld      hl,(__ldv_quo_l)
        ld      de,(__ldv_quo_h)
        ld      sp,ix
        pop     ix
        ret

; __lmods: signed 32-bit modulo.  Returns DE:HL = LHS % RHS.
        public  __lms
__lms:
        ; fastcall: divisor (RHS at every dcc call site) already live in
        ; DE:HL at entry; only the dividend (LHS) is pushed by the caller.
        ld      (__ldv_dvs_l),hl
        ld      (__ldv_dvs_h),de
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      (__ldv_dvd_l),hl
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      (__ldv_dvd_h),hl
        ; sign of result = sign of dividend
        ld      a,(ix+7)
        ld      (__ldv_sign),a
        ; If dvd negative: negate
        bit     7,a
        jr      z,lmods_dvd_pos
        ld      de,(__ldv_dvd_l)
        ld      hl,0
        or      a
        sbc     hl,de
        ld      (__ldv_dvd_l),hl
        ld      de,(__ldv_dvd_h)
        ld      hl,0
        sbc     hl,de
        ld      (__ldv_dvd_h),hl
lmods_dvd_pos:
        ; If dvs negative: negate. dvs is no longer on the stack, so read
        ; its sign byte back from the scratch copy (address+1 = high byte).
        ld      a,(__ldv_dvs_h+1)
        bit     7,a
        jr      z,lmods_dvs_pos
        ld      de,(__ldv_dvs_l)
        ld      hl,0
        or      a
        sbc     hl,de
        ld      (__ldv_dvs_l),hl
        ld      de,(__ldv_dvs_h)
        ld      hl,0
        sbc     hl,de
        ld      (__ldv_dvs_h),hl
lmods_dvs_pos:
        call    __ludivmod_core
        ; Apply sign to remainder
        ld      a,(__ldv_sign)
        bit     7,a
        jr      z,lmods_pos_result
        ld      de,(__ldv_rem_l)
        ld      hl,0
        or      a
        sbc     hl,de
        ld      (__ldv_rem_l),hl
        ld      de,(__ldv_rem_h)
        ld      hl,0
        sbc     hl,de
        ld      (__ldv_rem_h),hl
lmods_pos_result:
        ld      hl,(__ldv_rem_l)
        ld      de,(__ldv_rem_h)
        ld      sp,ix
        pop     ix
        ret

; ---- 32-bit comparison functions ----
; Each returns HL=1 (true) or HL=0 (false).
; Caller cleanup (HL only): ex de,hl; ld hl,8; add hl,sp; ld sp,hl; ex de,hl

; Macro-like helper: load LHS_L into HL, RHS_L into DE, then
; load LHS_H into HL, RHS_H into DE after sbc.
; LHS at IX+8/10, RHS at IX+4/6.

        public  __ltu
__ltu:
        ; High word first: if it differs from the other operand's high
        ; word, its carry alone decides the 32-bit unsigned comparison
        ; and the low word is never read. Falls through to the low word
        ; only when the high words are equal.
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+10)
        ld      h,(ix+11)
        ld      e,(ix+6)
        ld      d,(ix+7)
        or      a
        sbc     hl,de
        jr      nz,ltu_tail
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+4)
        ld      d,(ix+5)
        or      a
        sbc     hl,de
ltu_tail:
        ld      hl,0
        jr      nc,ltu_done
        inc     l
ltu_done:
        pop     ix
        ret

        public  __leu
__leu:
        ; LHS <= RHS  <==>  NOT (LHS > RHS)  <==>  NOT (RHS < LHS)
        ; High word first, same early-exit as __ltu above.
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      e,(ix+10)
        ld      d,(ix+11)
        or      a
        sbc     hl,de
        jr      nz,leu_tail
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+8)
        ld      d,(ix+9)
        or      a
        sbc     hl,de
leu_tail:
        ; carry set iff RHS < LHS, i.e. LHS > RHS
        ld      hl,1
        jr      nc,leu_done ; RHS >= LHS, so LHS <= RHS: return 1
        ld      l,0
leu_done:
        pop     ix
        ret

        public  __lgu
__lgu:
        ; LHS > RHS  <==>  RHS < LHS
        ; High word first, same early-exit as __ltu above.
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      e,(ix+10)
        ld      d,(ix+11)
        or      a
        sbc     hl,de
        jr      nz,gtu_tail
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+8)
        ld      d,(ix+9)
        or      a
        sbc     hl,de
gtu_tail:
        ld      hl,0
        jr      nc,gtu_done
        inc     l
gtu_done:
        pop     ix
        ret

        public  __lku
__lku:
        ; LHS >= RHS  <==>  NOT (LHS < RHS)
        ; High word first, same early-exit as __ltu above.
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+10)
        ld      h,(ix+11)
        ld      e,(ix+6)
        ld      d,(ix+7)
        or      a
        sbc     hl,de
        jr      nz,geu_tail
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+4)
        ld      d,(ix+5)
        or      a
        sbc     hl,de
geu_tail:
        ld      hl,1
        jr      nc,geu_done
        ld      l,0
geu_done:
        pop     ix
        ret

; Signed comparisons: same as unsigned but check sign bits differently.
; For signed 32-bit a < b:
;   if sign(a) != sign(b): a < b iff a is negative
;   else: a - b has borrow (same as unsigned)
; Implemented as: (a - b) has "signed overflow" indicated by
;   (result sign != expected sign), or equivalently check
;   carry XOR overflow. Simpler: use sbc and check signed flags.
; Actually on Z80 for signed compare: after sbc hl,de on high word,
;   the S and P/V flags together indicate signed overflow.
;   Signed less-than: S xor P/V (i.e. jp m after XOR check).
;   But after 32-bit subtraction we only have the high-word flags.
;   The flags from the high-word sbc are sufficient for signed compare.

        public  __lts
__lts:
        ; High word first: the SIGNED comparison of the high words alone
        ; decides whenever they differ (the low word only ever refines a
        ; tie, and is compared unsigned since it is a pure magnitude
        ; extension). Falls through to the low word only when the high
        ; words are equal.
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+10)
        ld      h,(ix+11)
        ld      e,(ix+6)
        ld      d,(ix+7)
        or      a
        sbc     hl,de
        jr      z,lts_eq
        ; Signed less-than: S xor P/V
        ; jp pe = jump if parity/overflow set; jp m = jump if sign (negative)
        ld      hl,0
        jp      pe,lts_ov  ; overflow set
        jp      m,lts_true ; no overflow, negative  LHS < RHS
        jr      lts_done
lts_ov:
        jp      p,lts_true ; overflow + positive  LHS < RHS
        jr      lts_done
lts_eq:
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+4)
        ld      d,(ix+5)
        or      a
        sbc     hl,de
        ld      hl,0
        jr      nc,lts_done
lts_true:
        inc     l
lts_done:
        pop     ix
        ret

        public  __lks
__lks:
        ; LHS >= RHS: NOT (LHS < RHS)
        ; High word first, same early-exit as __lts above.
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+10)
        ld      h,(ix+11)
        ld      e,(ix+6)
        ld      d,(ix+7)
        or      a
        sbc     hl,de
        jr      z,ges_eq
        ld      hl,1
        jp      pe,ges_ov
        jp      m,ges_false
        jr      ges_done
ges_ov:
        jp      p,ges_false
        jr      ges_done
ges_eq:
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+4)
        ld      d,(ix+5)
        or      a
        sbc     hl,de
        ld      hl,1
        jr      nc,ges_done
ges_false:
        ld      l,0
ges_done:
        pop     ix
        ret

        public  __lgs
__lgs:
        ; LHS > RHS: RHS < LHS (swap operands, do signed-lt)
        ; High word first, same early-exit as __lts above.
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      e,(ix+10)
        ld      d,(ix+11)
        or      a
        sbc     hl,de
        jr      z,gts_eq
        ld      hl,0
        jp      pe,gts_ov
        jp      m,gts_true
        jr      gts_done
gts_ov:
        jp      p,gts_true
        jr      gts_done
gts_eq:
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+8)
        ld      d,(ix+9)
        or      a
        sbc     hl,de
        ld      hl,0
        jr      nc,gts_done
gts_true:
        inc     l
gts_done:
        pop     ix
        ret

        public  __les
__les:
        ; LHS <= RHS: NOT (RHS < LHS)
        ; High word first, same early-exit as __lts above.
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      e,(ix+10)
        ld      d,(ix+11)
        or      a
        sbc     hl,de
        jr      z,les_eq
        ld      hl,1
        jp      pe,les_ov
        jp      m,les_false
        jr      les_done
les_ov:
        jp      p,les_false
        jr      les_done
les_eq:
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+8)
        ld      d,(ix+9)
        or      a
        sbc     hl,de
        ld      hl,1
        jr      nc,les_done
les_false:
        ld      l,0
les_done:
        pop     ix
        ret

; ============================================================
; Heap allocator: first-fit, 3-byte block headers.
;
; Header layout:
;   byte 0-1 = user data size in bytes, unsigned 16-bit
;   byte 2   = flags: bit 0 set means free, zero means in use
;
; Older DCCRTL stored the free flag in bit 15 of the size word.  That made
; malloc(32768) unrepresentable: freeing such a block looked like freeing a
; zero-sized block and corrupted the heap walk.  Keep the flag in a separate
; byte instead.  The one-byte header cost is worth allowing any allocation that
; fits in CP/M memory.
;
; __hbase / __brk / __hlimit are set by start:.
; ============================================================

        public  _malloc
_malloc:
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+4)
        ld      h,(ix+5)        ; HL = requested size
        call    __mlh
        pop     ix
        ret

        public  __ckmul
; Internal: HL = a, DE = b.  Returns HL = a*b (low 16 bits) and carry set
; when the true product exceeds 65535 (16-bit size_t overflow).  Reuses the
; tested __mulu/__divu helpers: multiply, then verify product/b == a.
; Corrupts AF, BC, DE.  Does not use IX.
__ckmul:
        ld      a,h
        or      l
        jr      z,ck_zero       ; a == 0 -> product 0, no overflow
        ld      a,d
        or      e
        jr      z,ck_zero       ; b == 0 -> product 0, no overflow
        ld      (__ck_a),hl     ; save a
        push    de              ; save b
        call    __mulu          ; HL = a*b (mod 65536)
        pop     de              ; DE = b
        push    hl              ; save product
        call    __divu          ; HL = product / b
        ld      de,(__ck_a)
        or      a
        sbc     hl,de           ; quotient - a
        pop     hl              ; HL = product (POP preserves flags)
        ret     z               ; quotient == a -> no overflow (carry clear)
        scf                     ; mismatch -> overflow
        ret
ck_zero:
        ld      hl,0
        or      a               ; clear carry
        ret
__ck_a:         dw      0

        public  _calloc
_calloc:
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+4)
        ld      h,(ix+5)        ; HL = nmemb
        ld      e,(ix+6)
        ld      d,(ix+7)        ; DE = size
        call    __ckmul         ; HL = nmemb*size; carry set on overflow
        jr      c,ca_ovf        ; overflow -> behave like allocation failure
        call    __mlh     ; HL = ptr or 0; __ml_need = total size
        push    hl              ; save ptr for return
        ld      a,h
        or      l
        jr      z,ca_done       ; NULL: skip zero fill
        ; Zero fill __ml_need bytes starting at HL
        ld      de,(__ml_need)
        ld      b,d
        ld      c,e             ; BC = count
        ld      a,b
        or      c
        jr      z,ca_done       ; nothing to zero
        xor     a
        ld      (hl),a          ; write first zero
        dec     bc
        ld      a,b
        or      c
        jr      z,ca_done       ; count was 1
        ld      d,h
        ld      e,l
        inc     de              ; DE = ptr+1
        ldir                    ; fill remaining bytes
ca_done:
        pop     hl              ; return ptr (or 0)
        pop     ix
        ret
ca_ovf:
        ld      hl,0
        pop     ix
        ret


        public  __real
__real:
        push    ix
        ld      ix,0
        add     ix,sp

        ; realloc(NULL, size) is malloc(size).
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      a,h
        or      l
        jr      nz,rl_have_ptr
        ld      l,(ix+6)
        ld      h,(ix+7)
        call    __mlh
        pop     ix
        ret

rl_have_ptr:
        ld      (__rl_old),hl
        ld      l,(ix+6)
        ld      h,(ix+7)
        ; Round up to even (0 stays 0, so the realloc(ptr,0) check below
        ; still sees the caller's true zero), matching __mlh's own header
        ; format - see __wr_hf's header comment.
        ld      a,l
        and     1
        jr      z,rl_sz_even
        inc     hl
rl_sz_even:
        ld      (__rl_size),hl

        ; realloc(ptr, 0): free ptr and return NULL.
        ld      a,h
        or      l
        jr      nz,rl_alloc
        ld      hl,(__rl_old)
        call    __frcoal        ; free + coalesce, like _free
        ld      hl,0
        pop     ix
        ret

rl_alloc:
        ; Read old block's true user size from its 2-byte packed header at
        ; ptr-HDRSIZE.  It is a used block, so the flag bit is clear and the
        ; raw stored value already equals the true size.
        ld      hl,(__rl_old)
        ld      de,0-HDRSIZE
        add     hl,de
        ld      e,(hl)
        inc     hl
        ld      d,(hl)
        ld      (__rl_cnt),de           ; __rl_cnt = old user size

        ; ---- In-place fast paths (avoid allocate + copy + free) ----
        ld      hl,(__rl_cnt)           ; old size
        ld      de,(__rl_size)          ; new size (already rounded to even)
        or      a
        sbc     hl,de
        jp      c,rl_try_grow           ; new > old -> try growing in place
        ; new <= old: shrink or same size, in place.  HL = old - new = slack.
        ld      a,h
        or      a
        jr      nz,rl_shrink_split      ; slack >= 256 -> always split a tail
        ld      a,l
        cp      HDRSIZE+FTRSIZE+2
        jr      c,rl_keep_whole         ; slack too small to make a useful tail
rl_shrink_split:
        ; Shrink the block to the new size (used) - header+footer.
        ld      hl,(__rl_old)
        ld      de,0-HDRSIZE
        add     hl,de                   ; HL = header
        ld      (__rl_hdr),hl
        ld      de,(__rl_size)
        ld      b,d
        ld      c,e                     ; BC = new size (used, flag clear)
        ld      hl,(__rl_hdr)
        call    __wr_hf

        ; tail user size = slack - (HDRSIZE+FTRSIZE)
        ld      hl,(__rl_cnt)
        ld      de,(__rl_size)
        or      a
        sbc     hl,de                   ; HL = slack
        ld      de,HDRSIZE+FTRSIZE
        or      a
        sbc     hl,de                   ; HL = tail user size (true, even)
        ld      (__rl_tsz),hl

        ; tail header = ptr + new_size + FTRSIZE (right after the used
        ; part's own footer, just written above).
        ld      hl,(__rl_old)
        ld      de,(__rl_size)
        add     hl,de
        ld      de,FTRSIZE
        add     hl,de                   ; HL = tail header address
        ld      (__rl_thdr),hl

        ; Write the tail as USED (flag clear) - __frcoal below expects a
        ; used block (it reads the header without masking a flag bit, on
        ; the assumption the flag is currently 0) and does its own mark-
        ; free + coalesce; pre-marking it free here would make __frcoal
        ; double-count the flag bit as part of the size.
        ld      bc,(__rl_tsz)           ; BC = tail user size (true)
        ld      de,(__rl_tsz)           ; DE = packed(used) = tail_size
        ld      hl,(__rl_thdr)
        call    __wr_hf

        ; Coalesce the freed tail forward (and trim __brk if it is the top).
        ld      hl,(__rl_thdr)
        ld      de,HDRSIZE
        add     hl,de                   ; HL = tail user pointer
        call    __frcoal
        ld      hl,(__rl_old)
        pop     ix
        ret
rl_keep_whole:
        ld      hl,(__rl_old)
        pop     ix
        ret

rl_try_grow:
        ; new > old.  Grow in place only when this is the top heap block,
        ; i.e. its end (== ptr+old_size+FTRSIZE) is __brk, and the larger
        ; end still fits below __hlimit.
        ld      hl,(__rl_old)
        ld      de,(__rl_cnt)
        add     hl,de
        ld      de,FTRSIZE
        add     hl,de                   ; HL = block end = ptr+old_size+FTRSIZE
        ld      de,(__brk)
        or      a
        sbc     hl,de
        jp      nz,rl_do_alloc          ; not the top block
        ld      hl,(__rl_old)
        ld      de,(__rl_size)
        add     hl,de
        ld      de,FTRSIZE
        add     hl,de                   ; HL = new block end = ptr+new_size+FTRSIZE
        jp      c,rl_do_alloc           ; address wrap -> cannot grow here
        push    hl
        ld      de,(__hlimit)
        or      a
        sbc     hl,de                   ; new_end - hlimit
        pop     hl                      ; HL = new_end
        jr      c,rl_grow_ok            ; new_end < hlimit
        jr      z,rl_grow_ok            ; new_end == hlimit
        jp      rl_do_alloc             ; would overflow the heap limit
rl_grow_ok:
        ld      (__brk),hl              ; extend heap to the new end
        ld      hl,(__rl_old)
        ld      de,0-HDRSIZE
        add     hl,de                   ; HL = header
        ld      (__rl_hdr),hl
        ld      de,(__rl_size)
        ld      b,d
        ld      c,e                     ; BC = new size
        ld      hl,(__rl_hdr)
        call    __wr_hf                 ; header+footer, used, size=new
        ld      hl,(__rl_old)
        pop     ix
        ret

rl_do_alloc:
        ; Allocate the new block.  On failure, leave old block unchanged.
        ld      hl,(__rl_size)
        call    __mlh
        ld      (__rl_new),hl
        ld      a,h
        or      l
        jr      nz,rl_copy
        pop     ix
        ret

rl_copy:
        ; Copy min(old_size, new_size) bytes.
        ld      hl,(__rl_cnt)
        ld      de,(__rl_size)
        or      a
        sbc     hl,de           ; old_size - new_size
        jr      c,rl_count_ok   ; old < new: keep old_size
        ld      (__rl_cnt),de   ; new <= old: use new_size
rl_count_ok:
        ld      bc,(__rl_cnt)
        ld      a,b
        or      c
        jr      z,rl_free_old
        ld      hl,(__rl_old)
        ld      de,(__rl_new)
        ldir

rl_free_old:
        ld      hl,(__rl_old)
        call    __frcoal        ; free + coalesce old block, like _free
        ld      hl,(__rl_new)
        pop     ix
        ret

__rl_old:       dw      0
__rl_new:       dw      0
__rl_size:      dw      0
__rl_cnt:       dw      0
__rl_hdr:       dw      0
__rl_tsz:       dw      0
__rl_thdr:      dw      0

        public  _free
_free:
        ; void free(void *ptr) - single pointer argument; IX-free leaf.
        pop     bc
        pop     hl              ; HL = ptr
        push    hl
        push    bc
        call    __frcoal        ; mark free + coalesce neighbours (handles NULL)
        ret

        public  __frcoal
; Internal: HL = user pointer (may be NULL).  Marks the block free and merges
; it with an immediately-preceding free block and any following free blocks.
; Shared by _free and realloc so every free path keeps the heap coalesced;
; malloc's first-fit walk does not itself merge adjacent free blocks.
;
; The preceding block's identity is found in O(1) via its footer - the 2
; bytes immediately before this block's own header - instead of a linear
; scan from __hbase; see __wr_hf's header comment for the packed
; header/footer format this depends on.
; Corrupts AF, BC, DE, HL.  Does not use IX.
__frcoal:
        ld      a,h
        or      l
        ret     z               ; NULL: do nothing
        ld      de,0-HDRSIZE
        add     hl,de           ; HL = header address
        ld      (__fr_hdr),hl

        ; Mark this block free: its packed value's flag bit is currently
        ; clear (used), so the raw stored bytes already equal its true
        ; size - set bit 0 and rewrite header+footer together.
        ld      e,(hl)
        inc     hl
        ld      d,(hl)          ; DE = packed (used, so DE == true size)
        ld      b,d
        ld      c,e             ; BC = true size (for __wr_hf)
        set     0,e             ; DE = packed(free) = size|1
        ld      hl,(__fr_hdr)
        call    __wr_hf

        ; O(1) predecessor check: unless this is the very first heap block,
        ; read the 2 bytes just before our own header - the preceding
        ; block's footer - to see if it is free.
        ld      hl,(__fr_hdr)
        ld      de,(__hbase)
        or      a
        sbc     hl,de
        jp      z,fr_coal       ; this IS the first block: no predecessor

        ld      hl,(__fr_hdr)
        ld      de,FTRSIZE
        or      a
        sbc     hl,de           ; HL = preceding block's footer address
        ld      e,(hl)
        inc     hl
        ld      d,(hl)          ; DE = preceding block's packed footer value
        ld      a,e
        and     1
        jr      z,fr_coal       ; preceding block is used: nothing to merge

        ; Preceding block is free: its header sits (HDRSIZE+FTRSIZE+size)
        ; bytes before our own header.
        ld      a,e
        and     0feh
        ld      e,a             ; DE = true preceding size
        ld      hl,(__fr_hdr)
        ld      bc,0-(HDRSIZE+FTRSIZE)
        add     hl,bc
        or      a
        sbc     hl,de           ; HL = preceding block's header address
        ld      (__fr_hdr),hl   ; it becomes the coalescing anchor

fr_coal:
        ; Merge any immediately following free blocks.  Never read a next
        ; header unless next < __brk; next == __brk means this is the tail.
        ld      hl,(__fr_hdr)
        ld      e,(hl)
        inc     hl
        ld      d,(hl)          ; DE = anchor packed value (flag=1, free)
        ld      a,e
        and     0feh
        ld      e,a             ; DE = true anchor size
        ld      (__fr_csz),de
        ld      hl,(__fr_hdr)
        ld      bc,HDRSIZE+FTRSIZE
        add     hl,bc
        add     hl,de           ; HL = next block header
        push    hl
        ld      de,(__brk)
        or      a
        sbc     hl,de           ; carry iff next < __brk
        pop     hl              ; HL = next block header
        jr      nc,fr_done      ; next >= __brk: no following block

        ld      e,(hl)
        inc     hl
        ld      d,(hl)          ; DE = next block's packed value
        ld      a,e
        and     1
        jr      z,fr_done       ; next block is used

        ld      a,e
        and     0feh
        ld      e,a             ; DE = true next size

        ; merged_size = anchor_size + HDRSIZE + FTRSIZE + next_size
        ld      hl,(__fr_csz)
        ld      bc,HDRSIZE+FTRSIZE
        add     hl,bc
        add     hl,de           ; HL = merged size (true, even)
        ld      b,h
        ld      c,l             ; BC = merged size
        ld      d,h
        ld      e,l
        set     0,e             ; DE = packed(free) = merged_size|1
        ld      hl,(__fr_hdr)
        call    __wr_hf         ; rewrites the anchor header + a new, farther
                                 ; out footer for the merged block
        jr      fr_coal
fr_done:
        ; Heap trim: if the (coalesced) free block ends exactly at __brk it is
        ; the top block, so lower __brk to its header.  This returns the space
        ; to the heap/stack gap instead of leaving a stranded top free block,
        ; so the heap high-water mark falls when the top block is released.
        ld      hl,(__fr_hdr)
        ld      e,(hl)
        inc     hl
        ld      d,(hl)                  ; DE = anchor packed value
        ld      a,e
        and     0feh
        ld      e,a                     ; DE = true anchor size
        ld      hl,(__fr_hdr)
        ld      bc,HDRSIZE+FTRSIZE
        add     hl,bc
        add     hl,de                   ; HL = anchor block end
        ld      de,(__brk)
        or      a
        sbc     hl,de                   ; anchor_end - __brk
        ret     nz                      ; not the top block: keep as free block
        ld      hl,(__fr_hdr)
        ld      (__brk),hl              ; drop the heap high-water mark
        ret

__fr_hdr:       dw      0
__fr_csz:       dw      0

        public  __mlh
; Internal: HL = requested size (0 treated as 2; odd sizes rounded up to
; the next even value - see __wr_hf's header comment for why). Returns
; HL = ptr or 0. Corrupts AF, BC, DE, HL. Does not use/save IX.
; Separate public block: _malloc/_calloc reference this helper, but _free
; and programs that only need heap-limit startup state do not pull it in.
__mlh:
        ld      a,l
        and     1
        jr      z,mh_rnd_ok
        inc     hl
mh_rnd_ok:
        ld      a,h
        or      l
        jr      nz,mh_sz_ok
        ld      l,2             ; size 0 -> 2
mh_sz_ok:
        ld      (__ml_need),hl

        ; Walk free list from __hbase to __brk
        ld      hl,(__hbase)
        ld      (__ml_p),hl

mh_walk:
        ; Stop if walk pointer has reached (or passed) __brk
        ld      hl,(__brk)
        ld      de,(__ml_p)
        or      a
        sbc     hl,de           ; HL = brk - p; carry if p > brk
        jp      z,mh_extend
        jp      c,mh_extend

        ; Read the 2-byte packed header at __ml_p: DE = size|flag.
        ld      hl,(__ml_p)
        ld      e,(hl)
        inc     hl
        ld      d,(hl)

        ld      a,e
        and     1
        jr      z,mh_used

        ; --- Free block --- DE currently holds size|1; mask to true size.
        ld      a,e
        and     0feh
        ld      e,a
        ld      (__ml_usiz),de  ; save true size in case block is too small

        ; Compare user_size (DE) >= need (HL = __ml_need)
        ld      hl,(__ml_need)
        ex      de,hl           ; HL = user_size, DE = need
        or      a
        sbc     hl,de           ; HL = user_size - need; carry if too small
        jr      c,mh_skip_free

        ; Block fits. HL = remainder (even), DE = need. Split only if the
        ; remainder can hold a useful (>=2 byte) free block of its own,
        ; i.e. remainder >= HDRSIZE+FTRSIZE+2.
        ld      a,h
        or      a
        jr      nz,mh_split     ; high byte != 0 -> remainder >= 256 -> always split
        ld      a,l
        cp      HDRSIZE+FTRSIZE+2
        jr      nc,mh_split

        ; No split: use whole block. Restore user_size = need + remainder,
        ; then write it back as used - flag bit clear, so the packed value
        ; is just the size unchanged.
        ex      de,hl           ; HL = need, DE = remainder
        add     hl,de           ; HL = user_size (true, even)
        ld      b,h
        ld      c,l             ; BC = user_size
        ld      d,h
        ld      e,l             ; DE = packed(used) = user_size unchanged
        ld      hl,(__ml_p)
        call    __wr_hf
        ld      hl,(__ml_p)
        ld      de,HDRSIZE
        add     hl,de
        ret

mh_split:
        ; HL = remainder, DE = need. Write the used header+footer for the
        ; 'need'-sized part first (__wr_hf leaves DE/BC untouched).
        push    hl              ; save remainder
        ld      b,d
        ld      c,e             ; BC = need (size arg; DE already packed(used))
        ld      hl,(__ml_p)
        call    __wr_hf
        pop     hl              ; HL = remainder (DE is still need)

        ; New free block header = __ml_p + HDRSIZE + need + FTRSIZE (right
        ; after the used part's own footer, which spans need's own end -
        ; not immediately after its data, or the free header would alias
        ; that footer).
        push    hl              ; save remainder
        ld      hl,(__ml_p)
        ld      bc,HDRSIZE+FTRSIZE
        add     hl,bc
        add     hl,de
        ld      (__ml_fp),hl    ; new free block's header address
        pop     hl              ; HL = remainder

        ; New free block's user_size = remainder - (HDRSIZE+FTRSIZE); its
        ; own footer lands exactly at the original block's unmoved footer
        ; (the arithmetic is verified in __wr_hf's header comment context).
        ld      de,HDRSIZE+FTRSIZE
        or      a
        sbc     hl,de           ; HL = new free user_size (true, even)
        ld      b,h
        ld      c,l             ; BC = new free user_size
        ld      d,h
        ld      e,l
        set     0,e             ; DE = packed(free) = user_size|1
        ld      hl,(__ml_fp)
        call    __wr_hf

        ; Return __ml_p + HDRSIZE
        ld      hl,(__ml_p)
        ld      de,HDRSIZE
        add     hl,de
        ret

mh_skip_free:
        ; Free but too small: advance by HDRSIZE + FTRSIZE + user_size
        ld      hl,(__ml_p)
        ld      de,(__ml_usiz)
        ld      bc,HDRSIZE+FTRSIZE
        add     hl,bc
        add     hl,de
        ld      (__ml_p),hl
        jp      mh_walk

mh_used:
        ; Used block. DE = packed header value; flag bit is clear so DE is
        ; already the true user_size.
        ld      hl,(__ml_p)
        ld      bc,HDRSIZE+FTRSIZE
        add     hl,bc
        add     hl,de
        ld      (__ml_p),hl
        jp      mh_walk

mh_extend:
        ; No free block found. Extend heap upward.
        ; Check: brk + HDRSIZE + FTRSIZE + need <= heap_limit
        ld      hl,(__brk)
        ld      (__ml_p),hl     ; save old brk (reuse __ml_p)
        ld      de,(__ml_need)
        add     hl,de
        jp      c,mh_oom        ; 16-bit wrap means the block cannot fit
        ld      de,HDRSIZE+FTRSIZE
        add     hl,de           ; HL = brk + need + HDRSIZE + FTRSIZE
        jp      c,mh_oom        ; header/footer addition wrapped past 0ffffh
        ; Require new_brk <= __hlimit.  HL is the exclusive end of
        ; the allocation (old brk + header + user size + footer).
        ; This comparison deliberately avoids computing hlimit+1, which
        ; itself can wrap when the CP/M stack starts near FFFFh.
        ld      de,(__hlimit)
        or      a
        sbc     hl,de           ; carry if end < limit, z if end == limit
        jr      c,mh_extend_ok
        jr      z,mh_extend_ok
        jr      mh_oom

mh_extend_ok:

        ; Write used header+footer at old brk (packed(used) == need, since
        ; need is already even and the flag bit is 0 for used).
        ld      de,(__ml_need)
        ld      b,d
        ld      c,e
        ld      hl,(__ml_p)
        call    __wr_hf
        ; Advance brk: new_brk = old_brk + HDRSIZE + FTRSIZE + need
        ld      hl,(__ml_p)
        ld      de,HDRSIZE+FTRSIZE
        add     hl,de
        ld      de,(__ml_need)
        add     hl,de
        ld      (__brk),hl
        ; Return old_brk + HDRSIZE
        ld      hl,(__ml_p)
        ld      de,HDRSIZE
        add     hl,de
        ret

mh_oom:
        ld      hl,0
        ret

; Allocator temporaries
__ml_need:      dw      0
__ml_p:         dw      0
__ml_usiz:      dw      0
__ml_fp:        dw      0

        public  __lmd
__lmd:
; ---- scratch data for long arithmetic ----
__lm_lhs_l:     dw      0
__lm_lhs_h:     dw      0
__lm_rhs_l:     dw      0
__lm_rhs_h:     dw      0
__lm_res_l:     dw      0
__lm_res_h:     dw      0

__ldv_dvs_l:    dw      0
__ldv_dvs_h:    dw      0
__ldv_dvd_l:    dw      0
__ldv_dvd_h:    dw      0
__ldv_rem_l:    dw      0
__ldv_rem_h:    dw      0
__ldv_quo_l:    dw      0
__ldv_quo_h:    dw      0
__ldv_sign:     db      0

; ============================================================
; Character classification and conversion
; ============================================================

; ---- _toupper(int c) ----
; Returns c converted to upper-case if 'a'<=c<='z', else c unchanged.
; Arg: c @ IX+4/5.  Return: HL = result.
        public  __ctu
__ctu:
        ld      hl,2
        add     hl,sp
        ld      a,(hl)          ; A = c low byte
        inc     hl
        ld      h,(hl)          ; H = c high byte
        ld      l,a             ; HL = c (full int)
        cp      'a'             ; c < 'a' -> leave as-is
        jr      c,toup_done
        cp      'z'+1           ; c > 'z' -> leave as-is
        jr      nc,toup_done
        sub     20h             ; lowercase -> uppercase
        ld      l,a
        ld      h,0
toup_done:
        ret

; ---- _isspace(int c) ----
; Returns HL=1 if c is a whitespace character, HL=0 otherwise.
; Recognises: SP HT LF VT FF CR.
        public  __csp
__csp:
        ld      hl,2
        add     hl,sp
        ld      a,(hl)
        cp      ' '
        jr      z,issp_yes
        cp      09h             ; HT
        jr      z,issp_yes
        cp      0ah             ; LF
        jr      z,issp_yes
        cp      0bh             ; VT
        jr      z,issp_yes
        cp      0ch             ; FF
        jr      z,issp_yes
        cp      0dh             ; CR
        jr      z,issp_yes
        ld      hl,0
        ret
issp_yes:
        ld      hl,1
        ret

; ---- _isdigit(int c) ----
; Returns HL=1 if '0'<=c<='9', HL=0 otherwise.
        public  __cdg
__cdg:
        ld      hl,2
        add     hl,sp
        ld      a,(hl)
        cp      '0'
        jr      c,isdig_no
        cp      '9'+1
        jr      nc,isdig_no
        ld      hl,1
        ret
isdig_no:
        ld      hl,0
        ret

; ---- ctype helpers with short external names for M80/L80 ----
; All take int c at IX+4/5 and return HL=1/0 except __ctl.

        public  __caa
__caa:
        ld      hl,2
        add     hl,sp
        ld      a,(hl)
        cp      'A'
        jr      c,ialp_no
        cp      'Z'+1
        jr      c,ialp_yes
        cp      'a'
        jr      c,ialp_no
        cp      'z'+1
        jr      c,ialp_yes
ialp_no:
        ld      hl,0
        ret
ialp_yes:
        ld      hl,1
        ret

        public  __can
__can:
        ld      hl,2
        add     hl,sp
        ld      a,(hl)
        cp      '0'
        jr      c,ialn_alpha
        cp      '9'+1
        jr      c,ialn_yes
ialn_alpha:
        cp      'A'
        jr      c,ialn_no
        cp      'Z'+1
        jr      c,ialn_yes
        cp      'a'
        jr      c,ialn_no
        cp      'z'+1
        jr      c,ialn_yes
ialn_no:
        ld      hl,0
        ret
ialn_yes:
        ld      hl,1
        ret

        public  __cup
__cup:
        ld      hl,2
        add     hl,sp
        ld      a,(hl)
        cp      'A'
        jr      c,isup_no
        cp      'Z'+1
        jr      nc,isup_no
        ld      hl,1
        ret
isup_no:
        ld      hl,0
        ret

        public  __clo
__clo:
        ld      hl,2
        add     hl,sp
        ld      a,(hl)
        cp      'a'
        jr      c,islo_no
        cp      'z'+1
        jr      nc,islo_no
        ld      hl,1
        ret
islo_no:
        ld      hl,0
        ret

        public  __cxd
__cxd:
        ld      hl,2
        add     hl,sp
        ld      a,(hl)
        cp      '0'
        jr      c,ixdg_alpha
        cp      '9'+1
        jr      c,ixdg_yes
ixdg_alpha:
        cp      'A'
        jr      c,ixdg_lower
        cp      'F'+1
        jr      c,ixdg_yes
ixdg_lower:
        cp      'a'
        jr      c,ixdg_no
        cp      'f'+1
        jr      c,ixdg_yes
ixdg_no:
        ld      hl,0
        ret
ixdg_yes:
        ld      hl,1
        ret

        public  __cpr
__cpr:
        ld      hl,2
        add     hl,sp
        ld      a,(hl)
        cp      20h
        jr      c,iprt_no
        cp      7fh
        jr      nc,iprt_no
        ld      hl,1
        ret
iprt_no:
        ld      hl,0
        ret

        public  __cct
__cct:
        ld      hl,2
        add     hl,sp
        ld      a,(hl)
        cp      20h
        jr      c,icnt_yes
        cp      7fh
        jr      z,icnt_yes
        ld      hl,0
        ret
icnt_yes:
        ld      hl,1
        ret

        public  __cpu
__cpu:
        ld      hl,2
        add     hl,sp
        ld      a,(hl)
        ; printable, not space, and not alnum
        cp      21h
        jr      c,ipnc_no
        cp      7fh
        jr      nc,ipnc_no
        cp      '0'
        jr      c,ipnc_yes
        cp      '9'+1
        jr      c,ipnc_no
        cp      'A'
        jr      c,ipnc_yes
        cp      'Z'+1
        jr      c,ipnc_no
        cp      'a'
        jr      c,ipnc_yes
        cp      'z'+1
        jr      c,ipnc_no
ipnc_yes:
        ld      hl,1
        ret
ipnc_no:
        ld      hl,0
        ret

        public  __ctl
__ctl:
        ld      hl,2
        add     hl,sp
        ld      a,(hl)          ; A = c low byte
        inc     hl
        ld      h,(hl)          ; H = c high byte
        ld      l,a             ; HL = c (full int)
        cp      'A'
        jr      c,tolo_done
        cp      'Z'+1
        jr      nc,tolo_done
        add     a,20h
        ld      l,a
        ld      h,0
tolo_done:
        ret

; ---- _fgets(char *buf, int size, FILE *fp) ----
; fp < 3 (stdin/stdout/stderr)  read from console via BDOS fn 1.
; fp >= 3 (real file)  read char-by-char using _read.
; Returns HL = buf on success, HL = 0 at EOF or if size <= 0.
; Args: buf @ IX+4/5,  size @ IX+6/7,  fp @ IX+8/9.
        public  _fgets
_fgets:
        push    ix
        ld      ix,0
        add     ix,sp

        ; if size <= 0 return NULL immediately
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      a,h
        or      l
        jp      z,fgets_null

        ; dispatch on fp: < 3  console, >= 3  file
        ld      a,(ix+8)
        cp      FIRSTFD
        jp      c,fgets_con

        ; ---- File path ----
        ; Check EOF flag for this slot
        sub     FIRSTFD                 ; A = slot
        ld      h,0
        ld      l,a
        ld      de,__fdeof
        add     hl,de
        ld      a,(hl)
        or      a
        jp      nz,fgets_null           ; already at EOF

        ; Set up: rem = size-1, ptr = buf, start = buf
        ld      l,(ix+6)
        ld      h,(ix+7)
        dec     hl
        ld      (__fgets_rem),hl
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      (__fgets_ptr),hl
        ld      (__fgets_start),hl

fgf_loop:
        ld      hl,(__fgets_rem)
        ld      a,h
        or      l
        jp      z,fgets_term            ; buffer full

        ; Check pushback buffer before calling _read.
        ld      a,(ix+8)                ; fd (low byte)
        cp      UGC_MAX
        jr      nc,fgf_no_pb
        ld      l,a
        ld      h,0
        ld      de,__ugv
        add     hl,de
        ld      a,(hl)
        or      a
        jr      z,fgf_no_pb
        xor     a
        ld      (hl),a                  ; consume: clear valid flag
        ld      l,(ix+8)
        ld      h,0
        ld      de,__ugc
        add     hl,de
        ld      a,(hl)
        ld      (__fgets_ch),a          ; treat as if _read returned it
        jr      fgf_have_ch

fgf_no_pb:
        ; _read(fp, &__fgets_ch, 1)
        ld      hl,1
        push    hl                      ; count=1
        ld      hl,__fgets_ch
        push    hl                      ; buf
        ld      l,(ix+8)
        ld      h,(ix+9)
        push    hl                      ; fp
        call    _read
        ex      de,hl                   ; DE = bytes read
        ld      hl,6
        add     hl,sp
        ld      sp,hl                   ; clean 3 args
        ex      de,hl                   ; HL = bytes read

        ld      a,h
        or      l
        jr      z,fgf_eof               ; read 0 bytes  EOF

fgf_have_ch:
        ld      a,(__fgets_ch)
        cp      1ah                     ; Ctrl-Z = CP/M EOF marker
        jr      z,fgf_eof

        ; store char
        ld      hl,(__fgets_ptr)
        ld      (hl),a
        inc     hl
        ld      (__fgets_ptr),hl
        ld      hl,(__fgets_rem)
        dec     hl
        ld      (__fgets_rem),hl
        cp      0ah                     ; LF  end of line
        jr      z,fgets_term
        jr      fgf_loop

fgf_eof:
        ; set EOF flag for this slot
        ld      a,(ix+8)
        sub     FIRSTFD
        ld      h,0
        ld      l,a
        ld      de,__fdeof
        add     hl,de
        ld      (hl),1
        ; if no chars were stored  return NULL
        ld      hl,(__fgets_ptr)
        ld      de,(__fgets_start)
        or      a
        sbc     hl,de
        jp      z,fgets_null            ; ptr == start  nothing read
        ; else: NUL-terminate and return buf
        jr      fgets_term

        ; ---- Console path ----
fgets_con:
        ; HL still = size (loaded at top); compute rem = size-1
        ld      l,(ix+6)
        ld      h,(ix+7)
        dec     hl
        ld      (__fgets_rem),hl
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      (__fgets_ptr),hl
        call    __cflush                ; show any pending prompt before input

fgets_loop:
        ld      hl,(__fgets_rem)
        ld      a,h
        or      l
        jr      z,fgets_term

        ld      c,1
        call    5                       ; BDOS fn 1: console input  A

        cp      1ah                     ; Ctrl-Z  EOF
        jr      z,fgets_term

        cp      0dh                     ; CR  translate to LF, end line
        jr      nz,fgets_store
        ld      e,0ah
        ld      c,2
        call    5                       ; echo LF
        ld      a,0ah

fgets_store:
        ld      b,a
        ld      hl,(__fgets_ptr)
        ld      (hl),b
        inc     hl
        ld      (__fgets_ptr),hl
        ld      hl,(__fgets_rem)
        dec     hl
        ld      (__fgets_rem),hl
        ld      a,b
        cp      0ah
        jr      z,fgets_term
        jr      fgets_loop

fgets_term:
        ld      hl,(__fgets_ptr)
        ld      (hl),0
        ld      l,(ix+4)
        ld      h,(ix+5)
        pop     ix
        ret

fgets_null:
        ld      hl,0
        pop     ix
        ret

__fgets_ptr:    dw      0
__fgets_rem:    dw      0
__fgets_ch:     db      0
__fgets_start:  dw      0

; ---- _gets(char *buf) ----
; Reads a line from stdin/console. Equivalent to fgets(buf, 32767, stdin)
; with the trailing newline stripped.
; Returns HL = buf on success, HL = 0 at EOF.
; Arg: buf @ IX+4/5
        public  _gets
_gets:
        push    ix
        ld      ix,0
        add     ix,sp

        ; call _fgets(buf, 32767, 0)  -- fp=0 routes to console path
        ld      hl,0
        push    hl                      ; fp = 0 (stdin)
        ld      hl,7fffh
        push    hl                      ; size = 32767
        ld      l,(ix+4)
        ld      h,(ix+5)
        push    hl                      ; buf
        call    _fgets
        ex      de,hl                   ; DE = fgets result
        ld      hl,6
        add     hl,sp
        ld      sp,hl                   ; clean 3 args
        ex      de,hl                   ; HL = fgets result (buf or 0)

        ld      a,h
        or      l
        jr      z,gets_null

        ; strip trailing LF from the returned string
        push    hl                      ; save buf start
gets_scan:
        ld      a,(hl)
        or      a
        jr      z,gets_done             ; end of string, no LF to strip
        cp      0ah                     ; LF?
        jr      z,gets_strip
        inc     hl
        jr      gets_scan
gets_strip:
        ld      (hl),0                  ; overwrite LF with NUL
gets_done:
        pop     hl                      ; restore buf start
        pop     ix
        ret

gets_null:
        ld      hl,0
        pop     ix
        ret

; ============================================================
; _sprintf(buf, fmt, ...)
; IX+4=buf, IX+6=fmt, IX+8=first vararg
; ============================================================
        public  _sprintf
_sprintf:
        push    ix
        ld      ix,0
        add     ix,sp
        push    bc
        push    de
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      (pf_bufptr),hl          ; pf_bufptr = buf
        ld      hl,0FFFFh
        ld      (pf_sink),hl            ; buffer mode
        ld      l,(ix+6)
        ld      h,(ix+7)                ; HL = fmt (second arg)
        ld      de,8                    ; first vararg at IX+8
        ld      bc,0
        call    __pf_run                ; IX = _sprintf's frame; varargs at IX+8+
        ld      hl,(pf_bufptr)
        ld      (hl),0                  ; NUL-terminate
        ld      h,b
        ld      l,c                     ; return count
        pop     de
        pop     bc
        pop     ix
        ret

; ============================================================
; _snprintf(buf, n, fmt, ...)   C99
; IX+4=buf, IX+6=n (size_t), IX+8=fmt, IX+10=first vararg
; pf_bufmax caps pf_bufcnt at n-1 (room for the NUL) so pf_emit_a's bounded
; path (pfe_bufn) never overflows buf; n=0 leaves buf completely untouched,
; not even a NUL, per C99. Returns the count as if the buffer were unbounded
; (BC, from __pf_run) - same value _sprintf returns, snprintf just also caps
; what actually lands in buf.
; ============================================================
        public  _snprintf
_snprintf:
        push    ix
        ld      ix,0
        add     ix,sp
        push    bc
        push    de
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      (pf_bufptr),hl          ; pf_bufptr = buf
        ld      l,(ix+6)
        ld      h,(ix+7)                ; HL = n
        ld      a,h
        or      l
        jr      z,snp_n_zero            ; n=0: cap stays 0, nothing gets written
        dec     hl                      ; cap = n-1 (room for the NUL)
snp_n_zero:
        ld      (pf_bufmax),hl
        ld      hl,0
        ld      (pf_bufcnt),hl
        ld      hl,1
        ld      (pf_sink),hl            ; bounded-buffer mode
        ld      l,(ix+8)
        ld      h,(ix+9)                ; HL = fmt
        ld      de,10                   ; first vararg at IX+10
        ld      bc,0
        call    __pf_run                ; IX = _snprintf's frame; varargs at IX+10+
        ld      l,(ix+6)
        ld      h,(ix+7)                ; reload n (IX still points at our frame)
        ld      a,h
        or      l
        jr      z,snp_done              ; n=0: buf untouched, not even a NUL
        ld      hl,(pf_bufptr)
        ld      (hl),0                  ; NUL-terminate at the truncation point
snp_done:
        ld      h,b
        ld      l,c                     ; return count (as if unbounded, per C99)
        pop     de
        pop     bc
        pop     ix
        ret

; ============================================================
; _fprintf(fp, fmt, ...)
; IX+4=fp, IX+6=fmt, IX+8=first vararg
; Formats into __pf_fbuf, then writes to fp via _write.
; ============================================================
        public  _fprintf
_fprintf:
        push    ix
        ld      ix,0
        add     ix,sp
        push    bc
        push    de

        ; For stdout/stderr, stream directly to the console.  The old path
        ; formatted into the fixed 256-byte __pf_fbuf and then called _write;
        ; that was fragile for status/progress output and any longer fprintf.
        ld      a,(ix+4)
        cp      1
        jr      z,fpcn
        cp      2
        jr      z,fpcn

        ld      hl,__pf_fbuf
        ld      (pf_bufptr),hl          ; output to static buffer
        ld      hl,0FFFFh
        ld      (pf_sink),hl            ; buffer mode
        ld      l,(ix+6)
        ld      h,(ix+7)                ; HL = fmt
        ld      de,8                    ; first vararg at IX+8
        ld      bc,0
        call    __pf_run                ; IX = _fprintf's frame
        ld      h,b
        ld      l,c
        ld      (__pf_cnt),hl           ; save count
        ld      hl,(pf_bufptr)
        ld      (hl),0                  ; NUL-terminate
        ; _write(fp, __pf_fbuf, count)
        ld      hl,(__pf_cnt)
        push    hl                      ; count
        ld      hl,__pf_fbuf
        push    hl                      ; buf
        ld      l,(ix+4)
        ld      h,(ix+5)
        push    hl                      ; fp
        call    _write
        ex      de,hl
        ld      hl,6
        add     hl,sp
        ld      sp,hl                   ; clean 3 args
        ld      hl,(__pf_cnt)           ; return char count
        pop     de
        pop     bc
        pop     ix
        ret

fpcn:
        ld      hl,0
        ld      (pf_sink),hl            ; direct console mode
        ld      l,(ix+6)
        ld      h,(ix+7)                ; HL = fmt
        ld      de,8
        ld      bc,0
        call    __pf_run
        ld      h,b
        ld      l,c
        pop     de
        pop     bc
        pop     ix
        ret

; ============================================================
; The v* formatted-output family.  C89 7.9.6.7-9.  Each takes a va_list
; (a char* pointing at the first remaining argument) instead of inline
; varargs.  They reuse __pf_run unchanged: that body fetches each argument
; via "HL = IX + DE" (DE = byte offset, auto-incremented), so pointing IX at
; the va_list and starting DE at 0 makes it read straight from the list.
; The va_list pointer is consumed but, like the rest of this runtime, the
; caller's copy is not updated (single forward pass).
; ============================================================

; int vprintf(const char *fmt, va_list ap)   IX+4=fmt, IX+6=ap
        public  _vprintf
_vprintf:
        push    ix
        ld      ix,0
        add     ix,sp
        push    bc
        push    de
        ld      hl,0
        ld      (pf_sink),hl            ; console mode
        ld      l,(ix+6)
        ld      h,(ix+7)                ; HL = ap
        push    hl
        ld      l,(ix+4)
        ld      h,(ix+5)                ; HL = fmt
        pop     ix                      ; IX = ap; __pf_run reads args at IX+DE
        ld      de,0                    ; first vararg at IX+0
        ld      bc,0
        call    __pf_run
        ld      h,b
        ld      l,c                     ; return char count
        pop     de
        pop     bc
        pop     ix
        ret

; int vsprintf(char *buf, const char *fmt, va_list ap)  IX+4=buf,6=fmt,8=ap
        public  _vsprintf
_vsprintf:
        push    ix
        ld      ix,0
        add     ix,sp
        push    bc
        push    de
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      (pf_bufptr),hl          ; pf_bufptr = buf
        ld      hl,0FFFFh
        ld      (pf_sink),hl            ; buffer mode
        ld      l,(ix+8)
        ld      h,(ix+9)                ; HL = ap
        push    hl
        ld      l,(ix+6)
        ld      h,(ix+7)                ; HL = fmt
        pop     ix                      ; IX = ap
        ld      de,0
        ld      bc,0
        call    __pf_run
        ld      hl,(pf_bufptr)
        ld      (hl),0                  ; NUL-terminate
        ld      h,b
        ld      l,c                     ; return count
        pop     de
        pop     bc
        pop     ix
        ret

; int vsnprintf(char *buf, size_t n, const char *fmt, va_list ap)   C99
; IX+4=buf, IX+6=n, IX+8=fmt, IX+10=ap
; Same pf_bufmax/pf_bufcnt bounded-write scheme as _snprintf, but IX gets
; repointed at ap (like _vsprintf) for __pf_run's vararg reads, so n is saved
; on the stack across the call instead of being re-read via IX afterward.
        public  _vsnprintf
_vsnprintf:
        push    ix
        ld      ix,0
        add     ix,sp
        push    bc
        push    de
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      (pf_bufptr),hl          ; pf_bufptr = buf
        ld      l,(ix+6)
        ld      h,(ix+7)                ; HL = n
        push    hl                      ; save n across the call (IX becomes ap below)
        ld      a,h
        or      l
        jr      z,vsnp_n_zero           ; n=0: cap stays 0, nothing gets written
        dec     hl                      ; cap = n-1 (room for the NUL)
vsnp_n_zero:
        ld      (pf_bufmax),hl
        ld      hl,0
        ld      (pf_bufcnt),hl
        ld      hl,1
        ld      (pf_sink),hl            ; bounded-buffer mode
        ld      l,(ix+10)
        ld      h,(ix+11)               ; HL = ap
        push    hl
        ld      l,(ix+8)
        ld      h,(ix+9)                ; HL = fmt
        pop     ix                      ; IX = ap
        ld      de,0
        ld      bc,0
        call    __pf_run
        pop     hl                      ; HL = saved n
        ld      a,h
        or      l
        jr      z,vsnp_done             ; n=0: buf untouched, not even a NUL
        ld      hl,(pf_bufptr)
        ld      (hl),0                  ; NUL-terminate at the truncation point
vsnp_done:
        ld      h,b
        ld      l,c                     ; return count (as if unbounded, per C99)
        pop     de
        pop     bc
        pop     ix
        ret

; int vfprintf(FILE *fp, const char *fmt, va_list ap)   IX+4=fp,6=fmt,8=ap
        public  _vfprintf
_vfprintf:
        push    ix
        ld      ix,0
        add     ix,sp
        push    bc
        push    de
        ; stdout/stderr stream straight to the console (see _fprintf).
        ld      a,(ix+4)
        cp      1
        jr      z,vfpcn
        cp      2
        jr      z,vfpcn

        ld      l,(ix+4)
        ld      h,(ix+5)                ; fp
        push    hl                      ; save fp (IX is about to become ap)
        ld      hl,__pf_fbuf
        ld      (pf_bufptr),hl          ; output to static buffer
        ld      hl,0FFFFh
        ld      (pf_sink),hl            ; buffer mode
        ld      l,(ix+8)
        ld      h,(ix+9)                ; HL = ap
        push    hl
        ld      l,(ix+6)
        ld      h,(ix+7)                ; HL = fmt
        pop     ix                      ; IX = ap
        ld      de,0
        ld      bc,0
        call    __pf_run
        ld      h,b
        ld      l,c
        ld      (__pf_cnt),hl           ; save count
        ld      hl,(pf_bufptr)
        ld      (hl),0                  ; NUL-terminate
        pop     bc                      ; BC = saved fp
        ; _write(fp, __pf_fbuf, count)
        ld      hl,(__pf_cnt)
        push    hl                      ; count
        ld      hl,__pf_fbuf
        push    hl                      ; buf
        push    bc                      ; fp
        call    _write
        ld      hl,6
        add     hl,sp
        ld      sp,hl                   ; clean 3 args
        ld      hl,(__pf_cnt)           ; return char count
        pop     de
        pop     bc
        pop     ix
        ret

vfpcn:
        ld      hl,0
        ld      (pf_sink),hl            ; direct console mode
        ld      l,(ix+8)
        ld      h,(ix+9)                ; HL = ap
        push    hl
        ld      l,(ix+6)
        ld      h,(ix+7)                ; HL = fmt
        pop     ix                      ; IX = ap
        ld      de,0
        ld      bc,0
        call    __pf_run
        ld      h,b
        ld      l,c
        pop     de
        pop     bc
        pop     ix
        ret

; ============================================================
; _puts(str)    write str + '\n' to stdout.
; ============================================================
        public  _puts
_puts:
        ; int puts(const char *str) - single pointer argument, and __conout
        ; preserves HL across every call in the loop; IX-free leaf.
        pop     bc
        pop     hl              ; str
        push    hl
        push    bc
puts_loop:
        ld      a,(hl)
        or      a
        jr      z,puts_nl
        ld      e,a
        call    __conout
        inc     hl
        jr      puts_loop
puts_nl:
        ld      e,0ah
        call    __conout                ; '\n' (with CR+LF translation)
        ld      hl,0
        ret

; ============================================================
; _fopen(path, mode)
; path @ IX+4/5, mode @ IX+6/7
; Returns HL = FILE* (fd 3..6) or HL = 0 on failure.
; ============================================================
        public  _fopen
_fopen:
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      a,(hl)                  ; first char of mode
        ld      hl,0
        cp      'r'
        jr      z,fo_doit               ; flags=0: open existing
        ld      hl,0240h
        cp      'w'
        jr      z,fo_doit               ; flags=O_CREAT|O_TRUNC
        ld      hl,0040h                ; "a" or other: O_CREAT only
fo_doit:
        push    hl                      ; flags (second arg to _open)
        ld      l,(ix+4)
        ld      h,(ix+5)
        push    hl                      ; path (first arg)
        call    _open
        pop     de
        pop     de                      ; clean 4 bytes
        ld      a,h
        cp      0FFh
        jr      z,fo_fail               ; _open returned -1
        ; Clear EOF and error flags for the new slot
        push    hl                      ; save fd
        ld      a,l
        sub     FIRSTFD
        ld      e,a
        ld      d,0
        ld      hl,__fdeof
        add     hl,de
        xor     a
        ld      (hl),a
        ld      hl,__fderr
        add     hl,de
        ld      (hl),a
        ; Initialize file position to zero for this slot
        ld      hl,__fdoff
        add     hl,de           ; HL = __fdoff + slot
        add     hl,de           ; HL = __fdoff + slot*2
        add     hl,de           ; HL = __fdoff + slot*3
        add     hl,de           ; HL = __fdoff + slot*4
        xor     a               ; A already 0 but be explicit
        ld      (hl),a
        inc     hl
        ld      (hl),a
        inc     hl
        ld      (hl),a
        inc     hl
        ld      (hl),a
        pop     hl                      ; restore fd = FILE*
        pop     ix
        ret
fo_fail:
        ld      hl,0
        pop     ix
        ret

; ============================================================
; _fclose(fp)
; ============================================================
        public  _fclose
_fclose:
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+4)
        ld      h,(ix+5)
        push    hl                      ; fp
        call    _close
        pop     de                      ; clean 2 bytes
        pop     ix
        ret                             ; HL = 0 (ok) or -1 (error)

; ============================================================
; tmpnam / tmpfile  (C89 7.9.4.3 / 7.9.4.4)
; ============================================================
;
; tmpnam generates names of the form "T%03d.TMP" (T000.TMP..T999.TMP).
; tmpfile creates a file and registers it for removal in _exit via the
; __tmpf_hook set in the _exit block.  The file is removed at program
; termination; fclose alone does not remove it.
;
; Constants (kept in sync with stdio.h):
;   L_tmpnam = 13  -- minimum buffer size for tmpnam (room for "T999.TMP\0")
;   TMP_MAX  = 1000 -- distinct names available per session
;   NTMP     = 4   -- simultaneous tmpfile handles
;   TN_NSZ   = 16  -- bytes per name slot (power-of-2; >= 9 for "T000.TMP\0")
NTMP     equ    4
TN_NSZ   equ    16

        public  _tmpnam
; char *tmpnam(char *s)
; Returns a pointer to a generated filename not currently matching any
; open temp file from this session.  If s is NULL the name is written
; into an internal static buffer (not re-entrant); otherwise it is
; written into s and s is returned.
_tmpnam:
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      a,h
        or      l
        jr      nz,tn_use
        ld      hl,__tn_buf             ; NULL arg: use internal buffer
tn_use:
        ld      (__tn_ptr),hl
        ; Increment 3-digit decimal counter stored as individual digit chars.
        ; __tn_d0 = units, __tn_d1 = tens, __tn_d2 = hundreds.
        ; Starts at '0'-1 so first call produces '0'.
        ld      hl,__tn_d0
        inc     (hl)
        ld      a,(hl)
        cp      '9'+1
        jr      c,tn_build
        ld      (hl),'0'
        ld      hl,__tn_d1
        inc     (hl)
        ld      a,(hl)
        cp      '9'+1
        jr      c,tn_build
        ld      (hl),'0'
        ld      hl,__tn_d2
        inc     (hl)
        ld      a,(hl)
        cp      '9'+1
        jr      c,tn_build
        ld      (hl),'0'                ; wrap: 999 -> 000
tn_build:
        ; Build "T" + d2 + d1 + d0 + ".TMP" + NUL into __tn_ptr
        ld      hl,(__tn_ptr)
        ld      (hl),'T'
        inc     hl
        ld      a,(__tn_d2)
        ld      (hl),a
        inc     hl
        ld      a,(__tn_d1)
        ld      (hl),a
        inc     hl
        ld      a,(__tn_d0)
        ld      (hl),a
        inc     hl
        ld      (hl),'.'
        inc     hl
        ld      (hl),'T'
        inc     hl
        ld      (hl),'M'
        inc     hl
        ld      (hl),'P'
        inc     hl
        ld      (hl),0
        ld      hl,(__tn_ptr)
        pop     ix
        ret

        public  _tmpfile
; FILE *tmpfile(void)
; Creates a temporary binary file (w+ mode) and returns its FILE*.
; The file is removed at program termination via the __tmpf_hook
; registered in _exit.  Returns NULL if no slot is free or open fails.
_tmpfile:
        push    ix
        ld      ix,0
        add     ix,sp
        ; Register exit-cleanup hook (sets __tmpf_hook in _exit block).
        ld      hl,__tmpf_cleanup
        ld      (__tmpf_hook),hl
        ; Find an empty slot in __tmpf_fd (0 = free).
        ld      hl,__tmpf_fd
        ld      b,NTMP
        ld      c,0                     ; C = slot index
tf_slotlp:
        ld      a,(hl)
        or      a
        jr      z,tf_found
        inc     hl
        inc     c
        djnz    tf_slotlp
        ld      hl,0                    ; no free slot
        pop     ix
        ret
tf_found:
        ; Compute name address: __tmpf_nm + slot * TN_NSZ (slot << 4)
        ld      h,0
        ld      l,c
        add     hl,hl
        add     hl,hl
        add     hl,hl
        add     hl,hl                   ; HL = slot * 16
        ld      de,__tmpf_nm
        add     hl,de                   ; HL = &__tmpf_nm[slot]
        ld      (__tf_nmptr),hl
        ld      a,c
        ld      (__tf_slot),a
        ; tmpnam(name_ptr) fills the slot's name buffer
        push    hl
        call    _tmpnam
        pop     de
        ; _open(name, O_CREAT|O_TRUNC) = _open(name, 0240h)
        ld      hl,0240h                ; O_CREAT | O_TRUNC
        push    hl
        ld      hl,(__tf_nmptr)
        push    hl
        call    _open
        pop     de
        pop     de
        ; HL = fd or 0FFFFh on failure
        ld      a,h
        cp      0ffh
        jr      z,tf_fail
        ; Store fd in slot
        push    hl
        ld      a,(__tf_slot)
        ld      l,a
        ld      h,0
        ld      de,__tmpf_fd
        add     hl,de
        pop     de
        ld      (hl),e                  ; __tmpf_fd[slot] = fd (low byte)
        ld      l,e
        ld      h,0                     ; return fd as FILE*
        pop     ix
        ret
tf_fail:
        ld      hl,0
        pop     ix
        ret

__tmpf_cleanup:
        ; Close and unlink all registered temp files.
        ; Called from _exit via the __tmpf_dispatch trampoline.
        ld      b,NTMP
        ld      c,0                     ; C = slot index
        ld      hl,__tmpf_fd
tf_cl_lp:
        ld      a,(hl)
        or      a
        jr      z,tf_cl_nx
        push    bc
        push    hl                      ; save __tmpf_fd[slot] ptr
        ; _close(fd) — ignoring errors; must close before unlink
        ld      e,a
        ld      d,0
        push    de
        call    _close
        pop     de
        ; clear fd slot and compute name pointer.
        ; NOTE: do NOT use C here — BDOS fn 16 (inside _close) corrupts C.
        ; Derive slot from pointer arithmetic: slot = (&__tmpf_fd[slot]) - __tmpf_fd
        pop     hl                      ; HL = &__tmpf_fd[slot]
        xor     a
        ld      (hl),a                  ; clear fd slot
        push    hl                      ; save &__tmpf_fd[slot] for later restore
        ; slot = HL - __tmpf_fd
        ld      de,__tmpf_fd
        or      a
        sbc     hl,de                   ; HL = slot (0..NTMP-1)
        ; &__tmpf_nm[slot] = __tmpf_nm + slot * TN_NSZ (slot << 4)
        add     hl,hl
        add     hl,hl
        add     hl,hl
        add     hl,hl                   ; HL = slot * 16
        ld      de,__tmpf_nm
        add     hl,de                   ; HL = &__tmpf_nm[slot]
        push    hl
        call    _unlink
        pop     de
        pop     hl                      ; restore &__tmpf_fd[slot] ptr
        pop     bc
tf_cl_nx:
        inc     hl
        inc     c
        djnz    tf_cl_lp
        ret

; tmpnam/tmpfile storage
__tn_d0:        db      '0'-1           ; units digit; '0'-1 so first call -> '0'
__tn_d1:        db      '0'
__tn_d2:        db      '0'
__tn_ptr:       dw      0
__tn_buf:       ds      9               ; internal buffer for tmpnam(NULL)
__tf_slot:      db      0
__tf_nmptr:     dw      0
__tmpf_fd:      ds      NTMP            ; fd per slot (0 = free)
__tmpf_nm:      ds      NTMP*TN_NSZ     ; name per slot (16 bytes each)

; ============================================================
; _freopen(path, mode, stream)  (C89 7.9.5.4)
; Closes stream, then opens path/mode on the same fd slot.
; Because _open always takes the lowest free slot and the slot
; freed by fclose is the lowest available, the returned FILE*
; equals stream on success.  Returns HL = FILE* or 0 on error.
; path @ IX+4/5, mode @ IX+6/7, stream @ IX+8/9
; ============================================================
        public  _freopen
_freopen:
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+8)
        ld      h,(ix+9)
        push    hl                      ; stream arg to fclose
        call    _fclose
        pop     de                      ; clean 2 bytes (ignore close result)
        ld      l,(ix+6)
        ld      h,(ix+7)
        push    hl                      ; mode arg to fopen
        ld      l,(ix+4)
        ld      h,(ix+5)
        push    hl                      ; path arg to fopen
        call    _fopen
        pop     de
        pop     de                      ; clean 4 bytes
        pop     ix
        ret                             ; HL = FILE* or 0

; ============================================================
; __fps(str, fp)
; fp < 3  console output;  fp >= 3  _write to file.
; ============================================================
        public  __fps
__fps:
        push    ix
        ld      ix,0
        add     ix,sp
        ld      a,(ix+6)                ; fp (low byte)
        cp      FIRSTFD
        jr      nc,fputs_file
        ; console path
        ld      l,(ix+4)
        ld      h,(ix+5)
fputs_con:
        ld      a,(hl)
        or      a
        jr      z,fputs_con_done
        ld      e,a
        call    __conout
        inc     hl
        jr      fputs_con
fputs_con_done:
        ld      hl,0
        pop     ix
        ret
fputs_file:
        ; compute strlen(str)
        ld      l,(ix+4)
        ld      h,(ix+5)
        push    hl
        ld      bc,0
fputs_sl:
        ld      a,(hl)
        or      a
        jr      z,fputs_sl_done
        inc     hl
        inc     bc
        jr      fputs_sl
fputs_sl_done:
        pop     hl                      ; str
        ; _write(fp, str, len)
        push    bc                      ; len
        push    hl                      ; str
        ld      l,(ix+6)
        ld      h,(ix+7)
        push    hl                      ; fp
        call    _write
        ex      de,hl
        ld      hl,6
        add     hl,sp
        ld      sp,hl
        ex      de,hl                   ; HL = _write return value
        pop     ix
        ret

; ============================================================
; _fread(buf, size, count, fp)
; IX+4=buf, IX+6=size, IX+8=count, IX+10=fp
; Returns HL = number of items read.
; ============================================================
        public  _fread
_fread:
        push    ix
        ld      ix,0
        add     ix,sp
        ; size == 0 -> 0 items (also avoids divide-by-zero in the item count)
        ld      l,(ix+6)
        ld      h,(ix+7)                ; HL = size
        ld      a,h
        or      l
        jr      z,frd_zero
        ; nbytes = size * count, rejecting 16-bit overflow
        ld      e,(ix+8)
        ld      d,(ix+9)                ; DE = count
        call    __ckmul                 ; HL = size*count; carry set on overflow
        jr      c,frd_zero              ; overflow -> read nothing
        ld      (__frw_nb),hl
        ; _read(fp, buf, nbytes)
        push    hl                      ; nbytes
        ld      l,(ix+4)
        ld      h,(ix+5)
        push    hl                      ; buf
        ld      l,(ix+10)
        ld      h,(ix+11)
        push    hl                      ; fp
        call    _read
        ex      de,hl
        ld      hl,6
        add     hl,sp
        ld      sp,hl
        ex      de,hl                   ; HL = bytes_read
        ; if bytes_read < nbytes  set EOF
        push    hl
        ld      de,(__frw_nb)
        or      a
        sbc     hl,de
        jr      nc,frd_neof
        ld      a,(ix+10)
        sub     FIRSTFD
        jr      c,frd_neof
        ld      h,0
        ld      l,a
        ld      de,__fdeof
        add     hl,de
        ld      (hl),1
frd_neof:
        pop     hl                      ; bytes_read
        ; return bytes_read / size
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    __divu                  ; HL = items read
        pop     ix
        ret
frd_zero:
        ld      hl,0
        pop     ix
        ret

__frw_nb:       dw      0

; ============================================================
; _fwrite(buf, size, count, fp)
; IX+4=buf, IX+6=size, IX+8=count, IX+10=fp
; Returns HL = number of items written.
; ============================================================
        public  _fwrite
_fwrite:
        push    ix
        ld      ix,0
        add     ix,sp
        ; size == 0 -> 0 items (also avoids divide-by-zero in the item count)
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      a,h
        or      l
        jr      z,fwr_zero
        ; nbytes = size * count, rejecting 16-bit overflow
        ld      e,(ix+8)
        ld      d,(ix+9)
        call    __ckmul                 ; HL = size*count; carry set on overflow
        jr      c,fwr_zero              ; overflow -> write nothing
        ; _write(fp, buf, nbytes)
        push    hl                      ; nbytes
        ld      l,(ix+4)
        ld      h,(ix+5)
        push    hl                      ; buf
        ld      l,(ix+10)
        ld      h,(ix+11)
        push    hl                      ; fp
        call    _write
        ex      de,hl
        ld      hl,6
        add     hl,sp
        ld      sp,hl
        ex      de,hl                   ; HL = bytes_written
        ; return bytes_written / size
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    __divu
        pop     ix
        ret
fwr_zero:
        ld      hl,0
        pop     ix
        ret

; ============================================================
; _fseek(fp, offset, whence)    delegates to _lseek; clears EOF.
; ============================================================
        public  _fseek
_fseek:
        push    ix
        ld      ix,0
        add     ix,sp

        ; int fseek(FILE *fp, long offset, int whence)
        ; ix+4/5   fp/fd
        ; ix+6..9  offset, low word then high word
        ; ix+10/11 whence
        ;
        ; Call long lseek(int fd, long offset, int whence).
        ld      l,(ix+10)
        ld      h,(ix+11)
        push    hl                      ; whence

        ld      l,(ix+8)
        ld      h,(ix+9)
        push    hl                      ; offset high word

        ld      l,(ix+6)
        ld      h,(ix+7)
        push    hl                      ; offset low word

        ld      l,(ix+4)
        ld      h,(ix+5)
        push    hl                      ; fp/fd

        call    _lseek

        ; Pop 8 bytes of arguments.
        push    de
        push    hl
        ld      hl,8
        add     hl,sp
        ld      sp,hl
        pop     hl
        pop     de

        ; lseek failure is -1L == DE:HL all ones.
        ld      a,h
        cp      0ffh
        jr      nz,fseek_ok_clear
        ld      a,l
        cp      0ffh
        jr      nz,fseek_ok_clear
        ld      a,d
        cp      0ffh
        jr      nz,fseek_ok_clear
        ld      a,e
        cp      0ffh
        jr      nz,fseek_ok_clear
        jr      fseek_bad

fseek_ok_clear:
        ; clear EOF flag
        ld      a,(ix+4)
        sub     FIRSTFD
        jr      c,fseek_ok
        ld      h,0
        ld      l,a
        ld      de,__fdeof
        add     hl,de
        ld      (hl),0
fseek_ok:
        ld      hl,0
        pop     ix
        ret
fseek_bad:
        ld      hl,0FFFFh
        pop     ix
        ret


; ============================================================
; _ftell(fp)    returns current file position (low 16 bits).
; ============================================================
        public  _ftell
_ftell:
        ; long ftell(FILE *fp) - fp/fd fits in a byte; IX-free leaf.
        pop     bc
        pop     hl
        push    hl
        push    bc
        ld      a,l
        sub     FIRSTFD
        jr      c,ftell_bad
        cp      NFILES
        jr      nc,ftell_bad
        ld      (__slot),a
        call    __offp                  ; HL  32-bit offset table entry
        ld      e,(hl)
        inc     hl
        ld      d,(hl)                  ; DE = low 16 bits of file position
        inc     hl
        ld      a,(hl)
        inc     hl
        ld      h,(hl)
        ld      l,a                     ; HL = high 16 bits of file position
        ex      de,hl                   ; HL = low 16 bits, DE = high 16 bits
        ret
ftell_bad:
        ld      hl,0FFFFh
        ld      de,0FFFFh
        ret

; ============================================================
; fgetpos / fsetpos  (C89 7.9.9.1 / 7.9.9.3)
; fpos_t is a 32-bit byte offset (typedef long fpos_t in stdio.h).
; Stored in memory as two consecutive 16-bit words, low word first.
; ============================================================
        public  _fgetpos
; int fgetpos(FILE *stream, fpos_t *pos)
; Returns 0 on success, nonzero on error (e.g. console stream or seekerror).
_fgetpos:
        push    ix
        ld      ix,0
        add     ix,sp
        ; ix+4/5 = stream, ix+6/7 = pos

        ; call _ftell(stream) -> DE:HL (high:low) or 0xFFFF:0xFFFF on error
        ld      l,(ix+4)
        ld      h,(ix+5)
        push    hl
        call    _ftell
        ; Check for -1L: all four bytes 0xFF
        ld      a,h
        and     l
        and     d
        and     e
        inc     a
        jr      z,fgpos_bad

        ; Save DE:HL before adjusting SP to discard the stream arg.
        ld      (__fgpos_lo),hl
        ld      (__fgpos_hi),de
        ld      hl,2
        add     hl,sp
        ld      sp,hl           ; discard stream arg

        ; Write 4 bytes to *pos (low word then high word, LE)
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      de,(__fgpos_lo)
        ld      a,e
        ld      (hl),a
        inc     hl
        ld      a,d
        ld      (hl),a
        inc     hl
        ld      de,(__fgpos_hi)
        ld      a,e
        ld      (hl),a
        inc     hl
        ld      a,d
        ld      (hl),a

        ld      hl,0
        pop     ix
        ret

fgpos_bad:
        ld      hl,2
        add     hl,sp
        ld      sp,hl
        ld      hl,0ffffh
        pop     ix
        ret

__fgpos_lo:     dw      0
__fgpos_hi:     dw      0

        public  _fsetpos
; int fsetpos(FILE *stream, const fpos_t *pos)
; Returns 0 on success (same as fseek), nonzero on error.
_fsetpos:
        push    ix
        ld      ix,0
        add     ix,sp
        ; ix+4/5 = stream, ix+6/7 = pos

        ; Read 4 bytes from *pos -> BC (low word), DE (high word)
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      c,(hl)
        inc     hl
        ld      b,(hl)          ; BC = low 16 bits
        inc     hl
        ld      e,(hl)
        inc     hl
        ld      d,(hl)          ; DE = high 16 bits

        ; call _fseek(stream, offset_lo=BC, offset_hi=DE, SEEK_SET=0)
        ld      hl,0
        push    hl              ; whence = SEEK_SET
        push    de              ; offset high word
        push    bc              ; offset low word
        ld      l,(ix+4)
        ld      h,(ix+5)
        push    hl              ; stream
        call    _fseek

        ; clean 8 bytes of args (stream + 3 × 2-byte words) preserving HL
        ex      de,hl
        ld      hl,8
        add     hl,sp
        ld      sp,hl
        ex      de,hl

        pop     ix
        ret                     ; HL = 0 (ok) or 0FFFFh (fseek failed)

; ============================================================
; _rewind(fp)    seek to 0, clear EOF.
; ============================================================
        public  _rewind
_rewind:
        push    ix
        ld      ix,0
        add     ix,sp
        ; rewind(fp) == (void)lseek(fd, 0L, SEEK_SET).  offset is a 32-bit long,
        ; so it must be pushed as two words; pushing a single word (as an
        ; earlier version did) misaligned the frame so _lseek read a garbage
        ; whence, fell through to EINVAL, and never moved the file position.
        ld      hl,0
        push    hl                      ; whence = 0 (SEEK_SET)
        push    hl                      ; offset high word = 0
        push    hl                      ; offset low word = 0
        ld      l,(ix+4)
        ld      h,(ix+5)
        push    hl                      ; fp
        call    _lseek
        ; Pop 8 bytes of arguments (return value unused: rewind is void).
        ld      hl,8
        add     hl,sp
        ld      sp,hl
        ; clear EOF flag
        ld      a,(ix+4)
        sub     FIRSTFD
        jr      c,rewind_ret
        ld      h,0
        ld      l,a
        ld      de,__fdeof
        add     hl,de
        ld      (hl),0
rewind_ret:
        ld      hl,0
        pop     ix
        ret

; ============================================================
; _feof(fp)    returns HL=1 if EOF, HL=0 otherwise.
; ============================================================
        public  _feof
_feof:
        ; int feof(FILE *fp) - fp/fd fits in a byte; IX-free leaf.
        pop     bc
        pop     hl
        push    hl
        push    bc
        ld      a,l
        sub     FIRSTFD
        jr      c,feof_no
        cp      NFILES
        jr      nc,feof_no
        ld      h,0
        ld      l,a
        ld      de,__fdeof
        add     hl,de
        ld      a,(hl)
        ld      l,a
        ld      h,0
        ret
feof_no:
        ld      hl,0
        ret

; ============================================================
; _ferror(fp)    returns HL=1 if error, HL=0 otherwise.
; ============================================================
        public  _ferror
_ferror:
        ; int ferror(FILE *fp) - fp/fd fits in a byte; IX-free leaf.
        pop     bc
        pop     hl
        push    hl
        push    bc
        ld      a,l
        sub     FIRSTFD
        jr      c,ferr_no
        cp      NFILES
        jr      nc,ferr_no
        ld      h,0
        ld      l,a
        ld      de,__fderr
        add     hl,de
        ld      a,(hl)
        ld      l,a
        ld      h,0
        ret
ferr_no:
        ld      hl,0
        ret

; ============================================================
; scanf family  (small non-floating C89 subset)
;
; Supports: whitespace/literal matching, %%, assignment suppression '*',
; field widths, h/l length modifiers, and conversions:
;   %d %i %u %x %X %o %c %s
;
; Deliberately not implemented here: floating input, scansets, %n, %p.
; All three public entry points share __scan_run.  IX stays bound to the
; public caller's frame so varargs can be read by byte offset, just like
; the printf engine above.
; ============================================================
        public  _scanf
_scanf:
        push    ix
        ld      ix,0
        add     ix,sp
        xor     a
        inc     a
        ld      (sc_kind),a             ; 1 = FILE/console source
        ld      hl,0
        ld      (sc_fp),hl              ; stdin fd
        ld      l,(ix+4)
        ld      h,(ix+5)                ; format
        ld      de,6                    ; first vararg offset
        call    __scan_run
        pop     ix
        ret

        public  _sscanf
_sscanf:
        push    ix
        ld      ix,0
        add     ix,sp
        xor     a
        ld      (sc_kind),a             ; 0 = string source
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      (sc_src),hl
        ld      l,(ix+6)
        ld      h,(ix+7)                ; format
        ld      de,8                    ; first vararg offset
        call    __scan_run
        pop     ix
        ret

        public  _fscanf
        public  __scan_run
_fscanf:
        push    ix
        ld      ix,0
        add     ix,sp
        xor     a
        inc     a
        ld      (sc_kind),a             ; 1 = FILE/console source
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      (sc_fp),hl
        ld      l,(ix+6)
        ld      h,(ix+7)                ; format
        ld      de,8                    ; first vararg offset
        call    __scan_run
        pop     ix
        ret

__scan_run:
        ld      (sc_fmt),hl
        ld      (sc_argoff),de
        ld      hl,0
        ld      (sc_count),hl
        ld      a,(sc_kind)
        or      a
        jr      nz,sc_init_file_pushback
        xor     a
        ld      (sc_ungot),a
        jr      sc_init_done
sc_init_file_pushback:
        ld      a,(sc_ungot)
        or      a
        jr      z,sc_init_done
        ld      a,(sc_ukind)
        cp      1
        jr      nz,sc_init_clear_pushback
        ld      hl,(sc_ufp)
        ld      de,(sc_fp)
        or      a
        sbc     hl,de
        ld      a,h
        or      l
        jr      z,sc_init_done
sc_init_clear_pushback:
        xor     a
        ld      (sc_ungot),a
sc_init_done:

sc_loop:
        ld      hl,(sc_fmt)
        ld      a,(hl)
        or      a
        jp      z,sc_done
        inc     hl
        ld      (sc_fmt),hl

        call    sc_is_space
        jp      c,sc_fmt_space

        cp      '%'
        jp      z,sc_percent

        ld      b,a
        call    sc_get
        jp      c,sc_input_fail
        cp      b
        jp      z,sc_loop
        call    sc_unget
        jp      sc_match_fail

sc_fmt_space:
        ld      hl,(sc_fmt)
sc_fmt_space_loop:
        ld      a,(hl)
        call    sc_is_space
        jr      nc,sc_fmt_space_done
        inc     hl
        jr      sc_fmt_space_loop
sc_fmt_space_done:
        ld      (sc_fmt),hl
        call    sc_skip_input_space
        jp      sc_loop

sc_percent:
        ld      a,1
        ld      (sc_assign),a
        xor     a
        ld      (sc_long),a
        ld      hl,0ffffh
        ld      (sc_width),hl

        call    sc_fmt_get
        or      a
        jp      z,sc_done

        cp      '%'
        jp      z,sc_match_percent

        cp      '*'
        jr      nz,sc_width_start
        xor     a
        ld      (sc_assign),a
        call    sc_fmt_get
        or      a
        jp      z,sc_done

sc_width_start:
        cp      '0'
        jr      c,sc_length_start
        cp      '9'+1
        jr      nc,sc_length_start
        ld      hl,0
        ld      (sc_width),hl
sc_width_loop:
        sub     '0'
        ld      (sc_digit),a
        ld      hl,(sc_width)
        add     hl,hl                   ; 2*w
        ld      d,h
        ld      e,l
        add     hl,hl                   ; 4*w
        add     hl,hl                   ; 8*w
        add     hl,de                   ; 10*w
        ld      a,(sc_digit)
        ld      e,a
        ld      d,0
        add     hl,de
        ld      (sc_width),hl
        call    sc_fmt_get
        cp      '0'
        jr      c,sc_length_start
        cp      '9'+1
        jr      c,sc_width_loop

sc_length_start:
        cp      'h'
        jr      nz,sc_check_long
        call    sc_fmt_get              ; short == int on dcc
        jr      sc_dispatch
sc_check_long:
        cp      'l'
        jr      nz,sc_dispatch
        ld      a,1
        ld      (sc_long),a
        call    sc_fmt_get

sc_dispatch:
        cp      'd'
        jp      z,sc_conv_d
        cp      'i'
        jp      z,sc_conv_i
        cp      'u'
        jp      z,sc_conv_u
        cp      'x'
        jp      z,sc_conv_x
        cp      'X'
        jp      z,sc_conv_x
        cp      'o'
        jp      z,sc_conv_o
        cp      'c'
        jp      z,sc_conv_c
        cp      's'
        jp      z,sc_conv_s
        jp      sc_match_fail

sc_match_percent:
        call    sc_get
        jp      c,sc_input_fail
        cp      '%'
        jp      z,sc_loop
        call    sc_unget
        jp      sc_match_fail

sc_conv_d:
        ld      a,10
        ld      (sc_base),a
        xor     a
        ld      (sc_auto),a
        jp      sc_scan_number
sc_conv_u:
        ld      a,10
        ld      (sc_base),a
        xor     a
        ld      (sc_auto),a
        jp      sc_scan_number
sc_conv_o:
        ld      a,8
        ld      (sc_base),a
        xor     a
        ld      (sc_auto),a
        jp      sc_scan_number
sc_conv_x:
        ld      a,16
        ld      (sc_base),a
        xor     a
        ld      (sc_auto),a
        jp      sc_scan_number
sc_conv_i:
        ld      a,10
        ld      (sc_base),a
        ld      a,1
        ld      (sc_auto),a
        jp      sc_scan_number

sc_conv_s:
        call    sc_skip_input_space
        jp      c,sc_input_fail
        xor     a
        ld      (sc_ndig),a
        ld      a,(sc_assign)
        or      a
        jr      z,sc_s_loop
        call    sc_next_arg
        ld      (sc_dest),hl
sc_s_loop:
        call    sc_get_w
        jr      c,sc_s_end_check
        ld      (sc_ch),a
        call    sc_is_space
        jr      nc,sc_s_store
        ld      a,(sc_ch)
        call    sc_unget
        jr      sc_s_end_check
sc_s_store:
        ld      a,(sc_assign)
        or      a
        jr      z,sc_s_count
        ld      a,(sc_ch)
        call    sc_store_char
sc_s_count:
        ld      a,(sc_ndig)
        inc     a
        ld      (sc_ndig),a
        ld      hl,(sc_width)
        ld      a,h
        or      l
        jr      nz,sc_s_loop
sc_s_end_check:
        ld      a,(sc_ndig)
        or      a
        jp      z,sc_input_fail
        ld      a,(sc_assign)
        or      a
        jp      z,sc_loop
        xor     a
        call    sc_store_char
        call    sc_inc_count
        jp      sc_loop

sc_conv_c:
        ld      hl,(sc_width)
        ld      a,h
        cp      0ffh
        jr      nz,sc_c_width_known
        ld      a,l
        cp      0ffh
        jr      nz,sc_c_width_known
        ld      hl,1
        ld      (sc_width),hl
sc_c_width_known:
        xor     a
        ld      (sc_ndig),a
        ld      a,(sc_assign)
        or      a
        jr      z,sc_c_loop
        call    sc_next_arg
        ld      (sc_dest),hl
sc_c_loop:
        ld      hl,(sc_width)
        ld      a,h
        or      l
        jr      z,sc_c_done
        call    sc_get_w
        jp      c,sc_input_fail
        ld      (sc_ch),a
        ld      a,(sc_assign)
        or      a
        jr      z,sc_c_count
        ld      a,(sc_ch)
        call    sc_store_char
sc_c_count:
        ld      a,(sc_ndig)
        inc     a
        ld      (sc_ndig),a
        jr      sc_c_loop
sc_c_done:
        ld      a,(sc_assign)
        or      a
        jp      z,sc_loop
        call    sc_inc_count
        jp      sc_loop

sc_scan_number:
        call    sc_skip_input_space
        jp      c,sc_input_fail
        ld      hl,0
        ld      (sc_val_l),hl
        ld      (sc_val_h),hl
        xor     a
        ld      (sc_sign),a
        ld      (sc_ndig),a

        call    sc_get_w
        jp      c,sc_input_fail
        cp      '-'
        jr      nz,sc_num_plus
        ld      a,1
        ld      (sc_sign),a
        call    sc_get_w
        jp      c,sc_match_fail
        jr      sc_num_after_sign
sc_num_plus:
        cp      '+'
        jr      nz,sc_num_after_sign
        call    sc_get_w
        jp      c,sc_match_fail

sc_num_after_sign:
        ld      b,a                     ; first candidate char
        ld      a,(sc_auto)
        or      a
        jr      z,sc_num_not_auto
        ld      a,b
        cp      '0'
        jr      nz,sc_num_auto_decimal
        ld      a,8
        ld      (sc_base),a
        ld      hl,(sc_width)
        ld      a,h
        or      l
        jr      z,sc_num_process_zero
        call    sc_get_w
        jr      c,sc_num_process_zero
        cp      'x'
        jr      z,sc_num_prefix_hex
        cp      'X'
        jr      z,sc_num_prefix_hex
        call    sc_unget
sc_num_process_zero:
        ld      a,'0'
        jr      sc_num_have_char
sc_num_auto_decimal:
        ld      a,10
        ld      (sc_base),a
        ld      a,b
        jr      sc_num_have_char

sc_num_not_auto:
        ld      a,(sc_base)
        cp      16
        jr      nz,sc_num_use_b
        ld      a,b
        cp      '0'
        jr      nz,sc_num_use_b
        ld      hl,(sc_width)
        ld      a,h
        or      l
        jr      z,sc_num_process_zero
        call    sc_get_w
        jr      c,sc_num_process_zero
        cp      'x'
        jr      z,sc_num_prefix_hex
        cp      'X'
        jr      z,sc_num_prefix_hex
        call    sc_unget
        ld      a,'0'
        jr      sc_num_have_char
sc_num_use_b:
        ld      a,b
        jr      sc_num_have_char

sc_num_prefix_hex:
        ld      a,16
        ld      (sc_base),a
        call    sc_get_w
        jp      c,sc_match_fail

sc_num_have_char:
        ld      (sc_ch),a
        call    sc_digit_value
        jr      nc,sc_num_digit_ok
        ld      a,(sc_ch)
        call    sc_unget
        jr      sc_num_end_check
sc_num_digit_ok:
        ld      (sc_digit),a
        call    sc_muladd_digit
        ld      a,(sc_ndig)
        inc     a
        ld      (sc_ndig),a
        ld      hl,(sc_width)
        ld      a,h
        or      l
        jr      z,sc_num_end_check
        call    sc_get_w
        jr      nc,sc_num_have_char

sc_num_end_check:
        ld      a,(sc_ndig)
        or      a
        jp      z,sc_match_fail
        ld      a,(sc_sign)
        or      a
        call    nz,sc_neg_val
        ld      a,(sc_assign)
        or      a
        jp      z,sc_loop
        call    sc_next_arg
        ld      (sc_dest),hl
        ld      a,(sc_long)
        or      a
        jr      z,sc_store_num16
        ld      hl,(sc_dest)
        ld      de,(sc_val_l)
        ld      (hl),e
        inc     hl
        ld      (hl),d
        inc     hl
        ld      de,(sc_val_h)
        ld      (hl),e
        inc     hl
        ld      (hl),d
        call    sc_inc_count
        jp      sc_loop
sc_store_num16:
        ld      hl,(sc_dest)
        ld      de,(sc_val_l)
        ld      (hl),e
        inc     hl
        ld      (hl),d
        call    sc_inc_count
        jp      sc_loop

sc_done:
        ld      hl,(sc_count)
        ret
sc_match_fail:
        ld      hl,(sc_count)
        ret
sc_input_fail:
        ld      hl,(sc_count)
        ld      a,h
        or      l
        ret     nz
        ld      hl,0ffffh
        ret

sc_fmt_get:
        ld      hl,(sc_fmt)
        ld      a,(hl)
        inc     hl
        ld      (sc_fmt),hl
        ret

sc_get_w:
        ld      hl,(sc_width)
        ld      a,h
        or      l
        jr      z,sc_get_w_fail
        dec     hl
        ld      (sc_width),hl
        call    sc_get
        ret
sc_get_w_fail:
        scf
        ret

sc_get:
        ld      a,(sc_ungot)
        or      a
        jr      z,sc_get_source
        xor     a
        ld      (sc_ungot),a
        ld      a,(sc_unch)
        or      a
        ret
sc_get_source:
        ld      a,(sc_kind)
        or      a
        jr      nz,sc_get_file
        ld      hl,(sc_src)
        ld      a,(hl)
        or      a
        jr      z,sc_get_eof
        inc     hl
        ld      (sc_src),hl
        or      a
        ret
sc_get_file:
        ld      hl,(sc_fp)
        push    hl
        call    __getc
        pop     bc
        ld      a,h
        cp      0ffh
        jr      nz,sc_get_file_ok
        ld      a,l
        cp      0ffh
        jr      z,sc_get_eof
sc_get_file_ok:
        ld      a,l
        or      a
        ret
sc_get_eof:
        scf
        ret

sc_unget:
        ld      (sc_unch),a
        ld      a,(sc_kind)
        ld      (sc_ukind),a
        or      a
        jr      z,sc_unget_set
        ld      hl,(sc_fp)
        ld      (sc_ufp),hl
sc_unget_set:
        ld      a,1
        ld      (sc_ungot),a
        ret

sc_skip_input_space:
        call    sc_get
        ret     c
        call    sc_is_space
        jr      c,sc_skip_input_space
        call    sc_unget
        or      a
        ret

sc_is_space:
        cp      ' '
        jr      z,sc_space_yes
        cp      9
        jr      z,sc_space_yes
        cp      10
        jr      z,sc_space_yes
        cp      11
        jr      z,sc_space_yes
        cp      12
        jr      z,sc_space_yes
        cp      13
        jr      z,sc_space_yes
        or      a
        ret
sc_space_yes:
        scf
        ret

sc_digit_value:
        cp      '0'
        jr      c,sc_digit_bad
        cp      '9'+1
        jr      c,sc_digit_dec
        cp      'A'
        jr      c,sc_digit_lower
        cp      'F'+1
        jr      c,sc_digit_upper
sc_digit_lower:
        cp      'a'
        jr      c,sc_digit_bad
        cp      'f'+1
        jr      nc,sc_digit_bad
        sub     'a'-10
        jr      sc_digit_check_base
sc_digit_upper:
        sub     'A'-10
        jr      sc_digit_check_base
sc_digit_dec:
        sub     '0'
sc_digit_check_base:
        ld      c,a
        ld      a,(sc_base)
        cp      c
        jr      z,sc_digit_bad
        jr      c,sc_digit_bad
        ld      a,c
        or      a
        ret
sc_digit_bad:
        scf
        ret

sc_muladd_digit:
        ld      hl,0
        ld      (sc_tmp_l),hl
        ld      (sc_tmp_h),hl
        ld      a,(sc_base)
        ld      b,a
sc_muladd_loop:
        ld      hl,(sc_tmp_l)
        ld      de,(sc_val_l)
        add     hl,de
        ld      (sc_tmp_l),hl
        ld      hl,(sc_tmp_h)
        ld      de,(sc_val_h)
        adc     hl,de
        ld      (sc_tmp_h),hl
        djnz    sc_muladd_loop
        ld      hl,(sc_tmp_l)
        ld      (sc_val_l),hl
        ld      hl,(sc_tmp_h)
        ld      (sc_val_h),hl
        ld      hl,(sc_val_l)
        ld      a,(sc_digit)
        ld      e,a
        ld      d,0
        add     hl,de
        ld      (sc_val_l),hl
        ld      hl,(sc_val_h)
        ld      de,0
        adc     hl,de
        ld      (sc_val_h),hl
        ret

sc_neg_val:
        ld      de,(sc_val_l)
        ld      hl,0
        or      a
        sbc     hl,de
        ld      (sc_val_l),hl
        ld      de,(sc_val_h)
        ld      hl,0
        sbc     hl,de
        ld      (sc_val_h),hl
        ret

sc_next_arg:
        ld      hl,(sc_argoff)
        ld      e,l
        ld      d,h
        push    ix
        pop     hl
        add     hl,de
        ld      e,(hl)
        inc     hl
        ld      d,(hl)
        ld      hl,(sc_argoff)
        inc     hl
        inc     hl
        ld      (sc_argoff),hl
        ex      de,hl
        ret

sc_store_char:
        ld      hl,(sc_dest)
        ld      (hl),a
        inc     hl
        ld      (sc_dest),hl
        ret

sc_inc_count:
        ld      hl,(sc_count)
        inc     hl
        ld      (sc_count),hl
        ret

sc_kind:        db      0
sc_ungot:       db      0
sc_unch:        db      0
sc_ukind:       db      0
sc_assign:      db      0
sc_long:        db      0
sc_base:        db      10
sc_auto:        db      0
sc_sign:        db      0
sc_ndig:        db      0
sc_digit:       db      0
sc_ch:          db      0
sc_src:         dw      0
sc_fp:          dw      0
sc_ufp:         dw      0
sc_fmt:         dw      0
sc_argoff:      dw      0
sc_count:       dw      0
sc_width:       dw      0
sc_dest:        dw      0
sc_val_l:       dw      0
sc_val_h:       dw      0
sc_tmp_l:       dw      0
sc_tmp_h:       dw      0

; ============================================================
; setjmp / longjmp  (C89)
;
; jmp_buf layout (stored at the address passed as first arg):
;   [0,1] = saved return address (where setjmp "returns" to)
;   [2,3] = saved SP  (= IX+4 at time of setjmp call, i.e. the SP
;            after ret from setjmp, pointing at the env argument)
;   [4,5] = saved IX  (caller's frame pointer)
;   [6,7] = padding
;
; Z80/dcc calling convention at entry to _setjmp:
;   (IX+0,1) = old IX pushed by prologue
;   (IX+2,3) = return address
;   (IX+4,5) = env pointer (first argument = &jmp_buf)
; ============================================================

        public  _setjmp
_setjmp:
        push    ix
        ld      ix,0
        add     ix,sp
        ; HL = env pointer (jmp_buf address)
        ld      l,(ix+4)
        ld      h,(ix+5)

        ; env[0,1] = return address
        ld      a,(ix+2)
        ld      (hl),a
        inc     hl
        ld      a,(ix+3)
        ld      (hl),a
        inc     hl

        ; env[2,3] = saved SP = IX + 4
        ;   (after ret from _setjmp, SP will point to env arg slot = IX+4)
        push    ix
        pop     de              ; DE = current IX value
        ld      a,e
        add     a,4
        ld      (hl),a
        inc     hl
        ld      a,d
        adc     a,0
        ld      (hl),a
        inc     hl

        ; env[4,5] = saved IX (caller's frame pointer = old IX at (IX+0,1))
        ld      a,(ix+0)
        ld      (hl),a
        inc     hl
        ld      a,(ix+1)
        ld      (hl),a

        ; return 0
        ld      hl,0
        ld      sp,ix
        pop     ix
        ret

; ============================================================
        public  _longjmp
_longjmp:
        push    ix
        ld      ix,0
        add     ix,sp
        ; (IX+4,5) = env pointer
        ; (IX+6,7) = val (must not be 0; if 0 return 1 per C standard)

        ; Get return value, ensure != 0
        ld      l,(ix+6)
        ld      h,(ix+7)
        ld      a,h
        or      l
        jr      nz,lj_nonzero
        ld      hl,1
lj_nonzero:
        ld      (lj_val),hl

        ; Load env pointer
        ld      l,(ix+4)
        ld      h,(ix+5)

        ; Read env[0,1] = saved return address
        ld      a,(hl)
        ld      (lj_retaddr),a
        inc     hl
        ld      a,(hl)
        ld      (lj_retaddr+1),a
        inc     hl

        ; Read env[2,3] = saved SP
        ld      a,(hl)
        ld      (lj_sp),a
        inc     hl
        ld      a,(hl)
        ld      (lj_sp+1),a
        inc     hl

        ; Read env[4,5] = saved IX
        ld      a,(hl)
        ld      (lj_ix),a
        inc     hl
        ld      a,(hl)
        ld      (lj_ix+1),a

        ; Restore SP (points to env arg slot in original setjmp call frame)
        ld      hl,(lj_sp)
        ld      sp,hl

        ; Restore IX (caller's frame pointer)
        ld      hl,(lj_ix)
        push    hl
        pop     ix

        ; Push return address so RET jumps to setjmp call site
        ld      hl,(lj_retaddr)
        push    hl

        ; Load return value into HL
        ld      hl,(lj_val)

        ; Jump to setjmp call site  HL is the return value
        ret

lj_val:         dw      0
lj_retaddr:     dw      0
lj_sp:          dw      0
lj_ix:          dw      0



; ============================================================
; Minimal CP/M dirent API
;
; Supports:
;   DIR *opendir(const char *path);     ; macro -> dopn
;   struct dirent *readdir(DIR *dirp);  ; macro -> drd
;   int closedir(DIR *dirp);         ; macro -> dcls
;   void perror(const char *s);
;
; This is intentionally small and CP/M-2.2-oriented.  opendir("."),
; opendir("*.*"), and opendir("A:") enumerate all files on the selected
; drive.  Other path strings are accepted but treated as wildcard scans;
; CP/M has no hierarchical directories.
; ============================================================
        public  _dopn
_dopn:
        push    ix
        ld      ix,0
        add     ix,sp

        ; Clear FCB.
        ld      hl,__drfcb
        ld      de,__drfcb+1
        ld      bc,35
        ld      (hl),0
        ldir

        ; Optional drive letter: "A:" -> 1, "B:" -> 2, ...
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      a,(hl)
        or      a
        jr      z,__drod0
        inc     hl
        ld      b,(hl)
        dec     hl
        ld      a,b
        cp      ':'
        jr      nz,__drod0
        ld      a,(hl)
        cp      'a'
        jr      c,__drod1
        cp      'z'+1
        jr      nc,__drod1
        sub     20h
__drod1:
        cp      'A'
        jr      c,__drod0
        cp      'Z'+1
        jr      nc,__drod0
        sub     'A'-1
        ld      (__drfcb),a
__drod0:

        ; Wildcard name/ext: ???????????
        ld      hl,__drfcb+1
        ld      b,11
__drofq:
        ld      (hl),'?'
        inc     hl
        djnz    __drofq

        ; Set DMA buffer.
        ld      c,26
        ld      de,__drdma
        call    5

        ; Find first.
        ld      c,17
        ld      de,__drfcb
        call    5
        cp      0ffh
        jr      nz,__droky
        ld      hl,0
        pop     ix
        ret

__droky:
        ld      (__dridx),a
        xor     a
        ld      (__drdn),a
        inc     a
        ld      (__drhav),a
        ld      hl,__dirob
        pop     ix
        ret

        public  _drd
_drd:
        push    ix
        ld      ix,0
        add     ix,sp

        ; NULL DIR* or done -> NULL.
        ld      a,(ix+4)
        or      (ix+5)
        jr      z,__drnul
        ld      a,(__drdn)
        or      a
        jr      nz,__drnul

        ; If opendir already has a current result, consume it; otherwise
        ; ask BDOS for the next result.
        ld      a,(__drhav)
        or      a
        jr      nz,__drcur

        ; A read()/write() since opendir may have repointed the BDOS DMA at a
        ; caller buffer (the direct-DMA file I/O path does this), so search-next
        ; would fill that buffer instead of __drdma.  Restore our directory DMA.
        ld      c,26
        ld      de,__drdma
        call    5

        ld      c,18
        ld      de,__drfcb
        call    5
        cp      0ffh
        jr      nz,__drnxt
        ld      (__drdn),a
__drnul:
        ld      hl,0
        pop     ix
        ret

__drnxt:
        ld      (__dridx),a
__drcur:
        xor     a
        ld      (__drhav),a

        ; HL = __drdma + result_index * 32
        ld      a,(__dridx)
        add     a,a
        add     a,a
        add     a,a
        add     a,a
        add     a,a
        ld      e,a
        ld      d,0
        ld      hl,__drdma
        add     hl,de
        inc     hl              ; skip user byte; now at 8-byte name
        ld      de,__drent

        ; Copy base name, trimming spaces/high attribute bits.
        ld      b,8
__drnam:
        ld      a,(hl)
        and     7fh
        cp      ' '
        jr      z,__drnsp
        ld      (de),a
        inc     de
__drnsp:
        inc     hl
        djnz    __drnam

        ; Extension: if first ext char is non-space, add '.' and copy the
        ; non-space extension chars.
        ld      a,(hl)
        and     7fh
        cp      ' '
        jr      z,__drter
        ld      a,'.'
        ld      (de),a
        inc     de
        ld      b,3
__drext:
        ld      a,(hl)
        and     7fh
        cp      ' '
        jr      z,__dresp
        ld      (de),a
        inc     de
__dresp:
        inc     hl
        djnz    __drext

__drter:
        xor     a
        ld      (de),a
        ld      hl,__drent
        pop     ix
        ret

        public  _dcls
_dcls:
        ld      a,1
        ld      (__drdn),a
        ld      hl,0
        ret

; Opaque DIR object, FCB, DMA buffer, and one static dirent.  This API is
; deliberately non-reentrant, matching the tiny CP/M runtime style.
__dirob:        db      0
__dridx:        db      0
__drhav:        db      0
__drdn:         db      1
__drfcb:        ds      36
__drdma:        ds      128
__drent:        ds      13

        public  _perror
_perror:
        ; void perror(const char *str) - single pointer argument, and
        ; __conout preserves HL across every call in the loops below;
        ; IX-free leaf.
        pop     bc
        pop     hl              ; str
        push    hl
        push    bc
        ld      a,h
        or      l
        jr      z,__prmsg
__prlp:
        ld      a,(hl)
        or      a
        jr      z,__prcol
        ld      e,a
        call    __conout
        inc     hl
        jr      __prlp
__prcol:
        ld      e,':'
        call    __conout
        ld      e,' '
        call    __conout
__prmsg:
        ld      hl,(_errno)
        push    hl
        call    _strerror
        pop     de
__prlp2:
        ld      a,(hl)
        or      a
        jr      z,__prend
        ld      e,a
        call    __conout
        inc     hl
        jr      __prlp2
__prend:
        ld      e,0ah
        call    __conout
        ld      hl,0
        ret



; ---------------------------------------------------------------------------
; IEEE-754 single precision float core, phase 1.
;
; ABI convention for opaque float values matches dcc's existing 32-bit value
; convention: DE:HL holds the raw IEEE bits, with HL = low word and DE = high
; word.  In memory this is little-endian: byte0, byte1, byte2, byte3.
;
; These helpers intentionally do not implement arithmetic yet.  They provide
; classification/sign primitives and real IEEE-aware equality/inequality that
; later arithmetic/conversion routines can build on.  Kept as separate PUBLIC
; blocks so dccrtlstrip can remove them when no float operation references them.
; ---------------------------------------------------------------------------

        public  __fzro
__fzro:
        ; input DE:HL raw float. return HL=1 if +/-0.0, else 0.
        ld      a,d
        and     7fh
        or      e
        or      h
        or      l
        ld      hl,0
        ret     nz
        inc     l
        ret

        public  __fnan
__fnan:
        ; input DE:HL raw float. return HL=1 if NaN, else 0.
        ld      a,d
        and     7fh
        cp      7fh
        jr      nz,__fnn0
        bit     7,e
        jr      z,__fnn0
        ld      a,e
        and     7fh
        or      h
        or      l
        jr      z,__fnn0
        ld      hl,1
        ret
__fnn0:
        ld      hl,0
        ret

        public  __finf
__finf:
        ; input DE:HL raw float. return HL=1 if +/-Inf, else 0.
        ld      a,d
        and     7fh
        cp      7fh
        jr      nz,__fif0
        bit     7,e
        jr      z,__fif0
        ld      a,e
        and     7fh
        or      h
        or      l
        jr      nz,__fif0
        ld      hl,1
        ret
__fif0:
        ld      hl,0
        ret

        public  __fabs
__fabs:
        ; input/output DE:HL raw float. clear sign bit.
        ld      a,d
        and     7fh
        ld      d,a
        ret

        public  __fsgn
__fsgn:
        ; input DE:HL raw float. return HL=1 if sign bit set, else 0.
        ld      hl,0
        bit     7,d
        ret     z
        inc     l
        ret

        public  __feq
__feq:
        ; int __feq(float a, float b)
        ; IEEE-aware equality for phase 1: NaN compares false, +0 == -0.
        push    ix
        ld      ix,0
        add     ix,sp

        ; if a is NaN, false
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    __fnan
        ld      a,h
        or      l
        jp      nz,__feq0

        ; if b is NaN, false
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+10)
        ld      d,(ix+11)
        call    __fnan
        ld      a,h
        or      l
        jp      nz,__feq0

        ; if a is zero, true only when b is also zero
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    __fzro
        ld      a,h
        or      l
        jp      z,__feq_cmp
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+10)
        ld      d,(ix+11)
        call    __fzro
        ld      a,h
        or      l
        jp      nz,__feq1
        jp      __feq0

__feq_cmp:
        ; raw bit compare for all non-zero, non-NaN values
        ld      a,(ix+4)
        cp      (ix+8)
        jp      nz,__feq0
        ld      a,(ix+5)
        cp      (ix+9)
        jp      nz,__feq0
        ld      a,(ix+6)
        cp      (ix+10)
        jp      nz,__feq0
        ld      a,(ix+7)
        cp      (ix+11)
        jp      nz,__feq0
__feq1:
        ld      hl,1
        ld      sp,ix
        pop     ix
        ret
__feq0:
        ld      hl,0
        ld      sp,ix
        pop     ix
        ret

        public  __fneq
__fneq:
        ; int __fneq(float a, float b) -- logical inverse of __feq.
        push    ix
        ld      ix,0
        add     ix,sp

        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    __fnan
        ld      a,h
        or      l
        jp      nz,__fnq1

        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+10)
        ld      d,(ix+11)
        call    __fnan
        ld      a,h
        or      l
        jp      nz,__fnq1

        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    __fzro
        ld      a,h
        or      l
        jp      z,__fnq_cmp
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+10)
        ld      d,(ix+11)
        call    __fzro
        ld      a,h
        or      l
        jp      nz,__fnq0
        jp      __fnq1

__fnq_cmp:
        ld      a,(ix+4)
        cp      (ix+8)
        jp      nz,__fnq1
        ld      a,(ix+5)
        cp      (ix+9)
        jp      nz,__fnq1
        ld      a,(ix+6)
        cp      (ix+10)
        jp      nz,__fnq1
        ld      a,(ix+7)
        cp      (ix+11)
        jp      nz,__fnq1
__fnq0:
        ld      hl,0
        ld      sp,ix
        pop     ix
        ret
__fnq1:
        ld      hl,1
        ld      sp,ix
        pop     ix
        ret


; ---------------------------------------------------------------------------
; IEEE-754 single precision ordered comparisons, phase 2.
;
; C-style ordered comparisons return false when either operand is NaN.
; +0.0 and -0.0 compare equal.  For all other values, comparison is done by
; sign first, then raw IEEE magnitude ordering.  This is enough for correct
; < <= > >= without doing any arithmetic.
;
; Calling convention: first arg at IX+4..IX+7, second arg at IX+8..IX+11.
; Return HL=1 for true, HL=0 for false.
; ---------------------------------------------------------------------------

        public  __flt
__flt:
        ; int __flt(float a, float b) -- a < b
        push    ix
        ld      ix,0
        add     ix,sp

        ; Fast path: both positive non-NaN. For positive IEEE singles (sign=0,
        ; exp<255), raw byte ordering matches numeric ordering, so skip NaN/zero
        ; checks and compare directly.
        ld      a,(ix+7)
        ld      b,a
        ld      a,(ix+11)
        or      b               ; both sign bits must be 0
        and     80h
        jp      nz,__flt_slow
        ld      a,(ix+7)
        and     7fh
        cp      7fh
        jp      z,__flt_slow    ; a: D&7F==7F => might be NaN/Inf
        ld      a,(ix+11)
        and     7fh
        cp      7fh
        jp      z,__flt_slow    ; b: D&7F==7F => might be NaN/Inf
        ld      a,(ix+7)
        cp      (ix+11)
        jp      c,__flt1
        jp      nz,__flt0
        ld      a,(ix+6)
        cp      (ix+10)
        jp      c,__flt1
        jp      nz,__flt0
        ld      a,(ix+5)
        cp      (ix+9)
        jp      c,__flt1
        jp      nz,__flt0
        ld      a,(ix+4)
        cp      (ix+8)
        jp      c,__flt1
        jp      __flt0

__flt_slow:
        ; cold path: classify once with the shared ordered comparator.
        ; __fcmps returns A = 0 unordered, 1 a<b, 2 a==b, 3 a>b.
        call    __fcmps
        cp      1
        jp      z,__flt1        ; a < b
        jp      __flt0
__flt1:
        ld      hl,1
        ld      sp,ix
        pop     ix
        ret
__flt0:
        ld      hl,0
        ld      sp,ix
        pop     ix
        ret

        public  __fgt
__fgt:
        ; int __fgt(float a, float b) -- a > b == b < a
        push    ix
        ld      ix,0
        add     ix,sp

        ; Fast path: both positive non-NaN -- a > b iff b_raw < a_raw.
        ld      a,(ix+7)
        ld      b,a
        ld      a,(ix+11)
        or      b
        and     80h
        jp      nz,__fgt_slow
        ld      a,(ix+7)
        and     7fh
        cp      7fh
        jp      z,__fgt_slow
        ld      a,(ix+11)
        and     7fh
        cp      7fh
        jp      z,__fgt_slow
        ld      a,(ix+11)       ; compare b vs a (b < a means a > b)
        cp      (ix+7)
        jp      c,__fgt1
        jp      nz,__fgt0
        ld      a,(ix+10)
        cp      (ix+6)
        jp      c,__fgt1
        jp      nz,__fgt0
        ld      a,(ix+9)
        cp      (ix+5)
        jp      c,__fgt1
        jp      nz,__fgt0
        ld      a,(ix+8)
        cp      (ix+4)
        jp      c,__fgt1
        jp      __fgt0

__fgt_slow:
        ; cold path: a > b is true only for the greater classification.
        call    __fcmps
        cp      3
        jp      z,__fgt1        ; a > b
        jp      __fgt0
__fgt1:
        ld      hl,1
        ld      sp,ix
        pop     ix
        ret
__fgt0:
        ld      hl,0
        ld      sp,ix
        pop     ix
        ret

        public  __fle
__fle:
        ; int __fle(float a, float b) -- a <= b, false if unordered.
        push    ix
        ld      ix,0
        add     ix,sp

        ; Fast path: both positive non-NaN -- a <= b iff a_raw <= b_raw.
        ld      a,(ix+7)
        ld      b,a
        ld      a,(ix+11)
        or      b
        and     80h
        jp      nz,__fle_slow
        ld      a,(ix+7)
        and     7fh
        cp      7fh
        jp      z,__fle_slow
        ld      a,(ix+11)
        and     7fh
        cp      7fh
        jp      z,__fle_slow
        ld      a,(ix+7)
        cp      (ix+11)
        jp      c,__fle1
        jp      nz,__fle0
        ld      a,(ix+6)
        cp      (ix+10)
        jp      c,__fle1
        jp      nz,__fle0
        ld      a,(ix+5)
        cp      (ix+9)
        jp      c,__fle1
        jp      nz,__fle0
        ld      a,(ix+4)
        cp      (ix+8)
        jp      c,__fle1
        jp      nz,__fle0
        jp      __fle1          ; equal => a <= b

__fle_slow:
        ; cold path: a <= b is true for less or equal, false if unordered.
        call    __fcmps
        or      a
        jp      z,__fle0        ; unordered
        cp      3
        jp      z,__fle0        ; greater
        ; falls through: less or equal
__fle1:
        ld      hl,1
        ld      sp,ix
        pop     ix
        ret
__fle0:
        ld      hl,0
        ld      sp,ix
        pop     ix
        ret

        public  __fge
__fge:
        ; int __fge(float a, float b) -- a >= b, false if unordered.
        push    ix
        ld      ix,0
        add     ix,sp

        ; Fast path: both positive non-NaN -- a >= b iff a_raw >= b_raw.
        ld      a,(ix+7)
        ld      b,a
        ld      a,(ix+11)
        or      b
        and     80h
        jp      nz,__fge_slow
        ld      a,(ix+7)
        and     7fh
        cp      7fh
        jp      z,__fge_slow
        ld      a,(ix+11)
        and     7fh
        cp      7fh
        jp      z,__fge_slow
        ld      a,(ix+7)
        cp      (ix+11)
        jp      c,__fge0        ; a_byte < b_byte => a < b
        jp      nz,__fge1       ; a_byte > b_byte => a > b
        ld      a,(ix+6)
        cp      (ix+10)
        jp      c,__fge0
        jp      nz,__fge1
        ld      a,(ix+5)
        cp      (ix+9)
        jp      c,__fge0
        jp      nz,__fge1
        ld      a,(ix+4)
        cp      (ix+8)
        jp      c,__fge0
        jp      __fge1          ; equal or a_byte >= b_byte => a >= b

__fge_slow:
        ; cold path: a >= b is true for greater or equal, false if unordered.
        call    __fcmps
        cp      2
        jp      nc,__fge1       ; equal or greater
        jp      __fge0          ; unordered or less
__fge1:
        ld      hl,1
        ld      sp,ix
        pop     ix
        ret
__fge0:
        ld      hl,0
        ld      sp,ix
        pop     ix
        ret

; ---------------------------------------------------------------------------
; Shared ordered float comparator.  Classifies a@IX+4 vs b@IX+8 once; the
; individual __flt/__fgt/__fle/__fge cold paths map the result to a boolean.
; Returns A = 0 unordered (either NaN), 1 a<b, 2 a==b (incl +0==-0), 3 a>b.
; Assumes the caller's IX frame is live; preserves IX.
; ---------------------------------------------------------------------------
__fcmps:
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    __fnan
        ld      a,h
        or      l
        jp      nz,__fcun       ; a is NaN -> unordered
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+10)
        ld      d,(ix+11)
        call    __fnan
        ld      a,h
        or      l
        jp      nz,__fcun       ; b is NaN -> unordered
        ; zero handling: +0 and -0 are equal to each other
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    __fzro
        push    hl
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+10)
        ld      d,(ix+11)
        call    __fzro          ; HL = (b == 0)
        pop     de              ; DE = (a == 0)
        ld      a,d
        or      e
        jp      z,__fcsg        ; a != 0 -> compare by sign/magnitude
        ld      a,h
        or      l
        jp      nz,__fceq       ; a == 0 and b == 0 -> equal
        ; a == 0, b != 0: fall through to sign/magnitude compare
__fcsg:
        ld      a,(ix+7)
        xor     (ix+11)
        and     80h
        jp      z,__fcsm        ; same sign
        ; different signs: the negative operand is the smaller
        ld      a,(ix+7)
        bit     7,a
        jp      nz,__fclt       ; a negative -> a < b
        jp      __fcgt          ; a positive, b negative -> a > b
__fcsm:
        ld      a,(ix+7)
        bit     7,a
        jp      nz,__fcsn
        ; both positive: raw magnitude order matches numeric order
        jp      __frcmp         ; tail: A = 1/2/3 maps to less/equal/greater
__fcsn:
        ; both negative: raw magnitude order is reversed
        call    __frcmp
        cp      1
        jp      z,__fcgt        ; a_raw < b_raw -> a > b
        cp      3
        jp      z,__fclt        ; a_raw > b_raw -> a < b
        ret                     ; equal stays equal (A = 2)
__fcun:
        xor     a               ; 0 = unordered
        ret
__fclt:
        ld      a,1
        ret
__fceq:
        ld      a,2
        ret
__fcgt:
        ld      a,3
        ret

; Raw unsigned 3-way magnitude compare of a@IX+4 vs b@IX+8.
; Returns A = 1 (a_raw < b_raw), 2 (a_raw == b_raw), 3 (a_raw > b_raw).
__frcmp:
        ld      a,(ix+7)
        cp      (ix+11)
        jp      c,__frcl
        jp      nz,__frcg
        ld      a,(ix+6)
        cp      (ix+10)
        jp      c,__frcl
        jp      nz,__frcg
        ld      a,(ix+5)
        cp      (ix+9)
        jp      c,__frcl
        jp      nz,__frcg
        ld      a,(ix+4)
        cp      (ix+8)
        jp      c,__frcl
        jp      nz,__frcg
        ld      a,2
        ret
__frcl:
        ld      a,1
        ret
__frcg:
        ld      a,3
        ret


; ---- IEEE single / integer conversion helpers ---------------------------
; Calling convention: float values are returned/passed in DE:HL, with HL
; holding the low 16 bits and DE holding the high 16 bits of the IEEE word.
;
; __fuf: unsigned 16-bit HL -> float DE:HL
; __fif: signed   16-bit HL -> float DE:HL
; __ffu: float DE:HL -> unsigned 16-bit HL, trunc toward zero
; __ffi: float DE:HL -> signed   16-bit HL, trunc toward zero

        public  __fuf
__fuf:
        ld      a,h
        or      l
        jp      nz,FUFNZ
        ld      de,0
        ret
FUFNZ:
        ld      b,142          ; exponent for bit 15
FUFN1:
        bit     7,h
        jp      nz,FUFND
        add     hl,hl
        dec     b
        jp      FUFN1
FUFND:
        ld      c,h            ; C = normalized high byte
        ld      a,l
        ld      h,a            ; HL low word = (norm_low << 8)
        ld      l,0
        ld      a,b
        ld      d,a
        srl     d              ; D = exponent >> 1
        and     1
        rrca                    ; A = exponent low bit in bit 7
        and     80h
        ld      e,a
        ld      a,c
        and     7fh            ; mantissa bits 22..16
        or      e
        ld      e,a
        ret

        public  __fif
__fif:
        bit     7,h
        jp      z,__fuf
        ld      a,h
        cpl
        ld      h,a
        ld      a,l
        cpl
        ld      l,a
        inc     hl
        call    __fuf
        ld      a,d
        or      80h
        ld      d,a
        ret

        public  __ffu
__ffu:
        ; Get unbiased exponent from high word DE.  Sign is ignored here.
        ld      a,d
        and     7fh
        add     a,a
        ld      c,a
        ld      a,e
        rlca
        and     1
        or      c              ; A = exponent
        cp      127
        jp      nc,FFU_GE1
        ld      hl,0
        ret
FFU_GE1:
        cp      143
        jp      c,FFU_OK
        ld      hl,0ffffh      ; saturate overflow/inf/nan-ish cases
        ret
FFU_OK:
        ld      c,a
        ld      a,142
        sub     c
        ld      b,a            ; B = right shift count
        ld      c,h            ; save mantissa bits 15..8 source
        ld      a,e
        and     7fh
        or      80h
        ld      h,a
        ld      l,c            ; HL = normalized 1.x as 16-bit
        inc     b
FFUS1:
        dec     b
        jp      z,FFUDN
        srl     h
        rr      l
        jp      FFUS1
FFUDN:
        ret

        public  __ffi
__ffi:
        ld      a,d
        and     80h
        push    af
        res     7,d
        call    __ffu
        pop     af
        or      a
        ret     z
        ld      a,h
        cpl
        ld      h,a
        ld      a,l
        cpl
        ld      l,a
        inc     hl
        ret



; ---- IEEE single add/sub helpers ----------------------------------------
; Calling convention: caller pushes left float then right float as
;   push de / push hl for each.  At entry:
;     IX+4..7   = right operand low..high
;     IX+8..11  = left  operand low..high
; Return DE:HL = left +/- right.  This is a compact phase-1 IEEE add/sub:
; normalized finite numbers and signed zero are handled; NaN/Inf handling is
; conservative and returns the left operand for those uncommon bootstrap cases.

        public  __faf
__faf:
        ; fastcall float a+b: DE:HL = b (live), a still on the stack (one
        ; push, 4 bytes). Named __faf, not __faddf: M80 truncates public
        ; symbols to 6 significant characters, and __faddf truncates to
        ; __FADD, colliding with __fadd itself - the same mistake as
        ; __msf's first attempt (__msetf) and __fmf's (__fmulf).
        xor     a
        ld      (FSUB),a
        jp      FADDR0F

        public  __fsf
__fsf:
        ; fastcall float a-b: DE:HL = b (live, the subtrahend - the
        ; calling convention's "right"/last-pushed operand at every call
        ; site), a still on the stack. Named __fsf, not __fsubf, for the
        ; same 6-char-truncation reason (__fsubf -> __FSUB, colliding
        ; with __fsub).
        ld      a,1
        ld      (FSUB),a
FADDR0F:
        ; Unpack b (still live in DE:HL, the CURRENTLY ACTIVE register
        ; bank) before ix/the stack are touched at all - FUNR only
        ; touches registers, so this works with no memory scratch and no
        ; push, unlike __fmul/__fdiv's memory-scratch-based fastcall
        ; unpack. Do NOT exx before this call: exx would swap DE:HL away
        ; to the shadow set, losing b's live value before FUNR ever sees
        ; it (the bug in an earlier version of this code, caught by a
        ; printf("%f") correctness test producing garbled digits).
        call    FUNR
        ; __fsf's sign flip, while b's bank is still the active one.
        ld      a,(FSUB)
        or      a
        jp      z,FAF_NOFLIP
        ld      a,d
        xor     80h
        ld      d,a
FAF_NOFLIP:
        exx                     ; b now safely parked in the shadow bank;
                                 ; the newly-active bank is free for a
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    FUNR            ; unpack a into the now-active bank
        jp      FANOFL2         ; active=a, shadow=b - matches FANOFL2's
                                 ; expectation exactly

        public  __fadd
__fadd:
        push    ix
        ld      ix,0
        add     ix,sp
        xor     a
        ld      (FSUB),a
        jp      FADDR0

        public  __fsub
__fsub:
        push    ix
        ld      ix,0
        add     ix,sp
        ld      a,1
        ld      (FSUB),a
FADDR0:
        ; Fully register-resident add/subtract: both operands' entire
        ; unpacked state (sign, exponent, 24-bit mantissa with the
        ; implicit bit merged in) live in registers for the WHOLE
        ; computation - one operand in the main register bank, the other
        ; in the alternate bank (reached via EXX) - with no named memory
        ; scratch at all, unlike __fmul/__fdiv's AM0-2/BM0-2/AEXP/BEXP/
        ; ASGN/BSGN. Mirrors z88dk math32's fsadd32 structure (see project
        ; notes), adapted for dcc's 24-bit (not 32-bit) mantissa.
        ;
        ; Register layout, per bank: B=exponent, C=mantissa high byte,
        ; H=mantissa mid byte, L=mantissa low byte, D=sign (0x80 or 0), E
        ; spare. EXX swaps BC/DE/HL only, never AF or the flags, so A (and
        ; the flags right after a compare) are always safe to carry across
        ; a bank switch.

        ; unpack operand A (left) into the main bank
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+10)
        ld      d,(ix+11)
        call    FUNR

        exx
        ; unpack operand B (right) into the alternate bank
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    FUNR

        ; __fsub: flip B's sign (alternate bank's D is active here)
        ld      a,(FSUB)
        or      a
        jp      z,FANOFL
        ld      a,d
        xor     80h             ; flip IEEE sign bit, not bit 0
        ld      d,a
FANOFL:
        exx                     ; main bank (operand A) active again
FANOFL2:
        ; __faf/__fsf rejoin here: they already did their own equivalent
        ; bank switch above, so they jump straight past this one.
        ; zero shortcuts: if A==0, result=B; if B==0, result=A. "Zero"
        ; means exponent and all three mantissa bytes are zero, matching
        ; the original memory-based check exactly (not just exponent==0).
        ld      a,b
        or      c
        or      h
        or      l
        jp      nz,FANZ
        ; A is zero: pack B (alternate bank) directly and return.
        exx
        call    FPKR
        jp      FARET
FANZ:
        exx                     ; peek at B's zero-ness
        ld      a,b
        or      c
        or      h
        or      l
        exx                     ; back to main; EXX doesn't touch flags
        jp      nz,FALGNR
        ; B is zero: pack A (main bank, already active) and return.
        call    FPKR
        jp      FARET

FALGNR:
        ; align exponents: compute the difference once (in whichever
        ; direction lands as a positive shift count) and shift the smaller
        ; operand's mantissa via FSHR (byte-skip plus register-resident
        ; residual bit shift, same technique as the old FALGN).
        exx                     ; alternate active (operand B)
        ld      a,b             ; A = BEXP
        exx                     ; main active again; A preserved = BEXP
        ld      e,a             ; E (main, spare) = BEXP, preserved for
                                ; later even though A gets consumed below
        sub     b               ; A = BEXP - AEXP; main's B (AEXP) unchanged
        jp      z,FSIGNC        ; equal exponents: nothing to align
        jp      c,FAEXPB        ; carry: BEXP < AEXP -> shift B's mantissa

        ; BEXP > AEXP: shift A's mantissa right by A(=diff), then AEXP:=BEXP
        cp      24
        jp      nc,FANEGL       ; diff >= 24: A's contribution negligible
        call    FSHR            ; shift main's C:H:L right by A bits
        ld      a,e
        ld      b,a             ; AEXP := BEXP
        jp      FSIGNC
FANEGL:
        ; A negligible relative to B: zero A's mantissa, AEXP := BEXP
        xor     a
        ld      c,a
        ld      h,a
        ld      l,a
        ld      a,e
        ld      b,a
        jp      FSIGNC

FAEXPB:
        ; AEXP > BEXP (A = BEXP-AEXP, negative): negate for B's shift count.
        ; AEXP (main's B) is already the correct result exponent here, so
        ; nothing needs preserving/restoring the way BEXP did above.
        neg
        cp      24
        jp      nc,FBNEGL       ; diff >= 24: B's contribution negligible
        exx                     ; alternate active (operand B's mantissa)
        call    FSHR            ; shift alternate's C:H:L right by A bits
        exx                     ; main active again
        jp      FSIGNC
FBNEGL:
        ; B negligible relative to A: zero B's mantissa (alternate bank)
        exx
        xor     a
        ld      c,a
        ld      h,a
        ld      l,a
        exx

FSIGNC:
        ; compare signs (both operands now share the same exponent)
        ld      a,d             ; A = ASGN
        exx                     ; alternate active; A preserved
        cp      d               ; compare against BSGN
        exx                     ; main active; EXX preserves flags
        jp      nz,FSUBTR

        ; same sign: mantissa add. Move main's low16 to the alternate bank
        ; via the stack (cheap, one push/pop pair - not a named-memory
        ; round trip), add there against B's own low16, then bring the
        ; 24-bit sum back the same way. See project notes for the by-hand
        ; trace confirming this is a correct 24-bit cross-bank add.
        push    hl              ; stack: main's AM1:AM0
        ld      a,c             ; A = AM2
        exx                     ; alternate active
        pop     de              ; DE(alt) = AM1:AM0
        add     hl,de           ; HL(alt, own BM1:BM0) + DE -> sum low16
        adc     a,c             ; A = AM2+BM2+carry -> sum high byte
        push    hl              ; stack: sum's low16
        exx                     ; main active; A (sum high byte) preserved
        pop     hl              ; main's HL = sum's low16
        ld      c,a             ; main's C = sum's high byte
        jp      c,FOVERF        ; carry: mantissa overflowed bit 23
        jp      FNORMR
FOVERF:
        ; overflow: shift right 1, restore the implicit bit, exponent++
        srl     c
        rr      h
        rr      l
        set     7,c
        inc     b
        jp      FPACKR

FSUBTR:
        ; different signs: subtract, result sign = sign of the bigger
        ; magnitude. Compute A-B via the same cross-bank stack transfer;
        ; a borrow out of the high byte means B was bigger, so negate the
        ; (still in-progress) difference and take B's sign instead of
        ; redoing a separate B-A subtraction.
        ;
        ; "pop de" below writes both D and E, which would destroy BSGN (in
        ; D) before FBBIG gets a chance to read it - save it into B first
        ; (BEXP is no longer needed once alignment is done, so B is free).
        push    hl              ; stack: main's AM1:AM0
        ld      a,c              ; A = AM2
        exx                      ; alternate active
        ld      b,d              ; B = BSGN (saved before "pop de" clobbers D)
        pop     de               ; DE(alt) = AM1:AM0
        ex      de,hl            ; HL(alt) = AM1:AM0, DE(alt) = BM1:BM0
        or      a                ; clear carry
        sbc     hl,de            ; HL = A_low16 - B_low16
        sbc     a,c              ; A = AM2-BM2-borrow -> diff high byte;
                                ; final borrow-out in carry
        jp      c,FBBIG          ; A_mantissa < B_mantissa
        ; A_mantissa >= B_mantissa: diff (A-B) is correct, sign stays A's
        push    hl
        exx                      ; main active; A (diff high byte) preserved
        pop     hl
        ld      c,a
        jp      FNORMR

FBBIG:
        ; A_mantissa < B_mantissa: negate {A:HL} (still in the alternate
        ; bank) to get B-A; result sign becomes B's sign (saved in B above).
        ; C (BM2) is no longer needed once the subtract is done, so it's
        ; free to use as the negate scratch instead of B (which now holds
        ; BSGN and must survive).
        ld      c,a
        xor     a
        sub     l
        ld      l,a
        ld      a,0
        sbc     a,h
        ld      h,a
        ld      a,0
        sbc     a,c             ; A = negated high byte
        push    hl               ; stack: negated low16
        exx                      ; main active; A preserved
        pop     hl               ; main's HL = negated low16
        ld      c,a               ; main's C = negated high byte
        exx                       ; alternate active, to fetch BSGN (saved in B)
        ld      a,b
        exx                       ; main active
        ld      d,a               ; ASGN := BSGN

FNORMR:
        ; Register-resident renormalize, identical logic/stopping
        ; conditions to the old memory-based FNORM, just targeting C:H:L
        ; (mantissa) and B (exponent) directly instead of AM2:AM1:AM0 and
        ; AEXP in memory.
        ld      a,c
        or      h
        or      l
        jp      z,FZERO
FNORMR_LP:
        bit     7,c
        jp      nz,FPACKR
        add     hl,hl           ; 16-bit shift left of the low 16 bits
        rl      c               ; carry out rolls into the high byte's bit 0
        djnz    FNORMR_LP       ; also decrements the exponent copy in B
FPACKR:
        call    FPKR
FARET:
        ld      sp,ix
        pop     ix
        ret
FZERO:
        ld      hl,0
        ld      de,0
        jp      FARET

; Unpack whichever register bank is currently active (transparent to
; EXX): entry D=sign+exp_hi7 E=exp_lo1+mant_hi7 H=mant_mid L=mant_lo (the
; packed float already loaded into DEHL); exit B=exponent C=mantissa high
; byte (implicit bit merged in) H=mantissa mid byte (unchanged from entry)
; L=mantissa low byte (unchanged from entry) D=sign. Used by the
; register-resident __fadd/__fsub above - unrelated to FUNA/FUNB, which
; __fmul/__fdiv still use to unpack into memory scratch.
FUNR:
        ld      a,d
        and     7fh
        add     a,a
        ld      b,a
        ld      a,e
        rlca
        and     1
        or      b
        ld      b,a             ; B = exponent (final)
        ld      a,d
        and     80h
        ld      d,a             ; D = sign (final) - safe, done with D's
                                ; incoming value
        ld      a,e
        and     7fh
        ld      c,a             ; C = mantissa high byte candidate
        ld      a,b
        or      a
        jp      z,FUNRZ
        ld      a,c
        or      80h
        ld      c,a
FUNRZ:
        ret

; Pack whichever register bank is currently active: entry B=exponent
; C=mantissa high byte H=mantissa mid byte L=mantissa low byte D=sign;
; exit D=sign+exp_hi7 E=exp_lo1+mant_hi7 H=mant_mid (unchanged) L=mant_lo
; (unchanged) - the packed float, ready to return via DE:HL.
FPKR:
        ld      a,b
        or      a
        jp      z,FPKRZ
        ld      e,a             ; E = exponent (preserved copy; E is
                                ; spare/free by pack time)
        srl     a
        or      d
        ld      d,a             ; D = sign | (exp>>1)  [final]
        ld      a,e
        and     1
        rrca
        and     80h
        ld      b,a             ; B's exponent role is done now
        ld      a,c
        and     7fh
        or      b
        ld      e,a             ; E = final byte2  [final]
        ret
FPKRZ:
        ld      d,0
        ld      e,0
        ld      h,0
        ld      l,0
        ret

; Shift whichever register bank's C:H:L mantissa (high:mid:low) right by
; A bits (A in 1..23), used by FALGNR above. Byte-skip shortcut for shift
; counts >=8 (a register move, not a memory copy like the old FALGN_AB8/
; FALGN_BB8), falling through to a register-resident residual bit shift
; for the remaining 0..7 bits - same technique as the old FALGN_ASHR/
; FALGN_BSHR, just reusable across both operands via EXX instead of
; duplicated per-operand.
FSHR:
FSHR_BC:
        cp      8
        jp      c,FSHR_RE
        sub     8
        ld      l,h
        ld      h,c
        ld      c,0
        jp      FSHR_BC
FSHR_RE:
        or      a
        ret     z
        ld      b,a
FSHR_BL:
        srl     c
        rr      h
        rr      l
        djnz    FSHR_BL
        ret

; unpack DE:HL to A scratch
FUNA:
        ld      a,d
        and     80h
        ld      (ASGN),a
        ld      a,d
        and     7fh
        add     a,a
        ld      b,a
        ld      a,e
        rlca
        and     1
        or      b
        ld      (AEXP),a
        ld      c,a             ; cache the exponent - avoids reloading it
                                ; from memory below, once A is clobbered
        ld      a,e
        and     7fh
        ld      b,a
        ld      a,c
        or      a
        jp      z,FUNAZ
        ld      a,b
        or      80h
        ld      b,a
FUNAZ:
        ld      a,b
        ld      (AM2),a
        ld      a,h
        ld      (AM1),a
        ld      a,l
        ld      (AM0),a
        ret
; unpack DE:HL to B scratch
FUNB:
        ld      a,d
        and     80h
        ld      (BSGN),a
        ld      a,d
        and     7fh
        add     a,a
        ld      b,a
        ld      a,e
        rlca
        and     1
        or      b
        ld      (BEXP),a
        ld      c,a             ; cache the exponent - avoids reloading it
                                ; from memory below, once A is clobbered
        ld      a,e
        and     7fh
        ld      b,a
        ld      a,c
        or      a
        jp      z,FUNBZ
        ld      a,b
        or      80h
        ld      b,a
FUNBZ:
        ld      a,b
        ld      (BM2),a
        ld      a,h
        ld      (BM1),a
        ld      a,l
        ld      (BM0),a
        ret

; pack A scratch to DE:HL
FPA:
        ld      a,(AEXP)
        or      a
        jp      z,FPAZ
        ld      b,a
        srl     a
        ld      d,a
        ld      a,(ASGN)
        or      d
        ld      d,a
        ld      a,b
        and     1
        rrca
        and     80h
        ld      b,a
        ld      a,(AM2)
        and     7fh
        or      b
        ld      e,a
        ld      a,(AM1)
        ld      h,a
        ld      a,(AM0)
        ld      l,a
        ret
FPAZ:
        ld      hl,0
        ld      de,0
        ret
FPB:
        ld      a,(BEXP)
        ld      (AEXP),a
        ld      a,(BSGN)
        ld      (ASGN),a
        ld      a,(BM2)
        ld      (AM2),a
        ld      a,(BM1)
        ld      (AM1),a
        ld      a,(BM0)
        ld      (AM0),a
        jp      FPA

FSRA:
        ld      a,(AM2)
        srl     a
        ld      (AM2),a
        ld      a,(AM1)
        rr      a
        ld      (AM1),a
        ld      a,(AM0)
        rr      a
        ld      (AM0),a
        ret
FSRB:
        ld      a,(BM2)
        srl     a
        ld      (BM2),a
        ld      a,(BM1)
        rr      a
        ld      (BM1),a
        ld      a,(BM0)
        rr      a
        ld      (BM0),a
        ret
FSLA:
        ld      a,(AM0)
        add     a,a
        ld      (AM0),a
        ld      a,(AM1)
        rla
        ld      (AM1),a
        ld      a,(AM2)
        rla
        ld      (AM2),a
        ret


        public  __fmf
__fmf:
        ; fastcall float fmul(float a [caller pushes 4 bytes], float b [live DE:HL])
        ; Entry: DE:HL = b, one operand live in registers instead of pushed -
        ; skips the general entry's second push/pop pair (fmul is
        ; commutative, so it doesn't matter which conceptual operand this
        ; is; the caller passes whichever one it already has in DE:HL,
        ; often the previous call's own result in a chained expression).
        ; The other operand (a) still travels via a single stack push: both
        ; 4-byte floats don't fit in the register file alongside what
        ; FUNA/FUNB/FMBODY need. Same rationale as the other DCCRTL.MAC
        ; fastcall pairs (__msf, __cmpf, __chf, __slf, __bdosf).
        ;
        ; Named __fmf, not __fmulf: M80 truncates public symbols to 6
        ; significant characters, and __fmulf truncates to __FMUL, which
        ; collides exactly with __fmul's own name (a real "%Mult. Def.
        ; Global __FMUL" linker warning - the same mistake as __msf's
        ; first attempt, __msetf; see project notes).
        call    FUNB            ; unpack b (still live in DE:HL) before the
                                 ; ix-frame setup below clobbers HL/DE
        push    ix
        ld      ix,0
        add     ix,sp
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    FUNA
        jp      FMBODY

        public  __fmul
__fmul:
        push    ix
        ld      ix,0
        add     ix,sp

        ; unpack left operand into A scratch
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+10)
        ld      d,(ix+11)
        call    FUNA
        ; unpack right operand into B scratch
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    FUNB

FMBODY:
        ; zero/subnormal shortcut: this phase treats exponent-zero values as 0.
        ld      a,(AEXP)
        or      a
        jp      z,FMZERO
        ld      a,(BEXP)
        or      a
        jp      z,FMZERO

        ; sign = ASGN xor BSGN
        ld      a,(ASGN)
        ld      b,a
        ld      a,(BSGN)
        xor     b
        and     80h
        ld      (ASGN),a

        ; exponent = AEXP + BEXP - 127
        ld      a,(AEXP)
        ld      l,a
        ld      h,0
        ld      a,(BEXP)
        ld      e,a
        ld      d,0
        add     hl,de
        ld      de,127
        or      a
        sbc     hl,de
        bit     7,h
        jp      nz,FMZERO
        ld      a,h
        or      a
        jp      nz,FMINF
        ld      a,l
        cp      255
        jp      nc,FMINF
        ld      (AEXP),a

        ; Mantissa multiply: compute only the top 32 bits of the 24x24-bit
        ; product AM2:AM1:AM0 * BM2:BM1:BM0, landing directly in FP2:FP3:
        ; FP4:FP5 - the only bytes the code below this point ever reads
        ; (FP0/FP1, the low 16 bits of the true 48-bit product, were
        ; computed by the old bit-serial loop but never read afterward).
        ;
        ; Replaces a 24-iteration bit-serial shift-and-add loop, where every
        ; iteration touched a 6-byte accumulator and a 6-byte shifted
        ; multiplicand entirely through memory, with up to four calls to
        ; __m1u - the same fully register-resident, unrolled 16x16->32
        ; unsigned multiply dcc's own long multiply already relies on (see
        ; __m1u above) - plus a small, fixed number of accumulator updates.
        ;
        ; Splitting each 24-bit mantissa into an 8-bit high part and 16-bit
        ; low part (A = Ahi*2^16 + Alo, B = Bhi*2^16 + Blo):
        ;
        ;   top32(A*B) = (Ahi*Bhi)<<16 + Ahi*Blo + Alo*Bhi + (Alo*Blo>>16)
        ;
        ; Every term is non-negative and A,B both lie in [2^23,2^24) (the
        ; implicit leading mantissa bit is always set here), so A*B lies in
        ; [2^46,2^48) and top32(A*B) is guaranteed to fit in 32 bits - a
        ; plain carry-propagating accumulator can never overflow while
        ; adding these four terms in any order.
        ;
        ; Small integer-valued floats (2.0, 3.0, ... up to 256.0) have Alo
        ; and/or Blo entirely zero, since their whole significant mantissa
        ; fits in the top byte - the old bit-serial loop special-cased this
        ; (skipping guaranteed-zero low iterations) and this workload is
        ; common enough (e.g. small-integer matrix benchmarks) that losing
        ; the shortcut was a measurable regression. Recover it here: any
        ; term whose Alo or Blo factor is entirely zero is mathematically
        ; zero and its __m1u call is skipped outright, rather than replacing
        ; the algorithm.
        ld      a,(AM0)
        ld      b,a
        ld      a,(AM1)
        or      b
        jp      nz,FMANZ        ; Alo != 0
        ld      a,(BM0)
        ld      b,a
        ld      a,(BM1)
        or      b
        jp      nz,FMAZBN       ; Alo == 0, Blo != 0
        jp      FMABZ           ; Alo == 0, Blo == 0

FMANZ:
        ld      a,(BM0)
        ld      b,a
        ld      a,(BM1)
        or      b
        jp      z,FMANBZ        ; Alo != 0, Blo == 0

        ; Alo != 0, Blo != 0: general case, all four terms.
        ;
        ; term = Alo*Blo -> DE:HL (32-bit); only DE (the high 16 bits)
        ; is needed - it seeds the accumulator directly.
        ld      a,(AM0)
        ld      c,a
        ld      a,(AM1)
        ld      b,a             ; BC = Alo
        ld      a,(BM0)
        ld      l,a
        ld      a,(BM1)
        ld      h,a             ; HL = Blo
        call    __m1u           ; DE:HL = Alo*Blo
        ld      a,e
        ld      (FP2),a
        ld      a,d
        ld      (FP3),a
        xor     a
        ld      (FP4),a
        ld      (FP5),a         ; accumulator = high16(Alo*Blo), high half 0

        ; term = Ahi*Blo (8x16) -> HL:E (24-bit); add in full at offset 0.
        ld      a,(BM0)
        ld      c,a
        ld      a,(BM1)
        ld      b,a             ; BC = Blo (multiplicand)
        ld      a,(AM2)         ; A = Ahi (8-bit multiplier)
        call    __m8u           ; HL:E = Ahi*Blo (byte0=E,byte1=L,byte2=H)
        ld      a,(FP2)
        add     a,e
        ld      (FP2),a
        ld      a,(FP3)
        adc     a,l
        ld      (FP3),a
        ld      a,(FP4)
        adc     a,h
        ld      (FP4),a
        ld      a,(FP5)
        adc     a,0
        ld      (FP5),a

        ; term = Alo*Bhi (16x8) -> HL:E (24-bit); add in full at offset 0.
        ld      a,(AM0)
        ld      c,a
        ld      a,(AM1)
        ld      b,a             ; BC = Alo (multiplicand)
        ld      a,(BM2)         ; A = Bhi (8-bit multiplier)
        call    __m8u           ; HL:E = Alo*Bhi (byte0=E,byte1=L,byte2=H)
        ld      a,(FP2)
        add     a,e
        ld      (FP2),a
        ld      a,(FP3)
        adc     a,l
        ld      (FP3),a
        ld      a,(FP4)
        adc     a,h
        ld      (FP4),a
        ld      a,(FP5)
        adc     a,0
        ld      (FP5),a

        ; term = Ahi*Bhi (8x8) -> HL:E; product fits in 16 bits (H = 0), so
        ; the value is L:E - add its two bytes at offset 16.
        ld      a,(BM2)
        ld      c,a
        ld      b,0             ; BC = 0:Bhi (multiplicand)
        ld      a,(AM2)         ; A = Ahi (8-bit multiplier)
        call    __m8u           ; HL:E = Ahi*Bhi (H = 0, value = L:E)
        ld      a,(FP4)
        add     a,e
        ld      (FP4),a
        ld      a,(FP5)
        adc     a,l
        ld      (FP5),a
        jp      FMDONE

FMANBZ:
        ; Alo != 0, Blo == 0: only Ahi*Bhi and Alo*Bhi survive. Both terms
        ; have an 8-bit operand (Bhi, Ahi respectively), so __m8u (half the
        ; iterations of __m1u) applies to both, same as the general case.
        xor     a
        ld      (FP2),a
        ld      (FP3),a
        ld      (FP4),a
        ld      (FP5),a

        ld      a,(AM0)
        ld      c,a
        ld      a,(AM1)
        ld      b,a             ; BC = Alo (multiplicand)
        ld      a,(BM2)         ; A = Bhi (8-bit multiplier)
        call    __m8u           ; HL:E = Alo*Bhi (byte0=E,byte1=L,byte2=H)
        ld      a,(FP2)
        add     a,e
        ld      (FP2),a
        ld      a,(FP3)
        adc     a,l
        ld      (FP3),a
        ld      a,(FP4)
        adc     a,h
        ld      (FP4),a
        ld      a,(FP5)
        adc     a,0
        ld      (FP5),a

        ld      a,(BM2)
        ld      c,a
        ld      b,0             ; BC = 0:Bhi (multiplicand)
        ld      a,(AM2)         ; A = Ahi (8-bit multiplier)
        call    __m8u           ; HL:E = Ahi*Bhi (H = 0, value = L:E)
        ld      a,(FP4)
        add     a,e
        ld      (FP4),a
        ld      a,(FP5)
        adc     a,l
        ld      (FP5),a
        jp      FMDONE

FMAZBN:
        ; Alo == 0, Blo != 0: only Ahi*Bhi and Ahi*Blo survive; both terms
        ; have an 8-bit operand (Ahi both times), same __m8u treatment.
        xor     a
        ld      (FP2),a
        ld      (FP3),a
        ld      (FP4),a
        ld      (FP5),a

        ld      a,(BM0)
        ld      c,a
        ld      a,(BM1)
        ld      b,a             ; BC = Blo (multiplicand)
        ld      a,(AM2)         ; A = Ahi (8-bit multiplier)
        call    __m8u           ; HL:E = Ahi*Blo (byte0=E,byte1=L,byte2=H)
        ld      a,(FP2)
        add     a,e
        ld      (FP2),a
        ld      a,(FP3)
        adc     a,l
        ld      (FP3),a
        ld      a,(FP4)
        adc     a,h
        ld      (FP4),a
        ld      a,(FP5)
        adc     a,0
        ld      (FP5),a

        ld      a,(BM2)
        ld      c,a
        ld      b,0             ; BC = 0:Bhi (multiplicand)
        ld      a,(AM2)         ; A = Ahi (8-bit multiplier)
        call    __m8u           ; HL:E = Ahi*Bhi (H = 0, value = L:E)
        ld      a,(FP4)
        add     a,e
        ld      (FP4),a
        ld      a,(FP5)
        adc     a,l
        ld      (FP5),a
        jp      FMDONE

FMABZ:
        ; Alo == 0, Blo == 0: only Ahi*Bhi survives, landing at offset 16
        ; with nothing to add to (accumulator would otherwise be zero).
        ; Both operands are 8-bit, so __m8u applies directly.
        xor     a
        ld      (FP2),a
        ld      (FP3),a
        ld      a,(BM2)
        ld      c,a
        ld      b,0             ; BC = 0:Bhi (multiplicand)
        ld      a,(AM2)         ; A = Ahi (8-bit multiplier)
        call    __m8u           ; HL:E = Ahi*Bhi (H = 0, value = L:E)
        ld      a,e
        ld      (FP4),a
        ld      a,l
        ld      (FP5),a

FMDONE:
        ; If product bit 47 is set, mantissa = product >> 24 and exponent++.
        ld      a,(FP5)
        bit     7,a
        jp      z,FMNOC
        ld      a,(AEXP)
        inc     a
        cp      255
        jp      nc,FMINF
        ld      (AEXP),a
        ld      a,(FP3)
        ld      (AM0),a
        ld      a,(FP4)
        ld      (AM1),a
        ld      a,(FP5)
        ld      (AM2),a
        jp      FMPAK

FMNOC:
        ; Mantissa = (product >> 23) & 0FFFFFFh.  The 32-bit value in
        ; FP5:FP4:FP3:FP2 (FP5 = high byte) has to be shifted right by 7 and
        ; its low 24 bits kept.  Bit 7 of FP5 is guaranteed clear here (the
        ; product-bit-47 case branched to the >>24 path above), so V < 2^31
        ; and therefore
        ;   (V >> 7) & 0FFFFFFh  ==  bytes 1..3 of (V << 1).
        ; That collapses the old seven-step right shift (28 shift ops) into a
        ; single 32-bit left shift plus three byte stores.
        ld      a,(FP2)
        ld      l,a
        ld      a,(FP3)
        ld      h,a
        ld      a,(FP4)
        ld      e,a
        ld      a,(FP5)
        ld      d,a             ; DEHL = FP5:FP4:FP3:FP2 (D = high byte)
        sla     l
        rl      h
        rl      e
        rl      d               ; DEHL <<= 1 (discarded top bit was 0)
        ld      a,h
        ld      (AM0),a         ; AM0 = byte 1 of (V<<1) = low byte of V>>7
        ld      a,e
        ld      (AM1),a         ; AM1 = byte 2
        ld      a,d
        ld      (AM2),a         ; AM2 = byte 3

FMPAK:
        call    FPA
        ld      sp,ix
        pop     ix
        ret
FMZERO:
        ld      hl,0
        ld      de,0
        ld      sp,ix
        pop     ix
        ret
FMINF:
        ld      hl,0
        ld      de,7f80h
        ld      a,(ASGN)
        or      d
        ld      d,a
        ld      sp,ix
        pop     ix
        ret

; __fmadd: fused a*b+c for floats.  Computes the product exactly as __fmul
; does above (same hybrid zero-skip mantissa multiply, same __m8u/__m1u
; calls, same normalize step - this whole block is a deliberate copy of
; __fmul's body, not a shared subroutine, so nothing here can ever affect
; __fmul's already-verified behavior) but instead of packing the product
; to IEEE format and returning, it loads the still-unpacked product
; (exponent, sign, normalized 24-bit mantissa - exactly the form __fadd's
; register-resident FUNR unpack produces) directly into the main register
; bank, unpacks 'c' the normal way into the alternate bank, and jumps
; straight into __fadd's existing register-resident logic at FANOFL (the
; point right after __fadd's own sign-flip check, which fmadd never needs
; since this is always an add, never a subtract). This skips one full
; pack+unpack round trip - and the stack traffic of an intermediate call -
; compared to a separate __fmul then __fadd.
;
; Stack args: caller pushes c, then a, then b (b closest to the return
; address, matching __fmul/__fadd's existing push order for their own two
; operands): ix+4..7 = b, ix+8..11 = a, ix+12..15 = c.
        public  __fmadd
__fmadd:
        push    ix
        ld      ix,0
        add     ix,sp

        ; Register-resident unpack of 'a' (main bank) and 'b' (alternate
        ; bank) via FUNR - see __fadd's design notes. Unlike the memory-
        ; based FUNA/FUNB (still used by __fmul above and by the memory-
        ; based fallback below), this never touches named memory for
        ; AM0-2/BM0-2/AEXP/BEXP/ASGN/BSGN - which matters because the
        ; common case (both operands small-integer-valued, e.g. mm.c-style
        ; matrices) hits the fast path further down and never needs memory
        ; at all for the mantissa multiply.
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+10)
        ld      d,(ix+11)
        call    FUNR
        exx
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    FUNR
        exx

        ; zero shortcuts (register-resident: exponent|mantissa all zero)
        ld      a,b
        or      c
        or      h
        or      l
        jp      z,FQZERO
        exx
        ld      a,b
        or      c
        or      h
        or      l
        exx
        jp      z,FQZERO

        ; sign = ASGN xor BSGN, stashed in the alternate bank's spare E'
        ; for now - D(main) needs to stay free for the exponent's 16-bit
        ; computation just below, so the final sign doesn't move into
        ; D(main) until after that completes.
        ld      a,d
        exx
        xor     d
        and     80h
        ld      e,a
        exx

        ; exponent = AEXP + BEXP - 127 (16-bit, matching __fmul's exact
        ; overflow/underflow checks - see FMDONE's comment above for why
        ; this needs to be 16-bit, not a plain 8-bit add). HL is needed as
        ; scratch for this, but HL is also where Alo (AM1:AM0) lives from
        ; the FUNR unpack - stash it on the stack first. If this hits an
        ; early FQZERO/FQOVF exit, the push is simply discarded by the
        ; shared epilogue's "ld sp,ix" reset; otherwise it's popped back
        ; explicitly right after, once HL is free again.
        push    hl
        ld      a,b
        ld      l,a
        ld      h,0
        exx
        ld      a,b
        exx
        ld      e,a
        ld      d,0
        add     hl,de
        ld      de,127
        or      a
        sbc     hl,de
        bit     7,h
        jp      nz,FQZERO
        ld      a,h
        or      a
        jp      nz,FQOVF
        ld      a,l
        cp      255
        jp      nc,FQOVF
        ld      b,a             ; B(main) = result exponent
        pop     hl              ; restore Alo (main H:L)

        ; move the stashed sign into its final home now that D(main) is
        ; free again (the exponent computation is done with it)
        exx
        ld      a,e
        exx
        ld      d,a             ; D(main) = result sign [final]

        ; check Alo==0 (main H|L) and Blo==0 (alternate H'|L') - true for
        ; every multiply in a small-integer-valued workload, since the
        ; whole significant mantissa then fits in the top byte (Ahi/Bhi,
        ; already register-resident in C/C').
        ld      a,h
        or      l
        jp      nz,FQFB1
        exx
        ld      a,h
        or      l
        exx
        jp      nz,FQFB2

        ; --- fast path: Alo==0 and Blo==0, only Ahi*Bhi survives ---
        ; "pop bc" below sets BOTH B and C - it's used to load C=Bhi, but
        ; that would just as well clobber B, which holds the precious
        ; result exponent. Save the whole BC pair (exponent+Ahi) on the
        ; stack first and restore it right after the __m8u call, once the
        ; 0:Bhi value it's needed for as an argument has been consumed.
        push    bc              ; stash exponent(B) + Ahi(C)
        ld      a,c             ; A = Ahi (main), the __m8u multiplier
        exx                      ; alternate active; A preserved
        ld      b,0
        push    bc               ; stack: 0:Bhi
        exx                       ; main active; A preserved
        pop     bc                ; BC(main) = 0:Bhi (multiplicand)
        call    __m8u             ; HL:E = Ahi*Bhi (H=0, value=L:E)
        pop     bc                ; restore B(exponent):C(Ahi, no longer needed)

        bit     7,l
        jp      z,FQFNOC
        ld      c,l
        ld      h,e
        ld      l,0
        inc     b
        ld      a,b
        cp      255
        jp      nc,FQOVF2
        jp      FQBRIDGE_R
FQFNOC:
        ; no-carry case: same "(V>>7)&0xFFFFFF == bytes1..3 of (V<<1)"
        ; identity as FQNOC/FMNOC above, specialized since the low two
        ; bytes of V are always 0 in this fast path (nothing but Ahi*Bhi
        ; contributes), so only L and E actually need shifting.
        sla     e
        rl      l
        ld      c,l
        ld      h,e
        ld      l,0
        jp      FQBRIDGE_R

FQOVF2:
        ; mantissa-carry pushed the exponent to overflow; sign is already
        ; final in D at this point (set before the fast path ran).
        ld      a,d
        ld      (ASGN),a
        jp      FQINF

FQOVF:
        ; exponent overflow before the multiply even starts; the sign is
        ; still in its stashed alternate-bank home (D(main) isn't final
        ; yet at this point), so fetch it from there instead.
        exx
        ld      a,e
        exx
        ld      (ASGN),a
        jp      FQINF

FQFB1:
        ; Alo != 0: no fast path. Store both operands to the same memory
        ; locations __fmul's unchanged FUNA/FUNB would have, then jump
        ; into FQANZ, whose own header re-checks Blo to pick the full
        ; four-term computation or FQANBZ - exactly the check this path
        ; still needs, so no work is duplicated.
        ld      a,b
        ld      (AEXP),a
        ld      a,d
        ld      (ASGN),a
        ld      a,c
        ld      (AM2),a
        ld      a,h
        ld      (AM1),a
        ld      a,l
        ld      (AM0),a
        exx
        ld      a,c
        ld      (BM2),a
        ld      a,h
        ld      (BM1),a
        ld      a,l
        ld      (BM0),a
        exx
        jp      FQANZ

FQFB2:
        ; Alo == 0, Blo != 0: store the same way, then jump directly into
        ; FQAZBN - its precondition is already exactly established here,
        ; so no re-check is needed.
        ld      a,b
        ld      (AEXP),a
        ld      a,d
        ld      (ASGN),a
        ld      a,c
        ld      (AM2),a
        ld      a,h
        ld      (AM1),a
        ld      a,l
        ld      (AM0),a
        exx
        ld      a,c
        ld      (BM2),a
        ld      a,h
        ld      (BM1),a
        ld      a,l
        ld      (BM0),a
        exx
        jp      FQAZBN

FQANZ:
        ld      a,(BM0)
        ld      b,a
        ld      a,(BM1)
        or      b
        jp      z,FQANBZ

        ld      a,(AM0)
        ld      c,a
        ld      a,(AM1)
        ld      b,a
        ld      a,(BM0)
        ld      l,a
        ld      a,(BM1)
        ld      h,a
        call    __m1u
        ld      a,e
        ld      (FP2),a
        ld      a,d
        ld      (FP3),a
        xor     a
        ld      (FP4),a
        ld      (FP5),a

        ld      a,(BM0)
        ld      c,a
        ld      a,(BM1)
        ld      b,a
        ld      a,(AM2)
        call    __m8u
        ld      a,(FP2)
        add     a,e
        ld      (FP2),a
        ld      a,(FP3)
        adc     a,l
        ld      (FP3),a
        ld      a,(FP4)
        adc     a,h
        ld      (FP4),a
        ld      a,(FP5)
        adc     a,0
        ld      (FP5),a

        ld      a,(AM0)
        ld      c,a
        ld      a,(AM1)
        ld      b,a
        ld      a,(BM2)
        call    __m8u
        ld      a,(FP2)
        add     a,e
        ld      (FP2),a
        ld      a,(FP3)
        adc     a,l
        ld      (FP3),a
        ld      a,(FP4)
        adc     a,h
        ld      (FP4),a
        ld      a,(FP5)
        adc     a,0
        ld      (FP5),a

        ld      a,(BM2)
        ld      c,a
        ld      b,0
        ld      a,(AM2)
        call    __m8u
        ld      a,(FP4)
        add     a,e
        ld      (FP4),a
        ld      a,(FP5)
        adc     a,l
        ld      (FP5),a
        jp      FQDONE

FQANBZ:
        xor     a
        ld      (FP2),a
        ld      (FP3),a
        ld      (FP4),a
        ld      (FP5),a

        ld      a,(AM0)
        ld      c,a
        ld      a,(AM1)
        ld      b,a
        ld      a,(BM2)
        call    __m8u
        ld      a,(FP2)
        add     a,e
        ld      (FP2),a
        ld      a,(FP3)
        adc     a,l
        ld      (FP3),a
        ld      a,(FP4)
        adc     a,h
        ld      (FP4),a
        ld      a,(FP5)
        adc     a,0
        ld      (FP5),a

        ld      a,(BM2)
        ld      c,a
        ld      b,0
        ld      a,(AM2)
        call    __m8u
        ld      a,(FP4)
        add     a,e
        ld      (FP4),a
        ld      a,(FP5)
        adc     a,l
        ld      (FP5),a
        jp      FQDONE

FQAZBN:
        xor     a
        ld      (FP2),a
        ld      (FP3),a
        ld      (FP4),a
        ld      (FP5),a

        ld      a,(BM0)
        ld      c,a
        ld      a,(BM1)
        ld      b,a
        ld      a,(AM2)
        call    __m8u
        ld      a,(FP2)
        add     a,e
        ld      (FP2),a
        ld      a,(FP3)
        adc     a,l
        ld      (FP3),a
        ld      a,(FP4)
        adc     a,h
        ld      (FP4),a
        ld      a,(FP5)
        adc     a,0
        ld      (FP5),a

        ld      a,(BM2)
        ld      c,a
        ld      b,0
        ld      a,(AM2)
        call    __m8u
        ld      a,(FP4)
        add     a,e
        ld      (FP4),a
        ld      a,(FP5)
        adc     a,l
        ld      (FP5),a
        jp      FQDONE

FQABZ:
        xor     a
        ld      (FP2),a
        ld      (FP3),a
        ld      a,(BM2)
        ld      c,a
        ld      b,0
        ld      a,(AM2)
        call    __m8u
        ld      a,e
        ld      (FP4),a
        ld      a,l
        ld      (FP5),a

FQDONE:
        ld      a,(FP5)
        bit     7,a
        jp      z,FQNOC
        ld      a,(AEXP)
        inc     a
        cp      255
        jp      nc,FQINF
        ld      (AEXP),a
        ld      a,(FP3)
        ld      (AM0),a
        ld      a,(FP4)
        ld      (AM1),a
        ld      a,(FP5)
        ld      (AM2),a
        jp      FQBRIDGE

FQNOC:
        ld      a,(FP2)
        ld      l,a
        ld      a,(FP3)
        ld      h,a
        ld      a,(FP4)
        ld      e,a
        ld      a,(FP5)
        ld      d,a
        sla     l
        rl      h
        rl      e
        rl      d
        ld      a,h
        ld      (AM0),a
        ld      a,e
        ld      (AM1),a
        ld      a,d
        ld      (AM2),a
        jp      FQBRIDGE

FQZERO:
        ; matches __fmul's own FMZERO exactly: always +0, sign dropped -
        ; a pre-existing dcc quirk (not introduced here), preserved for
        ; consistency with a separate __fmul+__fadd call pair.
        xor     a
        ld      (AEXP),a
        ld      (ASGN),a
        ld      (AM0),a
        ld      (AM1),a
        ld      (AM2),a
        jp      FQBRIDGE

FQINF:
        ; matches the unpacked form of __fmul's own FMINF packed output
        ; (7f80h | sign): AEXP=255, AM2=80h (FUNR would merge the implicit
        ; bit into any nonzero-exponent value, including this one), AM1/
        ; AM0=0.
        ld      a,255
        ld      (AEXP),a
        ld      a,80h
        ld      (AM2),a
        xor     a
        ld      (AM1),a
        ld      (AM0),a

FQBRIDGE:
        ld      a,(AEXP)
        ld      b,a
        ld      a,(ASGN)
        ld      d,a
        ld      a,(AM2)
        ld      c,a
        ld      a,(AM1)
        ld      h,a
        ld      a,(AM0)
        ld      l,a

FQBRIDGE_R:
        ; entry point for callers that already have B=exponent,
        ; C=mantissa-hi, H=mantissa-mid, L=mantissa-low, D=sign resident
        ; in registers (the fast path below) - skips the memory reads
        ; above entirely.
        exx
        ld      l,(ix+12)
        ld      h,(ix+13)
        ld      e,(ix+14)
        ld      d,(ix+15)
        call    FUNR
        jp      FANOFL


        public  __fdiv
__fdiv:
        push    ix
        ld      ix,0
        add     ix,sp

        ; unpack left operand into A scratch
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+10)
        ld      d,(ix+11)
        call    FUNA
        ; unpack right operand into B scratch
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    FUNB

        ; sign = ASGN xor BSGN
        ld      a,(ASGN)
        ld      c,a
        ld      a,(BSGN)
        xor     c
        and     80h
        ld      (ASGN),a

        ; 0 / anything = 0.  This phase treats subnormals as zero.
        ld      a,(AEXP)
        or      a
        jp      z,FDZRO

        ; divide by zero => signed infinity
        ld      a,(BEXP)
        or      a
        jp      z,FDINF

        ; exponent = AEXP - BEXP + 127
        ld      a,(AEXP)
        ld      l,a
        ld      h,0
        ld      a,(BEXP)
        ld      e,a
        ld      d,0
        or      a
        sbc     hl,de
        ld      de,127
        add     hl,de
        bit     7,h
        jp      nz,FDZRO
        ld      a,h
        or      a
        jp      nz,FDINF
        ld      a,l
        or      a
        jp      z,FDZRO
        cp      255
        jp      nc,FDINF
        ld      (AEXP),a

        ; R = A mantissa (register-resident), Q = 0 (register-resident).
        ; Compute 24-bit Q ~= A/B scaled by 2^23.
        ;
        ; Two register banks, swapped via EXX:
        ;   "arithmetic" bank (active by default): H=BM2,L=BM1,D=BM0 is the
        ;     constant divisor; B=R2,C=R1,E=R0 is the 24-bit remainder R.
        ;   "control" bank (reached via EXX): H=FQ1,L=FQ0,B=FQ2 is the
        ;     24-bit quotient Q being built; C=RHI is an explicit 0/1 flag
        ;     standing in for R's 25th bit (R is bounded to stay under
        ;     2*divisor < 2^25, so one flag bit suffices instead of a full
        ;     4th byte); D is the loop counter.
        ; EXX does not touch AF, so A/flags are free to use as scratch
        ; across bank switches without disturbing either bank's state.
        ;
        ; H=BM2, L=BM1, D=BM0 in the arithmetic bank are constant
        ; throughout; B=BM2 survives from FUNB; BM0/BM1 must reload from
        ; memory because the exponent computation above clobbers H, L, D,
        ; and E.
        ld      h,b             ; H = BM2  (B preserved through exponent computation)
        ld      a,(BM1)
        ld      l,a             ; L = BM1
        ld      a,(BM0)
        ld      d,a             ; D = BM0

        ld      a,(AM2)
        ld      b,a             ; R2 = AM2
        ld      a,(AM1)
        ld      c,a             ; R1 = AM1
        ld      a,(AM0)
        ld      e,a             ; R0 = AM0

        exx
        ; control bank: Q = 0, RHI = 0, loop counter = 24
        ld      b,0             ; FQ2 = 0
        ld      hl,0            ; FQ1:FQ0 = 0
        ld      c,0             ; RHI = 0
        ld      d,24            ; loop counter
FDLUP:
        ; --- check RHI (control bank active) ---
        ld      a,c
        or      a
        jp      nz,FDFSUB       ; RHI==1: R is unconditionally >= divisor

        ; --- RHI==0: compare R against the divisor (arithmetic bank) ---
        exx
        ld      a,b
        cp      h               ; R2 - BM2
        jp      c,FDNOSB        ; R < B
        jp      nz,FDDOSB       ; R > B
        ld      a,c
        cp      l               ; R1 - BM1
        jp      c,FDNOSB
        jp      nz,FDDOSB
        ld      a,e
        cp      d               ; R0 - BM0
        jp      c,FDNOSB        ; R < B; fall through if R >= B
FDDOSB:
        ld      a,e
        sub     d               ; R0 - BM0 (no borrow input)
        ld      e,a
        ld      a,c
        sbc     a,l             ; R1 - BM1 - borrow
        ld      c,a
        ld      a,b
        sbc     a,h             ; R2 - BM2 - borrow
        ld      b,a
        exx                     ; back to control bank
        ld      e,1             ; SUBFLAG = 1 (a subtract happened)
        jp      FDSHQ
FDNOSB:
        exx                     ; back to control bank
        ld      e,0             ; SUBFLAG = 0
        jp      FDSHQ

FDFSUB:
        ; RHI was 1, meaning R (conceptually RHI*2^24 + R-main) is
        ; unconditionally >= the 24-bit divisor.  R-main < divisor is
        ; therefore guaranteed (proof: the shift-doubling loop invariant
        ; keeps R < 2*divisor at all times, so RHI=1 implies
        ; R-main < 2*divisor - 2^24 <= divisor - 1), so the subtract always
        ; borrows and the new RHI is always 0 - true regardless of RHI's
        ; incoming value, so clear it unconditionally before subtracting.
        xor     a
        ld      c,a             ; RHI = 0
        exx                     ; to arithmetic bank
        ld      a,e
        sub     d
        ld      e,a
        ld      a,c
        sbc     a,l
        ld      c,a
        ld      a,b
        sbc     a,h
        ld      b,a
        exx                     ; back to control bank
        ld      e,1             ; SUBFLAG = 1

FDSHQ:
        ; --- Q <<= 1 (control bank: H:L = FQ1:FQ0, B = FQ2). Must happen
        ; BEFORE consulting SUBFLAG: the original algorithm shifts Q first
        ; (producing a fresh, zero bit 0) and only then ORs in the new low
        ; bit, so SUBFLAG has to be carried across this shift rather than
        ; applied before it. ---
        add     hl,hl
        rl      b
        ld      a,e             ; SUBFLAG
        or      a
        jp      z,FDNOLS
        ld      a,l
        or      1
        ld      l,a             ; Q's freshly-shifted-in low bit set
FDNOLS:
        ; --- R <<= 1 (arithmetic bank); carry-out becomes the new RHI ---
        exx
        ld      a,e
        add     a,a
        ld      e,a
        ld      a,c
        rla
        ld      c,a
        ld      a,b
        rla
        ld      b,a
        exx                     ; back to control bank; EXX preserves carry
        jp      c,FDSRHI
        xor     a
        ld      c,a             ; RHI = 0
        jp      FDCNT
FDSRHI:
        ld      a,1
        ld      c,a             ; RHI = 1
FDCNT:
        dec     d
        jp      nz,FDLUP

        ; Copy the register-resident R, RHI and Q back to the memory
        ; locations the unchanged rounding/normalize code below expects.
        ld      a,c
        ld      (FP3),a
        ld      a,l
        ld      (FQ0),a
        ld      a,h
        ld      (FQ1),a
        ld      a,b
        ld      (FQ2),a
        exx                     ; back to arithmetic bank for R2:R1:R0
        ld      a,e
        ld      (FP0),a
        ld      a,c
        ld      (FP1),a
        ld      a,b
        ld      (FP2),a

        ; Round division result.  At this point FP3:FP2:FP1:FP0 holds
        ; 2*remainder from the final quotient step.  If that value is at
        ; least the divisor mantissa, round the 24-bit quotient up.  This is
        ; round-half-up rather than full round-to-nearest-even, but it fixes
        ; the dominant truncation error without changing the ABI or helper
        ; calling convention.
        ld      a,(FP3)
        or      a
        jp      nz,FDRUP
        ld      a,(FP2)
        ld      c,a
        ld      a,(BM2)
        cp      c
        jp      c,FDRUP
        jp      nz,FDRNO
        ld      a,(FP1)
        ld      c,a
        ld      a,(BM1)
        cp      c
        jp      c,FDRUP
        jp      nz,FDRNO
        ld      a,(FP0)
        ld      c,a
        ld      a,(BM0)
        cp      c
        jp      c,FDRUP
        jp      nz,FDRNO
FDRUP:
        ld      a,(FQ0)
        inc     a
        ld      (FQ0),a
        jp      nz,FDRNO
        ld      a,(FQ1)
        inc     a
        ld      (FQ1),a
        jp      nz,FDRNO
        ld      a,(FQ2)
        inc     a
        ld      (FQ2),a
        jp      nz,FDRNO
        ; Quotient overflowed from 0ffffffh to 1000000h.  Renormalize to
        ; 800000h and bump exponent.
        ld      a,80h
        ld      (FQ2),a
        xor     a
        ld      (FQ1),a
        ld      (FQ0),a
        ld      a,(AEXP)
        inc     a
        cp      255
        jp      nc,FDINF
        ld      (AEXP),a
FDRNO:

        ; Q is the mantissa candidate. Normalize left if the hidden bit is clear.
        ld      a,(FQ0)
        ld      (AM0),a
        ld      a,(FQ1)
        ld      (AM1),a
        ld      a,(FQ2)
        ld      (AM2),a
FDNOR:
        ld      a,(AM2)
        bit     7,a
        jp      nz,FDPAK
        call    FSLA
        ld      a,(AEXP)
        dec     a
        ld      (AEXP),a
        jp      z,FDZRO
        jp      FDNOR

FDPAK:
        call    FPA
        ld      sp,ix
        pop     ix
        ret
FDZRO:
        ld      hl,0
        ld      de,0
        ld      sp,ix
        pop     ix
        ret
FDINF:
        ld      hl,0
        ld      de,7f80h
        ld      a,(ASGN)
        or      d
        ld      d,a
        ld      sp,ix
        pop     ix
        ret

FSUB:   db      0
ASGN:   db      0
AEXP:   db      0
AM0:    db      0
AM1:    db      0
AM2:    db      0
BSGN:   db      0
BEXP:   db      0
BM0:    db      0
BM1:    db      0
BM2:    db      0
FP0:    db      0
FP1:    db      0
FP2:    db      0
FP3:    db      0
FP4:    db      0
FP5:    db      0
FM0:    db      0
FM1:    db      0
FM2:    db      0
FM3:    db      0
FM4:    db      0
FM5:    db      0
FQ0:    db      0
FQ1:    db      0
FQ2:    db      0


; ---------------------------------------------------------------------------
; C89-ish single-precision math helpers.  These are intentionally separate
; PUBLIC blocks so dccrtlstrip can remove them unless the app references them.
;
; ABI: float arguments are 4 bytes on stack, low word then high word.
;      return float in DE:HL.
; These helpers reuse the existing IEEE single core/arithmetic helpers.

        public  _fabsf
_fabsf:
        ; float fabsf(float x) - single 4-byte argument fits in HL:DE
        ; across the restore-and-call; IX-free leaf.
        pop     bc
        pop     hl
        pop     de
        push    de
        push    hl
        push    bc
        call    __fabs
        ret

        public  _floorf
_floorf:
        push    ix
        ld      ix,0
        add     ix,sp
        ld      hl,-8
        add     hl,sp
        ld      sp,hl

        ; l = (long)x
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    __ffl
        ld      (ix-4),l
        ld      (ix-3),h
        ld      (ix-2),e
        ld      (ix-1),d

        ; y = (float)l
        ld      l,(ix-4)
        ld      h,(ix-3)
        ld      e,(ix-2)
        ld      d,(ix-1)
        call    __flf
        ld      (ix-8),l
        ld      (ix-7),h
        ld      (ix-6),e
        ld      (ix-5),d

        ; if (x < y) l--, y = (float)l.
        ; Do the adjustment in integer space.  This avoids depending on
        ; opposite-sign __fsub edge cases while preserving floor semantics
        ; for negative non-integral values.
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        push    de
        push    hl
        ld      l,(ix-8)
        ld      h,(ix-7)
        ld      e,(ix-6)
        ld      d,(ix-5)
        push    de
        push    hl
        call    __fgt             ; y > x
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        ld      a,h
        or      l
        jp      z,FMFRET

        ld      l,(ix-4)
        ld      h,(ix-3)
        ld      e,(ix-2)
        ld      d,(ix-1)
        dec     hl
        ld      a,l
        cp      0ffh
        jp      nz,FMFDEC
        ld      a,h
        cp      0ffh
        jp      nz,FMFDEC
        dec     de
FMFDEC:
        call    __flf
        ld      (ix-8),l
        ld      (ix-7),h
        ld      (ix-6),e
        ld      (ix-5),d
FMFRET:
        ld      l,(ix-8)
        ld      h,(ix-7)
        ld      e,(ix-6)
        ld      d,(ix-5)
        ld      sp,ix
        pop     ix
        ret

        public  _ceilf
_ceilf:
        push    ix
        ld      ix,0
        add     ix,sp
        ld      hl,-8
        add     hl,sp
        ld      sp,hl

        ; l = (long)x
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    __ffl
        ld      (ix-4),l
        ld      (ix-3),h
        ld      (ix-2),e
        ld      (ix-1),d

        ; y = (float)l
        ld      l,(ix-4)
        ld      h,(ix-3)
        ld      e,(ix-2)
        ld      d,(ix-1)
        call    __flf
        ld      (ix-8),l
        ld      (ix-7),h
        ld      (ix-6),e
        ld      (ix-5),d

        ; if (x > y) l++, y = (float)l.
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        push    de
        push    hl
        ld      l,(ix-8)
        ld      h,(ix-7)
        ld      e,(ix-6)
        ld      d,(ix-5)
        push    de
        push    hl
        call    __flt             ; y < x
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        ld      a,h
        or      l
        jp      z,FMCRET

        ld      l,(ix-4)
        ld      h,(ix-3)
        ld      e,(ix-2)
        ld      d,(ix-1)
        inc     hl
        ld      a,h
        or      l
        jp      nz,FMCCNV
        inc     de
FMCCNV:
        call    __flf
        ld      (ix-8),l
        ld      (ix-7),h
        ld      (ix-6),e
        ld      (ix-5),d
FMCRET:
        ld      l,(ix-8)
        ld      h,(ix-7)
        ld      e,(ix-6)
        ld      d,(ix-5)
        ld      sp,ix
        pop     ix
        ret

        public  _fmodf
_fmodf:
        push    ix
        ld      ix,0
        add     ix,sp
        ld      hl,-12
        add     hl,sp
        ld      sp,hl

        ; if (y == 0.0f) return quiet NaN (0x7fc00000).
        ; Treat both +0 and -0 as zero.
        ld      a,(ix+11)
        and     7fh
        ld      b,a
        ld      a,(ix+10)
        or      b
        ld      b,a
        ld      a,(ix+9)
        or      b
        ld      b,a
        ld      a,(ix+8)
        or      b
        jp      nz,FMDNZ
        ld      hl,0
        ld      de,7fc0h
        jp      FMDRET

FMDNZ:
        ; q = x / y
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        push    de              ; left operand x
        push    hl
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+10)
        ld      d,(ix+11)
        push    de              ; right operand y
        push    hl
        call    __fdiv
        pop     bc
        pop     bc
        pop     bc
        pop     bc

        ; iq = (long)q, truncating toward zero.
        call    __ffl

        ; tq = (float)iq
        call    __flf
        ld      (ix-4),l
        ld      (ix-3),h
        ld      (ix-2),e
        ld      (ix-1),d

        ; prod = tq * y
        ld      l,(ix-4)
        ld      h,(ix-3)
        ld      e,(ix-2)
        ld      d,(ix-1)
        push    de              ; left operand tq
        push    hl
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+10)
        ld      d,(ix+11)
        call    __fmf
        pop     bc
        pop     bc
        ld      (ix-8),l
        ld      (ix-7),h
        ld      (ix-6),e
        ld      (ix-5),d

        ; return x - prod
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        push    de              ; left operand x
        push    hl
        ld      l,(ix-8)
        ld      h,(ix-7)
        ld      e,(ix-6)
        ld      d,(ix-5)
        call    __fsf
        pop     bc
        pop     bc

FMDRET:
        ld      sp,ix
        pop     ix
        ret

        public  _sqrtf
_sqrtf:
        push    ix
        ld      ix,0
        add     ix,sp
        ld      hl,-10
        add     hl,sp
        ld      sp,hl

        ; if (x <= 0.0f) return 0.0f;
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        push    de
        push    hl
        ld      hl,0
        ld      de,0
        push    de
        push    hl
        call    __fge             ; generated convention for x <= 0.0f
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        ld      a,h
        or      l
        jp      z,FMSPOS
        ld      hl,0
        ld      de,0
        jp      FMSRET

FMSPOS:
        ; g = x
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        ld      (ix-4),l
        ld      (ix-3),h
        ld      (ix-2),e
        ld      (ix-1),d
        ld      hl,0              ; i = 0
        ld      (ix-6),l
        ld      (ix-5),h
FMSLP:
        ld      l,(ix-6)
        ld      h,(ix-5)
        push    hl
        ld      hl,8
        ex      de,hl
        pop     hl
        ld      a,h
        xor     80h
        ld      h,a
        ld      a,d
        xor     80h
        ld      d,a
        or      a
        sbc     hl,de
        jp      nc,FMSDONE

        ; g = (g + x / g) * 0.5f
        ld      l,(ix-4)
        ld      h,(ix-3)
        ld      e,(ix-2)
        ld      d,(ix-1)
        push    de
        push    hl
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        push    de
        push    hl
        ld      l,(ix-4)
        ld      h,(ix-3)
        ld      e,(ix-2)
        ld      d,(ix-1)
        push    de
        push    hl
        call    __fdiv
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        call    __faf
        pop     bc
        pop     bc
        ld      b,0ffh            ; exact * 2^-1, replacing full multiply by 0.5f
        call    __fscale_pow2
        ; If the new iterate equals the previous g bit-for-bit, Newton's
        ; method has reached a fixed point and every remaining iteration would
        ; reproduce it, so stop early.  g is a positive finite float here
        ; (never NaN), so a byte compare is a true value compare and the early
        ; exit is bit-identical to running the full iteration count.
        ld      a,l
        cp      (ix-4)
        jr      nz,FMSUPD
        ld      a,h
        cp      (ix-3)
        jr      nz,FMSUPD
        ld      a,e
        cp      (ix-2)
        jr      nz,FMSUPD
        ld      a,d
        cp      (ix-1)
        jp      z,FMSDONE       ; converged: stored g already equals new g
FMSUPD:
        ld      (ix-4),l
        ld      (ix-3),h
        ld      (ix-2),e
        ld      (ix-1),d

        inc     (ix-6)
        jp      nz,FMSLP
        inc     (ix-5)
        jp      FMSLP

FMSDONE:
        ; One final correction: the simple division/multiply helpers truncate,
        ; so Newton iteration can settle one representable value below the
        ; correctly rounded answer for perfect squares such as 9.0f.  If
        ; g*g < x, advance positive g by one IEEE single-precision bit.
        ld      l,(ix-4)
        ld      h,(ix-3)
        ld      e,(ix-2)
        ld      d,(ix-1)
        push    de
        push    hl
        call    __fmf
        pop     bc
        pop     bc
        ; Save product, then call __flt(product, x).  The C calling
        ; convention pushes arguments right-to-left, so push x first.
        ld      (ix-10),l
        ld      (ix-9),h
        ld      (ix-8),e
        ld      (ix-7),d
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        push    de
        push    hl
        ld      l,(ix-10)
        ld      h,(ix-9)
        ld      e,(ix-8)
        ld      d,(ix-7)
        push    de
        push    hl
        call    __flt             ; g*g < x ?
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        ld      a,h
        or      l
        jp      z,FMSLD
        ld      l,(ix-4)
        ld      h,(ix-3)
        ld      e,(ix-2)
        ld      d,(ix-1)
        inc     hl
        ld      a,h
        or      l
        jp      nz,FMSST
        inc     de
FMSST:
        ld      (ix-4),l
        ld      (ix-3),h
        ld      (ix-2),e
        ld      (ix-1),d
FMSLD:
        ld      l,(ix-4)
        ld      h,(ix-3)
        ld      e,(ix-2)
        ld      d,(ix-1)
FMSRET:
        ld      sp,ix
        pop     ix
        ret

; ---- IEEE single <-> 32-bit long conversion helpers ---------------------
; Float calling convention: DE:HL holds the 32-bit IEEE single value.
; Long calling convention:  DE:HL holds a 32-bit integer value.
;
; __flf   signed   long  DE:HL -> float DE:HL
; __fulf  unsigned long  DE:HL -> float DE:HL
; __ffl   float DE:HL -> signed   long DE:HL, trunc toward zero
; __fful  float DE:HL -> unsigned long DE:HL, trunc toward zero


        public  __fscale_pow2
__fscale_pow2:
        ; Scale float DE:HL by 2^B.
        ; Input:  DE:HL = IEEE single raw bits, B = signed exponent delta.
        ; Output: DE:HL = scaled float.
        ;
        ; Fast/correct for normalized finite values.  Preserves NaN/Inf and
        ; signed zero.  Overflow becomes signed infinity.  Underflow becomes
        ; signed zero, matching the compact RTL's existing subnormal policy.
        ;
        ; Important: the original D/E bytes contain sign, exponent, and the
        ; high mantissa bits.  Do not use D/E as scratch until after they have
        ; been saved; otherwise scaling 2.0f by 2 could preserve the scratch
        ; byte as a mantissa bit and produce 4.03125 instead of 4.0.

        ; exp = ((D & 7f) << 1) | (E >> 7)
        ld      a,d
        and     7fh
        add     a,a
        ld      c,a
        ld      a,e
        rlca
        and     1
        or      c              ; A = biased exponent

        ; zero/subnormal: preserve signed zero / treat subnormal as zero.
        or      a
        jp      z,FSCL_RET

        ; NaN/Inf: preserve input.
        cp      255
        jp      z,FSCL_RET

        ; Preserve original float bits before using DE/HL as integer scratch.
        push    de
        push    hl

        ; A = exponent, B = signed delta.  Compute signed 16-bit A+B in HL.
        ld      l,a
        ld      h,0
        bit     7,b
        jp      z,FSCL_POS
        ld      a,b
        ld      e,a
        ld      d,0ffh
        jp      FSCL_ADD
FSCL_POS:
        ld      e,b
        ld      d,0
FSCL_ADD:
        add     hl,de

        ; new exponent <= 0 => signed zero.
        bit     7,h
        jp      nz,FSCL_ZERO
        ld      a,h
        or      a
        jp      nz,FSCL_INF
        ld      a,l
        or      a
        jp      z,FSCL_ZERO

        ; new exponent >= 255 => signed infinity.
        cp      255
        jp      nc,FSCL_INF

        ; Install new biased exponent A into original D/E, preserving sign and
        ; mantissa.  Restore original raw bits first.
        ld      c,a            ; C = new exponent
        pop     hl
        pop     de
        srl     a              ; A = exp >> 1
        ld      b,a
        ld      a,d
        and     80h            ; sign bit
        or      b
        ld      d,a
        ld      a,c
        and     1
        rrca                   ; exp low bit -> bit 7
        ld      b,a
        ld      a,e
        and     7fh            ; preserve mantissa high 7 bits
        or      b
        ld      e,a
        ret

FSCL_ZERO:
        pop     hl
        pop     de
        ld      a,d
        and     80h
        ld      d,a
        ld      e,0
        ld      h,0
        ld      l,0
        ret

FSCL_INF:
        pop     hl
        pop     de
        ld      a,d
        and     80h
        or      7fh
        ld      d,a
        ld      e,80h
        ld      h,0
        ld      l,0
FSCL_RET:
        ret


        public  __fulf
__fulf:
        ld      a,d
        or      e
        or      h
        or      l
        jp      nz,FUL1
        ld      de,0
        ret
FUL1:
        ld      b,158          ; exponent for bit 31
FUL2:
        bit     7,d
        jp      nz,FUL3
        add     hl,hl
        rl      e
        rl      d
        dec     b
        jp      FUL2
FUL3:
        ld      a,e
        ld      (FULM),a       ; mantissa bits 23..16
        ld      a,h
        ld      (FULL),a       ; mantissa bits 15..8
        ld      c,d            ; normalized top byte, bit 7 hidden
        ld      a,b
        ld      d,a
        srl     d              ; D = exponent >> 1, sign clear
        and     1
        rrca
        and     80h
        ld      e,a
        ld      a,c
        and     7fh            ; mantissa bits 22..16
        or      e
        ld      e,a
        ld      a,(FULM)
        ld      h,a
        ld      a,(FULL)
        ld      l,a
        ret
FULM:   db      0
FULL:   db      0

        public  __flf
__flf:
        bit     7,d
        jp      z,__fulf
        ld      a,l
        cpl
        ld      l,a
        ld      a,h
        cpl
        ld      h,a
        ld      a,e
        cpl
        ld      e,a
        ld      a,d
        cpl
        ld      d,a
        inc     l
        jp      nz,FLF1
        inc     h
        jp      nz,FLF1
        inc     e
        jp      nz,FLF1
        inc     d
FLF1:
        call    __fulf
        ld      a,d
        or      80h
        ld      d,a
        ret

        public  __fful
__fful:
        ld      a,d
        and     7fh
        add     a,a
        ld      b,a
        ld      a,e
        rlca
        and     1
        or      b              ; A = biased exponent
        cp      127
        jp      nc,FFUL1
        ld      de,0
        ld      hl,0
        ret
FFUL1:
        cp      159
        jp      c,FFUL2
        ld      de,0ffffh
        ld      hl,0ffffh
        ret
FFUL2:
        ld      c,a            ; C = exponent
        ld      a,e
        and     7fh
        or      80h
        ld      e,a            ; DEHL = 00:mantissa24
        ld      d,0
        ; H and L are already mantissa low bytes from input float.
        ld      a,c
        cp      150
        jp      z,FFULD
        jp      c,FFURS
        sub     150
        ld      b,a
FFULS:
        add     hl,hl
        rl      e
        rl      d
        dec     b
        jp      nz,FFULS
        jp      FFULD
FFURS:
        ld      a,150
        sub     c
        ld      b,a
FFUR1:
        srl     d
        rr      e
        rr      h
        rr      l
        dec     b
        jp      nz,FFUR1
FFULD:
        ret

        public  __ffl
__ffl:
        ld      a,d
        and     80h
        push    af
        res     7,d
        call    __fful
        pop     af
        or      a
        ret     z
        ld      a,l
        cpl
        ld      l,a
        ld      a,h
        cpl
        ld      h,a
        ld      a,e
        cpl
        ld      e,a
        ld      a,d
        cpl
        ld      d,a
        inc     l
        ret     nz
        inc     h
        ret     nz
        inc     e
        ret     nz
        inc     d
        ret


; ---------------------------------------------------------------------------
; nextafter / nextafterf -- single-precision implementation for dcc.
;
; dcc currently has only 32-bit float arithmetic, so both nextafter and
; nextafterf use float ABI: nextafter(float x, float y) returns the adjacent
; IEEE-754 single value after x in the direction of y.
;
; Args: x at IX+4..IX+7, y at IX+8..IX+11. Return DE:HL.
; ---------------------------------------------------------------------------

        public  _nextafterf
_nextafterf:
        push    ix
        ld      ix,0
        add     ix,sp

        ; Fast path for nextafterf(x, FLT_MAX).  eps() uses exactly this form:
        ;     nextafterf(f, FLT_MAX) - f
        ; For finite/non-NaN x, moving toward +FLT_MAX is just an IEEE raw
        ; bit step: positive values increment, negative values decrement,
        ; zero returns the smallest positive subnormal.  Fall back to the
        ; general path for every other 'toward' value.
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+10)
        ld      d,(ix+11)
        ld      a,l
        cp      0ffh
        jp      nz,NXGEN
        ld      a,h
        cp      0ffh
        jp      nz,NXGEN
        ld      a,e
        cp      07fh
        jp      nz,NXGEN
        ld      a,d
        cp      07fh
        jp      nz,NXGEN

        ; x is NaN => return x
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    __fnan
        ld      a,h
        or      l
        jp      nz,NXRET_X

        ; x == FLT_MAX => return y/x unchanged
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        ld      a,l
        cp      0ffh
        jp      nz,NXFMAX_NE
        ld      a,h
        cp      0ffh
        jp      nz,NXFMAX_NE
        ld      a,e
        cp      07fh
        jp      nz,NXFMAX_NE
        ld      a,d
        cp      07fh
        jp      z,NXRET
NXFMAX_NE:

        ; x == +/-0 => smallest positive subnormal
        ld      a,d
        and     7fh
        or      e
        or      h
        or      l
        jp      nz,NXFMAX_NZ
        ld      hl,1
        ld      de,0
        jp      NXRET
NXFMAX_NZ:
        ; For negative x, move toward +FLT_MAX by decrementing raw bits.
        bit     7,d
        jp      nz,NXDEC
        jp      NXINC

NXGEN:
        ; if x is NaN, return x
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    __fnan
        ld      a,h
        or      l
        jp      nz,NXRET_X

        ; if y is NaN, return y
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+10)
        ld      d,(ix+11)
        call    __fnan
        ld      a,h
        or      l
        jp      nz,NXRET_Y

        ; if x == y, return y
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        push    de
        push    hl
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+10)
        ld      d,(ix+11)
        push    de
        push    hl
        call    __feq
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        ld      a,h
        or      l
        jp      nz,NXRET_Y

        ; if x == 0, return the smallest subnormal with y's sign
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        call    __fzro
        ld      a,h
        or      l
        jp      nz,NXZERO

        ; lt = x < y
        ; __flt follows the normal dcc call ABI: the first argument must be
        ; the last value pushed, so push y first, then x.
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+10)
        ld      d,(ix+11)
        push    de
        push    hl
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        push    de
        push    hl
        call    __flt
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        ld      a,h
        or      l
        ld      (NXLT),a

        ; Load raw x.
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)

        ; For positive x, x<y means increment raw bits; otherwise decrement.
        ; For negative x, x<y means decrement raw bits; otherwise increment.
        ld      a,d
        and     80h
        jp      nz,NXNEG
NXPOS:
        ld      a,(NXLT)
        or      a
        jp      nz,NXINC
        jp      NXDEC
NXNEG:
        ld      a,(NXLT)
        or      a
        jp      nz,NXDEC
        jp      NXINC

NXZERO:
        ld      hl,1
        ld      de,0
        ld      a,(ix+11)
        and     80h
        jp      z,NXRET
        ld      d,80h
        jp      NXRET

NXRET_X:
        ld      l,(ix+4)
        ld      h,(ix+5)
        ld      e,(ix+6)
        ld      d,(ix+7)
        jp      NXRET
NXRET_Y:
        ld      l,(ix+8)
        ld      h,(ix+9)
        ld      e,(ix+10)
        ld      d,(ix+11)
        jp      NXRET

NXINC:
        inc     l
        jp      nz,NXRET
        inc     h
        jp      nz,NXRET
        inc     e
        jp      nz,NXRET
        inc     d
        jp      NXRET

NXDEC:
        ld      a,l
        or      a
        jp      nz,NXDL
        ld      l,0ffh
        ld      a,h
        or      a
        jp      nz,NXDH
        ld      h,0ffh
        ld      a,e
        or      a
        jp      nz,NXDE
        ld      e,0ffh
        dec     d
        jp      NXRET
NXDE:
        dec     e
        jp      NXRET
NXDH:
        dec     h
        jp      NXRET
NXDL:
        dec     l

NXRET:
        ld      sp,ix
        pop     ix
        ret

NXLT:   db      0


