        public _log10f
_log10f:
        ; Leaf-style wrapper: preserve the caller-cleanup argument on the
        ; stack, duplicate it for _logf, then multiply by log10(e).
        pop bc                  ; caller return address
        pop hl                  ; x, low word
        pop de                  ; x, high word
        push de                 ; restore caller's argument
        push hl
        push bc                 ; restore caller return address

        push de                 ; _logf(x)
        push hl
        call _logf
        pop bc
        pop bc

        push de                 ; logf(x) * log10(e)
        push hl
        ld hl,23513
        ld de,16094
        call __fmf
        pop bc
        pop bc
        ret

