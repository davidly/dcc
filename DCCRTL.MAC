        pop hl                  ; signed flag (1=strtol, 0=strtoul)
        ld (__stox_signed),hl
        pop hl                  ; nptr
        ld (__stox_nptr),hl
        ld (__stox_p),hl        ; p = nptr
        pop de                  ; endptr
        ld (__stox_endptr),de
        pop hl                  ; base
        ld (__stox_base),hl

        push hl                 ; restore base
        push de                 ; restore endptr
        ld hl,(__stox_nptr)
        push hl                 ; restore nptr
        push bc                 ; restore return address
