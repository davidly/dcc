        ld l,a
        ld h,0
        ret
SCL21:
        ld a,l
        cp 'A'
        jr c,SCL29
        cp 'Z'+1
        jr nc,SCL29
        sub 'A'
        add a,10
        ld l,a
        ld h,0
        ret
SCL29:
        ld hl,99
        ret

        public __stol
__stol:
        ; long strtol(const char *nptr, char **endptr, int base)
        ; Trampoline into the shared __stox_core: inject a "signed" flag
        ; (1) as a hidden leading argument via jp, so __stox_core's own
        ; entry sees exactly [retaddr][signed][nptr][endptr][base] and
        ; the original external caller's return address is preserved.
        pop bc
        ld hl,1
        push hl
        push bc
        jp __stox_core

        public __stou
__stou:
        ; unsigned long strtoul(const char *nptr, char **endptr, int base)
        ; Same trampoline as __stol, with signed=0. Falls straight through
        ; into __stox_core below - no jp needed, this is its last instruction.
        pop bc
        ld hl,0
        push hl
        push bc

; Shared strtol/strtoul core. Not itself public - only ever reached via
; the __stol/__stou trampolines above, which inject a hidden "signed"
; flag as an extra leading argument (consumed here, never restored to
; the stack, so the real 3-argument cdecl contract with the external
; caller is unaffected). Locals live in static scratch (already
; non-reentrant, matching the atol/atof/strtod convention).
; __stox_nptr keeps the original pointer alive for the no-digits-
; consumed endptr case, while __stox_p is the working cursor that
; advances. The two places strtol/strtoul actually differ - the
; overflow-cutoff dividend and the overflow clamp value - are the only
; spots that branch on __stox_signed; everything else (whitespace/sign/
; base parsing, the digit-accumulation loop, and endptr handling) is one
; shared copy.
