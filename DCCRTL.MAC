        public _atan2f
_atan2f:
        ; Hand-written wrapper preserving the compiler-generated branch and
        ; operation order without an IX frame or four-byte local quotient.
        ; cdecl stack: return, y low, y high, x low, x high
        pop     bc
        pop     hl
        ld      (__atan2_ylo),hl
        pop     de
        ld      (__atan2_yhi),de
        pop     hl
        ld      (__atan2_xlo),hl
        pop     de
        ld      (__atan2_xhi),de
        push    de
        push    hl
        ld      de,(__atan2_yhi)
        ld      hl,(__atan2_ylo)
        push    de
        push    hl
        push    bc

        ; if (x == 0.0f)
        ld      de,(__atan2_xhi)
        ld      hl,(__atan2_xlo)
        push    de
        push    hl
        ld      hl,0
        ld      de,0
        push    de
        push    hl
        call    __feq
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        ld      a,h
        or      l
        jr      z,atan2_nonzero_x

        ; Preserve the former zero-denominator behavior exactly.
        ld      de,(__atan2_yhi)
        ld      hl,(__atan2_ylo)
        push    de
        push    hl
        ld      hl,0
        ld      de,0
        push    de
        push    hl
        call    __flt
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        ld      a,h
        or      l
        jr      z,atan2_check_positive_y
        ld      hl,4059
        ld      de,16329
        ret

atan2_check_positive_y:
        ld      de,(__atan2_yhi)
        ld      hl,(__atan2_ylo)
        push    de
        push    hl
        ld      hl,0
        ld      de,0
        push    de
        push    hl
        call    __fgt
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        ld      a,h
        or      l
        jr      z,atan2_return_zero
        ld      hl,4059
        ld      de,16329
        ld      a,d
        xor     80h
        ld      d,a
        ret

atan2_return_zero:
        ld      hl,0
        ld      de,0
        ret

atan2_nonzero_x:
        ; q = y / x
        ld      de,(__atan2_yhi)
        ld      hl,(__atan2_ylo)
        push    de
        push    hl
        ld      de,(__atan2_xhi)
        ld      hl,(__atan2_xlo)
        push    de
        push    hl
        call    __fdiv
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        ld      (__atan2_qlo),hl
        ld      (__atan2_qhi),de

        ; if (x < 0.0f) return atanf(q)
        ld      de,(__atan2_xhi)
        ld      hl,(__atan2_xlo)
        push    de
        push    hl
        ld      hl,0
        ld      de,0
        push    de
        push    hl
        call    __flt
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        ld      a,h
        or      l
        jr      z,atan2_x_not_negative
        ld      de,(__atan2_qhi)
        ld      hl,(__atan2_qlo)
        push    de
        push    hl
        call    _atanf
        pop     bc
        pop     bc
        ret

atan2_x_not_negative:
        ; Evaluate atanf(q) once, then apply the same +/- pi correction.
        ld      de,(__atan2_yhi)
        ld      hl,(__atan2_ylo)
        push    de
        push    hl
        ld      hl,0
        ld      de,0
        push    de
        push    hl
        call    __fle
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        ld      a,h
        or      l
        ld      (__atan2_yle),a

        ld      de,(__atan2_qhi)
        ld      hl,(__atan2_qlo)
        push    de
        push    hl
        call    _atanf
        pop     bc
        pop     bc
        push    de
        push    hl
        ld      hl,4059
        ld      de,16457
        ld      a,(__atan2_yle)
        or      a
        jr      z,atan2_sub_pi
        call    __faf
        jr      atan2_adjust_done
atan2_sub_pi:
        call    __fsf
atan2_adjust_done:
        pop     bc
        pop     bc
        ret

__atan2_ylo:   dw      0
__atan2_yhi:   dw      0
__atan2_xlo:   dw      0
__atan2_xhi:   dw      0
__atan2_qlo:   dw      0
__atan2_qhi:   dw      0
__atan2_yle:   db      0

