        public _acosf
_acosf:
        ; acosf(x) = pi/2 - asinf(x).  Preserve the original cdecl
        ; argument while avoiding an IX frame solely for argument access.
        pop bc                  ; caller return address
        pop hl                  ; x, low word
        pop de                  ; x, high word
        push de                 ; restore caller's argument
        push hl
        push bc                 ; restore caller return address

        ld bc,16329             ; pi/2, high word
        push bc
        ld bc,4059              ; pi/2, low word
        push bc
        push de                 ; asinf(x)
        push hl
        call _asinf
        pop bc
        pop bc
        call __fsf
        pop bc
        pop bc
        ret

        public _frexpf
_frexpf:
        ; Hand-written IEEE-style single-precision decomposition.  The
        ; original compiler output built 32-bit masks and shifted the value
        ; 23 times merely to obtain and replace the exponent field.
        ;
        ; cdecl stack: return, x low, x high, exponent pointer
        pop     bc
        pop     hl
        ld      (__frexp_xlo),hl
        pop     de
        ld      (__frexp_xhi),de
        pop     hl
        ld      (__frexp_eptr),hl
        push    hl
        push    de
        ld      hl,(__frexp_xlo)
        push    hl
        push    bc

        ; Treat either signed zero as zero, matching the former __feq call.
        ld      hl,(__frexp_xlo)
        ld      de,(__frexp_xhi)
        ld      a,d
        and     7fh
        or      e
        or      h
        or      l
        jr      nz,frexp_nonzero

        ld      hl,(__frexp_eptr)
        xor     a
        ld      (hl),a
        inc     hl
        ld      (hl),a
        ld      hl,0
        ld      de,0
        ret

frexp_nonzero:
        ; Biased exponent = ((D & 7fh) << 1) | (E >> 7).
        ld      a,d
        and     7fh
        add     a,a
        ld      c,a
        ld      a,e
        rlca
        and     1
        or      c
        sub     126
        ld      c,a
        sbc     a,a
        ld      b,a
        ld      hl,(__frexp_eptr)
        ld      (hl),c
        inc     hl
        ld      (hl),b

        ; Preserve sign and fraction, but force biased exponent 126.
        ld      hl,(__frexp_xlo)
        ld      de,(__frexp_xhi)
        ld      a,e
        and     7fh
        ld      e,a
        ld      a,d
        and     80h
        or      3fh
        ld      d,a
        ret

__frexp_xlo:   dw      0
__frexp_xhi:   dw      0
__frexp_eptr:  dw      0

        public _ldexpf
_ldexpf:
        ; Hand-written exponent adjustment.  This preserves the former
        ; overflow/underflow policy while replacing the generated 23-bit
        ; shift loops and 32-bit mask/or sequences with byte operations.
        ;
        ; cdecl stack: return, x low, x high, exponent adjustment
        pop     bc
        pop     hl
        ld      (__ldexp_xlo),hl
        pop     de
        ld      (__ldexp_xhi),de
        pop     hl
        ld      (__ldexp_n),hl
        push    hl
        push    de
        ld      hl,(__ldexp_xlo)
        push    hl
        push    bc

        ; Treat either signed zero as zero.
        ld      hl,(__ldexp_xlo)
        ld      de,(__ldexp_xhi)
        ld      a,d
        and     7fh
        or      e
        or      h
        or      l
        jr      nz,ldexp_nonzero
        ld      hl,0
        ld      de,0
        ret

ldexp_nonzero:
        ; Extract the old biased exponent and add the signed adjustment.
        ld      a,d
        and     7fh
        add     a,a
        ld      l,a
        ld      a,e
        rlca
        and     1
        or      l
        ld      l,a
        ld      h,0
        ld      de,(__ldexp_n)
        add     hl,de
        ld      (__ldexp_newexp),hl

        ; Signed comparison: new exponent >= 255.
        ld      de,33023                ; 8000h-biased representation of 255
        ld      a,h
        xor     80h
        ld      h,a
        or      a
        sbc     hl,de
        jr      c,ldexp_not_overflow

        ; Preserve the former saturation constant and the input sign.
        ld      hl,51614
        ld      de,32639
        ld      a,(__ldexp_xhi+1)
        and     80h
        jr      z,ldexp_done
        ld      a,d
        xor     80h
        ld      d,a
ldexp_done:
        ret

ldexp_not_overflow:
        ld      hl,(__ldexp_newexp)
        ld      a,h
        or      l
        jr      z,ldexp_underflow
        bit     7,h
        jr      nz,ldexp_underflow

        ; Install exponent bits directly into D:E.
        ld      b,h
        ld      c,l                     ; BC = new biased exponent
        ld      hl,(__ldexp_xlo)
        ld      de,(__ldexp_xhi)
        ld      a,c
        and     1
        rrca
        ld      b,a                     ; bit 7 for E
        ld      a,e
        and     7fh
        or      b
        ld      e,a
        ld      a,c
        srl     a
        and     7fh
        ld      b,a
        ld      a,d
        and     80h
        or      b
        ld      d,a
        ret

ldexp_underflow:
        ld      hl,0
        ld      de,0
        ret

__ldexp_xlo:    dw      0
__ldexp_xhi:    dw      0
__ldexp_n:      dw      0
__ldexp_newexp: dw      0

        public _modff
        public sc_isspace
        public sc_isdigit
_modff:
        ; Compiler-generated version used an IX frame and a four-byte local
        ; solely to preserve the integral part across calls.  Save the three
        ; arguments in private scratch storage and restore the caller-cleaned
        ; stack exactly before doing any work.
        pop     bc                      ; return address
        pop     hl                      ; x low word
        ld      (__modff_xlo),hl
        pop     de                      ; x high word
        ld      (__modff_xhi),de
        pop     hl                      ; iptr
        ld      (__modff_iptr),hl
        push    hl                      ; restore iptr
        push    de                      ; restore x high
        ld      hl,(__modff_xlo)
        push    hl                      ; restore x low
        push    bc                      ; restore return address

        ; Preserve the original test and operation order:
        ;     i = (x <= 0.0f) ? floorf(x) : ceilf(x);
        ld      de,(__modff_xhi)
        ld      hl,(__modff_xlo)
        push    de
        push    hl
        ld      hl,0
        ld      de,0
        push    de
        push    hl
        call    __fle
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        ld      a,h
        or      l
        jr      z,modff_use_ceil

        ld      de,(__modff_xhi)
        ld      hl,(__modff_xlo)
        push    de
        push    hl
        call    _floorf
        pop     bc
        pop     bc
        jr      modff_have_int

modff_use_ceil:
        ld      de,(__modff_xhi)
        ld      hl,(__modff_xlo)
        push    de
        push    hl
        call    _ceilf
        pop     bc
        pop     bc

modff_have_int:
        ld      (__modff_ilo),hl
        ld      (__modff_ihi),de

        ; *iptr = integral part
        ld      bc,(__modff_iptr)
        ld      a,l
        ld      (bc),a
        inc     bc
        ld      a,h
        ld      (bc),a
        inc     bc
        ld      a,e
        ld      (bc),a
        inc     bc
        ld      a,d
        ld      (bc),a

        ; Return x - integral part in DE:HL.
        ld      de,(__modff_xhi)
        ld      hl,(__modff_xlo)
        push    de
        push    hl
        ld      de,(__modff_ihi)
        ld      hl,(__modff_ilo)
        call    __fsf
        pop     bc
        pop     bc
        ret

__modff_xlo:    dw      0
__modff_xhi:    dw      0
__modff_iptr:   dw      0
__modff_ilo:    dw      0
__modff_ihi:    dw      0

