        public _sinhf
_sinhf:
        ; sinhf(x) = (expf(x) - expf(-x)) / 2.
        ; Preserve the caller-cleaned argument layout without an IX frame.
        pop     bc
        pop     hl
        pop     de
        push    de
        push    hl
        push    bc
        ld      (__hyp_xlo),hl
        ld      (__hyp_xhi),de

        push    de
        push    hl
        call    _expf
        pop     bc
        pop     bc
        ld      (__hyp_alo),hl
        ld      (__hyp_ahi),de

        ld      hl,(__hyp_xlo)
        ld      de,(__hyp_xhi)
        ld      a,d
        xor     80h
        ld      d,a
        push    de
        push    hl
        call    _expf
        pop     bc
        pop     bc

        ; Preserve the generated operand push order: exp(x), exp(-x).
        ld      (__hyp_blo),hl
        ld      (__hyp_bhi),de
        ld      hl,(__hyp_alo)
        ld      de,(__hyp_ahi)
        push    de
        push    hl
        ld      hl,(__hyp_blo)
        ld      de,(__hyp_bhi)
        call    __fsf
        pop     bc
        pop     bc
        ld      b,-1
        jp      __fscale_pow2

        public _coshf
_coshf:
        ; coshf(x) = (expf(x) + expf(-x)) / 2.
        pop     bc
        pop     hl
        pop     de
        push    de
        push    hl
        push    bc
        ld      (__hyp_xlo),hl
        ld      (__hyp_xhi),de

        push    de
        push    hl
        call    _expf
        pop     bc
        pop     bc
        ld      (__hyp_alo),hl
        ld      (__hyp_ahi),de

        ld      hl,(__hyp_xlo)
        ld      de,(__hyp_xhi)
        ld      a,d
        xor     80h
        ld      d,a
        push    de
        push    hl
        call    _expf
        pop     bc
        pop     bc

        ; Preserve the generated operand push order: exp(x), exp(-x).
        ld      (__hyp_blo),hl
        ld      (__hyp_bhi),de
        ld      hl,(__hyp_alo)
        ld      de,(__hyp_ahi)
        push    de
        push    hl
        ld      hl,(__hyp_blo)
        ld      de,(__hyp_bhi)
        call    __faf
        pop     bc
        pop     bc
        ld      b,-1
        jp      __fscale_pow2

        public _tanhf
_tanhf:
        ; Preserve x while retaining the public caller-cleanup convention.
        pop     bc
        pop     hl
        pop     de
        push    de
        push    hl
        push    bc
        ld      (__hyp_xlo),hl
        ld      (__hyp_xhi),de

        ; Keep the compiler-generated saturation thresholds exactly:
        ; x < 10.0f => continue, otherwise return +1.0f.
        push    de
        push    hl
        ld      hl,0
        ld      de,16752
        push    de
        push    hl
        call    __flt
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        ld      a,h
        or      l
        jr      z,tanh_check_negative
        ld      hl,0
        ld      de,16256
        ret

tanh_check_negative:
        ; x > -10.0f => continue, otherwise return -1.0f.
        ld      hl,(__hyp_xlo)
        ld      de,(__hyp_xhi)
        push    de
        push    hl
        ld      hl,0
        ld      de,16752
        ld      a,d
        xor     80h
        ld      d,a
        push    de
        push    hl
        call    __fgt
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        ld      a,h
        or      l
        jr      z,tanh_calculate
        ld      hl,0
        ld      de,16256
        ld      a,d
        xor     80h
        ld      d,a
        ret

tanh_calculate:
        ; y = expf(2*x)
        ld      hl,(__hyp_xlo)
        ld      de,(__hyp_xhi)
        ld      b,1
        call    __fscale_pow2
        push    de
        push    hl
        call    _expf
        pop     bc
        pop     bc
        ld      (__hyp_alo),hl
        ld      (__hyp_ahi),de

        ; numerator = y - 1.0f
        push    de
        push    hl
        ld      hl,0
        ld      de,16256
        call    __fsf
        pop     bc
        pop     bc
        ld      (__hyp_blo),hl
        ld      (__hyp_bhi),de

        ; denominator = y + 1.0f
        ld      hl,(__hyp_alo)
        ld      de,(__hyp_ahi)
        push    de
        push    hl
        ld      hl,0
        ld      de,16256
        call    __faf
        pop     bc
        pop     bc

        ; numerator / denominator. Preserve generated push order.
        ld      (__hyp_xlo),hl
        ld      (__hyp_xhi),de
        ld      hl,(__hyp_blo)
        ld      de,(__hyp_bhi)
        push    de
        push    hl
        ld      hl,(__hyp_xlo)
        ld      de,(__hyp_xhi)
        push    de
        push    hl
        call    __fdiv
        pop     bc
        pop     bc
        pop     bc
        pop     bc
        ret

