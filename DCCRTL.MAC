; static function sc_isspace
; Leaf helper: preserve the caller-cleaned argument while avoiding an IX frame.
sc_isspace:
        pop de                  ; return address
        pop hl                  ; int argument
        push hl                 ; restore argument for caller cleanup
        push de                 ; restore return address
        ld a,h
        or a
        jr nz,SCL8
        ld a,l
        cp 32
        jr z,SCL4
        cp 9
        jr c,SCL8
        cp 14
        jr nc,SCL8
SCL4:
        ld hl,1
        ret
SCL8:
        ld hl,0
        ret

; static function sc_digit (renamed sc_isdigit: collides with the unrelated
; sc_digit byte variable in _fscanf's parse state, earlier in this file)
; Leaf helper: preserve the caller-cleaned argument while avoiding an IX frame.
sc_isdigit:
        pop de                  ; return address
        pop hl                  ; int argument
        push hl                 ; restore argument for caller cleanup
        push de                 ; restore return address
        ld a,h
        or a
        jr nz,SCL29
        ld a,l
        cp '0'
        jr c,SCL13
        cp '9'+1
        jr nc,SCL13
        sub '0'
        ld l,a
        ld h,0
        ret
