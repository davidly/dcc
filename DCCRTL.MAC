        public __stok
; char *strtok(char *s, const char *delim)
; Hand-written version.  strtok is inherently non-reentrant because it keeps
; SCZ0007 as its saved position, so private scratch words do not weaken its
; semantics.  The caller still removes both arguments.
__stok:
        pop     bc                      ; return address
        pop     hl                      ; s
        ld      (__stok_s),hl
        pop     de                      ; delim
        ld      (__stok_delim),de
        push    de                      ; restore caller-cleanup stack
        push    hl
        push    bc

        ld      a,h
        or      l
        jr      nz,stok_have_s
        ld      hl,(SCZ0007)
        ld      (__stok_s),hl
stok_have_s:
        ld      a,h
        or      l
        ret     z                       ; no saved string: return NULL

