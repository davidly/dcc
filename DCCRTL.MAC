        public _atanf
_atanf:
        ; float atanf(float x)
        ; IX-free; x is a mutable range-reduction working value throughout
        ; this function (not just a fetched argument), so it is kept as a
        ; static (already non-reentrant) rather than only read once.
        pop bc                  ; return address
        pop hl                  ; x low word
        pop de                  ; x high word
        push de                 ; restore x high word
        push hl                 ; restore x low word
        push bc                 ; restore return address
        ld (__atanf_x),hl
        ld (__atanf_x+2),de

        ld hl,0
        ld de,16256
        ld (__atanf_sign),hl
        ld (__atanf_sign+2),de
        ld hl,0
        ld de,0
        ld (__atanf_offset),hl
        ld (__atanf_offset+2),de
        ld hl,(__atanf_x)
        ld de,(__atanf_x+2)
        push de
        push hl
        ld hl,0
        ld de,0
        push de
        push hl
        call __fgt
        pop bc
        pop bc
        pop bc
        pop bc
        ld a,h
        or l
        jr z,MFL71 ; peep: jp_to_jr
        ld hl,0
        ld de,16256
        ld a,d
        xor 80h
        ld d,a
        ld (__atanf_sign),hl
        ld (__atanf_sign+2),de
        ld hl,(__atanf_x)
        ld de,(__atanf_x+2)
        ld a,d
        xor 80h
        ld d,a
        ld (__atanf_x),hl
        ld (__atanf_x+2),de
