# DATA.TXT is read by test programs and must have LF line endings to avoid
# spurious output differences when CP/M text-mode I/O is involved. Lock it to LF
# on all platforms so a Windows checkout with core.autocrlf=true does not rewrite
# it to CRLF.
DATA.TXT -text eol=lf

# Preserve the shared COBOL benchmark and the legacy parity regression exactly.
TTT.COB -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
TTTPAR.COB -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
