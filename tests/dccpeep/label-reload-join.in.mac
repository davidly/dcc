_unsafe_join:
	ld a,b
	cp 224
	jp nz,Lunsafe
	ld a,c
	cpl
	ld c,a
	ld b,96
Lunsafe:
	ld a,b
	cp 96
	ret

_safe_target:
	ld a,e
	cp 3
	jp nz,Lsafe
	ld hl,6
	jp Ldone
Lsafe:
	ld a,e
	cp 4
Ldone:
	ret

_cross_function_target:
	ld a,d
	cp 1
	jp nz,Lcross
	ld hl,2
	jp Lcrossdone
Lcross:
	ld a,d
	cp 2
Lcrossdone:
	ret

_cross_function_entry:
	jp Lcross

_expression_target:
	ld a,h
	cp 1
	jp nz,Lexpr
	ld hl,2
	jp Lexprdone
Lexpr:
	ld a,h
	cp 2
Lexprdone:
	ret

_expression_entry:
	jp Lexpr+0

_safe_second:
	ld a,l
	cp 5
	jp nz,Lsafe2
	ld de,4
	jp Ldone2
Lsafe2:
	ld a,l
	cp 6
Ldone2:
	ret

_conditional_return:
	ld a,e
	cp 1
	jp nz,Lcret
	ld a,d
	ret z
Lcret:
	ld a,e
	cp 2
	ret

_user_asm_target:
	ld a,b
	cp 1
	jp nz,Luser
	ld hl,2
	jp Luserdone
Luser:
	ld a,b
	cp 2
Luserdone:
	ret

_user_asm_reference:
; dcc user asm begin
	jp Luser
; dcc user asm end
	ret

_case_target:
	ld a,c
	cp 1
	jp nz,Lcase
	ld hl,2
	jp Lcasedone
Lcase:
	ld a,c
	cp 2
Lcasedone:
	ret

_case_reference:
	jp lcase
