; dcc stage-1d output
	public _walk
_walk:
	push ix
	ld ix,0
	add ix,sp
	ld a,(ix+6)
	cp 4
	jr c,L1 ; peep: jp_to_jr
	ld a,(ix+4)
	or a
	jr z,L2 ; peep: jp_to_jr
	ld hl,1
	jr L3 ; peep: jp_to_jr
L2:
	bit 3,(ix+6) ; peep: cp8_to_bit3
	jr z,L1 ; peep: jp_to_jr
	ld hl,5
	jr L3 ; peep: jp_to_jr
L1:
	ld a,(ix+6)
	inc a
	ld c,a
	push bc
	ld h,0
	ld l,(ix+4)
	push hl
	call _walk
	pop bc
	pop bc
L3:
	ld sp,ix
	pop ix
	ret
	public _root
_root:
	ld c,0
	ld b,0
	push bc
	ld h,0
	ld l,0
	push hl
	call _walk
	pop bc
	pop bc
	ret
	end
