	public _check
_check:
	ld hl,6 ; peep: param_frame
	add hl,sp
	ld c,(hl)
	inc hl
	ld b,(hl)
	ld hl,4
	add hl,bc
	ld b,h
	ld c,l
	ld e,4
	ld hl,2 ; peep: param_frame
	add hl,sp
	ld a,(hl) ; peep: affine_byte_compare_loop
	add a,e ; peep: affine_byte_compare_loop
	ld h,a ; peep: affine_byte_compare_loop
	add a,124 ; peep: affine_byte_compare_loop
	ld d,a ; peep: affine_byte_compare_loop
	ld e,h ; peep: affine_byte_compare_loop
Lloop:
	ld a,(bc) ; peep: affine_byte_compare_loop
	cp e
	inc bc
	jp z, Lcontinue
	ld hl,0
	ret
Lcontinue:
	inc e
	ld a,e
	cp d ; peep: affine_byte_compare_loop
	jp nz, Lloop
	ld hl,1
	ret
