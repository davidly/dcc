; A local stays cached in BC (loop hoist or word cache) only if no store through a pointer can reach it once its frame address is taken.
	cseg

_through_pointer:
	push ix
	ld ix,0
	add ix,sp
	dec sp ; peep: local_alloc_wide
	dec sp ; peep: local_alloc_wide
	dec sp ; peep: local_alloc_wide
	dec sp ; peep: local_alloc_wide
	ld l,(ix+4)
	ld h,(ix+5)
	ld (ix-2),l
	ld (ix-1),h
	push de
	push ix
	pop hl
	ld de,-2
	add hl,de
	pop de
	ld c,l ; peep: word_loop_var_bc
	ld b,h ; peep: word_loop_var_bc
	ld l,(ix-2)
	ld h,(ix-1)
	inc hl
	ld (_g1),hl
	ld l,c ; peep: word_loop_var_bc
	ld h,b ; peep: word_loop_var_bc
	ld de,7
	ld (hl),7
	ld l,(ix-2)
	ld h,(ix-1)
	inc hl
	inc hl
	ld (_g2),hl
	ld l,(ix-2)
	ld h,(ix-1)
	inc hl
	inc hl
	inc hl
	ld (_g3),hl
	ld l,(ix-2)
	ld h,(ix-1)
	ld sp,ix
	pop ix
	ret

_identity:
	ld hl,2
	add hl,sp
	ld a,(hl)
	inc hl
	ld h,(hl)
	ld l,a
	ret

_shift_low_byte:
	push ix
	ld ix,0
	add ix,sp
	dec sp ; peep: local_alloc_wide
	dec sp ; peep: local_alloc_wide
	dec sp ; peep: local_alloc_wide
	dec sp ; peep: local_alloc_wide
	ld l,(ix+4)
	ld h,(ix+5)
	ld (ix-2),l
	ld (ix-1),h
	ld hl,3
	ld c,l ; peep: word_loop_var_bc
	ld b,h ; peep: word_loop_var_bc
L12:
	ld l,(ix-2)
	ld h,(ix-1)
	ld de,3 ; peep: push_lde_pop
	sra h
	rr l
	sra h
	rr l
	sra h
	rr l
	push hl
	push ix
	pop hl
	dec hl
	dec hl
	pop de
	ld (hl),e
	ld l,c ; peep: word_loop_var_bc
	ld h,b ; peep: word_loop_var_bc
	ld de,1 ; peep: push_lde_pop
	or a
	sbc hl,de
	ld c,l ; peep: word_loop_var_bc
	ld b,h ; peep: word_loop_var_bc
	ld a,h
	or l
	jp z,L13
	bit 7,h
	jr z,L12 ; peep: jp_to_jr
L13:
	ld l,(ix-2)
	ld h,(ix-1)
	ld sp,ix
	pop ix
	ret

	dseg
	_g1: ds 2
	_g2: ds 2
	_g3: ds 2
	end
