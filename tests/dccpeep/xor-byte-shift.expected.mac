_xor_left8:
	ld a,h ; peep: fold_xor_byte_shift
	xor l
	ld h,a
	ld a,l
	or a
	push af
	pop bc
	ld de,0
	ret

_xor_right9:
	ld a,h ; peep: fold_xor_byte_shift
	srl a
	xor l
	ld l,a
	push af
	pop bc
	ld de,0
	ret

_xor_right15:
	ld a,h ; peep: fold_xor_byte_shift
	srl a
	srl a
	srl a
	srl a
	srl a
	srl a
	srl a
	xor l
	ld l,a
	ld de,0
	ret

_xor_d_live:
	ld d,l ; peep: fold_xor_byte_shift
	ld a,h
	xor d
	ld h,a
	ld a,l
	or a
	ld (hl),d
	ld de,0
	ret

_xor_e_live:
	ld e,h ; peep: fold_xor_byte_shift
	ld d,0
	srl e
	ld a,l
	xor e
	ld l,a
	ld (hl),e
	ld de,0
	ret

_xor_live_successor:
	ld e,h ; peep: fold_xor_byte_shift
	ld a,l
	xor e
	ld l,a
	jp nz,L900
	ld de,0
	ret
L900:
	ld (hl),e
	ld de,0
	ret

_xor_signed_shift:
	push hl
	ld l,h
	ld h,0
	sra l
	ex de,hl
	pop hl
	ld a,h
	xor d
	ld h,a
	ld a,l
	xor e
	ld l,a
	ld de,0
	ret

_xor_wrong_operation:
	push hl
	ld h,l
	ld l,0
	ex de,hl
	pop hl
	ld a,h
	or d
	ld h,a
	ld a,l
	xor e
	ld l,a
	ld de,0
	ret

_xor_label_barrier:
	push hl
	ld h,l
	ld l,0
	ex de,hl
	pop hl
L901:
	ld a,h
	xor d
	ld h,a
	ld a,l
	xor e
	ld l,a
	ld de,0
	ret

_xor_other_entry:
	jp L901

_xor_call_barrier:
	push hl
	ld l,h
	ld h,0
	call _unknown
	ex de,hl
	pop hl
	ld a,h
	xor d
	ld h,a
	ld a,l
	xor e
	ld l,a
	ld de,0
	ret
