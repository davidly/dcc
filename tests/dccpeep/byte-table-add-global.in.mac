_byte_table_add_global:
	ld l,(hl)
	ld h,0
	ld de,(_pc)
	add hl,de
	ld (_pc),hl
	ld de,0
	ret

_byte_table_add_global_loop:
Lloop:
	call _a1opfetch
	ld l,(hl)
	ld h,0
	ld de,(_pc)
	add hl,de
	ld (_pc),hl
	jp Lloop

_byte_table_add_global_de_live:
	ld l,(hl)
	ld h,0
	ld de,(_pc)
	add hl,de
	ld (_pc),hl
	ld a,e
	ret
