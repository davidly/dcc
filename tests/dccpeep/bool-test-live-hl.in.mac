; A boolean's zero test folds into the branches that made it only when nothing after the test reads HL; bit 7,h still does.
cseg

_const_live:
ld hl,1
ld a,h
or l
jp z,L1
bit 7,h
jp nz,L1
ld hl,1
ret
L1:
ld hl,0
ret

_const_dead:
ld hl,1
ld a,h
or l
jp z,L2
ld hl,7
ret
L2:
ld hl,0
ret

_suffix_live:
jp c, L5
ld hl,0
jp L6
L5:
ld hl,1
L6:
ld a,h
or l
jp z,L7
bit 7,h
jp z,L8
L7:
ld hl,1
ret
L8:
ld hl,0
ret

end
