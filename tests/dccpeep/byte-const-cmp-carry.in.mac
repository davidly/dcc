; N - byte compares: z/nz keep "cp N"; c (N < byte) becomes "cp N+1 / jp nc" and nc (byte <= N) "cp N+1 / jp c"; N = 255 keeps the 16-bit form.
	cseg
	public _lt
_lt:
	push ix
	ld ix,0
	add ix,sp
	ld hl,127
	push hl
	ld l,(ix+4)
	ld h,0
	ex de,hl
	pop hl
	or a
	sbc hl,de
	jp c, L1
	ld hl,0
	pop ix
	ret
L1:
	ld hl,1
	pop ix
	ret
	public _ge
_ge:
	push ix
	ld ix,0
	add ix,sp
	ld hl,10
	push hl
	ld l,(ix+4)
	ld h,0
	ex de,hl
	pop hl
	or a
	sbc hl,de
	jp nc, L2
	ld hl,0
	pop ix
	ret
L2:
	ld hl,1
	pop ix
	ret
	public _eq
_eq:
	push ix
	ld ix,0
	add ix,sp
	ld hl,7
	push hl
	ld l,(ix+4)
	ld h,0
	ex de,hl
	pop hl
	or a
	sbc hl,de
	jp z, L3
	ld hl,0
	pop ix
	ret
L3:
	ld hl,1
	pop ix
	ret
	public _top
_top:
	push ix
	ld ix,0
	add ix,sp
	ld hl,255
	push hl
	ld l,(ix+4)
	ld h,0
	ex de,hl
	pop hl
	or a
	sbc hl,de
	jp c, L4
	ld hl,0
	pop ix
	ret
L4:
	ld hl,1
	pop ix
	ret
	end
