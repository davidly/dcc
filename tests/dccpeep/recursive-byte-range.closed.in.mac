; dcc stage-1d output
public _walk
_walk:
push ix
ld ix,0
add ix,sp
ld a,(ix+6)
cp 4
jp c, L1
ld a,(ix+4)
or a
jp z, L2
ld hl,1
jp L3
L2:
ld a,(ix+6)
cp 8
jp nz, L1
ld hl,5
jp L3
L1:
ld a,(ix+6)
inc a
ld c,a
push bc
ld h,0
ld l,(ix+4)
push hl
call _walk
pop bc
pop bc
L3:
ld sp,ix
pop ix
ret
public _root
_root:
ld c,0
ld b,0
push bc
ld h,0
ld l,0
push hl
call _walk
pop bc
pop bc
ret
end
