; dcc stage-1d output
_unsigned_live:
ld l,(hl)
ld h,0
ld a,h
or l
ld (_result),hl
ret
_unsigned_dead:
ld l,(hl)
ld h,0
ld a,h
or l
ld hl,7
ret
_signed_live:
ld l,(hl)
ld a,l
rlca
sbc a,a
ld h,a
ld a,h
or l
jp nz,_signed_sink
ld (_result),hl
_signed_sink:
ret
_signed_live_a:
ld l,(hl)
ld a,l
rlca
sbc a,a
ld h,a
ld a,h
or l
jp z,_a_zero
ld (_byte),a
_a_zero:
ld hl,7
ret
_signed_dead:
ld l,(hl)
ld a,l
rlca
sbc a,a
ld h,a
ld a,h
or l
jp nz,L9001
L9001:
ld hl,7
xor a
ret
_signed_parity:
ld l,(hl)
ld a,l
rlca
sbc a,a
ld h,a
ld a,h
or l
jp z,L9010
L9010:
ld hl,7
inc hl
jp pe,L9011
ld hl,9
L9011:
xor a
ret
_signed_unknown_call:
ld l,(hl)
ld a,l
rlca
sbc a,a
ld h,a
ld a,h
or l
jp z,L9020
L9020:
ld hl,7
call _opaque
xor a
ret
end
