	extrn _yes
	extrn _no
	extrn _tok
; Another jump reaches Lend with an unknown HL, so the suffix must not be folded.
	cseg
	public _f
_f:
	ld hl,(_tok)
	ld de,300
	or a
	sbc hl,de
	jr nz,L506 ; peep: jp_to_jr
	ld hl,(_tok)
	jr L510 ; peep: jp_to_jr
L506:
	ld hl,(_tok)
	ld de,91
	or a
	sbc hl,de
	jr nz,L508 ; peep: jp_to_jr
	ld hl,1
	jr L510 ; peep: jp_to_jr
L508:
	ld hl,0
L510:
	ld a,h
	or l
	jr nz,L504 ; peep: jp_to_jr
	jp _no ; peep: call_to_tail_jp
L504:
	jp _yes ; peep: call_to_tail_jp
