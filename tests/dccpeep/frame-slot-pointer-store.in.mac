; A local stays cached in BC (loop hoist or word cache) only if no store through a pointer can reach it once its frame address is taken.
cseg

_through_pointer:
push ix
ld ix,0
add ix,sp
ld hl,-4
add hl,sp
ld sp,hl
ld l,(ix+4)
ld h,(ix+5)
ld (ix-2),l
ld (ix-1),h
push de
push ix
pop hl
ld de,-2
add hl,de
pop de
ld (ix-4),l
ld (ix-3),h
ld l,(ix-2)
ld h,(ix-1)
inc hl
ld (_g1),hl
ld l,(ix-4)
ld h,(ix-3)
ld de,7
ld (hl),7
ld l,(ix-2)
ld h,(ix-1)
inc hl
inc hl
ld (_g2),hl
ld l,(ix-2)
ld h,(ix-1)
inc hl
inc hl
inc hl
ld (_g3),hl
ld l,(ix-2)
ld h,(ix-1)
ld sp,ix
pop ix
ret

_identity:
ld hl,2
add hl,sp
ld a,(hl)
inc hl
ld h,(hl)
ld l,a
ret

_shift_low_byte:
push ix
ld ix,0
add ix,sp
ld hl,-4
add hl,sp
ld sp,hl
ld l,(ix+4)
ld h,(ix+5)
ld (ix-2),l
ld (ix-1),h
ld hl,3
ld (ix-4),l
ld (ix-3),h
L12:
ld l,(ix-2)
ld h,(ix-1)
push hl
ld hl,3
ex de,hl
pop hl
sra h
rr l
sra h
rr l
sra h
rr l
push hl
push ix
pop hl
dec hl
dec hl
pop de
ld (hl),e
ld l,(ix-4)
ld h,(ix-3)
push hl
ld hl,1
ex de,hl
pop hl
or a
sbc hl,de
ld (ix-4),l
ld (ix-3),h
ld l,(ix-4)
ld h,(ix-3)
ld a,h
or l
jp z,L13
bit 7,h
jp nz,L13
jp L12
L13:
ld l,(ix-2)
ld h,(ix-1)
ld sp,ix
pop ix
ret

dseg
_g1: ds 2
_g2: ds 2
_g3: ds 2
end
