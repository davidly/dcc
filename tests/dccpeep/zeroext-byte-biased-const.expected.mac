; dcc stage-1d output
_decimal:
	ld a,(ix-1) ; peep: zeroext_byte_cmp_biased_const
	cp 2
	jp nc,_sink
_hex:
	ld a,(ix+4) ; peep: zeroext_byte_cmp_biased_const
	or a
	jp z,_sink
_constant_out_of_range:
	ld l,(ix-2)
	ld h,0
	ld de,33024
	ld a,h
	xor 128
	ld h,a
	sbc hl,de
	jp c,_sink
_not_zero_extended:
	ld l,(ix-3)
	ld h,1
	ld de,32769
	ld a,h
	xor 128
	ld h,a
	sbc hl,de
	jp nz,_sink
	ret
	end
