_narrow_store:
	ld h,0
	ld a,l
	rlca
	sbc a,a
	ld h,a
	push hl
	pop de
	pop hl
	ld (hl),e
	xor a
	ld de,0
	ret

_narrow_store_exchange:
	ld a,l
	rlca
	sbc a,a
	ld h,a
	ex de,hl
	push iy
	pop hl
	ld (hl),e
	xor a
	ld d,0
	ret

_narrow_store_de_live:
	ld a,l
	rlca
	sbc a,a
	ld h,a
	push hl
	pop de
	pop hl
	ld (hl),e
	ld a,d
	ret
