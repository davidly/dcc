	cseg
	public _probe
_probe:
	call _source
	ld (ix-8),l
	ld (ix-7),h
	ld (ix-6),e
	ld (ix-5),d
	jr Lskrl_5 ; peep: skip_ix_reload_across_label
Ljoin:
	ld l,(ix-8)
	ld h,(ix-7)
	ld e,(ix-6)
	ld d,(ix-5)
Lskrl_5:
	jp _sink ; peep: call_to_tail_jp
_entry:
	jp Ljoin
_existing:
	ld a,(ix-1)
	or a
	jp z,Lskrl_4
	call _source
Lskrl_4:
	ld a,1
	out (7),a
	ret
	extrn _source,_sink
	end
