; static function decline
_ZD:
	push ix
	ld ix,0
	add ix,sp
	ld hl,100
	ld (ix-2),l
	ld (ix-1),h
	ld a,(hl)
	call _external
	ld l,(ix-2)
	ld h,(ix-1)
	ld a,(hl)
	call _external
	ld l,(ix-2)
	ld h,(ix-1)
	ld a,(hl)
	call _external
	ld l,(ix-2)
	ld h,(ix-1)
	ld a,(hl)
	ld a,(ix-2)
	add a,1
	ld (ix-2),a
	jr nc,LDS
	inc (ix-1)
LDS:
	ld sp,ix
	pop ix
	ret
; static function accept
_ZA:
	push ix
	ld ix,0
	add ix,sp
	dec sp
	dec sp
	push iy ; peep: ix_pointer_to_iy_abi
	pop bc ; peep: ix_pointer_to_iy_abi
	ld (ix-2),c ; peep: ix_pointer_to_iy_abi
	ld (ix-1),b ; peep: ix_pointer_to_iy_abi
	ld hl,100
	push hl ; peep: ix_pointer_to_iy
	pop iy
	push iy ; peep: ix_pointer_to_iy
	pop hl
	ld a,(hl)
	call __safe
	push iy ; peep: ix_pointer_to_iy
	pop hl
	ld a,(hl)
	call __safe
	push iy ; peep: ix_pointer_to_iy
	pop de
	ex de,hl
	ld a,(hl)
	inc iy ; peep: ix_pointer_to_iy
	inc iy ; peep: ix_pointer_to_iy
	or a
	ld c,(ix-2) ; peep: ix_pointer_to_iy_abi
	ld b,(ix-1) ; peep: ix_pointer_to_iy_abi
	push bc ; peep: ix_pointer_to_iy_abi
	pop iy ; peep: ix_pointer_to_iy_abi
	ld sp,ix
	pop ix
	ret
; static function counted
_ZC:
	push ix
	ld ix,0
	add ix,sp
	dec sp ; peep: local_alloc_wide
	dec sp ; peep: local_alloc_wide
	dec sp ; peep: local_alloc_wide
	push iy ; peep: mutable_ix_pointer_to_iy_abi
	pop bc ; peep: mutable_ix_pointer_to_iy_abi
	ld (ix-2),c ; peep: mutable_ix_pointer_to_iy_abi
	ld (ix-1),b ; peep: mutable_ix_pointer_to_iy_abi
	ld hl,200
	push hl ; peep: mutable_ix_pointer_to_iy
	pop iy
	ld (ix-3),8
LC:
	push iy ; peep: mutable_ix_pointer_to_iy
	pop hl
	ld a,(hl)
	inc hl
	ld b,(hl)
	inc hl
	push hl ; peep: mutable_ix_pointer_to_iy
	pop iy
	dec (ix-3)
	jr nz,LC ; peep: jp_to_jr
	ld hl,0
	add hl,hl
	ld de,LCT
	add hl,de
	ld e,(hl)
	inc hl
	ld d,(hl)
	ex de,hl
	jp (hl)
LCT:
	dw LCEND
LCEND:
	ld c,(ix-2) ; peep: mutable_ix_pointer_to_iy_abi
	ld b,(ix-1) ; peep: mutable_ix_pointer_to_iy_abi
	push bc ; peep: mutable_ix_pointer_to_iy_abi
	pop iy ; peep: mutable_ix_pointer_to_iy_abi
	ld sp,ix
	pop ix
	ret
	end
